@page "/"
@using AniScroll.Models
@using AniScroll.Services
@inject AniListService AniListService
@inject IJSRuntime JS

<PageTitle>AnimeScroll</PageTitle>

<div class="anime-scroll-app" @ref="appContainer">
    <div class="main-scroll">
        @for (int i = 0; i < animes.Count; i++)
        {
            var index = i;
            var anime = animes[i];
            var isVisible = index == currentIndex;
            var layoutMode = GetLayoutMode(anime.Id, anime.Description);

            <div class="anime-card @(isVisible ? "active" : "") @GetCardTransitionClass(index)"
                 style="transform: translateY(@GetCardTransform(index)px); height: @(CARD_HEIGHT)px;"
                 @onmousedown="(e) => HandleCardMouseDown(e, index)"
                 @onmousemove="HandleCardMouseMove"
                 @onmouseup="HandleCardMouseUp"
                 @onmouseleave="HandleCardMouseUp">

                <!-- Background image flou -->
                <div class="bg-image" style="background-image: url('@anime.ImageUrl');"></div>
                <div class="gradient-overlay"></div>

                <!-- Contenu -->
                <div class="content-wrapper layout-@layoutMode">
                    <!-- Image principale -->
                    <div class="image-section">
                        <div class="anime-image"
                             style="background-image: url('@anime.ImageUrl'); @GetImageStyle(anime.Id, anime.Description)"></div>
                    </div>

                    <!-- Informations -->
                    <div class="info-section">
                        <h1 class="title @GetTitleClass(anime.Title)">@anime.Title</h1>

                        @if (!string.IsNullOrEmpty(anime.Season) && anime.Year.HasValue)
                        {
                            <div class="season-info">
                                @if (anime.Status == "RELEASING")
                                {
                                    <span class="status-dot releasing"></span>
                                }
                                else if (anime.Status == "NOT_YET_RELEASED")
                                {
                                    <span class="status-dot upcoming"></span>
                                }
                                <span>@anime.Season @anime.Year</span>
                            </div>
                        }

                        @if (anime.Genres?.Any() == true)
                        {
                            <p class="genres">@string.Join(" • ", anime.Genres)</p>
                        }

                        <!-- Stats badges -->
                        <div class="stats">
                            <div class="badge badge-score">★ @anime.Score</div>
                            <div class="badge badge-episodes">@anime.Episodes EP</div>
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrEmpty(anime.Description))
                        {
                            <div class="description-container">
                                @if (!IsExpanded(anime.Id))
                                {
                                    <p class="description-preview">@GetPreviewDescription(anime.Description)</p>
                                    @if (NeedsExpansion(anime.Description))
                                    {
                                        <button class="expand-btn" @onclick="() => ToggleExpand(anime.Id)">
                                            Read More
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="description-scroll-wrapper"
                                         style="@GetDescriptionWrapperStyle(anime.Description)"
                                         @ref="descScrollRef"
                                         @onmousedown="HandleDescMouseDown"
                                         @onmousemove="HandleDescMouseMove"
                                         @onmouseup="HandleDescMouseUp"
                                         @onmouseleave="HandleDescMouseUp">
                                        <div class="description-full">
                                            <p>@anime.Description</p>
                                            <button class="collapse-btn" @onclick="() => ToggleExpand(anime.Id)">
                                                See Less
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (isLoading)
        {
            <div class="loading-area">
                <div class="loading-box">
                    <div class="spinner"></div>
                    <p class="loading-title">🔍 Recherche en cours...</p>
                    <p class="loading-subtitle">Exploration de nouveaux animes sur AniList</p>
                </div>
            </div>
        }
    </div>

    <!-- Contrôles overlay -->
    <div class="overlay-controls">
        <!-- ⚠️ BOUTON CLOSE SUPPRIMÉ pour WASM -->
        <div class="counter">@animes.Count animes</div>
    </div>
</div>

@code {
    private List<AnimeCard> animes = new List<AnimeCard>();
    private HashSet<int> expandedAnimes = new HashSet<int>();
    private bool isLoading = false;
    private int currentIndex = 0;

    // ========== ⚙️ CONFIGURATION DU SCROLL - AJUSTABLE ICI ==========
    private double CARD_HEIGHT = 800; // Sera calculé dynamiquement
    private bool viewportHeightInitialized = false;

    // Pourcentage de l'écran à parcourir pour changer de carte (entre 0.1 et 0.5)
    private const double SWIPE_VALIDATION_PERCENT = 0.25; // 25% = 200 pixels sur 800px

    // Variables pour le drag de la card principale
    private bool isDraggingCard = false;
    private double dragStartY = 0;
    private double currentDragOffset = 0;
    private bool isTransitioning = false;

    // Variables pour le scroll de la description
    private bool isDraggingDesc = false;
    private double descDragStartY = 0;
    private double descScrollStartTop = 0;
    private ElementReference descScrollRef;
    private ElementReference appContainer;

    // Variables pour le mode swipe depuis la description
    private bool descSwipeMode = false;
    private double descSwipeStartY = 0;
    private bool hasReleasedAfterDescScroll = true;

    // Track des cartes créées pour éviter les transitions parasites
    private HashSet<int> newlyCreatedCards = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnimes(5);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Obtenir la hauteur réelle du viewport
                CARD_HEIGHT = await JS.InvokeAsync<double>("getViewportHeight");
                viewportHeightInitialized = true;

                // Debug: afficher la hauteur obtenue
                System.Diagnostics.Debug.WriteLine($"✅ Viewport height: {CARD_HEIGHT}px");

                StateHasChanged();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Erreur lors du calcul de la hauteur: {ex.Message}");
                // Garder la valeur par défaut de 800
            }
        }
    }

    private async Task LoadAnimes(int count)
    {
        isLoading = true;
        StateHasChanged();

        int startIndex = animes.Count;
        var newAnimes = await AniListService.GetMultipleAnimesAsync(count);
        animes.AddRange(newAnimes);

        // Marquer les nouvelles cartes comme "nouvelles" pour éviter la transition
        for (int i = startIndex; i < animes.Count; i++)
        {
            newlyCreatedCards.Add(i);
        }

        isLoading = false;
        StateHasChanged();

        // Après le rendu, retirer le flag "nouvelles cartes"
        await Task.Delay(50);
        newlyCreatedCards.Clear();
    }

    // ============================================
    // CALCUL DU MODE DE LAYOUT
    // ============================================

    private string GetLayoutMode(int animeId, string description)
    {
        if (!IsExpanded(animeId))
            return "normal";

        int descLength = description?.Length ?? 0;

        if (descLength < 300)
            return "short";

        if (descLength < 800)
            return "medium";

        return "long";
    }

    private string GetImageStyle(int animeId, string description)
    {
        if (!IsExpanded(animeId))
            return "";

        string layoutMode = GetLayoutMode(animeId, description);

        switch (layoutMode)
        {
            case "short":
                return "width: 280px; height: 420px;";
            case "medium":
                return "width: 200px; height: 300px;";
            case "long":
                return "width: 140px; height: 210px;";
            default:
                return "";
        }
    }

    private string GetDescriptionWrapperStyle(string description)
    {
        if (string.IsNullOrEmpty(description))
            return "max-height: 200px;";

        int descLength = description.Length;

        if (descLength < 300)
        {
            return "max-height: none; overflow-y: visible;";
        }
        else if (descLength < 800)
        {
            return "max-height: 300px;";
        }
        else
        {
            return "max-height: 400px;";
        }
    }

    private string GetTitleClass(string title)
    {
        if (string.IsNullOrEmpty(title)) return "";

        if (title.Length > 50)
            return "title-very-long";
        else if (title.Length > 30)
            return "title-long";

        return "";
    }

    // ============================================
    // 🎯 CLASSE CSS POUR TRANSITION
    // ============================================

    private string GetCardTransitionClass(int index)
    {
        // Ne pas appliquer de transition aux cartes nouvellement créées
        if (newlyCreatedCards.Contains(index))
            return "no-transition";

        // Ne pas appliquer de transition pendant le drag
        if (isDraggingCard)
            return "no-transition";

        // Appliquer la transition uniquement pendant le snap final
        if (isTransitioning)
            return "with-transition";

        return "no-transition";
    }

    // ============================================
    // 🎯 SCROLL VERTICAL TYPE INSTAGRAM/TIKTOK
    // ============================================

    private void HandleCardMouseDown(MouseEventArgs e, int index)
    {
        // Ne pas permettre le drag si on scrolle dans la description
        if (isDraggingDesc) return;

        // Ne permettre le drag que sur la carte active
        if (index != currentIndex) return;

        // Commencer le drag
        isDraggingCard = true;
        dragStartY = e.ClientY;
        currentDragOffset = 0;
        isTransitioning = false;
    }

    private void HandleCardMouseMove(MouseEventArgs e)
    {
        if (!isDraggingCard) return;

        // Calculer l'offset actuel par rapport au point de départ (1:1 avec le mouvement)
        currentDragOffset = e.ClientY - dragStartY;

        // Déclencher le re-render pour que les cartes suivent la souris
        StateHasChanged();
    }

    private async Task HandleCardMouseUp(MouseEventArgs e)
    {
        if (!isDraggingCard) return;

        isDraggingCard = false;

        // Calculer le seuil de validation (en pixels)
        double swipeThreshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;

        // Déterminer si le swipe est validé
        bool swipeValidated = Math.Abs(currentDragOffset) >= swipeThreshold;

        if (swipeValidated)
        {
            if (currentDragOffset < 0)
            {
                // Swipe vers le haut → Carte suivante
                if (currentIndex < animes.Count - 1)
                {
                    currentIndex++;
                }
                else
                {
                    // Charger plus d'animes
                    await LoadAnimes(5);
                    currentIndex++;
                }
            }
            else if (currentDragOffset > 0)
            {
                // Swipe vers le bas → Carte précédente
                if (currentIndex > 0)
                {
                    currentIndex--;
                }
            }
        }

        // Activer la transition pour le snap final
        isTransitioning = true;
        currentDragOffset = 0;
        StateHasChanged();

        // Désactiver la transition après animation
        await Task.Delay(300);
        isTransitioning = false;
    }

    private double GetCardTransform(int index)
    {
        // Position de base : chaque carte est espacée de CARD_HEIGHT
        double basePosition = (index - currentIndex) * CARD_HEIGHT;

        // Si on est en train de dragger, TOUTES les cartes bougent ensemble
        if (isDraggingCard || descSwipeMode)
        {
            return basePosition + currentDragOffset;
        }

        // Position normale
        return basePosition;
    }

    // ============================================
    // SCROLL DE LA DESCRIPTION
    // ============================================

    private async Task HandleDescMouseDown(MouseEventArgs e)
    {
        isDraggingDesc = true;
        descDragStartY = e.ClientY;
        descSwipeMode = false;

        var scrollInfo = await JS.InvokeAsync<ScrollInfo>("getScrollInfo", descScrollRef);
        descScrollStartTop = scrollInfo.ScrollTop;
    }

    private async Task HandleDescMouseMove(MouseEventArgs e)
    {
        if (!isDraggingDesc) return;

        double deltaY = descDragStartY - e.ClientY;

        if (descSwipeMode)
        {
            // Mode swipe : les cartes suivent la souris
            currentDragOffset = e.ClientY - descSwipeStartY;
            StateHasChanged();
            return;
        }

        var scrollInfo = await JS.InvokeAsync<ScrollInfo>("getScrollInfo", descScrollRef);
        double currentScrollTop = scrollInfo.ScrollTop;
        double maxScroll = scrollInfo.ScrollHeight - scrollInfo.ClientHeight;

        bool atStart = currentScrollTop <= 0;
        bool atEnd = currentScrollTop >= maxScroll - 5;

        // Si on est au bout ET qu'on a relâché depuis le dernier scroll
        if (((atStart && deltaY < 0) || (atEnd && deltaY > 0)) && hasReleasedAfterDescScroll)
        {
            // Activer le mode swipe
            descSwipeMode = true;
            descSwipeStartY = e.ClientY;
            isDraggingCard = true;
            dragStartY = e.ClientY;
            currentDragOffset = 0;
            hasReleasedAfterDescScroll = false;
            isTransitioning = false;
        }
        else
        {
            // Scroller normalement dans la description
            double newScrollTop = descScrollStartTop + deltaY;
            newScrollTop = Math.Max(0, Math.Min(newScrollTop, maxScroll));
            await JS.InvokeVoidAsync("setScrollTop", descScrollRef, newScrollTop);

            hasReleasedAfterDescScroll = false;
        }
    }

    private async Task HandleDescMouseUp(MouseEventArgs e)
    {
        if (!isDraggingDesc) return;

        isDraggingDesc = false;

        if (descSwipeMode)
        {
            descSwipeMode = false;
            isDraggingCard = false;

            // Calculer le seuil de validation
            double swipeThreshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;
            bool swipeValidated = Math.Abs(currentDragOffset) >= swipeThreshold;

            if (swipeValidated)
            {
                if (currentDragOffset < 0)
                {
                    if (currentIndex < animes.Count - 1)
                    {
                        currentIndex++;
                        expandedAnimes.Remove(animes[currentIndex - 1].Id);
                    }
                    else
                    {
                        await LoadAnimes(5);
                        currentIndex++;
                        if (currentIndex > 0)
                        {
                            expandedAnimes.Remove(animes[currentIndex - 1].Id);
                        }
                    }
                }
                else if (currentDragOffset > 0)
                {
                    if (currentIndex > 0)
                    {
                        expandedAnimes.Remove(animes[currentIndex].Id);
                        currentIndex--;
                    }
                }
            }

            // Activer la transition pour le snap final
            isTransitioning = true;
            currentDragOffset = 0;
            StateHasChanged();

            // Désactiver la transition après animation
            await Task.Delay(300);
            isTransitioning = false;
        }

        hasReleasedAfterDescScroll = true;
        StateHasChanged();
    }

    // ============================================
    // GESTION DE L'EXPANSION
    // ============================================

    private bool IsExpanded(int animeId)
    {
        return expandedAnimes.Contains(animeId);
    }

    private void ToggleExpand(int animeId)
    {
        if (expandedAnimes.Contains(animeId))
            expandedAnimes.Remove(animeId);
        else
            expandedAnimes.Add(animeId);

        StateHasChanged();
    }

    private bool NeedsExpansion(string description)
    {
        return description?.Length > 150;
    }

    private string GetPreviewDescription(string description)
    {
        if (string.IsNullOrEmpty(description))
            return "";

        if (description.Length <= 150)
            return description;

        return description.Substring(0, 150) + "...";
    }

    public class ScrollInfo
    {
        public double ScrollTop { get; set; }
        public double ScrollHeight { get; set; }
        public double ClientHeight { get; set; }
    }
}