@page "/"
@using AniScroll.Models
@using AniScroll.Services
@inject AniListService AniListService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>AnimeScroll</PageTitle>

<div class="anime-scroll-app" @ref="appContainer">
    <!-- Build Version -->
    <div class="build-version">v1.3.0</div>
    
    <div class="main-scroll">
        @for (int i = 0; i < animes.Count; i++)
        {
            var index = i;
            var anime = animes[i];
            var isVisible = index == currentIndex;
            var layoutMode = GetLayoutMode(anime.Id, anime.Description);

            <div class="anime-card @(isVisible ? "active" : "") @GetCardTransitionClass(index)"
                 style="transform: translateY(@GetCardTransform(index)px); height: @(CARD_HEIGHT)px;"
                 @onmousedown="(e) => HandleCardMouseDown(e, index)"
                 @onmousemove="HandleCardMouseMove"
                 @onmouseup="HandleCardMouseUp"
                 @onmouseleave="HandleCardMouseUp"
                 @ontouchstart="(e) => HandleCardTouchStart(e, index)"
                 @ontouchmove="HandleCardTouchMove"
                 @ontouchend="HandleCardTouchEnd">

                <!-- Background image flou -->
                <div class="bg-image" style="background-image: url('@anime.ImageUrl');"></div>
                <div class="gradient-overlay"></div>

                <!-- Contenu -->
                <div class="content-wrapper layout-@layoutMode">
                    <!-- Image principale -->
                    <div class="image-section">
                        <div class="anime-image"
                             style="background-image: url('@anime.ImageUrl'); @GetImageStyle(anime.Id, anime.Description)"></div>
                    </div>

                    <!-- Informations -->
                    <div class="info-section">
                        <h1 class="title @GetTitleClass(anime.Title)">@anime.Title</h1>

                        @if (!string.IsNullOrEmpty(anime.Season) && anime.Year.HasValue)
                        {
                            <div class="season-info">
                                @if (anime.Status == "RELEASING")
                                {
                                    <span class="status-dot releasing"></span>
                                }
                                else if (anime.Status == "NOT_YET_RELEASED")
                                {
                                    <span class="status-dot upcoming"></span>
                                }
                                <span>@anime.Season @anime.Year</span>
                            </div>
                        }

                        @if (anime.Genres?.Any() == true)
                        {
                            <p class="genres">@string.Join(" • ", anime.Genres)</p>
                        }

                        <!-- Stats badges -->
                        <div class="stats">
                            <div class="badge badge-score">★ @anime.Score</div>
                            <div class="badge badge-episodes">@anime.Episodes EP</div>
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrEmpty(anime.Description))
                        {
                            <div class="description-container">
                                @if (!IsExpanded(anime.Id))
                                {
                                    <p class="description-preview">@GetPreviewDescription(anime.Description)</p>
                                    @if (NeedsExpansion(anime.Description))
                                    {
                                        <button class="expand-btn" @onclick="() => ToggleExpand(anime.Id)">
                                            Read More
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="description-scroll-wrapper"
                                         style="@GetDescriptionWrapperStyle(anime.Description)"
                                         @ref="descScrollRef">
                                        <div class="description-full">
                                            <p>@anime.Description</p>
                                            <button class="collapse-btn" @onclick="() => ToggleExpand(anime.Id)">
                                                See Less
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (isLoading)
        {
            <div class="loading-area">
                <div class="loading-box">
                    <div class="spinner"></div>
                    <p class="loading-title">🔍 Chargement initial...</p>
                    <p class="loading-subtitle">Préparation de votre expérience anime</p>
                </div>
            </div>
        }
    </div>

    <!-- Contrôles overlay -->
    <div class="overlay-controls">
        <div class="counter">@animes.Count animes</div>
        @if (bufferSize > 0)
        {
            <div class="buffer-indicator">📦 @bufferSize ready</div>
        }
    </div>
</div>

@code {
    private List<AnimeCard> animes = new List<AnimeCard>();
    private HashSet<int> expandedAnimes = new HashSet<int>();
    private bool isLoading = false;
    private int currentIndex = 0;
    private int bufferSize = 0;

    // ========== ⚙️ CONFIGURATION ==========
    private double CARD_HEIGHT = 800;
    private bool viewportHeightInitialized = false;
    private const double SWIPE_VALIDATION_PERCENT = 0.06;

    // ========== 🚀 NOUVEAU SYSTÈME DE CHARGEMENT PROGRESSIF ==========
    private const int INITIAL_LOAD_COUNT = 5;
    private const int LOAD_MORE_THRESHOLD = 3; // Charger plus quand il reste 3 animes
    private const int LOAD_MORE_COUNT = 3; // Charger 3 animes à la fois
    private System.Threading.Timer? _bufferCheckTimer;

    // Variables pour le drag
    private bool isDraggingCard = false;
    private double dragStartY = 0;
    private double currentDragOffset = 0;
    private bool isTransitioning = false;

    private ElementReference descScrollRef;
    private ElementReference appContainer;
    private HashSet<int> newlyCreatedCards = new HashSet<int>();

    // Throttling
    private DateTime lastRenderTime = DateTime.Now;
    private const int THROTTLE_MS = 8;

    protected override async Task OnInitializedAsync()
    {
        // 🚀 DÉMARRER LE BACKGROUND LOADER
        AniListService.StartBackgroundLoading();
        
        // Charger les premiers animes
        await LoadInitialAnimes();
        
        // Démarrer le timer pour vérifier le buffer régulièrement
        _bufferCheckTimer = new System.Threading.Timer(
            async _ => await UpdateBufferSize(),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(2)
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                CARD_HEIGHT = await JS.InvokeAsync<double>("getViewportHeight");
                viewportHeightInitialized = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Erreur: {ex.Message}");
            }
        }
    }

    // ============================================
    // 🚀 CHARGEMENT PROGRESSIF
    // ============================================

    private async Task LoadInitialAnimes()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Récupérer depuis le buffer (instantané)
            var newAnimes = await AniListService.GetAnimesFromBufferAsync(INITIAL_LOAD_COUNT);
            
            if (newAnimes != null && newAnimes.Count > 0)
            {
                int startIndex = animes.Count;
                animes.AddRange(newAnimes);

                for (int i = startIndex; i < animes.Count; i++)
                {
                    newlyCreatedCards.Add(i);
                }

                System.Diagnostics.Debug.WriteLine($"✅ Chargement initial: {newAnimes.Count} animes");
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            
            await Task.Delay(50);
            newlyCreatedCards.Clear();
        }
    }

    private async Task LoadMoreAnimes()
    {
        try
        {
            int startIndex = animes.Count;
            
            // Récupérer depuis le buffer (instantané pour l'utilisateur)
            var newAnimes = await AniListService.GetAnimesFromBufferAsync(LOAD_MORE_COUNT);
            
            if (newAnimes != null && newAnimes.Count > 0)
            {
                animes.AddRange(newAnimes);

                for (int i = startIndex; i < animes.Count; i++)
                {
                    newlyCreatedCards.Add(i);
                }

                System.Diagnostics.Debug.WriteLine($"✅ Chargé {newAnimes.Count} animes supplémentaires. Total: {animes.Count}");
                StateHasChanged();
                
                await Task.Delay(50);
                newlyCreatedCards.Clear();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ Erreur LoadMoreAnimes: {ex.Message}");
        }
    }

    private async Task CheckAndLoadMore()
    {
        int remainingCards = animes.Count - currentIndex - 1;
        
        if (remainingCards <= LOAD_MORE_THRESHOLD)
        {
            System.Diagnostics.Debug.WriteLine($"🔄 Chargement auto déclenché. Restant: {remainingCards}");
            await LoadMoreAnimes();
        }
    }

    private async Task UpdateBufferSize()
    {
        try
        {
            int newBufferSize = await AniListService.GetBufferSizeAsync();
            if (newBufferSize != bufferSize)
            {
                bufferSize = newBufferSize;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ Erreur UpdateBufferSize: {ex.Message}");
        }
    }

    // ============================================
    // LAYOUT ET STYLES
    // ============================================

    private string GetLayoutMode(int animeId, string description)
    {
        if (!IsExpanded(animeId))
            return "normal";

        int descLength = description?.Length ?? 0;

        if (descLength < 300)
            return "short";

        if (descLength < 800)
            return "medium";

        return "long";
    }

    private string GetImageStyle(int animeId, string description)
    {
        if (!IsExpanded(animeId))
            return "";

        string layoutMode = GetLayoutMode(animeId, description);

        switch (layoutMode)
        {
            case "short":
                return "width: 280px; height: 420px;";
            case "medium":
                return "width: 200px; height: 300px;";
            case "long":
                return "width: 140px; height: 210px;";
            default:
                return "";
        }
    }

    private string GetDescriptionWrapperStyle(string description)
    {
        if (string.IsNullOrEmpty(description))
            return "max-height: 200px;";

        int descLength = description.Length;

        if (descLength < 300)
        {
            return "max-height: none; overflow-y: visible;";
        }
        else if (descLength < 800)
        {
            return "max-height: 350px;";
        }
        else
        {
            return "max-height: 450px;";
        }
    }

    private string GetTitleClass(string title)
    {
        if (string.IsNullOrEmpty(title)) return "";

        if (title.Length > 50)
            return "title-very-long";
        else if (title.Length > 30)
            return "title-long";

        return "";
    }

    private string GetCardTransitionClass(int index)
    {
        if (newlyCreatedCards.Contains(index))
            return "no-transition";

        if (isDraggingCard)
            return "no-transition";

        if (isTransitioning)
            return "with-transition";

        return "no-transition";
    }

    // ============================================
    // 🎯 SWIPE - SOURIS
    // ============================================

    private void HandleCardMouseDown(MouseEventArgs e, int index)
    {
        if (index != currentIndex) return;

        isDraggingCard = true;
        dragStartY = e.ClientY;
        currentDragOffset = 0;
        isTransitioning = false;
    }

    private void HandleCardMouseMove(MouseEventArgs e)
    {
        if (!isDraggingCard) return;

        var now = DateTime.Now;
        if ((now - lastRenderTime).TotalMilliseconds < THROTTLE_MS)
            return;

        lastRenderTime = now;

        currentDragOffset = e.ClientY - dragStartY;
        StateHasChanged();
    }

    private async Task HandleCardMouseUp(MouseEventArgs e)
    {
        if (!isDraggingCard) return;

        isDraggingCard = false;

        double swipeThreshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;
        bool swipeValidated = Math.Abs(currentDragOffset) >= swipeThreshold;

        if (swipeValidated)
        {
            if (currentDragOffset < 0)
            {
                if (currentIndex < animes.Count - 1)
                {
                    currentIndex++;
                    await CheckAndLoadMore();
                }
            }
            else if (currentDragOffset > 0)
            {
                if (currentIndex > 0)
                {
                    currentIndex--;
                }
            }
        }

        isTransitioning = true;
        currentDragOffset = 0;
        StateHasChanged();

        await Task.Delay(250);
        isTransitioning = false;
    }

    // ============================================
    // 🎯 SWIPE - TOUCH
    // ============================================

    private void HandleCardTouchStart(TouchEventArgs e, int index)
    {
        if (index != currentIndex) return;

        if (e.Touches.Length > 0)
        {
            isDraggingCard = true;
            dragStartY = e.Touches[0].ClientY;
            currentDragOffset = 0;
            isTransitioning = false;
        }
    }

    private void HandleCardTouchMove(TouchEventArgs e)
    {
        if (!isDraggingCard) return;

        var now = DateTime.Now;
        if ((now - lastRenderTime).TotalMilliseconds < THROTTLE_MS)
            return;

        lastRenderTime = now;

        if (e.Touches.Length > 0)
        {
            currentDragOffset = e.Touches[0].ClientY - dragStartY;
            StateHasChanged();
        }
    }

    private async Task HandleCardTouchEnd(TouchEventArgs e)
    {
        if (!isDraggingCard) return;

        isDraggingCard = false;

        double swipeThreshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;
        bool swipeValidated = Math.Abs(currentDragOffset) >= swipeThreshold;

        if (swipeValidated)
        {
            if (currentDragOffset < 0)
            {
                if (currentIndex < animes.Count - 1)
                {
                    currentIndex++;
                    await CheckAndLoadMore();
                }
            }
            else if (currentDragOffset > 0)
            {
                if (currentIndex > 0)
                {
                    currentIndex--;
                }
            }
        }

        isTransitioning = true;
        currentDragOffset = 0;
        StateHasChanged();

        await Task.Delay(250);
        isTransitioning = false;
    }

    private double GetCardTransform(int index)
    {
        double basePosition = (index - currentIndex) * CARD_HEIGHT;

        if (isDraggingCard)
        {
            return basePosition + currentDragOffset;
        }

        return basePosition;
    }

    // ============================================
    // EXPANSION
    // ============================================

    private bool IsExpanded(int animeId)
    {
        return expandedAnimes.Contains(animeId);
    }

    private void ToggleExpand(int animeId)
    {
        if (expandedAnimes.Contains(animeId))
            expandedAnimes.Remove(animeId);
        else
            expandedAnimes.Add(animeId);

        StateHasChanged();
    }

    private bool NeedsExpansion(string description)
    {
        return description?.Length > 150;
    }

    private string GetPreviewDescription(string description)
    {
        if (string.IsNullOrEmpty(description))
            return "";

        if (description.Length <= 150)
            return description;

        return description.Substring(0, 150) + "...";
    }

    public async ValueTask DisposeAsync()
    {
        _bufferCheckTimer?.Dispose();
        
        if (AniListService is IAsyncDisposable disposable)
        {
            await disposable.DisposeAsync();
        }
    }
}
