@page "/"
@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject AniListService AniListService
@inject IJSRuntime JS

<PageTitle>AnimeScroll</PageTitle>

<div class="anime-scroll-app" @ref="appContainer">
    <div class="build-version">v2.4.0</div>

    <div class="main-scroll">

        @* ── Windowed virtual rendering ──────────────────────────────────────────
           Only ±RENDER_WINDOW cards are in the DOM at any time.
           Cards outside the window are not rendered at all — no empty placeholder
           divs, no DOM bloat. Positioning stays correct because each card uses
           transform: translateY((i - currentIndex) * CARD_HEIGHT).
        *@
        @{
            int renderStart = Math.Max(0, currentIndex - RENDER_WINDOW);
            int renderEnd = Math.Min(animes.Count - 1, currentIndex + RENDER_WINDOW);
        }
        @for (int i = renderStart; i <= renderEnd; i++)
        {
            var index = i;
            var anime = animes[i];
            var isVisible = index == currentIndex;
            var layoutMode = GetLayoutMode(anime.Id, anime.Description);

            <div class="anime-card @(isVisible ? "active" : "") @(GetCardTransitionClass(index))"
                 style="transform: translateY(@(GetCardTransform(index).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px); height: @(CARD_HEIGHT)px;"
                 @onmousedown="(e) => HandleCardMouseDown(e, index)"
                 @onmousemove="HandleCardMouseMove"
                 @onmouseup="HandleCardMouseUp"
                 @onmouseleave="HandleCardMouseUp"
                 @ontouchstart="(e) => HandleCardTouchStart(e, index)"
                 @ontouchmove="HandleCardTouchMove"
                 @ontouchend="HandleCardTouchEnd">

                <div class="bg-image" style="background-image: url('@anime.ImageUrl');"></div>
                <div class="gradient-overlay"></div>

                <div class="content-wrapper layout-@layoutMode">
                    <div class="image-section">
                        <div class="anime-image"
                             style="background-image: url('@anime.ImageUrl'); @GetImageStyle(anime.Id, anime.Description)"
                             @onclick="() => HandleImageClick(anime)"></div>
                    </div>

                    <div class="info-section">
                        <h1 class="title @GetTitleClass(anime.Title)"
                            @onclick="() => HandleTitleClick(anime)">
                            @anime.Title
                        </h1>

                        @if (!string.IsNullOrEmpty(anime.Season) && anime.Year.HasValue)
                        {
                            <div class="season-info">
                                @if (anime.Status == "RELEASING")
                                {
                                    <span class="status-dot releasing"></span>
                                }
                                else if (anime.Status == "NOT_YET_RELEASED")
                                {
                                    <span class="status-dot upcoming"></span>
                                }
                                <span>@anime.Season @anime.Year</span>
                            </div>
                        }

                        @if (anime.Genres?.Any() == true)
                        {
                            <p class="genres">@string.Join(" • ", anime.Genres)</p>
                        }

                        <div class="stats">
                            <div class="badge badge-score">★ @anime.Score</div>
                            <div class="badge badge-episodes">@anime.Episodes EP</div>
                        </div>

                        @if (!string.IsNullOrEmpty(anime.Description))
                        {
                            <div class="description-container">
                                @if (!IsExpanded(anime.Id))
                                {
                                    <p class="description-preview">@GetSafePreviewDescription(anime.Description)</p>
                                    @if (NeedsExpansion(anime.Description))
                                    {
                                        <button class="expand-btn" @onclick="() => ToggleExpand(anime.Id)">
                                            Read More
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="description-scroll-wrapper description-scroll-zone"
                                         style="@GetDescriptionWrapperStyle(anime.Description)"
                                         @ref="descScrollRef"
                                         data-anime-id="@anime.Id">
                                        <div class="description-full">
                                            <p>@anime.Description</p>
                                        </div>
                                    </div>
                                    <button class="collapse-btn" @onclick="() => ToggleExpand(anime.Id)">
                                        See Less
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (isLoading && !isInitialLoadComplete)
        {
            <div class="loading-area">
                <div class="loading-box">
                    <div class="spinner"></div>
                    <p class="loading-title">Loading...</p>
                    <p class="loading-subtitle">Fetching 60 awesome animes</p>
                </div>
            </div>
        }

        @if (isRateLimited)
        {
            <div class="loading-area">
                <div class="loading-box rate-limit-box">
                    <div class="rate-limit-icon">⏱️</div>
                    <p class="loading-title">API Rate Limit Reached</p>
                    <p class="loading-subtitle">Retrying in @rateLimitCountdown seconds...</p>
                </div>
            </div>
        }
    </div>

    <div class="overlay-controls">
        <div class="counter">@(animeOffset + currentIndex) / @(animeOffset + animes.Count)</div>
        @if (isPreloading)
        {
            <div class="preload-badge">Loading more...</div>
        }
        @if (isRateLimited)
        {
            <div class="rate-limit-badge">Rate Limited</div>
        }
    </div>

    @if (!showDetailPopup)
    {
        <AniScroll.Shared.Components.Layout.NavigationBar OnSearchToggled="HandleSearchToggled"
                                                          OnListsClicked="HandleListsClicked"
                                                          OnProfileClicked="HandleProfileClicked"
                                                          OnSearchQueryChanged="HandleSearchQueryChanged" />
    }

    <AniScroll.Shared.Components.Layout.AnimeDetailPopup CurrentAnime="selectedAnime"
                                                         IsVisible="showDetailPopup"
                                                         OnClose="CloseDetailPopup" />
</div>

@code {
    // ─── Data ───────────────────────────────────────────────────────────────────
    private List<AnimeCard> animes = new();
    private HashSet<int> expandedAnimes = new();

    // ─── Virtualization ─────────────────────────────────────────────────────────
    // Only ±RENDER_WINDOW card divs exist in the DOM.
    // Max DOM nodes = 2 * RENDER_WINDOW + 1 = 7.
    private const int RENDER_WINDOW = 3;

    // ─── Memory management ──────────────────────────────────────────────────────
    // Cards far behind the current index are evicted to prevent memory growth.
    // animeOffset tracks how many were evicted so the counter stays correct.
    private int animeOffset = 0;
    private const int MAX_CARDS_BEHIND = 20;  // trigger trim when this many behind
    private const int TRIM_TO_BEHIND = 8;   // keep this many behind after trim

    // ─── Loading ─────────────────────────────────────────────────────────────────
    private bool isLoading = false;
    private bool isInitialLoadComplete = false;
    private bool isPreloading = false;
    private bool isRateLimited = false;
    private int rateLimitCountdown = 0;
    private const int PRELOAD_THRESHOLD = 30;
    private System.Threading.Timer? rateLimitTimer;

    // ─── Navigation ──────────────────────────────────────────────────────────────
    private int currentIndex = 0;
    private int previousIndex = -1;
    private double CARD_HEIGHT = 800;
    private const double SWIPE_VALIDATION_PERCENT = 0.06;

    // ─── Drag state ──────────────────────────────────────────────────────────────
    private bool isDraggingCard = false;
    private double dragStartY = 0;
    private double dragStartX = 0;
    private double currentDragOffset = 0;
    private bool isTransitioning = false;
    private bool isTouchingDescription = false;
    private bool descriptionScrolledToBottom = false;
    private bool isScrollingInDescription = false;

    // ─── Misc ────────────────────────────────────────────────────────────────────
    private ElementReference descScrollRef;
    private ElementReference appContainer;
    private DateTime lastRenderTime = DateTime.Now;
    private const int THROTTLE_MS = 8;
    private bool hasMoved = false;
    private const double clickThreshold = 5;

    // ─── Popup ───────────────────────────────────────────────────────────────────
    private bool showDetailPopup = false;
    private AnimeCard? selectedAnime = null;

    // ═══════════════════════════════════════════════════════════════════════════
    //  LIFECYCLE
    // ═══════════════════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        await LoadAnimes(60, isBackgroundLoad: false);
        isInitialLoadComplete = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                CARD_HEIGHT = await JS.InvokeAsync<double>("getViewportHeight");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Viewport height error: {ex.Message}");
            }
        }

        if (previousIndex != currentIndex && previousIndex >= 0)
        {
            // Collapse description of the card we left
            if (previousIndex < animes.Count)
            {
                var prev = animes[previousIndex];
                expandedAnimes.Remove(prev.Id);
            }

            // Background preload when approaching the end
            if (animes.Count > 0 &&
                currentIndex >= animes.Count - PRELOAD_THRESHOLD &&
                !isPreloading &&
                !AniListService.IsRateLimited())
            {
                _ = PreloadNextBatch();
            }
        }

        previousIndex = currentIndex;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  MEMORY MANAGEMENT
    // ═══════════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Evicts cards far behind currentIndex to keep the animes list bounded.
    /// Called after every navigation step.
    /// </summary>
    private void TrimAnimesList()
    {
        if (currentIndex <= MAX_CARDS_BEHIND) return;

        int trimCount = currentIndex - TRIM_TO_BEHIND;
        if (trimCount <= 0) return;

        // Remove leading items and clean up associated state
        animes.RemoveRange(0, trimCount);
        currentIndex -= trimCount;
        previousIndex = Math.Max(0, previousIndex - trimCount);
        animeOffset += trimCount;

        System.Diagnostics.Debug.WriteLine(
            $"✂️ Trimmed {trimCount} cards. List: {animes.Count}, offset: {animeOffset}");
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  DATA LOADING
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task PreloadNextBatch()
    {
        if (isPreloading) return;
        isPreloading = true;
        // Only update badge — avoid full re-render during preload start
        await InvokeAsync(StateHasChanged);
        await LoadAnimes(60, isBackgroundLoad: true);
        isPreloading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAnimes(int count, bool isBackgroundLoad = false)
    {
        if (AniListService.IsRateLimited())
        {
            isRateLimited = true;
            StartRateLimitCountdown();
            StateHasChanged();
            return;
        }

        if (!isBackgroundLoad) { isLoading = true; StateHasChanged(); }

        // Yield so the loading spinner renders before the synchronous JSON parse
        await Task.Yield();

        var result = await AniListService.GetMultipleAnimesAsync(count);

        if (result.IsRateLimited)
        {
            isRateLimited = true;
            if (!isBackgroundLoad) isLoading = false;
            StartRateLimitCountdown();
            StateHasChanged();
            return;
        }

        animes.AddRange(result.Animes);

        if (!isBackgroundLoad) isLoading = false;
        StateHasChanged();
    }

    private void StartRateLimitCountdown()
    {
        rateLimitCountdown = AniListService.GetRateLimitSecondsRemaining();
        rateLimitTimer?.Dispose();
        rateLimitTimer = new System.Threading.Timer(async _ =>
        {
            rateLimitCountdown = AniListService.GetRateLimitSecondsRemaining();
            if (rateLimitCountdown <= 0) { isRateLimited = false; rateLimitTimer?.Dispose(); }
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private string GetLayoutMode(int animeId, string description)
    {
        if (!IsExpanded(animeId)) return "normal";
        int len = description?.Length ?? 0;
        if (len < 300) return "short";
        if (len < 800) return "medium";
        return "long";
    }

    private string GetImageStyle(int animeId, string description)
    {
        if (!IsExpanded(animeId)) return "";
        return GetLayoutMode(animeId, description) switch
        {
            "short" => "width: 280px; height: 420px;",
            "medium" => "width: 200px; height: 300px;",
            "long" => "width: 140px; height: 210px;",
            _ => ""
        };
    }

    private string GetDescriptionWrapperStyle(string description)
    {
        if (string.IsNullOrEmpty(description)) return "max-height: 200px;";
        int len = description.Length;
        if (len < 300) return "max-height: min(200px, 50vh); overflow-y: auto;";
        if (len < 800) return "max-height: min(350px, 50vh); overflow-y: auto;";
        return "max-height: min(450px, 50vh); overflow-y: auto;";
    }

    private string GetTitleClass(string title)
    {
        if (string.IsNullOrEmpty(title)) return "";
        if (title.Length > 50) return "title-very-long";
        if (title.Length > 30) return "title-long";
        return "";
    }

    private string GetCardTransitionClass(int index)
    {
        // During drag: no transition on any card (follow finger directly)
        if (isDraggingCard) return "no-transition";
        // After releasing: transition on all windowed cards to snap into place
        if (isTransitioning) return "with-transition";
        return "no-transition";
    }

    private double GetCardTransform(int index)
    {
        double basePosition = (index - currentIndex) * CARD_HEIGHT;
        if (isDraggingCard) return basePosition + currentDragOffset;
        return basePosition;
    }

    private bool IsExpanded(int animeId) => expandedAnimes.Contains(animeId);

    private void ToggleExpand(int animeId)
    {
        if (expandedAnimes.Contains(animeId)) expandedAnimes.Remove(animeId);
        else expandedAnimes.Add(animeId);
        StateHasChanged();
    }

    private bool NeedsExpansion(string description) => description?.Length > 150;

    private string GetSafePreviewDescription(string description)
    {
        if (string.IsNullOrEmpty(description)) return "";
        int maxChars = 110;
        if (description.Length <= maxChars) return description;
        int cut = description.LastIndexOf(' ', Math.Min(maxChars, description.Length - 1));
        if (cut == -1 || cut < 50) cut = maxChars;
        return description.Substring(0, cut).TrimEnd() + "...";
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  MOUSE INPUT
    // ═══════════════════════════════════════════════════════════════════════════

    private void HandleCardMouseDown(MouseEventArgs e, int index)
    {
        if (index != currentIndex) return;
        isDraggingCard = true;
        dragStartY = e.ClientY;
        dragStartX = e.ClientX;
        currentDragOffset = 0;
        isTransitioning = false;
        hasMoved = false;
    }

    private void HandleCardMouseMove(MouseEventArgs e)
    {
        if (!isDraggingCard) return;

        if (Math.Abs(e.ClientX - dragStartX) > clickThreshold ||
            Math.Abs(e.ClientY - dragStartY) > clickThreshold)
            hasMoved = true;

        var now = DateTime.Now;
        if ((now - lastRenderTime).TotalMilliseconds < THROTTLE_MS) return;
        lastRenderTime = now;

        currentDragOffset = e.ClientY - dragStartY;
        StateHasChanged();
    }

    private async Task HandleCardMouseUp(MouseEventArgs e)
    {
        if (!isDraggingCard) return;
        isDraggingCard = false;
        await FinishSwipe();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  TOUCH INPUT
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task HandleCardTouchStart(TouchEventArgs e, int index)
    {
        if (index != currentIndex || e.Touches.Length == 0) return;

        var touch = e.Touches[0];
        isTouchingDescription = await JS.InvokeAsync<bool>("isTouchingDescriptionZone", touch.ClientX, touch.ClientY);

        if (isTouchingDescription && IsExpanded(animes[currentIndex].Id))
        {
            isScrollingInDescription = true;
            descriptionScrolledToBottom = await JS.InvokeAsync<bool>("isDescriptionAtBottom");
            return;
        }

        isDraggingCard = true;
        dragStartY = touch.ClientY;
        dragStartX = touch.ClientX;
        currentDragOffset = 0;
        isTransitioning = false;
        hasMoved = false;
    }

    private async Task HandleCardTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;

        var touch = e.Touches[0];
        if (Math.Abs(touch.ClientX - dragStartX) > clickThreshold ||
            Math.Abs(touch.ClientY - dragStartY) > clickThreshold)
            hasMoved = true;

        if (isScrollingInDescription)
        {
            bool atTop = await JS.InvokeAsync<bool>("isDescriptionAtTop");
            descriptionScrolledToBottom = await JS.InvokeAsync<bool>("isDescriptionAtBottom");
            double dy = touch.ClientY - dragStartY;

            bool shouldDrag = (atTop && dy > 0) || (descriptionScrolledToBottom && dy < 0);
            if (!shouldDrag) return;

            if (!isDraggingCard)
            {
                isDraggingCard = true;
                dragStartY = touch.ClientY;
                dragStartX = touch.ClientX;
                currentDragOffset = 0;
            }
        }

        if (!isDraggingCard) return;

        var now = DateTime.Now;
        if ((now - lastRenderTime).TotalMilliseconds < THROTTLE_MS) return;
        lastRenderTime = now;

        currentDragOffset = touch.ClientY - dragStartY;
        StateHasChanged();
    }

    private async Task HandleCardTouchEnd(TouchEventArgs e)
    {
        isScrollingInDescription = false;
        isTouchingDescription = false;
        descriptionScrolledToBottom = false;

        if (!isDraggingCard) return;
        isDraggingCard = false;
        await FinishSwipe();
    }

    // ─── Shared swipe completion ─────────────────────────────────────────────
    private async Task FinishSwipe()
    {
        double threshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;

        if (Math.Abs(currentDragOffset) >= threshold)
        {
            if (currentDragOffset < 0)
            {
                if (currentIndex < animes.Count - 1)
                {
                    currentIndex++;
                }
                else if (!AniListService.IsRateLimited())
                {
                    await LoadAnimes(60, isBackgroundLoad: false);
                    if (animes.Count > currentIndex + 1) currentIndex++;
                }
            }
            else if (currentDragOffset > 0 && currentIndex > 0)
            {
                currentIndex--;
            }
        }

        // Trim cards far behind to free memory
        TrimAnimesList();

        isTransitioning = true;
        currentDragOffset = 0;
        StateHasChanged();

        await Task.Delay(250);
        isTransitioning = false;
        hasMoved = false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  POPUP
    // ═══════════════════════════════════════════════════════════════════════════

    private void HandleImageClick(AnimeCard anime)
    {
        if (!hasMoved && !isDraggingCard) ShowAnimeDetails(anime);
    }

    private void HandleTitleClick(AnimeCard anime)
    {
        if (!hasMoved && !isDraggingCard) ShowAnimeDetails(anime);
    }

    private void ShowAnimeDetails(AnimeCard anime)
    {
        selectedAnime = anime;
        showDetailPopup = true;
        StateHasChanged();
    }

    private void CloseDetailPopup()
    {
        showDetailPopup = false;
        selectedAnime = null;
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  NAV BAR STUBS
    // ═══════════════════════════════════════════════════════════════════════════

    private void HandleSearchToggled() { }
    private void HandleListsClicked() { }
    private void HandleProfileClicked() { }
    private void HandleSearchQueryChanged(string query) { }

    public void Dispose() => rateLimitTimer?.Dispose();
}
