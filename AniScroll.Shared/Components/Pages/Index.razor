@page "/"
@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Text.Json
@inject AniListService AniListService
@inject AniListAuthService AniListAuth
@inject UserListService UserListService
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable


<PageTitle>AnimeScroll</PageTitle>

<div class="anime-scroll-app @(isSearchActive ? "search-is-active" : "")" @ref="appContainer">
    <div class="build-version">v1.7.5</div>

    <button @onclick="() => showDebugPanel = true"
            style="position:fixed;top:30px;left:10px;z-index:200;background:rgba(233,69,96,0.8);border:none;color:white;font-size:9px;padding:3px 6px;border-radius:5px;cursor:pointer;font-family:monospace;">
        DEBUG
    </button>

    <div class="main-scroll">
        @for (int i = 0; i < animes.Count; i++)
        {
            var index = i;
            var anime = animes[i];
            var isVisible = index == currentIndex;
            var distance = Math.Abs(index - currentIndex);

            @* Move/up/end handlers removed — drag.js owns them natively *@
            <div class="anime-card @(isVisible ? "active" : "") @GetCardTransitionClass(index)"
                 style="transform: translateY(@GetCardTranslateY(index)px); height: @(CARD_HEIGHT)px;"
                 @onmousedown="(e) => HandleCardMouseDown(e, index)"
                 @ontouchstart="(e) => HandleCardTouchStart(e, index)">

                @if (distance <= RENDER_WINDOW)
                {
                    <div class="bg-image" style="background-image: url('@anime.ImageUrl');"></div>
                    <div class="gradient-overlay"></div>

                    @* ── Swipe feather overlays (active card only) ── *@
                    @if (isVisible)
                    {
                        @* Opacity starts at 0 — drag.js updates it directly during drag *@
                        <div class="swipe-feather swipe-feather-right" style="opacity:0"></div>
                        <div class="swipe-feather swipe-feather-left" style="opacity:0"></div>
                    }

                    <div class="content-wrapper">
                        <div class="image-section">
                            @if (isVisible)
                            {
                                @* Hints start hidden — drag.js drives their opacity *@
                                <div class="swipe-hint swipe-hint-right" style="opacity:0">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.8"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Completed</span>
                                </div>

                                <div class="swipe-hint swipe-hint-left" style="opacity:0">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    <span>Planning</span>
                                </div>
                            }

                            <div class="anime-image @GetImageTransitionClass(index)"
                                 style="background-image: url('@anime.ImageUrl'); @GetImageTransform(index)"
                                 @onclick="async () => await HandleImageClick(anime)"></div>
                        </div>

                        <div class="info-section">
                            <h1 class="title @GetTitleClass(anime.Title)"
                                @onclick="async () => await HandleTitleClick(anime)">
                                @anime.Title
                            </h1>

                            @if (!string.IsNullOrEmpty(anime.Season) && anime.Year.HasValue)
                            {
                                <div class="season-info">
                                    @if (anime.Status == "RELEASING")
                                    {
                                        <span class="status-dot releasing"></span>
                                    }
                                    else if (anime.Status == "NOT_YET_RELEASED")
                                    {
                                        <span class="status-dot upcoming"></span>
                                    }
                                    <span>@anime.Season @anime.Year</span>
                                </div>
                            }

                            @if (anime.Genres?.Any() == true)
                            {
                                <p class="genres">@string.Join(" • ", anime.Genres)</p>
                            }

                            <div class="stats">
                                <div class="badge badge-score">★ @anime.Score</div>
                                <div class="badge badge-episodes">@anime.Episodes EP</div>
                            </div>

                            @if (!string.IsNullOrEmpty(anime.Description))
                            {
                                <div class="description-container">
                                    <p class="description-preview">@anime.Description</p>
                                    <button class="read-more-btn" @onclick="async () => await ShowAnimeDetails(anime)">
                                        Read More
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        }

        @if (isLoading && !isInitialLoadComplete)
        {
            <div class="loading-area">
                <div class="loading-box">
                    <div class="spinner"></div>
                    <p class="loading-title">Loading...</p>
                    <p class="loading-subtitle">Fetching 60 awesome animes</p>
                </div>
            </div>
        }

        @if (isRateLimited)
        {
            <div class="loading-area">
                <div class="loading-box rate-limit-box">
                    <div class="rate-limit-icon">⏱️</div>
                    <p class="loading-title">API Rate Limit Reached</p>
                    <p class="loading-subtitle">Retrying in @rateLimitCountdown seconds...</p>
                </div>
            </div>
        }
    </div>

    <div class="overlay-controls">
        <div class="counter">@(currentIndex + 1) / @animes.Count</div>
        @if (isPreloading)
        {
            <div class="preload-badge">🔄️</div>
        }
        @if (isRateLimited)
        {
            <div class="rate-limit-badge">Rate Limited</div>
        }
    </div>

    @if (isSearchActive)
    {
        <div class="search-results-panel visible"
             @onclick:stopPropagation="true"
             @onmousedown:stopPropagation="true"
             @ontouchstart:stopPropagation="true"
             @ontouchmove:stopPropagation="true"
             @ontouchend:stopPropagation="true">

            @if (isSearchLoading && !searchResults.Any())
            {
                <div class="search-results-loading">
                    <div class="spinner-small"></div>
                    <span>Searching...</span>
                </div>
            }
            else if (!isSearchLoading && !searchResults.Any())
            {
                <div class="search-no-results">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                         stroke="rgba(255,255,255,0.2)" stroke-width="1.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                    <span>No results found</span>
                    <span class="search-no-results-hint">Try a different title or spelling</span>
                </div>
            }

            @foreach (var result in searchResults)
            {
                var r = result;
                <div class="search-result-item" @onclick="() => HandleSearchResultClick(r)">
                    <div class="search-result-thumb"
                         style="background-image: url('@r.ImageUrl');"></div>
                    <div class="search-result-info">
                        <div class="search-result-title">@r.Title</div>
                        <div class="search-result-meta">
                            @r.Type
                            @if (r.Episodes.HasValue && r.Episodes > 0)
                            {
                                <span> · @r.Episodes EP</span>
                            }
                            @if (!string.IsNullOrEmpty(r.Score) && r.Score != "N/A")
                            {
                                <span> · ★ @r.Score</span>
                            }
                        </div>
                    </div>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </div>
            }

            @if (isSearchLoading && searchResults.Any())
            {
                <div class="search-results-updating">Updating...</div>
            }
        </div>
    }

    @if (isLoadingSelectedAnime)
    {
        <div class="search-fetch-overlay"
             @onclick:stopPropagation="true"
             @ontouchstart:stopPropagation="true">
            <div class="spinner"></div>
        </div>
    }

    @if (!showDetailPopup)
    {
        <AniScroll.Shared.Components.Layout.NavigationBar OnSearchToggled="HandleSearchToggled"
                                                          OnListsClicked="HandleListsClicked"
                                                          OnProfileClicked="HandleProfileClicked"
                                                          IsAniListConnected="AniListAuth.IsAuthenticated"
                                                          OnSearchQueryChanged="HandleSearchQueryChanged" />
    }

    <AniScroll.Shared.Components.Layout.AnimeDetailPopup CurrentAnime="selectedAnime"
                                                         IsVisible="showDetailPopup"
                                                         OnClose="CloseDetailPopup" />

    <ListsPanel IsVisible="showListsPanel"
                OnClose="CloseListsPanel"
                OnAnimeSelected="HandleListsAnimeSelected" />

    <AniScroll.Shared.Components.Layout.DebugPanel IsVisible="showDebugPanel"
                                                   OnHide="@(() => showDebugPanel = false)" />

    <ProfilePanel IsVisible="_showProfilePanel"
                  OnClose="@(() => _showProfilePanel = false)"
                  @ref="_profilePanel" />
</div>

@code {
    private bool showDebugPanel = false;

    // ─── Data ────────────────────────────────────────────────────────────────
    private List<AnimeCard> animes = new();

    // ─── Virtualization ──────────────────────────────────────────────────────
    private const int RENDER_WINDOW = 5;

    // ─── Loading ─────────────────────────────────────────────────────────────
    private bool isLoading = false;
    private bool isInitialLoadComplete = false;
    private bool isPreloading = false;
    private bool isRateLimited = false;
    private int rateLimitCountdown = 0;
    private const int PRELOAD_THRESHOLD = 40;
    private System.Threading.Timer? rateLimitTimer;

    // ─── Navigation ──────────────────────────────────────────────────────────
    private int currentIndex = 0;
    private int previousIndex = -1;
    private double CARD_HEIGHT = 800;
    private const double SWIPE_VALIDATION_PERCENT = 0.06;

    // ─── Drag state (structural — visual state lives in drag.js) ─────────────
    private bool isDraggingCard = false;
    private double currentDragOffset = 0;
    private bool isTransitioning = false;

    // ─── Horizontal swipe ────────────────────────────────────────────────────
    private enum SwipeAxis { None, Vertical, Horizontal }
    private SwipeAxis _swipeAxis = SwipeAxis.None;
    private double currentDragXOffset = 0;
    private const double HORIZ_SWIPE_THRESHOLD = 85.0;

    // ─── Misc ────────────────────────────────────────────────────────────────
    private ElementReference appContainer;
    private HashSet<int> newlyCreatedCards = new();
    private bool hasMoved = false;

    // ─── Popup ───────────────────────────────────────────────────────────────
    private bool showDetailPopup = false;
    private bool showListsPanel = false;
    private AnimeCard? selectedAnime = null;
    private bool _detailOpenedFromLists = false;

    // ─── Search ──────────────────────────────────────────────────────────────
    private bool isSearchActive = false;
    private bool isSearchLoading = false;
    private bool isLoadingSelectedAnime = false;
    private List<JikanSearchResult> searchResults = new();
    private CancellationTokenSource? searchCts;

    // ─── Preload ─────────────────────────────────────────────────────────────
    private HashSet<int> preloadedIndices = new();

    // ─── Profile ─────────────────────────────────────────────────────────────
    private bool _showProfilePanel = false;
    private ProfilePanel _profilePanel = default!;
    private bool _oauthHandled = false;

    // ─── ESC ─────────────────────────────────────────────────────────────────
    private DotNetObjectReference<Index>? _dotNetRef;

    // ═══════════════════════════════════════════════════════════════════════════
    //  LIFECYCLE
    // ═══════════════════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAnimes(60, isBackgroundLoad: false); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Init] {ex}"); isLoading = false; }
        finally { isInitialLoadComplete = true; StateHasChanged(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { CARD_HEIGHT = await JS.InvokeAsync<double>("getViewportHeight"); StateHasChanged(); }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Viewport: {ex.Message}"); }

            _dotNetRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("registerEscapeKey", _dotNetRef); } catch { }
            // Hand the .NET ref to drag.js so it can call back on drag-end
            try { await JS.InvokeVoidAsync("initCardDrag", _dotNetRef); } catch { }
        }

        _ = PreloadNearbyImages();

        if (previousIndex != currentIndex && previousIndex >= 0 &&
            animes.Count > 0 &&
            currentIndex >= animes.Count - PRELOAD_THRESHOLD &&
            !isPreloading && !AniListService.IsRateLimited())
        {
            _ = PreloadNextBatch();
        }
        previousIndex = currentIndex;

        if (!_oauthHandled) { _oauthHandled = true; await HandleOAuthTokenAsync(); }
    }

    private async Task HandleOAuthTokenAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("aniListGetToken");
            var token = result.GetProperty("token").GetString();
            var isNewAuth = result.GetProperty("isNewAuth").GetBoolean();
            if (string.IsNullOrEmpty(token)) return;
            AniListAuth.SetToken(token);
            if (isNewAuth) { _showProfilePanel = true; StateHasChanged(); await _profilePanel.OnTokenReceived(); }
            else { _ = _profilePanel.TryAutoImportAsync(); }
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"OAuth: {ex.Message}"); }
    }

    [JSInvokable]
    public void HandleEscapeKey()
    {
        if (showDetailPopup) { CloseDetailPopup(); return; }
        if (showListsPanel) { CloseListsPanel(); return; }
        if (_showProfilePanel) { _showProfilePanel = false; StateHasChanged(); return; }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  PRELOADING
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task PreloadNearbyImages()
    {
        if (animes.Count == 0) return;
        var urls = new List<string>();
        for (int offset = 0; offset <= 3; offset++)
        {
            int idx = currentIndex + offset;
            if (idx >= animes.Count) break;
            if (preloadedIndices.Contains(idx)) continue;
            var a = animes[idx];
            if (!string.IsNullOrEmpty(a.ImageUrl)) urls.Add(a.ImageUrl);
            if (!string.IsNullOrEmpty(a.BannerUrl)) urls.Add(a.BannerUrl);
            preloadedIndices.Add(idx);
        }
        if (urls.Count > 0)
            try { await JS.InvokeVoidAsync("preloadImages", (object)urls.ToArray()); } catch { }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  DATA LOADING
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task PreloadNextBatch()
    {
        if (isPreloading) return;
        isPreloading = true; StateHasChanged();
        await LoadAnimes(60, isBackgroundLoad: true);
        isPreloading = false; StateHasChanged();
    }

    private async Task LoadAnimes(int count, bool isBackgroundLoad = false)
    {
        if (AniListService.IsRateLimited())
        { isRateLimited = true; StartRateLimitCountdown(); StateHasChanged(); return; }

        if (!isBackgroundLoad) { isLoading = true; StateHasChanged(); }

        int startIndex = animes.Count;
        var result = await AniListService.GetMultipleAnimesAsync(count);

        if (result.IsRateLimited)
        {
            isRateLimited = true;
            if (!isBackgroundLoad) isLoading = false;
            StartRateLimitCountdown(); StateHasChanged(); return;
        }

        animes.AddRange(result.Animes);
        for (int i = startIndex; i < animes.Count; i++) newlyCreatedCards.Add(i);

        if (!isBackgroundLoad) isLoading = false;
        StateHasChanged();

        await Task.Delay(50);
        newlyCreatedCards.Clear();
    }

    private void StartRateLimitCountdown()
    {
        rateLimitCountdown = AniListService.GetRateLimitSecondsRemaining();
        rateLimitTimer?.Dispose();
        rateLimitTimer = new System.Threading.Timer(async _ =>
        {
            rateLimitCountdown = AniListService.GetRateLimitSecondsRemaining();
            if (rateLimitCountdown <= 0) { isRateLimited = false; rateLimitTimer?.Dispose(); }
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private string GetTitleClass(string title)
    {
        if (string.IsNullOrEmpty(title)) return "";
        if (title.Length > 50) return "title-very-long";
        if (title.Length > 30) return "title-long";
        return "";
    }

    private string GetCardTransitionClass(int index)
    {
        if (newlyCreatedCards.Contains(index)) return "no-transition";
        if (isDraggingCard) return "no-transition";
        if (isTransitioning && _swipeAxis != SwipeAxis.Horizontal) return "with-transition";
        return "no-transition";
    }

    // Only used for initial positioning; drag.js overrides during drag
    private double GetCardTranslateY(int index)
        => (index - currentIndex) * CARD_HEIGHT;

    // Applied after drag-end fly-off / snap-back transition
    private string GetImageTransform(int index)
    {
        if (index != currentIndex || currentDragXOffset == 0) return "";
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        double rot = Math.Max(-16.0, Math.Min(16.0, currentDragXOffset * 0.022));
        return $"transform: translateX({currentDragXOffset.ToString(ic)}px) rotate({rot.ToString("F3", ic)}deg);";
    }

    private string GetImageTransitionClass(int index)
        => (index == currentIndex && isTransitioning) ? "image-with-transition" : "";

    // ═══════════════════════════════════════════════════════════════════════════
    //  INPUT — Start only (drag.js owns move/end)
    // ═══════════════════════════════════════════════════════════════════════════

    private void HandleCardMouseDown(MouseEventArgs e, int index)
    {
        if (index != currentIndex) return;
        isDraggingCard = true;
        isTransitioning = false;
        _ = JS.InvokeVoidAsync("startCardDrag", e.ClientX, e.ClientY);
    }

    private Task HandleCardTouchStart(TouchEventArgs e, int index)
    {
        if (index != currentIndex || e.Touches.Length == 0) return Task.CompletedTask;
        isDraggingCard = true;
        isTransitioning = false;
        _ = JS.InvokeVoidAsync("startCardDrag", e.Touches[0].ClientX, e.Touches[0].ClientY);
        return Task.CompletedTask;
    }

    // ─── Drag-end callback from drag.js ──────────────────────────────────────

    [JSInvokable]
    public async Task OnDragEnd(double xOffset, double yOffset, string axisName, bool moved)
    {
        hasMoved = moved;
        isDraggingCard = false;
        currentDragXOffset = xOffset;
        currentDragOffset = yOffset;
        _swipeAxis = axisName switch
        {
            "horizontal" => SwipeAxis.Horizontal,
            "vertical" => SwipeAxis.Vertical,
            _ => SwipeAxis.None
        };

        if (_swipeAxis == SwipeAxis.Horizontal) await FinishHorizontalSwipe();
        else await FinishSwipe();
    }

    // ─── Vertical finish ─────────────────────────────────────────────────────

    private async Task FinishSwipe()
    {
        double threshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;

        if (Math.Abs(currentDragOffset) >= threshold)
        {
            if (currentDragOffset < 0)
            {
                if (currentIndex < animes.Count - 1) currentIndex++;
                else if (!AniListService.IsRateLimited())
                {
                    await LoadAnimes(60, isBackgroundLoad: false);
                    if (animes.Count > currentIndex + 1) currentIndex++;
                }
            }
            else if (currentDragOffset > 0 && currentIndex > 0)
            {
                currentIndex--;
            }
        }
        else
        {
            _ = JS.InvokeVoidAsync("snapCardsBack");
        }

        isTransitioning = true; currentDragOffset = 0; currentDragXOffset = 0;
        _swipeAxis = SwipeAxis.None;
        StateHasChanged();

        await Task.Delay(250);
        isTransitioning = false; hasMoved = false;
    }

    // ─── Horizontal finish ────────────────────────────────────────────────────

    private async Task FinishHorizontalSwipe()
    {
        if (Math.Abs(currentDragXOffset) >= HORIZ_SWIPE_THRESHOLD)
        {
            bool isRight = currentDragXOffset > 0;

            // ── FIX : on enregistre l'action et on avance l'index IMMÉDIATEMENT
            //    sans aucun délai — drag.js gère déjà le fly-off visuellement.
            //    Blazor re-rend le nouvel anime pendant que le fly-off JS se joue.
            await HandleListAction(animes[currentIndex], isRight ? "COMPLETED" : "PLANNING");

            if (currentIndex < animes.Count - 1) currentIndex++;

            // Reset tous les états de drag
            isTransitioning = false;
            currentDragXOffset = 0;
            currentDragOffset = 0;
            _swipeAxis = SwipeAxis.None;
            hasMoved = false;

            StateHasChanged(); // Blazor rend le nouvel anime immédiatement
        }
        else
        {
            // Snap back — pas de changement d'index
            isTransitioning = true;
            currentDragXOffset = 0;
            StateHasChanged();
            await Task.Delay(260);
            isTransitioning = false;
            _swipeAxis = SwipeAxis.None;
            hasMoved = false;
        }
    }

    private async Task HandleListAction(AnimeCard anime, string status)
    {
        var listStatus = status == "COMPLETED" ? ListStatus.Completed : ListStatus.Planning;
        UserListService.AddOrUpdate(anime, listStatus);
        System.Diagnostics.Debug.WriteLine($"[Swipe] \"{anime.Title}\" → {listStatus}");
        await Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  POPUP
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task HandleImageClick(AnimeCard anime)
    {
        if (hasMoved || isDraggingCard || _swipeAxis != SwipeAxis.None) return;
        await ShowAnimeDetails(anime);
    }

    private async Task HandleTitleClick(AnimeCard anime)
    {
        if (hasMoved || isDraggingCard || _swipeAxis != SwipeAxis.None) return;
        await ShowAnimeDetails(anime);
    }

    private async Task ShowAnimeDetails(AnimeCard anime)
    {
        bool isJikanStub = anime.Id == 0;
        bool missingData = !isJikanStub && anime.Relations.Count == 0
                           && string.IsNullOrEmpty(anime.Format)
                           && anime.Tags.Count == 0;

        if (isJikanStub || missingData)
        {
            isLoadingSelectedAnime = true; StateHasChanged();
            AnimeCard? full = null;
            if (anime.Id > 0) full = await AniListService.GetAnimeByAniListIdAsync(anime.Id);
            isLoadingSelectedAnime = false;
            if (full != null) anime = full;
        }

        selectedAnime = anime; showDetailPopup = true;
        StateHasChanged();
    }

    private void CloseDetailPopup()
    {
        showDetailPopup = false; selectedAnime = null;
        _detailOpenedFromLists = false; StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  SEARCH
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task HandleSearchQueryChanged(string query)
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var cts = searchCts;

        if (string.IsNullOrWhiteSpace(query))
        {
            searchResults.Clear(); isSearchActive = false; isSearchLoading = false;
            StateHasChanged(); return;
        }

        isSearchActive = true; isSearchLoading = true; StateHasChanged();

        try { await Task.Delay(350, cts.Token); }
        catch (OperationCanceledException) { return; }
        if (cts.IsCancellationRequested) return;

        var results = await AniListService.SearchJikanAsync(query);
        if (cts.IsCancellationRequested) return;

        searchResults = results; isSearchLoading = false; StateHasChanged();
    }

    private async Task HandleSearchResultClick(JikanSearchResult result)
    {
        searchResults.Clear(); isSearchActive = false; isSearchLoading = false;
        isLoadingSelectedAnime = true; StateHasChanged();

        AnimeCard? anime = null;
        if (result.MalId > 0) anime = await AniListService.GetAnimeByMalIdAsync(result.MalId);
        if (anime == null && !string.IsNullOrEmpty(result.Title))
            anime = await AniListService.GetAnimeByTitleAsync(result.Title);

        isLoadingSelectedAnime = false;

        if (anime != null)
        {
            selectedAnime = anime; showDetailPopup = true; StateHasChanged();
        }
        else
        {
            selectedAnime = new AnimeCard
            {
                Title = result.Title,
                ImageUrl = result.ImageUrl,
                Score = result.Score,
                Episodes = result.Episodes?.ToString() ?? "N/A",
                Format = result.Type
            };
            showDetailPopup = true; StateHasChanged();
        }
    }

    private void HandleSearchToggled()
    { searchResults.Clear(); isSearchActive = false; isSearchLoading = false; StateHasChanged(); }

    private void HandleListsClicked() { showListsPanel = true; StateHasChanged(); }
    private void CloseListsPanel() { showListsPanel = false; StateHasChanged(); }

    private async Task HandleListsAnimeSelected(AnimeCard anime)
    { _detailOpenedFromLists = true; await ShowAnimeDetails(anime); }

    private void HandleProfileClicked() { _showProfilePanel = !_showProfilePanel; }

    // ═══════════════════════════════════════════════════════════════════════════
    //  DISPOSE
    // ═══════════════════════════════════════════════════════════════════════════

    public async ValueTask DisposeAsync()
    {
        rateLimitTimer?.Dispose();
        try { await JS.InvokeVoidAsync("unregisterEscapeKey"); } catch { }
        _dotNetRef?.Dispose();
    }
}
