@page "/"
@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject AniListService AniListService
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>AnimeScroll</PageTitle>

<div class="anime-scroll-app @(isSearchActive ? "search-is-active" : "")" @ref="appContainer">
    <div class="build-version">v1.7.3</div>

    <button @onclick="() => showDebugPanel = true"
            style="position:fixed;top:30px;left:10px;z-index:200;background:rgba(233,69,96,0.8);border:none;color:white;font-size:9px;padding:3px 6px;border-radius:5px;cursor:pointer;font-family:monospace;">
        DEBUG
    </button>

    <div class="main-scroll">
        @for (int i = 0; i < animes.Count; i++)
        {
            var index = i;
            var anime = animes[i];
            var isVisible = index == currentIndex;
            var distance = Math.Abs(index - currentIndex);

            <div class="anime-card @(isVisible ? "active" : "") @GetCardTransitionClass(index)"
                 style="transform: translateY(@GetCardTransform(index)px); height: @(CARD_HEIGHT)px;"
                 @onmousedown="(e) => HandleCardMouseDown(e, index)"
                 @onmousemove="HandleCardMouseMove"
                 @onmouseup="HandleCardMouseUp"
                 @onmouseleave="HandleCardMouseUp"
                 @ontouchstart="(e) => HandleCardTouchStart(e, index)"
                 @ontouchmove="HandleCardTouchMove"
                 @ontouchend="HandleCardTouchEnd">

                @if (distance <= RENDER_WINDOW)
                {
                    <div class="bg-image" style="background-image: url('@anime.ImageUrl');"></div>
                    <div class="gradient-overlay"></div>

                    <div class="content-wrapper">
                        <div class="image-section">
                            <div class="anime-image"
                                 style="background-image: url('@anime.ImageUrl');"
                                 @onclick="async () => await HandleImageClick(anime)"></div>
                        </div>

                        <div class="info-section">
                            <h1 class="title @GetTitleClass(anime.Title)"
                                @onclick="async () => await HandleTitleClick(anime)">
                                @anime.Title
                            </h1>

                            @if (!string.IsNullOrEmpty(anime.Season) && anime.Year.HasValue)
                            {
                                <div class="season-info">
                                    @if (anime.Status == "RELEASING")
                                    {
                                        <span class="status-dot releasing"></span>
                                    }
                                    else if (anime.Status == "NOT_YET_RELEASED")
                                    {
                                        <span class="status-dot upcoming"></span>
                                    }
                                    <span>@anime.Season @anime.Year</span>
                                </div>
                            }

                            @if (anime.Genres?.Any() == true)
                            {
                                <p class="genres">@string.Join(" • ", anime.Genres)</p>
                            }

                            <div class="stats">
                                <div class="badge badge-score">★ @anime.Score</div>
                                <div class="badge badge-episodes">@anime.Episodes EP</div>
                            </div>

                            @if (!string.IsNullOrEmpty(anime.Description))
                            {
                                <div class="description-container">
                                    <p class="description-preview">@anime.Description</p>
                                    <button class="read-more-btn" @onclick="async () => await ShowAnimeDetails(anime)">
                                        Read More
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        }

        @if (isLoading && !isInitialLoadComplete)
        {
            <div class="loading-area">
                <div class="loading-box">
                    <div class="spinner"></div>
                    <p class="loading-title">Loading...</p>
                    <p class="loading-subtitle">Fetching 60 awesome animes</p>
                </div>
            </div>
        }

        @if (isRateLimited)
        {
            <div class="loading-area">
                <div class="loading-box rate-limit-box">
                    <div class="rate-limit-icon">⏱️</div>
                    <p class="loading-title">API Rate Limit Reached</p>
                    <p class="loading-subtitle">Retrying in @rateLimitCountdown seconds...</p>
                </div>
            </div>
        }
    </div>

    <div class="overlay-controls">
        <div class="counter">@currentIndex / @animes.Count</div>
        @if (isPreloading)
        {
            <div class="preload-badge">🔄️</div>
        }
        @if (isRateLimited)
        {
            <div class="rate-limit-badge">Rate Limited</div>
        }
    </div>

    @if (isSearchActive)
    {
        <div class="search-results-panel visible"
             @onclick:stopPropagation="true"
             @onmousedown:stopPropagation="true"
             @ontouchstart:stopPropagation="true"
             @ontouchmove:stopPropagation="true"
             @ontouchend:stopPropagation="true">

            @if (isSearchLoading && !searchResults.Any())
            {
                <div class="search-results-loading">
                    <div class="spinner-small"></div>
                    <span>Searching...</span>
                </div>
            }
            else if (!isSearchLoading && !searchResults.Any())
            {
                <div class="search-no-results">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                         stroke="rgba(255,255,255,0.2)" stroke-width="1.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                    <span>No results found</span>
                    <span class="search-no-results-hint">Try a different title or spelling</span>
                </div>
            }

            @foreach (var result in searchResults)
            {
                var r = result;
                <div class="search-result-item" @onclick="() => HandleSearchResultClick(r)">
                    <div class="search-result-thumb"
                         style="background-image: url('@r.ImageUrl');"></div>
                    <div class="search-result-info">
                        <div class="search-result-title">@r.Title</div>
                        <div class="search-result-meta">
                            @r.Type
                            @if (r.Episodes.HasValue && r.Episodes > 0)
                            {
                                <span> · @r.Episodes EP</span>
                            }
                            @if (!string.IsNullOrEmpty(r.Score) && r.Score != "N/A")
                            {
                                <span> · ★ @r.Score</span>
                            }
                        </div>
                    </div>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </div>
            }

            @if (isSearchLoading && searchResults.Any())
            {
                <div class="search-results-updating">Updating...</div>
            }
        </div>
    }

    @if (isLoadingSelectedAnime)
    {
        <div class="search-fetch-overlay"
             @onclick:stopPropagation="true"
             @ontouchstart:stopPropagation="true">
            <div class="spinner"></div>
        </div>
    }

    @if (!showDetailPopup)
    {
        <AniScroll.Shared.Components.Layout.NavigationBar OnSearchToggled="HandleSearchToggled"
                                                          OnListsClicked="HandleListsClicked"
                                                          OnProfileClicked="HandleProfileClicked"
                                                          OnSearchQueryChanged="HandleSearchQueryChanged" />
    }

    <AniScroll.Shared.Components.Layout.AnimeDetailPopup CurrentAnime="selectedAnime"
                                                         IsVisible="showDetailPopup"
                                                         OnClose="CloseDetailPopup" />

    <AniScroll.Shared.Components.Layout.DebugPanel IsVisible="showDebugPanel"
                                                   OnHide="@(() => showDebugPanel = false)" />
</div>

@code {
    private bool showDebugPanel = false;

    // ─── Data ────────────────────────────────────────────────────────────────
    private List<AnimeCard> animes = new();

    // ─── Virtualization ──────────────────────────────────────────────────────
    private const int RENDER_WINDOW = 5;

    // ─── Loading ─────────────────────────────────────────────────────────────
    private bool isLoading = false;
    private bool isInitialLoadComplete = false;
    private bool isPreloading = false;
    private bool isRateLimited = false;
    private int rateLimitCountdown = 0;
    private const int PRELOAD_THRESHOLD = 40;
    private System.Threading.Timer? rateLimitTimer;

    // ─── Navigation ──────────────────────────────────────────────────────────
    private int currentIndex = 0;
    private int previousIndex = -1;
    private double CARD_HEIGHT = 800;
    private const double SWIPE_VALIDATION_PERCENT = 0.06;

    // ─── Drag state ──────────────────────────────────────────────────────────
    private bool isDraggingCard = false;
    private double dragStartY = 0;
    private double dragStartX = 0;
    private double currentDragOffset = 0;
    private bool isTransitioning = false;

    // ─── Misc ────────────────────────────────────────────────────────────────
    private ElementReference appContainer;
    private HashSet<int> newlyCreatedCards = new();
    private DateTime lastRenderTime = DateTime.Now;
    private const int THROTTLE_MS = 8;
    private bool hasMoved = false;
    private const double clickThreshold = 5;

    // ─── Popup ───────────────────────────────────────────────────────────────
    private bool showDetailPopup = false;
    private AnimeCard? selectedAnime = null;

    // ─── Search ──────────────────────────────────────────────────────────────
    private bool isSearchActive = false;
    private bool isSearchLoading = false;
    private bool isLoadingSelectedAnime = false;
    private List<JikanSearchResult> searchResults = new();
    private CancellationTokenSource? searchCts;

    // ─── Banner preload tracking ──────────────────────────────────────────────
    private HashSet<int> preloadedIndices = new();


    // ═══════════════════════════════════════════════════════════════════════════
    //  LIFECYCLE
    // ═══════════════════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        await LoadAnimes(60, isBackgroundLoad: false);
        isInitialLoadComplete = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                CARD_HEIGHT = await JS.InvokeAsync<double>("getViewportHeight");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Viewport height error: {ex.Message}");
            }
        }

        _ = PreloadNearbyImages();

        if (previousIndex != currentIndex && previousIndex >= 0)
        {
            if (animes.Count > 0 &&
                currentIndex >= animes.Count - PRELOAD_THRESHOLD &&
                !isPreloading &&
                !AniListService.IsRateLimited())
            {
                _ = PreloadNextBatch();
            }
        }

        previousIndex = currentIndex;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  IMAGE PRELOADING
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task PreloadNearbyImages()
    {
        if (animes.Count == 0) return;

        var urls = new List<string>();
        for (int offset = 0; offset <= 3; offset++)
        {
            int idx = currentIndex + offset;
            if (idx >= animes.Count) break;
            if (preloadedIndices.Contains(idx)) continue;

            var anime = animes[idx];
            if (!string.IsNullOrEmpty(anime.ImageUrl)) urls.Add(anime.ImageUrl);
            if (!string.IsNullOrEmpty(anime.BannerUrl)) urls.Add(anime.BannerUrl);

            preloadedIndices.Add(idx);
        }

        if (urls.Count > 0)
        {
            try { await JS.InvokeVoidAsync("preloadImages", (object)urls.ToArray()); }
            catch { }
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  DATA LOADING
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task PreloadNextBatch()
    {
        if (isPreloading) return;
        isPreloading = true;
        StateHasChanged();
        await LoadAnimes(60, isBackgroundLoad: true);
        isPreloading = false;
        StateHasChanged();
    }

    private async Task LoadAnimes(int count, bool isBackgroundLoad = false)
    {
        if (AniListService.IsRateLimited())
        {
            isRateLimited = true;
            StartRateLimitCountdown();
            StateHasChanged();
            return;
        }

        if (!isBackgroundLoad) { isLoading = true; StateHasChanged(); }

        int startIndex = animes.Count;
        var result = await AniListService.GetMultipleAnimesAsync(count);

        if (result.IsRateLimited)
        {
            isRateLimited = true;
            if (!isBackgroundLoad) isLoading = false;
            StartRateLimitCountdown();
            StateHasChanged();
            return;
        }

        animes.AddRange(result.Animes);

        for (int i = startIndex; i < animes.Count; i++)
            newlyCreatedCards.Add(i);

        if (!isBackgroundLoad) isLoading = false;
        StateHasChanged();

        await Task.Delay(50);
        newlyCreatedCards.Clear();
    }

    private void StartRateLimitCountdown()
    {
        rateLimitCountdown = AniListService.GetRateLimitSecondsRemaining();
        rateLimitTimer?.Dispose();
        rateLimitTimer = new System.Threading.Timer(async _ =>
        {
            rateLimitCountdown = AniListService.GetRateLimitSecondsRemaining();
            if (rateLimitCountdown <= 0) { isRateLimited = false; rateLimitTimer?.Dispose(); }
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private string GetTitleClass(string title)
    {
        if (string.IsNullOrEmpty(title)) return "";
        if (title.Length > 50) return "title-very-long";
        if (title.Length > 30) return "title-long";
        return "";
    }

    private string GetCardTransitionClass(int index)
    {
        if (newlyCreatedCards.Contains(index)) return "no-transition";
        if (isDraggingCard) return "no-transition";
        if (isTransitioning) return "with-transition";
        return "no-transition";
    }

    private double GetCardTransform(int index)
    {
        double basePosition = (index - currentIndex) * CARD_HEIGHT;
        if (isDraggingCard) return basePosition + currentDragOffset;
        return basePosition;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  MOUSE INPUT
    // ═══════════════════════════════════════════════════════════════════════════

    private void HandleCardMouseDown(MouseEventArgs e, int index)
    {
        if (index != currentIndex) return;
        isDraggingCard = true;
        dragStartY = e.ClientY;
        dragStartX = e.ClientX;
        currentDragOffset = 0;
        isTransitioning = false;
        hasMoved = false;
    }

    private void HandleCardMouseMove(MouseEventArgs e)
    {
        if (!isDraggingCard) return;

        if (Math.Abs(e.ClientX - dragStartX) > clickThreshold ||
            Math.Abs(e.ClientY - dragStartY) > clickThreshold)
            hasMoved = true;

        var now = DateTime.Now;
        if ((now - lastRenderTime).TotalMilliseconds < THROTTLE_MS) return;
        lastRenderTime = now;

        currentDragOffset = e.ClientY - dragStartY;
        StateHasChanged();
    }

    private async Task HandleCardMouseUp(MouseEventArgs e)
    {
        if (!isDraggingCard) return;
        isDraggingCard = false;
        await FinishSwipe();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  TOUCH INPUT
    // ═══════════════════════════════════════════════════════════════════════════

    private Task HandleCardTouchStart(TouchEventArgs e, int index)
    {
        if (index != currentIndex || e.Touches.Length == 0) return Task.CompletedTask;
        isDraggingCard = true;
        dragStartY = e.Touches[0].ClientY;
        dragStartX = e.Touches[0].ClientX;
        currentDragOffset = 0;
        isTransitioning = false;
        hasMoved = false;
        return Task.CompletedTask;
    }

    private void HandleCardTouchMove(TouchEventArgs e)
    {
        if (!isDraggingCard || e.Touches.Length == 0) return;

        var touch = e.Touches[0];
        if (Math.Abs(touch.ClientX - dragStartX) > clickThreshold ||
            Math.Abs(touch.ClientY - dragStartY) > clickThreshold)
            hasMoved = true;

        var now = DateTime.Now;
        if ((now - lastRenderTime).TotalMilliseconds < THROTTLE_MS) return;
        lastRenderTime = now;

        currentDragOffset = touch.ClientY - dragStartY;
        StateHasChanged();
    }

    private async Task HandleCardTouchEnd(TouchEventArgs e)
    {
        if (!isDraggingCard) return;
        isDraggingCard = false;
        await FinishSwipe();
    }

    private async Task FinishSwipe()
    {
        double threshold = CARD_HEIGHT * SWIPE_VALIDATION_PERCENT;

        if (Math.Abs(currentDragOffset) >= threshold)
        {
            if (currentDragOffset < 0)
            {
                if (currentIndex < animes.Count - 1)
                    currentIndex++;
                else if (!AniListService.IsRateLimited())
                {
                    await LoadAnimes(60, isBackgroundLoad: false);
                    if (animes.Count > currentIndex + 1) currentIndex++;
                }
            }
            else if (currentDragOffset > 0 && currentIndex > 0)
            {
                currentIndex--;
            }
        }

        isTransitioning = true;
        currentDragOffset = 0;
        StateHasChanged();

        await Task.Delay(250);
        isTransitioning = false;
        hasMoved = false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  POPUP
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task HandleImageClick(AnimeCard anime)
    {
        if (!hasMoved && !isDraggingCard) await ShowAnimeDetails(anime);
    }

    private async Task HandleTitleClick(AnimeCard anime)
    {
        if (!hasMoved && !isDraggingCard) await ShowAnimeDetails(anime);
    }

    private async Task ShowAnimeDetails(AnimeCard anime)
    {
        // Les cartes du scroller sont chargées sans relations → on fetch le détail complet
        if (anime.Relations.Count == 0 && anime.Id > 0)
        {
            isLoadingSelectedAnime = true;
            StateHasChanged();
            var full = await AniListService.GetAnimeByAniListIdAsync(anime.Id);
            isLoadingSelectedAnime = false;
            if (full != null) anime = full;
        }
        selectedAnime = anime;
        showDetailPopup = true;
        StateHasChanged();
    }

    private void CloseDetailPopup()
    {
        showDetailPopup = false;
        selectedAnime = null;
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //  SEARCH
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task HandleSearchQueryChanged(string query)
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var cts = searchCts;

        if (string.IsNullOrWhiteSpace(query))
        {
            searchResults.Clear();
            isSearchActive = false;
            isSearchLoading = false;
            StateHasChanged();
            return;
        }

        isSearchActive = true;
        isSearchLoading = true;
        StateHasChanged();

        try { await Task.Delay(350, cts.Token); }
        catch (OperationCanceledException) { return; }

        if (cts.IsCancellationRequested) return;

        var results = await AniListService.SearchJikanAsync(query);
        if (cts.IsCancellationRequested) return;

        searchResults = results;
        isSearchLoading = false;
        StateHasChanged();
    }

    private async Task HandleSearchResultClick(JikanSearchResult result)
    {
        searchResults.Clear();
        isSearchActive = false;
        isSearchLoading = false;
        isLoadingSelectedAnime = true;
        StateHasChanged();

        AnimeCard? anime = null;

        if (result.MalId > 0)
            anime = await AniListService.GetAnimeByMalIdAsync(result.MalId);

        if (anime == null && !string.IsNullOrEmpty(result.Title))
        {
            System.Diagnostics.Debug.WriteLine("MAL ID lookup failed, trying title: " + result.Title);
            anime = await AniListService.GetAnimeByTitleAsync(result.Title);
        }

        isLoadingSelectedAnime = false;

        if (anime != null)
        {
            selectedAnime = anime;
            showDetailPopup = true;
            StateHasChanged();
        }
        else
        {
            System.Diagnostics.Debug.WriteLine("Both AniList lookups failed, using Jikan fallback");
            selectedAnime = new AnimeCard
            {
                Title = result.Title,
                ImageUrl = result.ImageUrl,
                Score = result.Score,
                Episodes = result.Episodes?.ToString() ?? "N/A",
                Format = result.Type
            };
            showDetailPopup = true;
            StateHasChanged();
        }
    }

    private void HandleSearchToggled()
    {
        searchResults.Clear();
        isSearchActive = false;
        isSearchLoading = false;
        StateHasChanged();
    }

    private void HandleListsClicked() { }
    private void HandleProfileClicked() { }

    public void Dispose() => rateLimitTimer?.Dispose();
}
