@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject AniListAuthService AniListAuth
@inject IJSRuntime JS

@* Always mounted so TryAutoImportAsync works even before the panel is opened.
   AccountTab renders nothing when IsActive=false, so there is zero DOM cost. *@
@if (!IsVisible)
{
    <AccountTab IsVisible="false" IsActive="false" @ref="_accountTab" />
}

@if (IsVisible)
{
    <div class="pp-overlay" @onclick="HandleOverlayClick">
        <div class="pp-panel" @onclick:stopPropagation="true">

            <!-- ── Sticky top ── -->
            <div class="pp-sticky-top">
                <div class="pp-handle-zone"><div class="pp-handle-bar"></div></div>

                <div class="pp-header">
                    <span class="pp-title">Profile</span>
                    <button class="pp-close-btn" @onclick="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="pp-tabs">
                    <button class="pp-tab @(_activeTab == "account" ? "pp-tab-active" : "")" @onclick='() => _activeTab = "account"'>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Account
                    </button>
                    <button class="pp-tab @(_activeTab == "stats" ? "pp-tab-active" : "")" @onclick='() => _activeTab = "stats"'>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="4" y1="20" x2="4" y2="14" />
                            <line x1="9" y1="20" x2="9" y2="4" />
                            <line x1="14" y1="20" x2="14" y2="10" />
                            <line x1="19" y1="20" x2="19" y2="7" />
                        </svg>
                        Stats
                    </button>
                </div>

                <div class="pp-divider"></div>
            </div>

            <!-- ── Scrollable body ── -->
            <div class="pp-body">
                <AccountTab IsVisible="IsVisible" IsActive='_activeTab == "account"' @ref="_accountTab" />
                <StatsTab IsActive='_activeTab == "stats"' />
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _activeTab = "account";
    private bool _prevVisible = false;
    private AccountTab _accountTab = default!;

    // ── Public API (called from Index.razor) ──────────────────────────────
    public async Task OnTokenReceived() => await _accountTab.OnTokenReceived();
    public async Task TryAutoImportAsync() => await _accountTab.TryAutoImportAsync();

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnParametersSet()
    {
        bool justOpened = IsVisible && !_prevVisible;
        _prevVisible = IsVisible;

        if (justOpened)
            _activeTab = "account";
    }

    private void HandleOverlayClick() => Close();
    private void Close() => OnClose.InvokeAsync();
}
