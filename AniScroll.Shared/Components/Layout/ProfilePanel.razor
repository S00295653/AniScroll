@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject AniListAuthService AniListAuth
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="pp-overlay" @onclick="HandleOverlayClick">
        <div class="pp-panel" @onclick:stopPropagation="true">

            <div class="pp-handle-zone"><div class="pp-handle-bar"></div></div>

            <div class="pp-header">
                <span class="pp-title">Profile</span>
                <button class="pp-close-btn" @onclick="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <div class="pp-tabs">
                <button class="pp-tab @(_activeTab == "account" ? "pp-tab-active" : "")" @onclick='() => _activeTab = "account"'>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Account
                </button>
                <button class="pp-tab @(_activeTab == "stats" ? "pp-tab-active" : "")" @onclick='() => { _activeTab = "stats"; ComputeStats(); }'>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                    Stats
                </button>
            </div>

            <div class="pp-divider"></div>

            <div class="pp-body">

                @if (_activeTab == "account")
                {
                    @if (_state == PanelState.NotConnected)
                    {
                        <div class="pp-connect-section">
                            <div class="pp-connect-icon-wrap">
                                <svg width="36" height="36" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h512v512H0" fill="#1e2630" /><path d="M321.92 323.27V136.6c0-10.698-5.887-16.602-16.558-16.602h-36.433c-10.672 0-16.561 5.904-16.561 16.602v88.651c0 2.497 23.996 14.089 24.623 16.541 18.282 71.61 3.972 128.92-13.359 131.6 28.337 1.405 31.455 15.064 10.348 5.731 3.229-38.209 15.828-38.134 52.049-1.406.31.317 7.427 15.282 7.87 15.282h85.545c10.672 0 16.558-5.9 16.558-16.6v-36.524c0-10.698-5.886-16.602-16.558-16.602z" fill="#02a9ff" /><path d="M170.68 120 74.999 393h74.338l16.192-47.222h80.96L262.315 393h73.968l-95.314-273zm11.776 165.28 23.183-75.629 25.393 75.629z" fill="#fefefe" /></svg>
                            </div>
                            <p class="pp-connect-title">Connect with AniList</p>
                            <p class="pp-connect-sub">Sign in to sync your anime list, custom lists, scores, episodes, and notes.</p>
                            <div class="pp-connect-features">
                                <div class="pp-connect-feature"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="#02a9ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Import your anime &amp; manga list</div>
                                <div class="pp-connect-feature"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="#02a9ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Sync scores, episodes &amp; notes</div>
                                <div class="pp-connect-feature"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="#02a9ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Custom lists &amp; watch status</div>
                            </div>
                            <button class="pp-anilist-btn" @onclick="StartOAuth">
                                <svg width="16" height="16" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h512v512H0" fill="#1e2630" /><path d="M321.92 323.27V136.6c0-10.698-5.887-16.602-16.558-16.602h-36.433c-10.672 0-16.561 5.904-16.561 16.602v88.651c0 2.497 23.996 14.089 24.623 16.541 18.282 71.61 3.972 128.92-13.359 131.6 28.337 1.405 31.455 15.064 10.348 5.731 3.229-38.209 15.828-38.134 52.049-1.406.31.317 7.427 15.282 7.87 15.282h85.545c10.672 0 16.558-5.9 16.558-16.6v-36.524c0-10.698-5.886-16.602-16.558-16.602z" fill="#02a9ff" /><path d="M170.68 120 74.999 393h74.338l16.192-47.222h80.96L262.315 393h73.968l-95.314-273zm11.776 165.28 23.183-75.629 25.393 75.629z" fill="#fefefe" /></svg>
                                Connect with AniList
                            </button>
                        </div>
                    }
                    else if (_state == PanelState.Loading)
                    {
                        <div class="pp-loading-section"><div class="pp-spinner"></div><p class="pp-loading-text">@_loadingText</p></div>
                    }
                    else if (_state == PanelState.Connected)
                    {
                        <div class="pp-user-card">
                            @if (!string.IsNullOrEmpty(AniListAuth.CurrentUser?.AvatarUrl))
                            {
                                <div class="pp-avatar" style="background-image:url('@AniListAuth.CurrentUser.AvatarUrl');"></div>
                            }
                            else
                            {

                                <div class="pp-avatar pp-avatar-placeholder"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                            }
                            <div class="pp-user-info">
                                <span class="pp-username">@(AniListAuth.CurrentUser?.Name ?? "AniList User")</span>
                                <a class="pp-anilist-link" href="https://anilist.co/user/@(AniListAuth.CurrentUser?.Name)" target="_blank"><span class="pp-al-dot"></span>AniList profile</a>
                            </div>
                        </div>
                        <button class="pp-import-btn" @onclick="StartImport">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v13M7 10l5 5 5-5" /><rect x="3" y="16" width="18" height="5" rx="1" /></svg>
                            Import My List
                        </button>
                        <button class="pp-disconnect-btn" @onclick="() => _ = Disconnect()">Disconnect</button>
                    }
                    else if (_state == PanelState.Importing)
                    {
                        <div class="pp-import-progress">
                            <div class="pp-spinner"></div>
                            <p class="pp-loading-text">@_loadingText</p>
                            @if (_importTotal > 0)
                            {
                                <div class="pp-progress-bar-wrap"><div class="pp-progress-bar" style="width:@((_importDone * 100.0 / _importTotal).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div></div>
                                <p class="pp-progress-count">@_importDone / @_importTotal</p>
                            }
                        </div>
                    }
                    else if (_state == PanelState.Done)
                    {
                        <div class="pp-done-section">
                            <div class="pp-done-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11.5 14.5 15.5 9.5" /></svg></div>
                            <p class="pp-done-title">Import Complete!</p>
                            <div class="pp-done-stats">
                                <div class="pp-stat"><span class="pp-stat-num">@_importDone</span><span class="pp-stat-lbl">anime imported</span></div>
                                <div class="pp-stat"><span class="pp-stat-num">@_listsCreated</span><span class="pp-stat-lbl">lists created</span></div>
                            </div>
                            @if (!string.IsNullOrEmpty(AniListAuth.CurrentUser?.Name))
                            {
                                <div class="pp-user-mini">
                                    @if (!string.IsNullOrEmpty(AniListAuth.CurrentUser.AvatarUrl))
                                    {
                                        <div class="pp-avatar-mini" style="background-image:url('@AniListAuth.CurrentUser.AvatarUrl');"></div>
                                    }
                                    <span class="pp-username-mini">@AniListAuth.CurrentUser.Name</span>
                                </div>
                            }
                            <button class="pp-done-close-btn" @onclick="Close">Done</button>
                            <button class="pp-disconnect-btn" @onclick="() => _ = Disconnect()">Disconnect</button>
                        </div>
                    }
                    else if (_state == PanelState.Error)
                    {
                        <div class="pp-error-section">
                            <div class="pp-error-icon">⚠️</div>
                            <p class="pp-error-title">Something went wrong</p>
                            <p class="pp-error-sub">@_errorMessage</p>
                            <button class="pp-anilist-btn" @onclick="() => _state = PanelState.NotConnected">Try Again</button>
                        </div>
                    }
                    else if (_state == PanelState.WaitingForPin)
                    {
                        <div class="pp-connect-section">
                            <p class="pp-connect-title">Paste your token</p>
                            <p class="pp-connect-sub">AniList has opened in a new tab. After authorizing, copy the token shown and paste it below.</p>
                            <input class="pp-token-input" placeholder="Paste token here..." @bind="_pastedToken" />
                            <button class="pp-anilist-btn" @onclick="SubmitToken">Connect</button>
                        </div>
                    }
                }

                else if (_activeTab == "stats")
                {
                    @if (_s == null || _s.Total == 0)
                    {
                        <div class="st-empty">
                            <div class="st-empty-icon">📊</div>
                            <p class="st-empty-title">No data yet</p>
                            <p class="st-empty-sub">Add anime to your list to unlock your stats.</p>
                        </div>
                    }
                    else
                    {
                        <!-- ── Hero ── -->
                        <div class="st-hero">
                            <div class="st-hero-main">
                                <span class="st-hero-num">@_s.Total</span>
                                <span class="st-hero-lbl">total anime</span>
                            </div>
                            <div class="st-hero-subs">
                                <div class="st-hero-sub"><span class="st-hero-sub-num">@FormatDays(_s.TotalMinutes)</span><span class="st-hero-sub-lbl">days watched</span></div>
                                <div class="st-hero-sub"><span class="st-hero-sub-num">@_s.TotalEpisodes.ToString("N0")</span><span class="st-hero-sub-lbl">episodes</span></div>
                                @if (_s.Favorited > 0)
                                {
                                    <div class="st-hero-sub"><span class="st-hero-sub-num" style="color:#f43f5e">@_s.Favorited</span><span class="st-hero-sub-lbl">favourites</span></div>
                                }
                            </div>
                        </div>

                        <!-- ── Status breakdown ── -->
                        <div class="st-section">
                            <div class="st-section-title">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                                Lists
                            </div>
                            <div class="st-status-grid">
                                @foreach (var kv in _s.ByStatus)
                                {
                                    var color = GetStatusColor(kv.Key);
                                    var pct = _s.Total > 0 ? kv.Value * 100.0 / _s.Total : 0;
                                    <div class="st-status-row">
                                        <span class="st-status-dot" style="background:@color;box-shadow:0 0 5px @(color)88;"></span>
                                        <span class="st-status-name">@GetStatusLabel(kv.Key)</span>
                                        <div class="st-status-bar-wrap">
                                            <div class="st-status-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@color;"></div>
                                        </div>
                                        <span class="st-status-count">@kv.Value</span>
                                    </div>
                                }
                            </div>
                            <div class="st-completion-row">
                                <span class="st-completion-lbl">Completion rate</span>
                                <div class="st-completion-bar-wrap">
                                    <div class="st-completion-bar" style="width:@_s.CompletionRate.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <span class="st-completion-val">@_s.CompletionRate.ToString("F0")%</span>
                            </div>
                        </div>

                        <!-- ── Score distribution ── -->
                        @if (_s.ScoredCount > 0)
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                    Scores
                                    <span class="st-section-meta">@_s.ScoredCount scored · avg <strong style="color:@GetScoreColor(_s.AvgScore)">@_s.AvgScore.ToString("F1")</strong></span>
                                </div>
                                <div class="st-score-chart">
                                    @{
                                        var maxCount = _s.ScoreDist.Values.DefaultIfEmpty(1).Max();
                                    }
                                    @for (int sc = 10; sc >= 1; sc--)
                                    {
                                        var count = _s.ScoreDist.GetValueOrDefault(sc, 0);
                                        var barPct = maxCount > 0 ? count * 100.0 / maxCount : 0;
                                        var color = GetScoreBarColor(sc);
                                        var isAvg = Math.Abs(sc - _s.AvgScore) < 0.5;
                                        <div class="st-score-row @(isAvg ? "st-score-row-avg" : "")">
                                            <span class="st-score-label">@sc</span>
                                            <div class="st-score-bar-wrap">
                                                <div class="st-score-bar-fill" style="width:@barPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@color;"></div>
                                            </div>
                                            <span class="st-score-count">@(count > 0 ? count.ToString() : "")</span>
                                        </div>
                                    }
                                </div>
                                <div class="st-score-extremes">
                                    @if (_s.BestAnime != null)
                                    {
                                        <div class="st-score-extreme">
                                            <span class="st-extreme-lbl">⭐ Best rated</span>
                                            <span class="st-extreme-title">@TruncateTitle(_s.BestAnime.Anime.Title)</span>
                                            <span class="st-extreme-score" style="color:#22c55e">@_s.BestAnime.Score</span>
                                        </div>
                                    }
                                    @if (_s.WorstAnime != null && _s.WorstAnime.Anime.Id != _s.BestAnime?.Anime.Id)
                                    {
                                        <div class="st-score-extreme">
                                            <span class="st-extreme-lbl">💀 Lowest rated</span>
                                            <span class="st-extreme-title">@TruncateTitle(_s.WorstAnime.Anime.Title)</span>
                                            <span class="st-extreme-score" style="color:#ef4444">@_s.WorstAnime.Score</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Watch time ── -->
                        @if (_s.TotalMinutes > 0)
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                    Watch Time
                                </div>
                                <div class="st-time-grid">
                                    <div class="st-time-cell">
                                        <span class="st-time-val">@FormatHours(_s.TotalMinutes)</span>
                                        <span class="st-time-lbl">hours total</span>
                                    </div>
                                    <div class="st-time-cell">
                                        <span class="st-time-val">@FormatDays(_s.TotalMinutes)</span>
                                        <span class="st-time-lbl">days total</span>
                                    </div>
                                    @if (_s.AvgEpisodeDuration > 0)
                                    {
                                        <div class="st-time-cell">
                                            <span class="st-time-val">@_s.AvgEpisodeDuration min</span>
                                            <span class="st-time-lbl">avg ep length</span>
                                        </div>
                                    }
                                    @if (_s.Rewatched > 0)
                                    {
                                        <div class="st-time-cell">
                                            <span class="st-time-val">@_s.Rewatched</span>
                                            <span class="st-time-lbl">rewatched</span>
                                        </div>
                                    }
                                </div>
                                @if (_s.LongestAnime != null)
                                {
                                    <div class="st-longest-row">
                                        <span class="st-longest-lbl">⏱ Most time spent</span>
                                        <span class="st-longest-title">@TruncateTitle(_s.LongestAnime.Anime.Title)</span>
                                        <span class="st-longest-dur">@FormatMinutes(GetAnimeMinutes(_s.LongestAnime.Anime))</span>
                                    </div>
                                }
                            </div>
                        }

                        <!-- ── Genres ── -->
                        @if (_s.TopGenres.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>
                                    Genres
                                    <span class="st-section-meta">@_s.UniqueGenres unique</span>
                                </div>
                                <div class="st-bar-list">
                                    @{
                                        var maxG = _s.TopGenres.FirstOrDefault().Value;
                                    }
                                    @foreach (var kv in _s.TopGenres.Take(12))
                                    {
                                        var pct = maxG > 0 ? kv.Value * 100.0 / maxG : 0;
                                        var rank = _s.TopGenres.Keys.ToList().IndexOf(kv.Key);
                                        <div class="st-bar-row">
                                            <span class="st-bar-name @(rank < 3 ? "st-bar-name-top" : "")">@kv.Key</span>
                                            <div class="st-bar-track">
                                                <div class="st-bar-fill st-bar-genre" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                            <span class="st-bar-val">@kv.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Formats ── -->
                        @if (_s.ByFormat.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 3H8" /></svg>
                                    Formats
                                </div>
                                <div class="st-format-chips">
                                    @foreach (var kv in _s.ByFormat.OrderByDescending(x => x.Value))
                                    {
                                        var pct = _s.Total > 0 ? kv.Value * 100.0 / _s.Total : 0;
                                        <div class="st-format-chip">
                                            <span class="st-format-name">@kv.Key</span>
                                            <span class="st-format-count">@kv.Value</span>
                                            <span class="st-format-pct">@pct.ToString("F0")%</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Studios ── -->
                        @if (_s.TopStudios.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></svg>
                                    Studios
                                    <span class="st-section-meta">@_s.UniqueStudios unique</span>
                                </div>
                                <div class="st-bar-list">
                                    @{
                                        var maxS = _s.TopStudios.FirstOrDefault().Value;
                                    }
                                    @foreach (var kv in _s.TopStudios.Take(8))
                                    {
                                        var pct = maxS > 0 ? kv.Value * 100.0 / maxS : 0;
                                        <div class="st-bar-row">
                                            <span class="st-bar-name">@kv.Key</span>
                                            <div class="st-bar-track">
                                                <div class="st-bar-fill st-bar-studio" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                            <span class="st-bar-val">@kv.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── By Year ── -->
                        @if (_s.ByYear.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                                    By Year
                                    <span class="st-section-meta">@_s.ByYear.Count years</span>
                                </div>
                                <div class="st-year-chart">
                                    @{
                                        var maxY = _s.ByYear.Values.DefaultIfEmpty(1).Max();
                                    }
                                    @foreach (var kv in _s.ByYear.OrderByDescending(x => x.Key).Take(15))
                                    {
                                        var pct = maxY > 0 ? kv.Value * 100.0 / maxY : 0;
                                        <div class="st-year-row">
                                            <span class="st-year-lbl">@kv.Key</span>
                                            <div class="st-year-bar-wrap">
                                                <div class="st-year-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                            <span class="st-year-count">@kv.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Seasons ── -->
                        @if (_s.BySeason.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">🌸 Seasons</div>
                                <div class="st-season-grid">
                                    @{
                                        var maxSeason = _s.BySeason.Values.DefaultIfEmpty(0).Max();
                                    }
                                    @foreach (var season in new[] { "WINTER", "SPRING", "SUMMER", "FALL" })
                                    {
                                        var count = _s.BySeason.GetValueOrDefault(season, 0);
                                        var total = _s.BySeason.Values.Sum();
                                        var pct = total > 0 ? count * 100.0 / total : 0;
                                        var emoji = season switch { "WINTER" => "❄️", "SPRING" => "🌸", "SUMMER" => "☀️", "FALL" => "🍂", _ => "🌿" };
                                        <div class="st-season-cell @(count == maxSeason && count > 0 ? "st-season-top" : "")">
                                            <span class="st-season-emoji">@emoji</span>
                                            <span class="st-season-name">@(season[0] + season[1..].ToLower())</span>
                                            <span class="st-season-count">@count</span>
                                            <span class="st-season-pct">@pct.ToString("F0")%</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Sources ── -->
                        @if (_s.BySource.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                                    Source Material
                                </div>
                                <div class="st-bar-list">
                                    @{
                                        var maxSrc = _s.BySource.Values.DefaultIfEmpty(1).Max();
                                    }
                                    @foreach (var kv in _s.BySource.OrderByDescending(x => x.Value).Take(8))
                                    {
                                        var pct = maxSrc > 0 ? kv.Value * 100.0 / maxSrc : 0;
                                        <div class="st-bar-row">
                                            <span class="st-bar-name">@kv.Key</span>
                                            <div class="st-bar-track">
                                                <div class="st-bar-fill st-bar-source" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                            <span class="st-bar-val">@kv.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Country ── -->
                        @if (_s.ByCountry.Count > 1)
                        {
                            <div class="st-section">
                                <div class="st-section-title">🌏 Country of Origin</div>
                                <div class="st-bar-list">
                                    @{
                                        var maxC = _s.ByCountry.Values.DefaultIfEmpty(1).Max();
                                    }
                                    @foreach (var kv in _s.ByCountry.OrderByDescending(x => x.Value))
                                    {
                                        var flag = kv.Key switch { "JP" => "🇯🇵", "CN" => "🇨🇳", "KR" => "🇰🇷", "TW" => "🇹🇼", _ => "🌐" };
                                        var name = kv.Key switch { "JP" => "Japan", "CN" => "China", "KR" => "South Korea", "TW" => "Taiwan", _ => kv.Key };
                                        var pct = maxC > 0 ? kv.Value * 100.0 / maxC : 0;
                                        <div class="st-bar-row">
                                            <span class="st-bar-name">@flag @name</span>
                                            <div class="st-bar-track">
                                                <div class="st-bar-fill st-bar-country" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                            <span class="st-bar-val">@kv.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Tags ── -->
                        @if (_s.TopTags.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>
                                    Top Tags
                                </div>
                                <div class="st-tags-wrap">
                                    @{
                                        var maxTag = _s.TopTags.FirstOrDefault().Value;
                                    }
                                    @foreach (var kv in _s.TopTags.Take(24))
                                    {
                                        var tagPct = maxTag > 0 ? (int)(kv.Value * 100 / maxTag) : 0;
                                        var opacity = 0.45 + tagPct * 0.0055;
                                        <span class="st-tag" style="opacity:@opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">@kv.Key<span class="st-tag-count">@kv.Value</span></span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ── Engagement ── -->
                        <div class="st-section">
                            <div class="st-section-title">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                                Engagement
                            </div>
                            <div class="st-engage-grid">
                                <div class="st-engage-cell">
                                    <span class="st-engage-val">@_s.WithNotes</span>
                                    <span class="st-engage-lbl">with notes</span>
                                </div>
                                <div class="st-engage-cell">
                                    <span class="st-engage-val">@_s.Rewatched</span>
                                    <span class="st-engage-lbl">rewatched</span>
                                </div>
                                <div class="st-engage-cell">
                                    <span class="st-engage-val">@_s.CompletionRate.ToString("F0")%</span>
                                    <span class="st-engage-lbl">completion</span>
                                </div>
                                <div class="st-engage-cell">
                                    <span class="st-engage-val">@_s.DropRate.ToString("F0")%</span>
                                    <span class="st-engage-lbl">drop rate</span>
                                </div>
                                <div class="st-engage-cell">
                                    <span class="st-engage-val">@_s.Private</span>
                                    <span class="st-engage-lbl">private</span>
                                </div>
                                <div class="st-engage-cell">
                                    <span class="st-engage-val">@_s.Favorited</span>
                                    <span class="st-engage-lbl">favourited</span>
                                </div>
                            </div>
                        </div>

                        <!-- ── Recent activity ── -->
                        @if (_s.RecentlyUpdated.Any())
                        {
                            <div class="st-section">
                                <div class="st-section-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 .49-4.5" /></svg>
                                    Recent Activity
                                </div>
                                <div class="st-recent-list">
                                    @foreach (var e in _s.RecentlyUpdated)
                                    {
                                        <div class="st-recent-row">
                                            <div class="st-recent-poster" style="background-image:url('@e.Anime.ImageUrl');@(!string.IsNullOrEmpty(e.Anime.CoverColor) ? $"background-color:{e.Anime.CoverColor};" : "")"></div>
                                            <div class="st-recent-info">
                                                <span class="st-recent-title">@TruncateTitle(e.Anime.Title)</span>
                                                <div class="st-recent-meta">
                                                    @if (e.Status.HasValue)
                                                    {
                                                        var sc = GetStatusColor(e.Status.Value);
                                                        <span class="st-recent-status" style="color:@sc">@GetStatusLabel(e.Status.Value)</span>
                                                        <span class="st-recent-sep">·</span>
                                                    }
                                                    <span class="st-recent-date">@FormatRelativeDate(e.UpdatedAt)</span>
                                                </div>
                                            </div>
                                            @if (e.Score > 0)
                                            {
                                                <span class="st-recent-score" style="color:@GetScoreColor(e.Score)">@e.Score.ToString("G")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _activeTab = "account";
    private string _pastedToken = "";

    private enum PanelState { NotConnected, Loading, Connected, Importing, Done, Error, WaitingForPin }
    private PanelState _state = PanelState.NotConnected;
    private string _loadingText = "Loading…";
    private string _errorMessage = "";
    private int _importTotal = 0, _importDone = 0, _listsCreated = 0;

    private static readonly string[] _swatches = {
        "#ef4444","#f97316","#f59e0b","#eab308","#84cc16","#22c55e",
        "#10b981","#14b8a6","#06b6d4","#0ea5e9","#3b82f6","#6366f1",
        "#8b5cf6","#a855f7","#d946ef","#ec4899"
    };

    // ── Stats snapshot ──────────────────────────────────────────────────
    private StatsSnapshot? _s;

    private class StatsSnapshot
    {
        public int Total { get; set; }
        public int TotalEpisodes { get; set; }
        public long TotalMinutes { get; set; }
        public int ScoredCount { get; set; }
        public double AvgScore { get; set; }
        public int Favorited { get; set; }
        public int WithNotes { get; set; }
        public int Rewatched { get; set; }
        public int Private { get; set; }
        public int Completed { get; set; }
        public double CompletionRate { get; set; }
        public double DropRate { get; set; }
        public int UniqueGenres { get; set; }
        public int UniqueStudios { get; set; }
        public int AvgEpisodeDuration { get; set; }

        public Dictionary<ListStatus, int> ByStatus { get; set; } = new();
        public Dictionary<int, int> ScoreDist { get; set; } = new();
        public Dictionary<string, int> TopGenres { get; set; } = new();
        public Dictionary<string, int> ByFormat { get; set; } = new();
        public Dictionary<string, int> TopStudios { get; set; } = new();
        public Dictionary<int, int> ByYear { get; set; } = new();
        public Dictionary<string, int> BySeason { get; set; } = new();
        public Dictionary<string, int> BySource { get; set; } = new();
        public Dictionary<string, int> ByCountry { get; set; } = new();
        public Dictionary<string, int> TopTags { get; set; } = new();

        public UserListEntry? BestAnime { get; set; }
        public UserListEntry? WorstAnime { get; set; }
        public UserListEntry? LongestAnime { get; set; }
        public List<UserListEntry> RecentlyUpdated { get; set; } = new();
    }

    private void ComputeStats()
    {
        var all = UserListService.GetAll().ToList();
        var s = new StatsSnapshot { Total = all.Count };
        if (s.Total == 0) { _s = s; return; }

        s.Favorited = UserListService.GetFavoriteIds().Count;

        foreach (var e in all)
        {
            if (e.Status.HasValue)
                s.ByStatus[e.Status.Value] = s.ByStatus.GetValueOrDefault(e.Status.Value) + 1;

            s.TotalEpisodes += e.EpisodesWatched;
            var dur = e.Anime.Duration ?? 24;
            s.TotalMinutes += (long)e.EpisodesWatched * dur;

            if (e.Score > 0)
            {
                s.ScoredCount++;
                s.AvgScore += e.Score;
                int bucket = Math.Clamp((int)Math.Round(e.Score), 1, 10);
                s.ScoreDist[bucket] = s.ScoreDist.GetValueOrDefault(bucket) + 1;
            }

            foreach (var g in e.Anime.Genres ?? new())
                s.TopGenres[g] = s.TopGenres.GetValueOrDefault(g) + 1;

            if (!string.IsNullOrEmpty(e.Anime.Format))
                s.ByFormat[e.Anime.Format] = s.ByFormat.GetValueOrDefault(e.Anime.Format) + 1;

            foreach (var st in e.Anime.Studios ?? new())
                s.TopStudios[st.Name] = s.TopStudios.GetValueOrDefault(st.Name) + 1;

            if (e.Anime.Year.HasValue)
                s.ByYear[e.Anime.Year.Value] = s.ByYear.GetValueOrDefault(e.Anime.Year.Value) + 1;

            if (!string.IsNullOrEmpty(e.Anime.Season))
                s.BySeason[e.Anime.Season] = s.BySeason.GetValueOrDefault(e.Anime.Season) + 1;

            if (!string.IsNullOrEmpty(e.Anime.Source))
                s.BySource[e.Anime.Source] = s.BySource.GetValueOrDefault(e.Anime.Source) + 1;

            if (!string.IsNullOrEmpty(e.Anime.CountryOfOrigin))
                s.ByCountry[e.Anime.CountryOfOrigin] = s.ByCountry.GetValueOrDefault(e.Anime.CountryOfOrigin) + 1;

            foreach (var t in e.Anime.Tags?.Where(t => !t.IsMediaSpoiler) ?? Enumerable.Empty<AnimeTag>())
                s.TopTags[t.Name] = s.TopTags.GetValueOrDefault(t.Name) + 1;

            if (!string.IsNullOrEmpty(e.Notes)) s.WithNotes++;
            if (e.TotalRewatches > 0) s.Rewatched++;
            if (e.IsPrivate) s.Private++;
        }

        if (s.ScoredCount > 0) s.AvgScore /= s.ScoredCount;

        s.Completed = s.ByStatus.GetValueOrDefault(ListStatus.Completed);
        int dropped = s.ByStatus.GetValueOrDefault(ListStatus.Dropped);
        int finished = s.Completed + dropped;
        s.CompletionRate = finished > 0 ? s.Completed * 100.0 / finished : 0;
        s.DropRate = s.Total > 0 ? dropped * 100.0 / s.Total : 0;
        s.UniqueGenres = s.TopGenres.Count;
        s.UniqueStudios = s.TopStudios.Count;

        s.TopGenres = s.TopGenres.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);
        s.TopStudios = s.TopStudios.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);
        s.TopTags = s.TopTags.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);

        var scored = all.Where(e => e.Score > 0).ToList();
        s.BestAnime = scored.OrderByDescending(e => e.Score).FirstOrDefault();
        s.WorstAnime = scored.OrderBy(e => e.Score).FirstOrDefault();

        s.LongestAnime = all
            .Where(e => e.Anime.Duration.HasValue && e.EpisodesWatched > 0)
            .OrderByDescending(e => e.EpisodesWatched * (e.Anime.Duration ?? 0))
            .FirstOrDefault();

        var withDur = all.Where(e => e.Anime.Duration.HasValue).ToList();
        if (withDur.Any()) s.AvgEpisodeDuration = (int)Math.Round(withDur.Average(e => e.Anime.Duration!.Value));

        s.RecentlyUpdated = all.OrderByDescending(e => e.UpdatedAt).Take(5).ToList();
        _s = s;
    }

    // ── Format helpers ───────────────────────────────────────────────────
    private static string FormatDays(long min) { double d = min / 1440.0; return d >= 1 ? d.ToString("F1") : (min / 60.0).ToString("F1"); }
    private static string FormatHours(long min) => (min / 60.0).ToString("F0");
    private static string FormatMinutes(long min) { if (min >= 1440) return (min / 1440.0).ToString("F1") + " days"; if (min >= 60) return (min / 60.0).ToString("F0") + " hrs"; return min + " min"; }

    private static long GetAnimeMinutes(AnimeCard a)
    {
        int eps = 1;
        if (!string.IsNullOrEmpty(a.Episodes) && a.Episodes != "N/A")
        { var part = a.Episodes.Split('/').Last().Trim().TrimEnd('+', '?'); if (int.TryParse(part, out int p) && p > 0) eps = p; }
        return eps * (long)(a.Duration ?? 24);
    }

    private static string FormatRelativeDate(DateTime dt)
    {
        var d = DateTime.Now - dt;
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        if (d.TotalDays < 30) return $"{(int)d.TotalDays}d ago";
        if (d.TotalDays < 365) return $"{(int)(d.TotalDays / 30)}mo ago";
        return $"{(int)(d.TotalDays / 365)}y ago";
    }

    private static string TruncateTitle(string t) => t.Length > 28 ? t[..26] + "…" : t;

    private string GetStatusColor(ListStatus s) => s switch
    {
        ListStatus.Watching => "#22c55e",
        ListStatus.Rewatching => "#06b6d4",
        ListStatus.Completed => "#3b82f6",
        ListStatus.Planning => "#a855f7",
        ListStatus.Paused => "#f97316",
        ListStatus.Dropped => "#ef4444",
        _ => "#6b7280"
    };

    private string GetStatusLabel(ListStatus s) => s switch
    {
        ListStatus.Watching => "Watching",
        ListStatus.Rewatching => "Rewatching",
        ListStatus.Completed => "Completed",
        ListStatus.Planning => "Planning",
        ListStatus.Paused => "Paused",
        ListStatus.Dropped => "Dropped",
        _ => s.ToString()
    };

    private static string GetScoreColor(double score) => score switch
    {
        >= 8.5 => "#22c55e",
        >= 7 => "#84cc16",
        >= 5 => "#eab308",
        >= 3 => "#f97316",
        _ => "#ef4444"
    };

    private static string GetScoreBarColor(int score) => score switch
    {
        >= 9 => "#22c55e",
        >= 7 => "#84cc16",
        >= 5 => "#eab308",
        >= 3 => "#f97316",
        _ => "#ef4444"
    };

    // ── Lifecycle ────────────────────────────────────────────────────────
    private bool _prevVisible = false;
    protected override void OnParametersSet()
    {
        bool justOpened = IsVisible && !_prevVisible;
        _prevVisible = IsVisible;
        if (justOpened)
        {
            _activeTab = "account";
            if (AniListAuth.IsAuthenticated && _state == PanelState.NotConnected)
                _state = PanelState.Connected;
        }
    }

    // ── OAuth ────────────────────────────────────────────────────────────
    private async Task SubmitToken()
    {
        if (string.IsNullOrWhiteSpace(_pastedToken)) return;
        AniListAuth.SetToken(_pastedToken.Trim());
        _state = PanelState.Loading; _loadingText = "Fetching your profile…"; StateHasChanged();
        var user = await AniListAuth.FetchCurrentUserAsync();
        _state = user == null ? PanelState.Error : PanelState.Connected;
        if (user == null) _errorMessage = "Invalid token or could not fetch profile.";
        StateHasChanged();
    }

    public async Task OnTokenReceived()
    {
        _state = PanelState.Loading; _loadingText = "Fetching your profile…"; StateHasChanged();
        var user = await AniListAuth.FetchCurrentUserAsync();
        if (user == null) { _state = PanelState.Error; _errorMessage = "Could not fetch your AniList profile."; }
        else _state = PanelState.Connected;
        StateHasChanged();
    }

    public async Task TryAutoImportAsync()
    {
        if (!AniListAuth.IsAuthenticated) return;
        if (AniListAuth.CurrentUser == null) { var u = await AniListAuth.FetchCurrentUserAsync(); if (u == null) return; }
        await DoImportAsync(false);
    }

    private async Task StartOAuth()
    {
        try { await JS.InvokeVoidAsync("open", AniListAuth.GetAuthUrl(), "_blank"); _state = PanelState.WaitingForPin; StateHasChanged(); }
        catch (Exception ex) { _state = PanelState.Error; _errorMessage = "Could not open AniList login: " + ex.Message; StateHasChanged(); }
    }

    private async Task StartImport()
    {
        if (AniListAuth.CurrentUser == null) return;
        _state = PanelState.Importing; _loadingText = "Fetching your anime list…";
        _importDone = 0; _importTotal = 0; _listsCreated = 0; StateHasChanged();
        await DoImportAsync(true);
    }

    private async Task DoImportAsync(bool showUI)
    {
        if (AniListAuth.CurrentUser == null) return;
        var entries = await AniListAuth.FetchAnimeListAsync(AniListAuth.CurrentUser.Id);
        if (entries.Count == 0) { if (showUI) { _state = PanelState.Error; _errorMessage = "Your AniList is empty or could not be fetched."; StateHasChanged(); } return; }

        var (map, newCount) = BuildCustomListMap(entries.SelectMany(e => e.CustomListNames).Distinct(StringComparer.OrdinalIgnoreCase).ToList());
        _listsCreated = newCount; _importTotal = entries.Count;
        if (showUI) { _loadingText = "Importing anime…"; StateHasChanged(); }

        foreach (var imp in entries) { ApplyEntry(imp, map); _importDone++; if (showUI && _importDone % 20 == 0) { StateHasChanged(); await Task.Yield(); } }
        UserListService.NotifyChanged();

        try { var favIds = await AniListAuth.FetchFavouriteIdsAsync(); if (favIds.Count > 0) { UserListService.ImportFavorites(favIds); UserListService.NotifyChanged(); } } catch { }

        if (showUI) { _state = PanelState.Done; StateHasChanged(); }
    }

    private (Dictionary<string, string> map, int newCount) BuildCustomListMap(List<string> names)
    {
        if (!names.Any()) return (new(), 0);
        var existing = UserListService.GetCustomLists();
        var avail = _swatches.Where(c => !existing.Select(l => l.Color).ToHashSet(StringComparer.OrdinalIgnoreCase).Contains(c)).ToList();
        if (!avail.Any()) avail = _swatches.ToList();
        var rng = new Random(); var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase); var toAdd = new List<UserCustomList>();
        foreach (var name in names)
        {
            var ex = existing.FirstOrDefault(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase));
            if (ex != null) { map[name] = ex.Id; continue; }
            string color; if (avail.Any()) { int idx = rng.Next(avail.Count); color = avail[idx]; avail.RemoveAt(idx); } else color = _swatches[rng.Next(_swatches.Length)];
            var nl = new UserCustomList { Id = Guid.NewGuid().ToString(), Name = name, Color = color, IsStatusList = false, Order = existing.Count + toAdd.Count };
            toAdd.Add(nl); map[name] = nl.Id;
        }
        int newCount = toAdd.Count;
        if (toAdd.Any()) UserListService.SaveCustomLists(existing.Concat(toAdd).ToList());
        return (map, newCount);
    }

    private void ApplyEntry(AniListImportEntry src, Dictionary<string, string> map)
    {
        if (src.AnimeCard.Id == 0 && src.MediaId == 0) return;
        if (src.AnimeCard.Id == 0) src.AnimeCard.Id = src.MediaId;
        UserListService.ImportEntry(new UserListEntry { Anime = src.AnimeCard, Status = MapStatus(src.AniListStatus), Score = src.Score, EpisodesWatched = src.Progress, TotalRewatches = src.Repeat, Notes = src.Notes, IsPrivate = src.IsPrivate, HideFromStatusLists = src.HideFromStatusLists, StartDate = src.StartedAt, FinishDate = src.CompletedAt, AddedAt = src.CreatedAt, UpdatedAt = src.UpdatedAt, CustomListIds = src.CustomListNames.Where(n => map.ContainsKey(n)).Select(n => map[n]).ToList() });
    }

    private static ListStatus? MapStatus(string s) => s switch { "CURRENT" => ListStatus.Watching, "REPEATING" => ListStatus.Rewatching, "COMPLETED" => ListStatus.Completed, "PLANNING" => ListStatus.Planning, "PAUSED" => ListStatus.Paused, "DROPPED" => ListStatus.Dropped, _ => null };

    private async Task Disconnect()
    {
        try { await JS.InvokeVoidAsync("aniListRemoveToken"); } catch { }
        AniListAuth.ClearToken(); _state = PanelState.NotConnected; _importDone = 0; _importTotal = 0; _listsCreated = 0; StateHasChanged();
    }

    private void HandleOverlayClick() => Close();
    private void Close() => OnClose.InvokeAsync();
    public void Dispose() { }
}
