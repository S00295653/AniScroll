    // ── SVG ───────────────────────────────────────────────────────────────
    private static string BuildRadarSvg(List<KeyValuePair<string, int>> items, string strokeColor, string fillColor)
    {
        if (items.Count < 2) return "";
        int n = items.Count;
        double maxVal = items.Max(x => x.Value);
        if (maxVal == 0) return "";
        const double cx = 100, cy = 100, r = 75;
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\" class=\"st-radar-svg\">");
        for (int ring = 1; ring <= 4; ring++)
        {
            double rr = r * ring / 4.0;
            sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{rr:F1}\" fill=\"none\" stroke=\"rgba(255,255,255,0.08)\" stroke-width=\"0.5\"/>");
        }
        for (int i = 0; i < n; i++)
        {
            double a = 2 * Math.PI * i / n - Math.PI / 2;
            sb.Append($"<line x1=\"{cx}\" y1=\"{cy}\" x2=\"{cx + r * Math.Cos(a):F1}\" y2=\"{cy + r * Math.Sin(a):F1}\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"0.5\"/>");
        }
        var pts = Enumerable.Range(0, n).Select(i =>
        {
            double a = 2 * Math.PI * i / n - Math.PI / 2, v = items[i].Value / maxVal;
            return (x: cx + r * v * Math.Cos(a), y: cy + r * v * Math.Sin(a));
        }).ToList();
        sb.Append($"<polygon points=\"{string.Join(" ", pts.Select(p => $"{p.x:F1},{p.y:F1}"))}\" fill=\"{fillColor}\" fill-opacity=\"0.15\" stroke=\"{strokeColor}\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/>");
        foreach (var (px, py) in pts) sb.Append($"<circle cx=\"{px:F1}\" cy=\"{py:F1}\" r=\"2.5\" fill=\"{strokeColor}\"/>");
        for (int i = 0; i < n; i++)
        {
            double a = 2 * Math.PI * i / n - Math.PI / 2;
            double lx = cx + (r + 14) * Math.Cos(a), ly = cy + (r + 14) * Math.Sin(a);
            string anchor = lx < cx - 5 ? "end" : lx > cx + 5 ? "start" : "middle";
            string lbl = items[i].Key.Length > 10 ? items[i].Key[..9] + "…" : items[i].Key;
            sb.Append($"<text x=\"{lx:F1}\" y=\"{ly:F1}\" text-anchor=\"{anchor}\" dominant-baseline=\"middle\" font-size=\"7\" fill=\"rgba(255,255,255,0.5)\">{System.Net.WebUtility.HtmlEncode(lbl)}</text>");
        }
        sb.Append("</svg>"); return sb.ToString();
    }

    private static string BuildPieSvg(List<KeyValuePair<string, int>> items)
    {
        if (!items.Any()) return "";
        var colors = new[] { "#E94560", "#3b82f6", "#22c55e", "#f97316", "#a855f7", "#06b6d4" };
        double total = items.Sum(x => x.Value);
        if (total == 0) return "";
        const double cx = 100, cy = 100, outerR = 74, innerR = 46;
        double gap = items.Count > 1 ? 0.025 : 0;
        string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\" class=\"st-pie-svg\">");
        double angle = -Math.PI / 2; int ci = 0;
        foreach (var kv in items)
        {
            double sw = 2 * Math.PI * kv.Value / total, sa = angle + gap, ea = angle + sw - gap;
            if (ea > sa)
            {
                double x1 = cx + outerR * Math.Cos(sa), y1 = cy + outerR * Math.Sin(sa);
                double x2 = cx + outerR * Math.Cos(ea), y2 = cy + outerR * Math.Sin(ea);
                double xi1 = cx + innerR * Math.Cos(sa), yi1 = cy + innerR * Math.Sin(sa);
                double xi2 = cx + innerR * Math.Cos(ea), yi2 = cy + innerR * Math.Sin(ea);
                int large = (sw - gap * 2) > Math.PI ? 1 : 0;
                string col = colors[ci % colors.Length];
                sb.Append($"<path d=\"M {F(xi1)} {F(yi1)} L {F(x1)} {F(y1)} A {F(outerR)} {F(outerR)} 0 {large} 1 {F(x2)} {F(y2)} L {F(xi2)} {F(yi2)} A {F(innerR)} {F(innerR)} 0 {large} 0 {F(xi1)} {F(yi1)} Z\" fill=\"{col}\"/>");
                double pct = kv.Value / total;
                if (pct > 0.07) { double mid = sa + (ea - sa) / 2, lr = (outerR + innerR) / 2; sb.Append($"<text x=\"{F(cx + lr * Math.Cos(mid))}\" y=\"{F(cy + lr * Math.Sin(mid))}\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"9\" font-weight=\"700\" fill=\"white\">{(pct * 100).ToString("F0")}%</text>"); }
            }
            angle += sw; ci++;
        }
        sb.Append($"<circle cx=\"100\" cy=\"100\" r=\"{F(innerR - 1)}\" fill=\"#14141f\"/>");
        sb.Append($"<text x=\"100\" y=\"96\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"18\" font-weight=\"800\" fill=\"rgba(255,255,255,0.88)\">{(int)total}</text>");
        sb.Append($"<text x=\"100\" y=\"110\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"8\" fill=\"rgba(255,255,255,0.3)\">anime</text>");
        sb.Append("</svg>"); return sb.ToString();
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    private static int GetTotalEpsFromString(string? s) { if (string.IsNullOrWhiteSpace(s) || s == "N/A") return 0; var p = s.Split('/').Last().Trim().TrimEnd('+', '?'); return int.TryParse(p, out int v) && v > 0 ? v : 0; }
    private static string FormatDays(long min) { double d = min / 1440.0; return d >= 1 ? d.ToString("F1") : (min / 60.0).ToString("F1"); }
    private static string FormatHours(long min) => (min / 60.0).ToString("F0");
    private static string FormatMinutes(long min) { if (min >= 1440) return (min / 1440.0).ToString("F1") + " days"; if (min >= 60) return (min / 60.0).ToString("F0") + " hrs"; return min + " min"; }
    private static long GetAnimeMinutes(AnimeCard a) { int eps = 1; if (!string.IsNullOrEmpty(a.Episodes) && a.Episodes != "N/A") { var p = a.Episodes.Split('/').Last().Trim().TrimEnd('+', '?'); if (int.TryParse(p, out int v) && v > 0) eps = v; } return eps * (long)(a.Duration ?? 24); }
    private static string TruncateTitle(string t) => t.Length > 28 ? t[..26] + "…" : t;

