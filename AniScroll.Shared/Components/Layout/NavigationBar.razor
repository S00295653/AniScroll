@inject IJSRuntime JS

<div class="mobile-navigation @(IsSearchOpen ? "search-active" : "")">
    
    <!-- Search Expansion Zone -->
    <div class="search-expansion @(IsSearchOpen ? "expanded" : "")">
        <div class="search-circle @(IsSearchOpen ? "grow" : "")">
            <div class="search-input-container @(IsSearchOpen ? "visible" : "")">
                <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text" 
                       class="search-field" 
                       placeholder="Search anime..." 
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @ref="searchInputRef" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button class="clear-search-btn" @onclick="ClearSearch">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="modern-nav-bar">
        <button class="nav-item" @onclick="OnListsClick">
            <div class="nav-item-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                </svg>
            </div>
            <span class="nav-item-label">Lists</span>
        </button>

        <button class="nav-item nav-item-center @(IsSearchOpen ? "is-active" : "")" @onclick="ToggleSearch">
            <div class="center-button-icon">
                @if (IsSearchOpen)
                {
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M3 12h18M3 6h18M3 18h18"></path>
                    </svg>
                }
                else
                {
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                }
            </div>
        </button>

        <button class="nav-item" @onclick="OnProfileClick">
            <div class="nav-item-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="8" r="5"></circle>
                    <path d="M20 21a8 8 0 1 0-16 0"></path>
                </svg>
            </div>
            <span class="nav-item-label">Profile</span>
        </button>
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnSearchToggled { get; set; }
    [Parameter] public EventCallback OnListsClicked { get; set; }
    [Parameter] public EventCallback OnProfileClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchQueryChanged { get; set; }

    private bool IsSearchOpen { get; set; } = false;
    private string SearchQuery { get; set; } = string.Empty;
    private ElementReference searchInputRef;

    private async Task ToggleSearch()
    {
        IsSearchOpen = !IsSearchOpen;
        
        if (IsSearchOpen)
        {
            await Task.Delay(600);
            await JS.InvokeVoidAsync("focusElement", searchInputRef);
        }
        else
        {
            SearchQuery = string.Empty;
        }

        await OnSearchToggled.InvokeAsync();
    }

    private void ClearSearch()
    {
        SearchQuery = string.Empty;
        OnSearchQueryChanged.InvokeAsync(SearchQuery);
    }

    private void OnListsClick()
    {
        OnListsClicked.InvokeAsync();
    }

    private void OnProfileClick()
    {
        OnProfileClicked.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SearchQuery))
        {
            OnSearchQueryChanged.InvokeAsync(SearchQuery);
        }
    }
}
