@inject IJSRuntime JS

<div class="nav-section @(IsSearchOpen ? "search-open" : "")">
    <nav class="main-nav-bar">

        <!-- Search row : expand the bar from inside -->
        <div class="search-row">
            <div class="search-inner @(IsSearchOpen ? "visible" : "")">
                <svg class="search-pill-icon" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text"
                       class="search-field"
                       placeholder="Search anime..."
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @onchange="OnSearchChanged"
                       @ref="searchInputRef" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button class="clear-search-btn" @onclick="ClearSearch">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                }
            </div>
        </div>

        <!-- Nav buttons -->
        <div class="nav-buttons-row">

            <button class="nav-btn" @onclick="OnListsClick">
                <div class="nav-btn-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                    </svg>
                </div>
                <span class="nav-btn-label">Lists</span>
            </button>

            <button class="nav-btn nav-center-btn @(IsSearchOpen ? "is-active" : "")"
                    @onclick="ToggleSearch">
                <div class="center-btn-icon">
                    @if (IsSearchOpen)
                    {
                        <!-- Cards / scroll feed icon -->
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <rect x="5" y="10" width="14" height="10" rx="2" opacity="0.4"></rect>
                            <rect x="3" y="6" width="14" height="10" rx="2" opacity="0.7"></rect>
                            <rect x="1" y="2" width="14" height="10" rx="2"></rect>
                            <polyline points="19 9 22 6 22 14"></polyline>
                            <line x1="22" y1="6" x2="22" y2="14"></line>
                        </svg>
                    }
                    else
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                    }
                </div>
            </button>

            <button class="nav-btn" @onclick="OnProfileClick">
                <div class="nav-btn-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="8" r="5"></circle>
                        <path d="M20 21a8 8 0 1 0-16 0"></path>
                    </svg>
                </div>
                <span class="nav-btn-label">Profile</span>
            </button>

        </div>
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnSearchToggled { get; set; }
    [Parameter] public EventCallback OnListsClicked { get; set; }
    [Parameter] public EventCallback OnProfileClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchQueryChanged { get; set; }

    private bool IsSearchOpen { get; set; } = false;
    private string SearchQuery { get; set; } = string.Empty;
    private ElementReference searchInputRef;

    private async Task ToggleSearch()
    {
        IsSearchOpen = !IsSearchOpen;

        if (IsSearchOpen)
        {
            await Task.Delay(400);
            try { await JS.InvokeVoidAsync("focusElement", searchInputRef); }
            catch { }
        }
        else
        {
            SearchQuery = string.Empty;
            await OnSearchQueryChanged.InvokeAsync(string.Empty);
        }

        await OnSearchToggled.InvokeAsync();
    }

    private void ClearSearch()
    {
        SearchQuery = string.Empty;
        OnSearchQueryChanged.InvokeAsync(string.Empty);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? string.Empty;
        OnSearchQueryChanged.InvokeAsync(SearchQuery);
    }

    private void OnListsClick() => OnListsClicked.InvokeAsync();
    private void OnProfileClick() => OnProfileClicked.InvokeAsync();
}