@inject IJSRuntime JS

<div class="nav-section @(IsSearchOpen ? "search-open" : "")">

    <!-- Zone de recherche qui apparaît au-dessus de la nav bar -->
    <div class="search-expansion-zone">
        <div class="search-morphing-pill @(IsSearchOpen ? "expanded" : "")">
            <div class="search-pill-content @(IsSearchOpen ? "visible" : "")">
                <svg class="search-pill-icon" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text"
                       class="search-field"
                       placeholder="Search anime..."
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @onchange="OnSearchChanged"
                       @ref="searchInputRef" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button class="clear-search-btn" @onclick="ClearSearch">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Barre de navigation -->
    <nav class="main-nav-bar">

        <!-- Bouton Lists -->
        <button class="nav-btn" @onclick="OnListsClick">
            <div class="nav-btn-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                </svg>
            </div>
            <span class="nav-btn-label">Lists</span>
        </button>

        <!-- Bouton central (Search / Reels) -->
        <button class="nav-btn nav-center-btn @(IsSearchOpen ? "is-active" : "")"
                @onclick="ToggleSearch">
            <div class="center-btn-icon">
                @if (IsSearchOpen)
                {
                    <!-- Icône "scroll/reels" — indique le mode scrolling -->
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="m9 10 3 3 3-3"></path>
                        <line x1="12" y1="13" x2="12" y2="20"></line>
                        <line x1="8" y1="20" x2="16" y2="20"></line>
                    </svg>
                }
                else
                {
                    <!-- Icône loupe -->
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                }
            </div>
        </button>

        <!-- Bouton Profile -->
        <button class="nav-btn" @onclick="OnProfileClick">
            <div class="nav-btn-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="8" r="5"></circle>
                    <path d="M20 21a8 8 0 1 0-16 0"></path>
                </svg>
            </div>
            <span class="nav-btn-label">Profile</span>
        </button>

    </nav>
</div>

@code {
    [Parameter] public EventCallback OnSearchToggled { get; set; }
    [Parameter] public EventCallback OnListsClicked { get; set; }
    [Parameter] public EventCallback OnProfileClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchQueryChanged { get; set; }

    private bool IsSearchOpen { get; set; } = false;
    private string SearchQuery { get; set; } = string.Empty;
    private ElementReference searchInputRef;

    private async Task ToggleSearch()
    {
        IsSearchOpen = !IsSearchOpen;

        if (IsSearchOpen)
        {
            // Attendre la fin de l'animation avant de focus
            await Task.Delay(700);
            try
            {
                await JS.InvokeVoidAsync("focusElement", searchInputRef);
            }
            catch { }
        }
        else
        {
            SearchQuery = string.Empty;
            await OnSearchQueryChanged.InvokeAsync(string.Empty);
        }

        await OnSearchToggled.InvokeAsync();
    }

    private void ClearSearch()
    {
        SearchQuery = string.Empty;
        OnSearchQueryChanged.InvokeAsync(string.Empty);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? string.Empty;
        OnSearchQueryChanged.InvokeAsync(SearchQuery);
    }

    private void OnListsClick() => OnListsClicked.InvokeAsync();
    private void OnProfileClick() => OnProfileClicked.InvokeAsync();
}
