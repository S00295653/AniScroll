@inject IJSRuntime JS

<div class="nav-section">
    <nav class="main-nav-bar @(IsSearchOpen ? "search-open" : "")">

        <!-- Search row -->
        <div class="search-row">
            <div class="search-morphing-pill @(IsSearchOpen ? "expanded" : "")">
                <div class="search-pill-content @(IsSearchOpen ? "visible" : "")">
                    <svg class="search-pill-icon" width="17" height="17" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input type="text"
                           class="search-field"
                           placeholder="Search anime..."
                           value="@SearchQuery"
                           @oninput="OnSearchInput"
                           @ref="searchInputRef" />
                    @if (!string.IsNullOrEmpty(SearchQuery))
                    {
                        <button class="clear-search-btn" @onclick="ClearSearch">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Always-visible buttons -->
        <div class="nav-buttons-row">

            <button class="nav-btn" @onclick="OnListsClick">
                <div class="nav-btn-icon">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.9"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                    </svg>
                </div>
                <span class="nav-btn-label">Lists</span>
            </button>

            <button class="nav-center-btn @(IsSearchOpen ? "is-active" : "")"
                    @onclick="ToggleSearch">
                @if (IsSearchOpen)
                {
                    <svg width="23" height="23" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="4"></rect>
                        <polygon points="10,8 16,12 10,16" fill="currentColor" stroke="none"></polygon>
                    </svg>
                }
                else
                {
                    <svg width="23" height="23" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                }
            </button>

            <button class="nav-btn" @onclick="OnProfileClick">
                <div class="nav-btn-icon">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.9"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
                    </svg>
                </div>
                <span class="nav-btn-label">Profile</span>
            </button>

        </div>
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnSearchToggled { get; set; }
    [Parameter] public EventCallback OnListsClicked { get; set; }
    [Parameter] public EventCallback OnProfileClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchQueryChanged { get; set; }

    private bool IsSearchOpen { get; set; } = false;
    private string SearchQuery { get; set; } = string.Empty;
    private ElementReference searchInputRef;

    private async Task ToggleSearch()
    {
        IsSearchOpen = !IsSearchOpen;

        if (IsSearchOpen)
        {
            await Task.Delay(650);
            try { await JS.InvokeVoidAsync("focusElement", searchInputRef); }
            catch { }
        }
        else
        {
            // Closing search — clear query and notify parent
            SearchQuery = string.Empty;
            await OnSearchQueryChanged.InvokeAsync(string.Empty);
        }

        await OnSearchToggled.InvokeAsync();
    }

    // Fires on EVERY keystroke via @oninput
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? string.Empty;
        await OnSearchQueryChanged.InvokeAsync(SearchQuery);
        // Force re-render so clear button appears/disappears
        StateHasChanged();
    }

    private async Task ClearSearch()
    {
        SearchQuery = string.Empty;
        await OnSearchQueryChanged.InvokeAsync(string.Empty);
        try { await JS.InvokeVoidAsync("focusElement", searchInputRef); }
        catch { }
        StateHasChanged();
    }

    private void OnListsClick() => OnListsClicked.InvokeAsync();
    private void OnProfileClick() => OnProfileClicked.InvokeAsync();
}
