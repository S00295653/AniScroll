@using AniScroll.Shared.Models
@inject IJSRuntime JS

<div class="nav-section">
    <div class="main-nav-bar @(isSearchOpen ? "search-open" : "")">

        <!-- ── Search row ───────────────────────────────────────────────── -->
        <div class="search-row">
            <div class="search-morphing-pill @(isSearchOpen ? "expanded" : "")">
                <div class="search-pill-content @(isSearchOpen ? "visible" : "")">
                    <svg class="search-pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input @ref="searchInputRef"
                           class="search-field"
                           type="text"
                           placeholder="Search anime..."
                           value="@searchQuery"
                           @oninput="HandleSearchInput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="clear-search-btn" @onclick="ClearSearch">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- ── Nav buttons row ─────────────────────────────────────────── -->
        <div class="nav-buttons-row">

            <!-- Lists -->
            <button class="nav-btn" @onclick="HandleListsClick">
                <div class="nav-btn-icon">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                </div>
                <span class="nav-btn-label">Lists</span>
            </button>

            <!-- Centre / Search toggle -->
            <button class="nav-center-btn @(isSearchOpen ? "is-active" : "")" @onclick="ToggleSearch">
                @if (!isSearchOpen)
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                }
            </button>

            <!-- Profile -->
            <button class="nav-btn" @onclick="HandleProfileClick">
                <div class="nav-btn-icon">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <span class="nav-btn-label">Profile</span>
            </button>

        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSearchToggled { get; set; }
    [Parameter] public EventCallback OnListsClicked { get; set; }
    [Parameter] public EventCallback OnProfileClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchQueryChanged { get; set; }

    private bool isSearchOpen = false;
    private string searchQuery = string.Empty;
    private ElementReference searchInputRef;

    // ── Search ────────────────────────────────────────────────────────────────

    private async Task ToggleSearch()
    {
        isSearchOpen = !isSearchOpen;

        if (!isSearchOpen)
        {
            // closing: clear query and notify parent
            searchQuery = string.Empty;
            await OnSearchQueryChanged.InvokeAsync(string.Empty);
            await OnSearchToggled.InvokeAsync();
        }
        else
        {
            StateHasChanged();
            // wait for animation then focus
            await Task.Delay(600);
            try { await JS.InvokeVoidAsync("focusElement", searchInputRef); }
            catch { /* ignore JS interop errors */ }
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        await OnSearchQueryChanged.InvokeAsync(searchQuery);
    }

    private async Task ClearSearch()
    {
        searchQuery = string.Empty;
        await OnSearchQueryChanged.InvokeAsync(string.Empty);
        StateHasChanged();
        try { await JS.InvokeVoidAsync("focusElement", searchInputRef); }
        catch { }
    }

    // ── Nav actions ───────────────────────────────────────────────────────────

    private Task HandleListsClick() => OnListsClicked.InvokeAsync();
    private Task HandleProfileClick() => OnProfileClicked.InvokeAsync();
}
