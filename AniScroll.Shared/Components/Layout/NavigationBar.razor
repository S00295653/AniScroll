@inject IJSRuntime JS

<div class="navigation-container @(IsSearchOpen ? "search-open" : "")">
    @if (IsSearchOpen)
    {
        <div class="search-bar-container">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" 
                       class="search-input" 
                       placeholder="Search anime..." 
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @ref="searchInputRef" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button class="clear-btn" @onclick="ClearSearch">✕</button>
                }
            </div>
        </div>
    }

    <nav class="nav-bar">
        <button class="nav-btn" @onclick="OnListsClick">
            <div class="nav-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
            </div>
            <span class="nav-label">Lists</span>
        </button>

        <button class="nav-btn nav-btn-center @(IsSearchOpen ? "active" : "")" @onclick="ToggleSearch">
            <div class="center-icon">
                @if (IsSearchOpen)
                {
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="4"></circle>
                        <line x1="21.17" y1="8" x2="12" y2="8"></line>
                        <line x1="3.95" y1="6.06" x2="8.54" y2="14"></line>
                        <line x1="10.88" y1="21.94" x2="15.46" y2="14"></line>
                    </svg>
                }
                else
                {
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                }
            </div>
        </button>

        <button class="nav-btn" @onclick="OnProfileClick">
            <div class="nav-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <span class="nav-label">Profile</span>
        </button>
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnSearchToggled { get; set; }
    [Parameter] public EventCallback OnListsClicked { get; set; }
    [Parameter] public EventCallback OnProfileClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchQueryChanged { get; set; }

    private bool IsSearchOpen { get; set; } = false;
    private string SearchQuery { get; set; } = string.Empty;
    private ElementReference searchInputRef;

    private async Task ToggleSearch()
    {
        IsSearchOpen = !IsSearchOpen;
        
        if (IsSearchOpen)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("focusElement", searchInputRef);
        }
        else
        {
            SearchQuery = string.Empty;
        }

        await OnSearchToggled.InvokeAsync();
    }

    private void ClearSearch()
    {
        SearchQuery = string.Empty;
        OnSearchQueryChanged.InvokeAsync(SearchQuery);
    }

    private void OnListsClick()
    {
        OnListsClicked.InvokeAsync();
    }

    private void OnProfileClick()
    {
        OnProfileClicked.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SearchQuery))
        {
            OnSearchQueryChanged.InvokeAsync(SearchQuery);
        }
    }
}
