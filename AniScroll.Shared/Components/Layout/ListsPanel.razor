@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Globalization
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="lists-overlay" @onclick="Close">
        <div class="lists-panel"
             @onclick:stopPropagation="true"
             style="transform: translateY(@(pullOffset.ToString("F1", CultureInfo.InvariantCulture))px);
                    transition: @(isPulling ? "none" : "transform 0.32s cubic-bezier(0.25,0.46,0.45,0.94)");">

            <!-- ── Drag handle ─────────────────────────────────────────────────── -->
            <div class="lists-handle-zone"
                 @ontouchstart="HandleTouchStart"
                 @ontouchmove="HandleTouchMove"
                 @ontouchend="HandleTouchEnd">
                <div class="lists-handle-bar"></div>
            </div>

            <!-- ── Header ─────────────────────────────────────────────────────── -->
            <div class="lists-header">
                <div class="lists-header-left">
                    <h2 class="lists-title">My Lists</h2>
                    @if (UserListService.Count() > 0)
                    {
                        <span class="lists-total-badge">@UserListService.Count()</span>
                    }
                </div>
                <button class="lists-close-btn" @onclick="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- ── Status tabs ────────────────────────────────────────────────── -->
            <div class="lists-tabs-row">

                <!-- Custom list manager button -->
                <button class="lists-add-btn"
                        @onclick="OpenCustomListManager"
                        title="Manage custom lists">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>

                @foreach (var tab in _tabs)
                {
                    int cnt = tab.Status == null
                        ? UserListService.GetAll().Count(e => e.Status.HasValue)
                        : UserListService.Count(tab.Status.Value);

                    bool active = activeStatus == tab.Status;

                    <button class="lists-tab lists-tab-@tab.CssKey @(active ? "active" : "")"
                            @onclick="() => SetTab(tab.Status)">
                        <span class="le-dd-dot le-dd-dot-@tab.CssKey"></span>
                        <span class="lists-tab-label">@tab.Label</span>
                        @if (cnt > 0)
                        {
                            <span class="lists-tab-count">@cnt</span>
                        }
                    </button>
                }

                <!-- 🔥 CUSTOM LIST TABS -->
                @foreach (var cl in UserListService.GetCustomLists())
                {
                    <button class="lists-tab lists-tab-custom @(activeCustomListId == cl.Id ? "active" : "")"
                            style="--cl-color:@cl.Color;"
                            @onclick="() => SetCustomTab(cl.Id)">
                        <span class="le-dd-dot" style="background:@cl.Color; box-shadow:0 0 6px @(cl.Color)80;"></span>
                        <span>@cl.Name</span>
                        @if (UserListService.GetCountForCustomList(cl.Id) > 0)
                        {
                            <span class="lists-tab-count">
                                @UserListService.GetCountForCustomList(cl.Id)
                            </span>
                        }
                    </button>
                }

            </div>

            <div class="lists-header-divider"></div>

            <!-- ── Entries ────────────────────────────────────────────────────── -->
            <div class="lists-content">
                @{
                    var entries =
                        activeCustomListId != null
                            ? UserListService.GetEntriesForCustomList(activeCustomListId)
                            : activeStatus == null
                                ? UserListService.GetAll().Where(e => e.Status.HasValue).ToList()
                                : UserListService.GetByStatus(activeStatus.Value);
                }

                @if (!entries.Any())
                {
                    <div class="lists-empty">
                        <div class="lists-empty-icon">@GetEmptyIcon(activeStatus)</div>
                        <p class="lists-empty-title">@GetEmptyTitle(activeStatus)</p>
                        <p class="lists-empty-sub">@GetEmptySub(activeStatus)</p>
                    </div>
                }
                else
                {
                    @foreach (var entry in entries)
                    {
                        var e = entry;
                        <div class="list-entry" @onclick="() => HandleEntryClick(e)">

                            <!-- Poster -->
                            <div class="entry-poster"
                                 style="background-image: url('@e.Anime.ImageUrl');
                                        @(!string.IsNullOrEmpty(e.Anime.CoverColor) ? $"background-color:{e.Anime.CoverColor};" : "")">
                            </div>

                            <!-- Info -->
                            <div class="entry-info">
                                <div class="entry-title">@e.Anime.Title</div>

                                @{
                                    var metaParts = new List<string>();
                                    if (e.Anime.Score != "N/A" && !string.IsNullOrEmpty(e.Anime.Score))
                                        metaParts.Add("★ " + e.Anime.Score);
                                    if (!string.IsNullOrEmpty(e.Anime.Format))
                                        metaParts.Add(e.Anime.Format);
                                    if (e.Anime.Episodes != "N/A" && !string.IsNullOrEmpty(e.Anime.Episodes))
                                        metaParts.Add(e.Anime.Episodes + " EP");
                                    if (e.Score > 0)
                                        metaParts.Add("My score: " + e.Score);
                                }
                                @if (metaParts.Any())
                                {
                                    <div class="entry-meta">@string.Join(" · ", metaParts)</div>
                                }

                                @if (e.Status.HasValue)
                                {
                                    <div class="entry-status-badge entry-status-@GetStatusCssKey(e.Status.Value)">
                                        @GetStatusIcon(e.Status.Value) @GetStatusLabel(e.Status.Value)
                                    </div>
                                }
                            </div>

                            <!-- Remove button -->
                            <button class="entry-remove-btn"
                                    title="Remove"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => RemoveEntry(e.Anime.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* FIX: outside lists-overlay so its backdrop click doesn't bubble and close ListsPanel *@
    <CustomListManager IsVisible="showCustomListManager"
                       OnClose="CloseCustomListManager" />
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AnimeCard> OnAnimeSelected { get; set; }

    private ListStatus? activeStatus = null;

    private bool showCustomListManager = false;
    private void OpenCustomListManager() => showCustomListManager = true;
    private void CloseCustomListManager() { showCustomListManager = false; StateHasChanged(); }
    private string? activeCustomListId = null;

    // ─── Pull-to-close ────────────────────────────────────────────────────────
    private double pullOffset    = 0;
    private double pullStartY    = 0;
    private bool   isPulling     = false;
    private bool   isPullActive  = false;
    private const double PULL_CLOSE_THRESHOLD = 80;

    // ─── Tab definitions ──────────────────────────────────────────────────────
    private sealed record TabDef(string Label, ListStatus? Status, string CssKey);

    private static readonly TabDef[] _tabs =
    {
        new("All",        null,                  "all"),
        new("Watching",   ListStatus.Watching,   "watching"),
        new("Rewatching", ListStatus.Rewatching, "rewatching"),
        new("Completed",  ListStatus.Completed,  "completed"),
        new("Planning",   ListStatus.Planning,   "planning"),
        new("Paused",     ListStatus.Paused,     "paused"),
        new("Dropped",    ListStatus.Dropped,    "dropped"),
    };

    // ─── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        UserListService.OnChanged += HandleListChanged;
    }

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            pullOffset = 0;
            isPulling  = false;
        }
    }

    public void Dispose() => UserListService.OnChanged -= HandleListChanged;

    private void HandleListChanged() => InvokeAsync(StateHasChanged);

    // ─── Interactions ─────────────────────────────────────────────────────────

    private void SetTab(ListStatus? status)
    {
        activeCustomListId = null;
        activeStatus = status;
        StateHasChanged();
    }

    private void SetCustomTab(string id)
    {
        activeStatus = null;
        activeCustomListId = id;
        StateHasChanged();
    }

    private void Close() => OnClose.InvokeAsync();

    private void RemoveEntry(int animeId) => UserListService.Remove(animeId);

    private async Task HandleEntryClick(UserListEntry entry)
    {
        await JS.InvokeVoidAsync("console.log", $"[ListsPanel] Entry clicked: {entry.Anime.Title}");
        await OnAnimeSelected.InvokeAsync(entry.Anime);
    }

    // ─── Touch gestures ───────────────────────────────────────────────────────

    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        isPullActive = true;
        isPulling    = false;
        pullStartY   = e.Touches[0].ClientY;
        pullOffset   = 0;
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        if (!isPullActive || e.Touches.Length == 0) return;
        double delta = e.Touches[0].ClientY - pullStartY;
        if (delta <= 0) { isPulling = false; pullOffset = 0; return; }
        isPulling  = true;
        pullOffset = delta <= PULL_CLOSE_THRESHOLD
            ? delta
            : PULL_CLOSE_THRESHOLD + (delta - PULL_CLOSE_THRESHOLD) * 0.28;
        StateHasChanged();
    }

    private async Task HandleTouchEnd(TouchEventArgs e)
    {
        if (!isPullActive) return;
        isPullActive = false;
        isPulling    = false;

        if (pullOffset >= PULL_CLOSE_THRESHOLD)
        {
            pullOffset = 900;
            StateHasChanged();
            await Task.Delay(260);
            pullOffset = 0;
            await OnClose.InvokeAsync();
        }
        else
        {
            pullOffset = 0;
            StateHasChanged();
        }
    }

    // ─── Static helpers ───────────────────────────────────────────────────────

    private static string GetStatusLabel(ListStatus s) => s switch
    {
        ListStatus.Watching   => "Watching",
        ListStatus.Rewatching => "Rewatching",
        ListStatus.Completed  => "Completed",
        ListStatus.Planning   => "Planning",
        ListStatus.Paused     => "Paused",
        ListStatus.Dropped    => "Dropped",
        _                     => s.ToString()
    };

    private static string GetStatusCssKey(ListStatus s) => s switch
    {
        ListStatus.Watching   => "watching",
        ListStatus.Rewatching => "rewatching",
        ListStatus.Completed  => "completed",
        ListStatus.Planning   => "planning",
        ListStatus.Paused     => "paused",
        ListStatus.Dropped    => "dropped",
        _                     => "all"
    };

    private static string GetStatusIcon(ListStatus s) => s switch
    {
        ListStatus.Watching   => "▶",
        ListStatus.Rewatching => "↻",
        ListStatus.Completed  => "✓",
        ListStatus.Planning   => "☆",
        ListStatus.Paused     => "⏸",
        ListStatus.Dropped    => "✕",
        _                     => ""
    };

    private static string GetEmptyIcon(ListStatus? s) => s switch
    {
        ListStatus.Watching   => "▶",
        ListStatus.Rewatching => "↻",
        ListStatus.Completed  => "✓",
        ListStatus.Planning   => "☆",
        ListStatus.Paused     => "⏸",
        ListStatus.Dropped    => "✕",
        _                     => "📺"
    };

    private static string GetEmptyTitle(ListStatus? s) => s switch
    {
        null                  => "Your list is empty",
        ListStatus.Watching   => "Nothing currently watching",
        ListStatus.Rewatching => "No rewatches tracked",
        ListStatus.Completed  => "Nothing completed yet",
        ListStatus.Planning   => "Nothing planned yet",
        ListStatus.Paused     => "Nothing on hold",
        ListStatus.Dropped    => "Nothing dropped",
        _                     => "Nothing here"
    };

    private static string GetEmptySub(ListStatus? s) => s switch
    {
        null                  => "Browse anime and tap \"Add to List\"",
        ListStatus.Watching   => "Mark shows you're currently watching",
        ListStatus.Rewatching => "Track your rewatches here",
        ListStatus.Completed  => "Finish something to see it here",
        ListStatus.Planning   => "Save anime you want to watch later",
        ListStatus.Paused     => "Shows you've temporarily put on hold",
        ListStatus.Dropped    => "Shows you decided to stop watching",
        _                     => ""
    };
}
