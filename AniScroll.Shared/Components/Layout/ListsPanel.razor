@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Globalization
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="lists-overlay" @onclick="() => { CloseAllDropdowns(); Close(); }">
        <div class="lists-panel"
             @onclick="CloseAllDropdowns"
             @onclick:stopPropagation="true"
             @onkeydown="OnPanelKeyDown" @onkeydown:stopPropagation="true"
             style="transform: translateY(@(pullOffset.ToString("F1", CultureInfo.InvariantCulture))px);
                                                    transition: @(isPulling ? "none" : "transform 0.32s cubic-bezier(0.25,0.46,0.45,0.94)");">

            <!-- ── Drag handle ──────────────────────────────────── -->
            <div class="lists-handle-zone"
                 @ontouchstart="HandleTouchStart"
                 @ontouchmove="HandleTouchMove"
                 @ontouchend="HandleTouchEnd">
                <div class="lists-handle-bar"></div>
            </div>

            <!-- ── Header ──────────────────────────────────────── -->
            <div class="lists-header">
                <div class="lists-header-left">
                    <h2 class="lists-title">My Lists</h2>
                    @if (UserListService.CountTracked() > 0)
                    {
                        <span class="lists-total-badge">@UserListService.CountTracked()</span>
                    }
                </div>
                <button class="lists-close-btn" @onclick="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- ── Filter bar ──────────────────────────────────── -->
            <div class="lf-bar @(_searchOpen ? "lf-bar-search-mode" : "")" @onclick:stopPropagation="true">

                <!-- [+] Manage lists -->
                <button class="lists-add-btn" @onclick="OpenCustomListManager" title="Manage lists">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>

                <!-- [⇅] Sort & Filter -->
                <button class="lists-add-btn lists-sort-btn @(!_sortOptions.IsDefault ? "lists-sort-btn-active" : "")"
                        @onclick="OpenSortFilter" title="Sort & Filter">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="6" y1="12" x2="18" y2="12" />
                        <line x1="9" y1="18" x2="15" y2="18" />
                    </svg>
                    @if (!_sortOptions.IsDefault && SortFilterCategoryCount > 0)
                    {
                        <span class="lists-sort-badge">@SortFilterCategoryCount</span>
                    }
                </button>

                <!-- [🔍] Expandable search toggle -->
                <div class="lf-search-toggle @(_searchOpen ? "lf-search-open" : "")"
                     @onclick="HandleSearchToggleClick"
                     @onclick:stopPropagation="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input @ref="_searchInputRef"
                           class="lf-search-input"
                           type="text"
                           placeholder="Search your list…"
                           value="@_listSearchQuery"
                           @oninput="HandleListSearchInput"
                           @onblur="HandleSearchInputBlur"
                           @onfocus="HandleSearchInputFocus"
                           @onclick:stopPropagation="true" />
                    @if (!string.IsNullOrEmpty(_listSearchQuery))
                    {
                        <button class="lf-search-clear-btn"
                                @onclick="ClearListSearch"
                                @onclick:stopPropagation="true">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>

                <!-- Status dropdown (shrinks when search open) -->
                <div class="lf-dd lf-dd-status lf-dd-hide-on-search" @onclick:stopPropagation="true">
                    @{
                        string statusTriggerColor = _activeStatusColor;
                        bool statusActive = _selectedStatus.HasValue || _selectedStatusCustomId != null;
                    }
                    <button class="lf-trigger @(statusActive ? "lf-trigger-active" : "")"
                            style="@(statusActive ? $"border-color:{statusTriggerColor}40;color:{statusTriggerColor};" : "")"
                            @onclick="ToggleStatusDropdown">
                        @if (statusActive)
                        {
                            @GlowDot(statusTriggerColor)
                        }
                        <span class="lf-trigger-label">@GetStatusTriggerLabel()</span>
                        <svg class="lf-chevron @(_statusDropdownOpen ? "open" : "")" width="12" height="12"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_statusDropdownOpen)
                    {
                        <div class="lf-dd-menu" @onclick:stopPropagation="true">
                            <button class="lf-dd-option @(!statusActive ? "lf-dd-selected" : "")"
                                    @onclick="() => SelectStatus(null, null)">
                                <span class="lf-dd-dot" style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background: rgba(255, 255, 255, 0.6);box-shadow: 0 0 6px rgba(255,255,255,0.6), 0 0 2px rgba(255,255,255,0.35);"></span>
                                <span class="lf-dd-option-label">All</span>
                                @if (!statusActive)
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                }
                            </button>
                            @{
                                var allStatusItems = UserListService.GetStatusSettings()
                                .Select(s => (isBuiltIn: true, setting: s, custom: (UserCustomList?)null))
                                .Concat(UserListService.GetStatusTypeLists()
                                .Select(c => (isBuiltIn: false, setting: (StatusListSetting?)null, custom: (UserCustomList?)c)))
                                .OrderBy(x => x.isBuiltIn ? x.setting!.Order : x.custom!.Order).ToList();
                            }
                            @foreach (var item in allStatusItems)
                            {
                                @if (item.isBuiltIn)
                                {
                                    var s = item.setting!;
                                    if (!Enum.TryParse<ListStatus>(s.Key, out var ls)) { continue; }
                                    bool isSel = _selectedStatus == ls && _selectedStatusCustomId == null;
                                    <button class="lf-dd-option @(isSel ? "lf-dd-selected" : "")"
                                            style="@(isSel ? $"background:color-mix(in srgb,{s.Color} 10%,transparent);color:{s.Color};" : "")"
                                            @onclick="() => SelectStatus(ls, null)">
                                        @GlowDot(s.Color)
                                        <span class="lf-dd-option-label">@s.DisplayName</span>
                                        @if (isSel)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        }
                                    </button>
                                }
                                else
                                {
                                    var cl = item.custom!;
                                    bool isSel = _selectedStatusCustomId == cl.Id;
                                    <button class="lf-dd-option @(isSel ? "lf-dd-selected" : "")"
                                            style="@(isSel ? $"background:color-mix(in srgb,{cl.Color} 10%,transparent);color:{cl.Color};" : "")"
                                            @onclick="() => SelectStatus(null, cl.Id)">
                                        @GlowDot(cl.Color)
                                        <span class="lf-dd-option-label">@cl.Name</span>
                                        @if (isSel)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Custom Lists dropdown (shrinks when search open) -->
                <div class="lf-dd lf-dd-custom lf-dd-hide-on-search" @onclick:stopPropagation="true">
                    @{
                        var regularLists = UserListService.GetRegularCustomLists();
                        bool customActive = _selectedCustomListIds.Any();
                    }
                    <button class="lf-trigger @(customActive ? "lf-trigger-active" : "")"
                            style="@(customActive ? "border-color:rgba(99,102,241,0.4);color:#818cf8;" : "")"
                            @onclick="ToggleCustomDropdown">
                        <span class="lf-trigger-label">
                            Lists
                            @if (customActive)
                            {
                                <span class="lf-count-badge">@_selectedCustomListIds.Count</span>
                            }
                        </span>
                        <svg class="lf-chevron @(_customDropdownOpen ? "open" : "")" width="12" height="12"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_customDropdownOpen)
                    {
                        <div class="lf-dd-menu lf-dd-menu-right" @onclick:stopPropagation="true">
                            @if (!regularLists.Any())
                            {
                                <div class="lf-dd-empty">No custom lists yet</div>
                            }
                            else
                            {
                                @foreach (var cl in regularLists)
                                {
                                    bool isSel = _selectedCustomListIds.Contains(cl.Id);
                                    <button class="lf-dd-option @(isSel ? "lf-dd-selected" : "")"
                                            style="@(isSel ? $"background:color-mix(in srgb,{cl.Color} 10%,transparent);color:{cl.Color};" : "")"
                                            @onclick="() => ToggleCustomList(cl.Id)">
                                        @GlowDot(cl.Color)
                                        <span class="lf-dd-option-label">@cl.Name</span>
                                        @if (isSel)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        }
                                    </button>
                                }
                            }
                            @if (customActive)
                            {
                                <div class="lf-dd-separator"></div>
                                <button class="lf-dd-clear" @onclick="ClearCustomFilters">Clear filters</button>
                            }
                        </div>
                    }
                </div>

            </div>

            <div class="lists-header-divider"></div>

            <!-- ── Entries ──────────────────────────────────────── -->
            <div class="lists-content" @onclick="CloseAllDropdowns">
                @{
                    var entries = GetFilteredEntries().ToList();
                }

                @if (!entries.Any())
                {
                    <div class="lists-empty">
                        <div class="lists-empty-icon">
                            @((_searchOpen && !string.IsNullOrEmpty(_listSearchQuery)) ? "🔍"
                                                : (_selectedStatus.HasValue || _selectedStatusCustomId != null || _selectedCustomListIds.Any() || !_sortOptions.IsDefault) ? "🔍" : "📺")
                </div>
                <p class="lists-empty-title">
                    @if (_searchOpen && !string.IsNullOrEmpty(_listSearchQuery))
                            {
                                <text>No results for "@_listSearchQuery"</text>
                            }
                            else if (UserListService.CountTracked() == 0)
                            {
                                <text>Your list is empty</text>
                            }
                            else
                            {
                                <text>No results for these filters</text>
                            }
                        </p>
                        <p class="lists-empty-sub">
                            @if (_searchOpen && !string.IsNullOrEmpty(_listSearchQuery))
                            {
                                <text>Try a different title</text>
                            }
                            else if (UserListService.CountTracked() == 0)
                            {
                                <text>Browse anime and tap "Add to List"</text>
                            }
                            else
                            {
                                <text>Try adjusting the filters</text>
                            }
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var entry in entries)
                    {
                        var e = entry;
                        <div class="list-entry" @onclick="() => HandleEntryClick(e)">
                            <div class="entry-poster"
                                 style="background-image: url('@e.Anime.ImageUrl');
                                                                                                    @(!string.IsNullOrEmpty(e.Anime.CoverColor) ? $"background-color:{e.Anime.CoverColor};" : "")">
                            </div>
                            <div class="entry-info">
                                <div class="entry-title">
                                    @e.Anime.Title
                                    @if (UserListService.IsFavorited(e.Anime.Id))
                                    {
                                        <span class="entry-fav-badge" title="Favourited">♥</span>
                                    }
                                </div>

                                @{
                                    bool hasScore = e.Anime.Score != "N/A" && !string.IsNullOrEmpty(e.Anime.Score);
                                    bool hasFormat = !string.IsNullOrEmpty(e.Anime.Format);
                                    bool hasEpisodes = e.Anime.Episodes != "N/A" && !string.IsNullOrEmpty(e.Anime.Episodes);
                                    bool hasMyScore = e.Score > 0;
                                    bool hasAnyMeta = hasScore || hasFormat || hasEpisodes || hasMyScore;
                                }
                                @if (hasAnyMeta)
                                {
                                    <div class="entry-meta">
                                        @if (hasScore)
                                        {
                                            <span class="entry-meta-item">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                </svg>
                                                @e.Anime.Score
                                            </span>
                                        }
                                        @if (hasFormat)
                                        {
                                            @if (hasScore)
                                            {
                                                <span class="entry-meta-sep">·</span>
                                            }
                                            <span class="entry-meta-item">@e.Anime.Format</span>
                                        }
                                        @if (hasEpisodes)
                                        {
                                            @if (hasScore || hasFormat)
                                            {
                                                <span class="entry-meta-sep">·</span>
                                            }
                                            <span class="entry-meta-item">@FormatEpisodeDisplay(e.Anime.Episodes, e.EpisodesWatched)</span>
                                        }
                                        @if (hasMyScore)
                                        {
                                            @if (hasScore || hasFormat || hasEpisodes)
                                            {
                                                <span class="entry-meta-sep">·</span>
                                            }
                                            <span class="entry-meta-item">@e.Score</span>
                                        }
                                    </div>
                                }

                                @if (e.Status.HasValue)
                                {
                                    var sc = GetStatusColor(e.Status.Value);
                                    <div class="entry-status-badge"
                                         style="color:@sc;background:color-mix(in srgb,@(sc) 12%,transparent);border:1px solid color-mix(in srgb,@(sc) 30%,transparent);">
                                        @GetStatusSvgIcon(e.Status.Value) @GetStatusLabel(e.Status.Value)
                                    </div>
                                }
                                @{
                                    var entryCustomLists = UserListService.GetRegularCustomLists()
                                    .Where(cl => e.CustomListIds.Contains(cl.Id)).ToList();
                                }
                                @if (entryCustomLists.Any())
                                {
                                    <div class="entry-custom-tags">
                                        @foreach (var cl in entryCustomLists)
                                        {
                                            <span class="entry-custom-tag"
                                                  style="color:@cl.Color;background:color-mix(in srgb,@(cl.Color) 12%,transparent);border:1px solid color-mix(in srgb,@(cl.Color) 30%,transparent);">
                                                @cl.Name
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <CustomListManager IsVisible="showCustomListManager" OnClose="CloseCustomListManager" />

    <SortFilterPopup IsVisible="_showSortFilter"
                     Current="_sortOptions"
                     AllEntries="GetBaseEntries()"
                     OnClose="() => { _showSortFilter = false; StateHasChanged(); }"
                     OnApply="OnSortFilterApplied"
                     OnRandomPicked="HandleRandomPicked" />
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AnimeCard> OnAnimeSelected { get; set; }

    // ── Search ────────────────────────────────────────────────────────────
    private bool _searchOpen = false;
    private bool _searchBlurPending = false;
    private string _listSearchQuery = string.Empty;
    private ElementReference _searchInputRef;

    private async Task HandleSearchToggleClick()
    {
        _searchOpen = true;
        _searchBlurPending = false;
        CloseAllDropdowns();
        StateHasChanged();
        await Task.Delay(40);
        try { await JS.InvokeVoidAsync("focusElement", _searchInputRef); } catch { }
    }

    private async Task HandleSearchInputBlur()
    {
        _searchBlurPending = true;
        await Task.Delay(150);
        if (_searchBlurPending)
        {
            if (string.IsNullOrEmpty(_listSearchQuery))
            {
                _searchOpen = false;
            }
            _searchBlurPending = false;
            StateHasChanged();
        }
    }

    private void HandleSearchInputFocus()
    {
        _searchBlurPending = false;
        if (!_searchOpen)
        {
            _searchOpen = true;
            StateHasChanged();
        }
    }

    private void HandleListSearchInput(ChangeEventArgs e)
    {
        _listSearchQuery = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private async Task ClearListSearch()
    {
        _searchBlurPending = false;
        _listSearchQuery = string.Empty;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("focusElement", _searchInputRef); } catch { }
    }

    // ── Sort & Filter ─────────────────────────────────────────────────────
    private SortFilterOptions _sortOptions = new();
    private bool _showSortFilter = false;

    private void OpenSortFilter() { CloseAllDropdowns(); _showSortFilter = true; StateHasChanged(); }

    private int SortFilterCategoryCount
    {
        get
        {
            var o = _sortOptions;
            int n = 0;
            if (o.Sort != SortFilterPopup.SortMode.RecentlyUpdated) n++;
            if (o.YearFrom.HasValue || o.YearTo.HasValue) n++;
            if (o.ScoreFrom.HasValue || o.ScoreTo.HasValue) n++;
            if (o.EpFrom.HasValue || o.EpTo.HasValue) n++;
            n += o.AiringStatuses.Count;
            n += o.Formats.Count;
            n += o.Seasons.Count;
            n += o.Genres.Count;
            n += o.Studios.Count;
            n += o.Tags.Count;
            n += o.Sources.Count;
            n += o.Platforms.Count;
            n += o.Countries.Count;
            if (o.Adult.HasValue) n++;
            return n;
        }
    }

    private void OnSortFilterApplied(SortFilterOptions opts) { _sortOptions = opts; StateHasChanged(); }

    private static int ParseEp(string? s)
    {
        if (string.IsNullOrWhiteSpace(s) || s == "N/A") return 0;
        var slash = s.IndexOf('/');
        var part = slash >= 0 ? s[(slash + 1)..] : s;
        if (part.TrimEnd('+', '?', ' ') == "" || part.StartsWith('?')) return int.MaxValue - 1;
        part = part.TrimEnd('+', '?', ' ');
        return int.TryParse(part, out var v) ? v : 0;
    }

    private async Task HandleRandomPicked(AnimeCard anime)
    {
        _showSortFilter = false;
        CloseAllDropdowns();
        await OnAnimeSelected.InvokeAsync(anime);
    }

    // ── Filter state ──────────────────────────────────────────────────────
    private ListStatus? _selectedStatus = null;
    private string? _selectedStatusCustomId = null;
    private HashSet<string> _selectedCustomListIds = new();
    private bool _statusDropdownOpen = false;
    private bool _customDropdownOpen = false;

    private bool showCustomListManager = false;
    private void OpenCustomListManager() { CloseAllDropdowns(); showCustomListManager = true; }
    private void CloseCustomListManager() { showCustomListManager = false; StateHasChanged(); }

    // ── Pull-to-close ─────────────────────────────────────────────────────
    private double pullOffset = 0;
    private double pullStartY = 0;
    private bool isPulling = false;
    private bool isPullActive = false;
    private const double PULL_CLOSE_THRESHOLD = 80;

    protected override void OnInitialized() => UserListService.OnChanged += HandleListChanged;
    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            pullOffset = 0; isPulling = false;
        }
    }
    public void Dispose() => UserListService.OnChanged -= HandleListChanged;
    private void HandleListChanged() => InvokeAsync(StateHasChanged);

    private MarkupString GlowDot(string color) => UiHelpers.GlowDot(color);
    private string GetStatusColor(ListStatus s) => UiHelpers.GetStatusColor(s, UserListService.GetStatusSettings());

    // ── SVG icons for status badges ──────────────────────────────────────
    private MarkupString GetStatusSvgIcon(ListStatus s) => s switch
    {
        ListStatus.Watching => new MarkupString(
            "<svg width=\"11\" height=\"11\" viewBox=\"0 0 512 512\" fill=\"none\" stroke=\"currentColor\" stroke-miterlimit=\"10\" stroke-width=\"32\" style=\"flex-shrink:0;\">" +
            "<path d=\"M112 111v290c0 17.44 17 28.52 31 20.16l247.9-148.37c12.12-7.25 12.12-26.33 0-33.58L143 90.84c-14-8.36-31 2.72-31 20.16z\"/></svg>"),

        ListStatus.Rewatching => new MarkupString(
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" viewBox=\"0 0 232 232\" fill=\"currentColor\" stroke=\"none\" style=\"flex-shrink:0;\">" +
            "<g transform=\"translate(0,232) scale(0.1,-0.1)\">" +
            "<path d=\"M975 2166 c-129 -26 -266 -85 -375 -160 l-65 -46 -5 81 c-5 73 -8 83 -33 105 -47 40 -123 23 -145 -33 -13 -33 -53 -465 -43 -475 6 -7 369 -38 443 -38 62 0 98 33 98 89 0 64 -30 90 -113 101 -38 4 -71 11 -74 13 -8 8 86 73 154 106 392 192 874 22 1063 -374 220 -461 -53 -1013 -552 -1116 -113 -23 -188 -24 -304 -4 -315 55 -579 313 -638 623 -19 98 -47 132 -111 132 -31 0 -81 -43 -88 -75 -11 -60 44 -251 105 -364 103 -191 279 -354 473 -439 147 -64 213 -77 400 -77 147 0 181 3 250 23 288 83 507 264 636 527 76 156 94 238 94 430 0 134 -4 174 -23 245 -91 341 -349 605 -690 706 -73 22 -112 27 -237 30 -101 2 -173 -1 -220 -10z\"/>" +
            "</g>" +
            "</svg>"),

        ListStatus.Completed => new MarkupString(
           "<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0;\">" +
           "<polyline points=\"20 6 9 17 4 12\"/></svg>"),

        ListStatus.Planning => new MarkupString(
            "<svg width=\"10\" height=\"11\" viewBox=\"0 0 512 512\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"32\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0;\">" +
            "<path d=\"M352 48H160a48 48 0 00-48 48v368l144-128 144 128V96a48 48 0 00-48-48z\"/></svg>"),

        ListStatus.Paused => new MarkupString(
            "<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" style=\"flex-shrink:0;\">" +
            "<line x1=\"7\" y1=\"4\" x2=\"7\" y2=\"20\"/>" + "<line x1=\"17\" y1=\"4\" x2=\"17\" y2=\"20\"/></svg>"),

        ListStatus.Dropped => new MarkupString(
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\" style=\"flex-shrink:0;\">" +
            "<line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg>"),

        _ => new MarkupString("")
    };

    private string _activeStatusColor
    {
        get
        {
            if (_selectedStatusCustomId != null)
            {
                var cl = UserListService.GetStatusTypeLists().FirstOrDefault(l => l.Id == _selectedStatusCustomId);
                return cl?.Color ?? "#6366f1";
            }
            if (_selectedStatus.HasValue) return GetStatusColor(_selectedStatus.Value);
            return "#6b7280";
        }
    }

    private string GetStatusTriggerLabel()
    {
        if (_selectedStatusCustomId != null)
        {
            var cl = UserListService.GetStatusTypeLists().FirstOrDefault(l => l.Id == _selectedStatusCustomId);
            return cl?.Name ?? "Status";
        }
        if (_selectedStatus.HasValue)
        {
            var key = _selectedStatus.Value.ToString();
            var setting = UserListService.GetStatusSettings().FirstOrDefault(s => s.Key == key);
            return setting?.DisplayName ?? GetStatusLabel(_selectedStatus.Value);
        }
        return "Status";
    }

    private IEnumerable<UserListEntry> GetBaseEntries() =>
        UserListService.GetAll().Where(e => e.Status.HasValue || e.CustomListIds.Any());

    private IEnumerable<UserListEntry> GetFilteredEntries()
    {
        IEnumerable<UserListEntry> entries = GetBaseEntries();

        if (!string.IsNullOrWhiteSpace(_listSearchQuery))
        {
            var q = _listSearchQuery.Trim();
            entries = entries.Where(e =>
                e.Anime.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(e.Anime.NativeTitle) && e.Anime.NativeTitle.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        if (_selectedStatusCustomId != null)
            entries = entries.Where(e => e.CustomListIds.Contains(_selectedStatusCustomId));
        else if (_selectedStatus.HasValue)
            entries = entries.Where(e => e.Status == _selectedStatus.Value);

        foreach (var id in _selectedCustomListIds)
            entries = entries.Where(e => e.CustomListIds.Contains(id));

        entries = entries.Where(e => SortFilterPopup.PassesFilters(e, _sortOptions));

        entries = _sortOptions.Sort switch
        {
            SortFilterPopup.SortMode.TitleAZ => entries.OrderBy(e => e.Anime.Title, StringComparer.OrdinalIgnoreCase),
            SortFilterPopup.SortMode.TitleZA => entries.OrderByDescending(e => e.Anime.Title, StringComparer.OrdinalIgnoreCase),
            SortFilterPopup.SortMode.MyScoreDesc => entries.OrderByDescending(e => e.Score).ThenBy(e => e.Anime.Title),
            SortFilterPopup.SortMode.MyScoreAsc => entries.OrderBy(e => e.Score == 0 ? double.MaxValue : e.Score).ThenBy(e => e.Anime.Title),
            SortFilterPopup.SortMode.AniListScore => entries.OrderByDescending(e =>
                double.TryParse(e.Anime.Score, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var sc) ? sc : -1d),
            SortFilterPopup.SortMode.AniListScoreAsc => entries.OrderBy(e =>
                double.TryParse(e.Anime.Score, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var sc) ? sc : double.MaxValue),
            SortFilterPopup.SortMode.EpisodesDesc => entries.OrderByDescending(e =>
                { var ep = ParseEp(e.Anime.Episodes); return ep > 0 ? ep : -1; }),
            SortFilterPopup.SortMode.EpisodesAsc => entries.OrderBy(e =>
                { var ep = ParseEp(e.Anime.Episodes); return ep > 0 ? ep : int.MaxValue; }),
            SortFilterPopup.SortMode.YearDesc => entries.OrderByDescending(e => e.Anime.Year ?? 0),
            SortFilterPopup.SortMode.YearAsc => entries.OrderBy(e => e.Anime.Year ?? 9999),
            SortFilterPopup.SortMode.Favourites => entries
                 .Where(e => UserListService.IsFavorited(e.Anime.Id))
                 .OrderByDescending(e => UserListService.GetFavoritedAt(e.Anime.Id)),
            _ => entries.OrderByDescending(e => e.UpdatedAt),
        };

        return entries;
    }

    private void ToggleStatusDropdown()
    {
        _statusDropdownOpen = !_statusDropdownOpen;
        if (_statusDropdownOpen) _customDropdownOpen = false;
        StateHasChanged();
    }
    private void ToggleCustomDropdown()
    {
        _customDropdownOpen = !_customDropdownOpen;
        if (_customDropdownOpen) _statusDropdownOpen = false;
        StateHasChanged();
    }
    private void CloseAllDropdowns() { _statusDropdownOpen = false; _customDropdownOpen = false; StateHasChanged(); }
    private void SelectStatus(ListStatus? status, string? customId)
    {
        _selectedStatus = status; _selectedStatusCustomId = customId;
        _statusDropdownOpen = false; StateHasChanged();
    }
    private void ToggleCustomList(string id) { if (!_selectedCustomListIds.Remove(id)) _selectedCustomListIds.Add(id); StateHasChanged(); }
    private void ClearCustomFilters() { _selectedCustomListIds.Clear(); _customDropdownOpen = false; StateHasChanged(); }

    private void Close() => OnClose.InvokeAsync();
    private async Task OnPanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_showSortFilter)
            await OnClose.InvokeAsync();
    }

    private async Task HandleEntryClick(UserListEntry entry) { CloseAllDropdowns(); await OnAnimeSelected.InvokeAsync(entry.Anime); }

    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        isPullActive = true; isPulling = false; pullStartY = e.Touches[0].ClientY; pullOffset = 0;
    }
    private void HandleTouchMove(TouchEventArgs e)
    {
        if (!isPullActive || e.Touches.Length == 0) return;
        double delta = e.Touches[0].ClientY - pullStartY;
        if (delta <= 0) { isPulling = false; pullOffset = 0; return; }
        isPulling = true;
        pullOffset = delta <= PULL_CLOSE_THRESHOLD ? delta : PULL_CLOSE_THRESHOLD + (delta - PULL_CLOSE_THRESHOLD) * 0.28;
        StateHasChanged();
    }
    private async Task HandleTouchEnd(TouchEventArgs e)
    {
        if (!isPullActive) return;
        isPullActive = false; isPulling = false;
        if (pullOffset >= PULL_CLOSE_THRESHOLD)
        {
            pullOffset = 900; StateHasChanged();
            await Task.Delay(260); pullOffset = 0;
            await OnClose.InvokeAsync();
        }
        else { pullOffset = 0; StateHasChanged(); }
    }

    private string GetStatusLabel(ListStatus s) => UiHelpers.GetStatusLabel(s);

    private static string FormatEpisodeDisplay(string? s, int watched = 0)
    {
        if (string.IsNullOrWhiteSpace(s) || s == "N/A") return "";

        if (s == "?+")
            return watched > 0 ? $"{watched}/?+ EP" : "?+ EP";

        if (s.EndsWith('+'))
        {
            var total = s.TrimEnd('+');
            return watched > 0 ? $"{watched}/{total}+ EP" : $"{s} EP";
        }

        if (s.Contains('/'))
        {
            var total = s[(s.IndexOf('/') + 1)..];
            return watched > 0 ? $"{watched}/{total} EP" : $"{s} EP";
        }

        return watched > 0 ? $"{watched}/{s} EP" : $"{s} EP";
    }
}
