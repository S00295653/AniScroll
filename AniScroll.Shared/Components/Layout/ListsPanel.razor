@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Globalization
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="lists-overlay" @onclick="() => { CloseAllDropdowns(); Close(); }">
        <div class="lists-panel"
             @onclick:stopPropagation="true"
             style="transform: translateY(@(pullOffset.ToString("F1", CultureInfo.InvariantCulture))px);
                    transition: @(isPulling ? "none" : "transform 0.32s cubic-bezier(0.25,0.46,0.45,0.94)");">

            <!-- ── Drag handle ──────────────────────────────────── -->
            <div class="lists-handle-zone"
                 @ontouchstart="HandleTouchStart"
                 @ontouchmove="HandleTouchMove"
                 @ontouchend="HandleTouchEnd">
                <div class="lists-handle-bar"></div>
            </div>

            <!-- ── Header ──────────────────────────────────────── -->
            <div class="lists-header">
                <div class="lists-header-left">
                    <h2 class="lists-title">My Lists</h2>
                    @if (UserListService.Count() > 0)
                    {
                        <span class="lists-total-badge">@UserListService.Count()</span>
                    }
                </div>
                <button class="lists-close-btn" @onclick="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- ── Filter bar ──────────────────────────────────── -->
            <div class="lf-bar" @onclick:stopPropagation="true">

                <!-- [+] Manage lists button -->
                <button class="lists-add-btn"
                        @onclick="OpenCustomListManager"
                        title="Manage lists">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>

                <!-- Status dropdown (single-select) -->
                <div class="lf-dd lf-dd-status">
                    @{
                        string statusTriggerColor = _activeStatusColor;
                        bool statusActive = _selectedStatus.HasValue || _selectedStatusCustomId != null;
                    }
                    <button class="lf-trigger @(statusActive ? "lf-trigger-active" : "")"
                            style="@(statusActive ? $"border-color:{statusTriggerColor}40;color:{statusTriggerColor};" : "")"
                            @onclick="ToggleStatusDropdown">
                        @if (statusActive)
                        {
                            @GlowDot(statusTriggerColor)
                        }
                        <span class="lf-trigger-label">@GetStatusTriggerLabel()</span>
                        <svg class="lf-chevron @(_statusDropdownOpen ? "open" : "")"
                             width="12" height="12" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_statusDropdownOpen)
                    {
                        <div class="lf-dd-menu" @onclick:stopPropagation="true">
                            <!-- All -->
                            <button class="lf-dd-option @(!statusActive ? "lf-dd-selected" : "")"
                                    @onclick="() => SelectStatus(null, null)">
                                <span class="lf-dd-dot" style="background:rgba(255,255,255,0.3);"></span>
                                <span class="lf-dd-option-label">All</span>
                                @if (!statusActive) { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                            </button>

                            <!-- Built-in statuses -->
                            @foreach (var setting in UserListService.GetStatusSettings())
                            {
                                if (!Enum.TryParse<ListStatus>(setting.Key, out var ls)) continue;
                                bool isSel = _selectedStatus == ls && _selectedStatusCustomId == null;
                                <button class="lf-dd-option @(isSel ? "lf-dd-selected" : "")"
                                        style="@(isSel ? $"background:color-mix(in srgb,{setting.Color} 10%,transparent);color:{setting.Color};" : "")"
                                        @onclick="() => SelectStatus(ls, null)">
                                    @GlowDot(setting.Color)
                                    <span class="lf-dd-option-label">@setting.DisplayName</span>
                                    @if (isSel) { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                </button>
                            }

                            <!-- User-created status-type lists -->
                            @{
                                var statusTypeLists = UserListService.GetStatusTypeLists();
                            }
                            @if (statusTypeLists.Any())
                            {
                                <div class="lf-dd-separator"></div>
                                @foreach (var stl in statusTypeLists)
                                {
                                    bool isSel = _selectedStatusCustomId == stl.Id;
                                    <button class="lf-dd-option @(isSel ? "lf-dd-selected" : "")"
                                            style="@(isSel ? $"background:color-mix(in srgb,{stl.Color} 10%,transparent);color:{stl.Color};" : "")"
                                            @onclick="() => SelectStatus(null, stl.Id)">
                                        @GlowDot(stl.Color)
                                        <span class="lf-dd-option-label">@stl.Name</span>
                                        @if (isSel) { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Custom Lists dropdown (multi-select) -->
                <div class="lf-dd lf-dd-custom">
                    @{
                        var regularLists = UserListService.GetRegularCustomLists();
                        bool customActive = _selectedCustomListIds.Any();
                    }
                    <button class="lf-trigger @(customActive ? "lf-trigger-active" : "")"
                            style="@(customActive ? "border-color:rgba(99,102,241,0.4);color:#818cf8;" : "")"
                            @onclick="ToggleCustomDropdown">
                        <span class="lf-trigger-label">
                            Lists
                            @if (customActive)
                            {
                                <span class="lf-count-badge">@_selectedCustomListIds.Count</span>
                            }
                        </span>
                        <svg class="lf-chevron @(_customDropdownOpen ? "open" : "")"
                             width="12" height="12" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_customDropdownOpen)
                    {
                        <div class="lf-dd-menu lf-dd-menu-right" @onclick:stopPropagation="true">
                            @if (!regularLists.Any())
                            {
                                <div class="lf-dd-empty">No custom lists yet</div>
                            }
                            else
                            {
                                @foreach (var cl in regularLists)
                                {
                                    bool isSel = _selectedCustomListIds.Contains(cl.Id);
                                    <button class="lf-dd-option @(isSel ? "lf-dd-selected" : "")"
                                            style="@(isSel ? $"background:color-mix(in srgb,{cl.Color} 10%,transparent);color:{cl.Color};" : "")"
                                            @onclick="() => ToggleCustomList(cl.Id)">
                                        @GlowDot(cl.Color)
                                        <span class="lf-dd-option-label">@cl.Name</span>
                                        @if (isSel)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        }
                                    </button>
                                }
                            }

                            @if (customActive)
                            {
                                <div class="lf-dd-separator"></div>
                                <button class="lf-dd-clear" @onclick="ClearCustomFilters">
                                    Clear filters
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="lists-header-divider"></div>

            <!-- ── Entries ──────────────────────────────────────── -->
            <div class="lists-content" @onclick="CloseAllDropdowns">
                @{
                    var entries = GetFilteredEntries().ToList();
                }

                @if (!entries.Any())
                {
                    <div class="lists-empty">
                        <div class="lists-empty-icon">
                            @((_selectedStatus.HasValue || _selectedStatusCustomId != null || _selectedCustomListIds.Any())
                                ? "🔍" : "📺")
                        </div>
                        <p class="lists-empty-title">
                            @(UserListService.Count() == 0
                                ? "Your list is empty"
                                : "No results for these filters")
                        </p>
                        <p class="lists-empty-sub">
                            @(UserListService.Count() == 0
                                ? "Browse anime and tap \"Add to List\""
                                : "Try adjusting the status or custom list filters")
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var entry in entries)
                    {
                        var e = entry;
                        <div class="list-entry" @onclick="() => HandleEntryClick(e)">

                            <div class="entry-poster"
                                 style="background-image: url('@e.Anime.ImageUrl');
                                        @(!string.IsNullOrEmpty(e.Anime.CoverColor) ? $"background-color:{e.Anime.CoverColor};" : "")">
                            </div>

                            <div class="entry-info">
                                <div class="entry-title">@e.Anime.Title</div>
                                @{
                                    var metaParts = new List<string>();
                                    if (e.Anime.Score != "N/A" && !string.IsNullOrEmpty(e.Anime.Score))
                                        metaParts.Add("★ " + e.Anime.Score);
                                    if (!string.IsNullOrEmpty(e.Anime.Format))
                                        metaParts.Add(e.Anime.Format);
                                    if (e.Anime.Episodes != "N/A" && !string.IsNullOrEmpty(e.Anime.Episodes))
                                        metaParts.Add(e.Anime.Episodes + " EP");
                                    if (e.Score > 0)
                                        metaParts.Add("My score: " + e.Score);
                                }
                                @if (metaParts.Any())
                                {
                                    <div class="entry-meta">@string.Join(" · ", metaParts)</div>
                                }

                                @if (e.Status.HasValue)
                                {
                                    var sc = GetStatusColor(e.Status.Value);
                                    <div class="entry-status-badge"
                                         style="color:@sc;background:color-mix(in srgb,@(sc) 12%,transparent);border:1px solid color-mix(in srgb,@(sc) 30%,transparent);">
                                        @GetStatusIcon(e.Status.Value) @GetStatusLabel(e.Status.Value)
                                    </div>
                                }

                                @{
                                    var entryCustomLists = UserListService.GetRegularCustomLists()
                                        .Where(cl => e.CustomListIds.Contains(cl.Id))
                                        .ToList();
                                }
                                @if (entryCustomLists.Any())
                                {
                                    <div class="entry-custom-tags">
                                        @foreach (var cl in entryCustomLists)
                                        {
                                            <span class="entry-custom-tag"
                                                  style="color:@cl.Color;background:color-mix(in srgb,@(cl.Color) 12%,transparent);border:1px solid color-mix(in srgb,@(cl.Color) 30%,transparent);">
                                                @cl.Name
                                            </span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- delete button removed — click the entry to edit instead -->

                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- CustomListManager outside overlay -->
    <CustomListManager IsVisible="showCustomListManager"
                       OnClose="CloseCustomListManager" />
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AnimeCard> OnAnimeSelected { get; set; }

    // ── Filter state ──────────────────────────────────────────────────────
    private ListStatus?    _selectedStatus         = null;
    private string?        _selectedStatusCustomId = null;
    private HashSet<string> _selectedCustomListIds = new();

    private bool _statusDropdownOpen = false;
    private bool _customDropdownOpen = false;

    private bool showCustomListManager = false;
    private void OpenCustomListManager() { CloseAllDropdowns(); showCustomListManager = true; }
    private void CloseCustomListManager() { showCustomListManager = false; StateHasChanged(); }

    // ── Pull-to-close ─────────────────────────────────────────────────────
    private double pullOffset    = 0;
    private double pullStartY    = 0;
    private bool   isPulling     = false;
    private bool   isPullActive  = false;
    private const double PULL_CLOSE_THRESHOLD = 80;

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UserListService.OnChanged += HandleListChanged;
    }

    protected override void OnParametersSet()
    {
        if (IsVisible) { pullOffset = 0; isPulling = false; }
    }

    public void Dispose() => UserListService.OnChanged -= HandleListChanged;

    private void HandleListChanged() => InvokeAsync(StateHasChanged);

    // ── Helpers ───────────────────────────────────────────────────────────

    private static MarkupString GlowDot(string color)
    {
        var style = $"display:inline-block;width:7px;height:7px;border-radius:50%;flex-shrink:0;" +
                    $"background:{color};box-shadow:0 0 6px {color}99,0 0 2px {color};";
        return new MarkupString($"<span style=\"{style}\"></span>");
    }

    private string GetStatusColor(ListStatus s)
    {
        var key = s.ToString();
        return UserListService.GetStatusSettings().FirstOrDefault(x => x.Key == key)?.Color
               ?? s switch
               {
                   ListStatus.Watching   => "#22c55e",
                   ListStatus.Rewatching => "#06b6d4",
                   ListStatus.Completed  => "#3b82f6",
                   ListStatus.Planning   => "#a855f7",
                   ListStatus.Paused     => "#f97316",
                   ListStatus.Dropped    => "#ef4444",
                   _                     => "#6366f1"
               };
    }

    private string _activeStatusColor
    {
        get
        {
            if (_selectedStatusCustomId != null)
            {
                var cl = UserListService.GetStatusTypeLists().FirstOrDefault(l => l.Id == _selectedStatusCustomId);
                return cl?.Color ?? "#6366f1";
            }
            if (_selectedStatus.HasValue) return GetStatusColor(_selectedStatus.Value);
            return "#6b7280";
        }
    }

    private string GetStatusTriggerLabel()
    {
        if (_selectedStatusCustomId != null)
        {
            var cl = UserListService.GetStatusTypeLists().FirstOrDefault(l => l.Id == _selectedStatusCustomId);
            return cl?.Name ?? "Status";
        }
        if (_selectedStatus.HasValue)
        {
            var key = _selectedStatus.Value.ToString();
            var setting = UserListService.GetStatusSettings().FirstOrDefault(s => s.Key == key);
            return setting?.DisplayName ?? GetStatusLabel(_selectedStatus.Value);
        }
        return "Status";
    }

    // ── Filtering ─────────────────────────────────────────────────────────

    private IEnumerable<UserListEntry> GetFilteredEntries()
    {
        IEnumerable<UserListEntry> entries = UserListService.GetAll()
            .Where(e => e.Status.HasValue || e.CustomListIds.Any());

        if (_selectedStatusCustomId != null)
            entries = entries.Where(e => e.CustomListIds.Contains(_selectedStatusCustomId));
        else if (_selectedStatus.HasValue)
            entries = entries.Where(e => e.Status == _selectedStatus.Value);

        foreach (var id in _selectedCustomListIds)
            entries = entries.Where(e => e.CustomListIds.Contains(id));

        return entries;
    }

    // ── Dropdown interactions ─────────────────────────────────────────────

    private void ToggleStatusDropdown()
    {
        _statusDropdownOpen = !_statusDropdownOpen;
        if (_statusDropdownOpen) _customDropdownOpen = false;
        StateHasChanged();
    }

    private void ToggleCustomDropdown()
    {
        _customDropdownOpen = !_customDropdownOpen;
        if (_customDropdownOpen) _statusDropdownOpen = false;
        StateHasChanged();
    }

    private void CloseAllDropdowns()
    {
        _statusDropdownOpen = false;
        _customDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectStatus(ListStatus? status, string? customId)
    {
        _selectedStatus         = status;
        _selectedStatusCustomId = customId;
        _statusDropdownOpen     = false;
        StateHasChanged();
    }

    private void ToggleCustomList(string id)
    {
        if (!_selectedCustomListIds.Remove(id))
            _selectedCustomListIds.Add(id);
        StateHasChanged();
    }

    private void ClearCustomFilters()
    {
        _selectedCustomListIds.Clear();
        _customDropdownOpen = false;
        StateHasChanged();
    }

    // ── Panel interactions ────────────────────────────────────────────────

    private void Close() => OnClose.InvokeAsync();

    private async Task HandleEntryClick(UserListEntry entry)
    {
        CloseAllDropdowns();
        await OnAnimeSelected.InvokeAsync(entry.Anime);
    }

    // ── Touch gestures ────────────────────────────────────────────────────

    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        isPullActive = true;
        isPulling    = false;
        pullStartY   = e.Touches[0].ClientY;
        pullOffset   = 0;
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        if (!isPullActive || e.Touches.Length == 0) return;
        double delta = e.Touches[0].ClientY - pullStartY;
        if (delta <= 0) { isPulling = false; pullOffset = 0; return; }
        isPulling  = true;
        pullOffset = delta <= PULL_CLOSE_THRESHOLD
            ? delta
            : PULL_CLOSE_THRESHOLD + (delta - PULL_CLOSE_THRESHOLD) * 0.28;
        StateHasChanged();
    }

    private async Task HandleTouchEnd(TouchEventArgs e)
    {
        if (!isPullActive) return;
        isPullActive = false;
        isPulling    = false;

        if (pullOffset >= PULL_CLOSE_THRESHOLD)
        {
            pullOffset = 900;
            StateHasChanged();
            await Task.Delay(260);
            pullOffset = 0;
            await OnClose.InvokeAsync();
        }
        else { pullOffset = 0; StateHasChanged(); }
    }

    // ── Static helpers ────────────────────────────────────────────────────

    private static string GetStatusLabel(ListStatus s) => s switch
    {
        ListStatus.Watching   => "Watching",
        ListStatus.Rewatching => "Rewatching",
        ListStatus.Completed  => "Completed",
        ListStatus.Planning   => "Planning",
        ListStatus.Paused     => "Paused",
        ListStatus.Dropped    => "Dropped",
        _                     => s.ToString()
    };

    private static string GetStatusIcon(ListStatus s) => s switch
    {
        ListStatus.Watching   => "▶",
        ListStatus.Rewatching => "↻",
        ListStatus.Completed  => "✓",
        ListStatus.Planning   => "☆",
        ListStatus.Paused     => "⏸",
        ListStatus.Dropped    => "✕",
        _                     => ""
    };
}
