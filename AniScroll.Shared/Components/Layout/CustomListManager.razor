@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Globalization
@inject UserListService UserListService

@if (IsVisible)
{
    <!--
        @onpointermove / @onpointerup on the overlay so drag tracking
        continues even if the pointer wanders outside the panel.
        Touch events are stopped on the panel to prevent scroll fighting,
        but pointer events are NOT stopped, so they still bubble to the overlay.
    -->
    <div class="clm-overlay"
         @onclick="HandleOverlayClick"
         @onpointermove="HandlePointerMove"
         @onpointerup="HandlePointerUp"
         @onpointercancel="CancelPointerDrag">

        <div class="clm-panel"
             @onclick:stopPropagation="true"
             @ontouchstart:stopPropagation="true"
             @ontouchmove:stopPropagation="true">

            <!-- ── Header ─────────────────────────────────────────── -->
            <div class="clm-header">
                <div class="clm-handle-bar"></div>
                <div class="clm-header-row">
                    <span class="clm-title">My Lists</span>
                    <button class="clm-close-btn" @onclick="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- ── Body ───────────────────────────────────────────── -->
            <div class="clm-body">

                <!-- NEW LIST ROW -->
                <div class="clm2-row clm2-row-new">

                    <div class="clm2-swatch @(string.IsNullOrEmpty(_newColor) ? "clm2-swatch-empty" : "clm2-swatch-filled")"
                         style="@(!string.IsNullOrEmpty(_newColor) ? $"background:{_newColor};" : "")"
                         @onclick:stopPropagation="true"
                         @onclick="e => OpenPicker(-1, _newColor ?? string.Empty,
                                         c => { _newColor = c; StateHasChanged(); },
                                         e.ClientY)">
                        @if (string.IsNullOrEmpty(_newColor))
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        }
                    </div>

                    <input class="clm2-name-input"
                           placeholder="New list name…"
                           value="@_newName"
                           @oninput="e => _newName = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnNewKeyDown"
                           @onclick:stopPropagation="true" />

                    <button class="clm2-add-btn @(CanAdd ? "" : "clm2-add-btn-off")"
                            disabled="@(!CanAdd)"
                            @onclick="AddList"
                            @onclick:stopPropagation="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>

                <!-- LIST ROWS -->
                @for (int i = 0; i < _rows.Count; i++)
                {
                    var ri     = i;
                    var row    = _rows[i];
                    var color  = row.Color;
                    var isDrag = _dragIdx == ri;

                    // Visual Y offset for this row:
                    //   • Dragged row  → follows the pointer (raw px delta from drag start)
                    //   • Other rows   → shift ±ROW_H to make room (only while dragging)
                    double translatePx = isDrag
                        ? (_dragCurrentY - _dragStartY)
                        : GetShiftPx(ri);

                    // Dragged row has no transition so it snaps to the finger.
                    // Other rows animate smoothly when they shift.
                    string rowTransition = (_pointerDragging && isDrag)
                        ? "none"
                        : "transform 0.18s cubic-bezier(0.25,0.46,0.45,0.94)";

                    var cnt = row.IsStatus
                        ? UserListService.Count(ParseStatus(row.Status!.Key))
                        : UserListService.GetCountForCustomList(row.Custom!.Id);

                    <div class="clm2-row @(isDrag ? "clm2-dragging" : "")"
                         style="transform: translateY(@(translatePx.ToString("F1", CultureInfo.InvariantCulture))px);
                                z-index: @(isDrag ? 10 : 1);
                                transition: @rowTransition;
                                user-select: none;
                                -webkit-user-select: none;">

                        <!--
                            Drag handle — touch-action:none prevents the browser from
                            intercepting touch scroll so pointer events fire cleanly.
                        -->
                        <div class="clm2-drag"
                             style="touch-action: none; cursor: grab;"
                             @onpointerdown="e => StartPointerDrag(e, ri)"
                             @onpointerdown:stopPropagation="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <line x1="9"  y1="5"  x2="15" y2="5"></line>
                                <line x1="9"  y1="12" x2="15" y2="12"></line>
                                <line x1="9"  y1="19" x2="15" y2="19"></line>
                            </svg>
                        </div>

                        <!-- Swatch / color picker trigger -->
                        <div class="clm2-swatch clm2-swatch-filled"
                             style="background:@color;"
                             @onclick:stopPropagation="true"
                             @onclick="e => OpenPicker(ri, color,
                                             c => { row.SetColor(c); SaveAll(); StateHasChanged(); },
                                             e.ClientY)">
                        </div>

                        <!-- Editable name -->
                        <input class="clm2-name-input"
                               value="@row.Name"
                               @oninput="e => row.SetName(e.Value?.ToString() ?? row.Name)"
                               @onchange="e => { row.SetName(e.Value?.ToString() ?? row.Name); SaveAll(); }"
                               @onclick:stopPropagation="true" />

                        <!-- Entry count badge -->
                        @if (cnt > 0)
                        {
                            <span class="clm2-count"
                                  style="border-color:@(color)66; color:@color;">
                                @cnt
                            </span>
                        }

                        <!-- Status list → lock icon  |  Custom list → delete button -->
                        @if (row.IsStatus)
                        {
                            <div class="clm2-lock">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                     stroke="rgba(255,255,255,0.2)" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                        }
                        else
                        {
                            <button class="clm2-delete-btn"
                                    @onclick="() => DeleteRow(ri)"
                                    @onclick:stopPropagation="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </button>
                        }
                    </div>
                }

            </div><!-- /clm-body -->
        </div><!-- /clm-panel -->

        <!--
            Color picker — rendered OUTSIDE .clm-panel so nothing clips it.
            Anchored vertically near the swatch that was tapped instead of
            being stuck at the screen center.
        -->
        @if (_pickerOpen && _pickerCallback != null)
        {
            <!-- Invisible full-screen backdrop: tap outside = close -->
            <div class="clm2-picker-backdrop"
                 @onclick="ClosePicker"
                 @onclick:stopPropagation="true"></div>

            <div class="clm2-picker-fixed"
                 style="@GetPickerPositionStyle()"
                 @onclick:stopPropagation="true">
                <div class="clm2-picker-grid">
                    @foreach (var c in _palette)
                    {
                        var cc = c;
                        <button class="clm2-pal-btn @(_pickerCurrentColor == cc ? "clm2-pal-sel" : "")"
                                style="background:@cc;"
                                @onclick="() => PickColor(cc)">
                        </button>
                    }
                </div>
                <input type="color" class="clm2-color-native"
                       value="@(_pickerCurrentColor.Length > 0 ? _pickerCurrentColor : "#6366f1")"
                       @onchange="e => PickColor(e.Value?.ToString() ?? string.Empty)" />
            </div>
        }

    </div><!-- /clm-overlay -->
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // ── Row wrapper ──────────────────────────────────────────────────────
    private class Row
    {
        public bool IsStatus;
        public StatusListSetting? Status;
        public UserCustomList?    Custom;

        public string Color => IsStatus ? (Status!.Color ?? "#6366f1") : (Custom!.Color ?? "#6366f1");
        public string Name  => IsStatus ? Status!.DisplayName           : Custom!.Name;

        public void SetColor(string c) { if (IsStatus) Status!.Color = c; else Custom!.Color = c; }
        public void SetName(string n)  { if (IsStatus) Status!.DisplayName = n; else Custom!.Name = n; }
    }

    private List<Row> _rows = new();

    // ── New list form ────────────────────────────────────────────────────
    private string  _newName  = "";
    private string? _newColor = null;
    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName);

    // ── Color picker ─────────────────────────────────────────────────────
    private bool            _pickerOpen         = false;
    private int             _pickerOpenFor      = -2;   // -2 = closed, -1 = new-row, >=0 = row index
    private string          _pickerCurrentColor = "";
    private Action<string>? _pickerCallback;
    private double          _pickerAnchorY      = 0;    // clientY of the tap that opened the picker

    // ── Pointer drag ─────────────────────────────────────────────────────
    // _dragIdx:    index of the row being dragged (-1 = none)
    // _targetIdx:  where the row will land when released (-1 = none)
    // _dragStartY / _dragCurrentY: raw clientY values used for visual offset
    private bool   _pointerDragging = false;
    private int    _dragIdx         = -1;
    private int    _targetIdx       = -1;
    private double _dragStartY      = 0;
    private double _dragCurrentY    = 0;

    // Must stay in sync with the CSS row height (height + gap/margin of .clm2-row)
    private const int ROW_H = 64;

    // ── Palette ──────────────────────────────────────────────────────────
    private static readonly string[] _palette =
    {
        "#ef4444","#f97316","#f59e0b","#eab308",
        "#84cc16","#22c55e","#10b981","#06b6d4",
        "#3b82f6","#6366f1","#8b5cf6","#a855f7",
        "#ec4899","#f43f5e","#64748b","#78716c"
    };

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnParametersSet()
    {
        if (!IsVisible) return;
        RebuildRows();
        _newName         = "";
        _newColor        = null;
        _pickerOpen      = false;
        _pickerOpenFor   = -2;
        _pickerCallback  = null;
        _pointerDragging = false;
        _dragIdx         = -1;
        _targetIdx       = -1;
    }

    private void RebuildRows()
    {
        _rows = UserListService.GetStatusSettings()
            .Select(s => new Row { IsStatus = true,  Status = s })
            .Concat(UserListService.GetCustomLists()
                .Select(c => new Row { IsStatus = false, Custom = c }))
            .ToList();
    }

    // ── Visual shift ─────────────────────────────────────────────────────
    // Returns the translateY offset (px) a non-dragged row should apply
    // so that the gap for the dragged row opens in the right place.
    //
    //   Dragging DOWN (dragIdx < targetIdx):
    //     rows in (dragIdx, targetIdx]  → shift UP   by -ROW_H
    //   Dragging UP (dragIdx > targetIdx):
    //     rows in [targetIdx, dragIdx)  → shift DOWN by +ROW_H
    private double GetShiftPx(int i)
    {
        if (!_pointerDragging || _dragIdx < 0 || _targetIdx < 0 || i == _dragIdx) return 0;

        if (_dragIdx < _targetIdx && i > _dragIdx && i <= _targetIdx) return -ROW_H;
        if (_dragIdx > _targetIdx && i >= _targetIdx && i < _dragIdx)  return  ROW_H;

        return 0;
    }

    // ── Pointer drag handlers ─────────────────────────────────────────────
    private void StartPointerDrag(PointerEventArgs e, int ri)
    {
        _pointerDragging = true;
        _dragIdx         = ri;
        _targetIdx       = ri;
        _dragStartY      = e.ClientY;
        _dragCurrentY    = e.ClientY;
        StateHasChanged();
    }

    private void HandlePointerMove(PointerEventArgs e)
    {
        if (!_pointerDragging || _dragIdx < 0) return;

        _dragCurrentY = e.ClientY;

        // Compute how many rows the dragged item has moved past.
        // Using the index-relative formula avoids needing absolute panel coords.
        double offsetPx  = _dragCurrentY - _dragStartY;
        int    newTarget = (int)Math.Round(_dragIdx + offsetPx / ROW_H);
        _targetIdx = Math.Clamp(newTarget, 0, _rows.Count - 1);

        StateHasChanged();
    }

    private void HandlePointerUp(PointerEventArgs e)
    {
        if (!_pointerDragging) return;
        CommitPointerDrop();
    }

    private void CancelPointerDrag()
    {
        _pointerDragging = false;
        _dragIdx         = -1;
        _targetIdx       = -1;
        StateHasChanged();
    }

    private void CommitPointerDrop()
    {
        if (_dragIdx >= 0 && _targetIdx >= 0 && _dragIdx != _targetIdx)
        {
            var item = _rows[_dragIdx];
            _rows.RemoveAt(_dragIdx);

            // Adjust insertion index after the removal shifted indices.
            int at = _targetIdx > _dragIdx ? _targetIdx - 1 : _targetIdx;
            at = Math.Clamp(at, 0, _rows.Count);
            _rows.Insert(at, item);

            SaveAll();
        }

        _pointerDragging = false;
        _dragIdx         = -1;
        _targetIdx       = -1;
        StateHasChanged();
    }

    // ── Color picker ─────────────────────────────────────────────────────
    private void OpenPicker(int forIdx, string currentColor, Action<string> callback, double clientY = 0)
    {
        // Second tap on the same swatch closes the picker
        if (_pickerOpenFor == forIdx && _pickerOpen) { ClosePicker(); return; }

        _pickerOpen         = true;
        _pickerOpenFor      = forIdx;
        _pickerCurrentColor = currentColor;
        _pickerCallback     = callback;
        _pickerAnchorY      = clientY;
        StateHasChanged();
    }

    private void PickColor(string color)
    {
        if (string.IsNullOrEmpty(color)) return;
        _pickerCurrentColor = color;
        _pickerCallback?.Invoke(color);
        ClosePicker();
    }

    private void ClosePicker()
    {
        _pickerOpen     = false;
        _pickerOpenFor  = -2;
        _pickerCallback = null;
        StateHasChanged();
    }

    // Positions the picker vertically near the swatch that triggered it.
    // • Preferred: above the tap (so the thumb doesn't hide the picker)
    // • Fallback : below if there isn't enough room above
    // Horizontally the picker stays centred in the viewport.
    private string GetPickerPositionStyle()
    {
        const double pickerH = 230; // approximate rendered height of the picker card
        const double margin  = 10;
        const double minTop  = 60;  // keep it below the status-bar / header

        double top = _pickerAnchorY - pickerH - margin;
        if (top < minTop)
            top = _pickerAnchorY + margin; // not enough room above → show below

        top = Math.Max(minTop, top);

        // Override the CSS class's centered positioning with an anchored one.
        return $"position:fixed; top:{top:F0}px; left:50%; transform:translateX(-50%);";
    }

    // ── Persist ──────────────────────────────────────────────────────────
    private void SaveAll()
    {
        var statusRows = _rows.Where(r => r.IsStatus).Select(r => r.Status!).ToList();
        for (int i = 0; i < statusRows.Count; i++) statusRows[i].Order = i;

        var customRows = _rows.Where(r => !r.IsStatus).Select(r => r.Custom!).ToList();
        for (int i = 0; i < customRows.Count; i++) customRows[i].Order = i;

        UserListService.SaveStatusSettings(statusRows);
        UserListService.SaveCustomLists(customRows);
    }

    // ── Add / Delete ─────────────────────────────────────────────────────
    private void AddList()
    {
        if (!CanAdd) return;
        _rows.Add(new Row
        {
            IsStatus = false,
            Custom   = new UserCustomList
            {
                Id    = Guid.NewGuid().ToString(),
                Name  = _newName.Trim(),
                Color = _newColor ?? "#6366f1",
                Order = _rows.Count
            }
        });
        SaveAll();
        _newName        = "";
        _newColor       = null;
        _pickerOpen     = false;
        _pickerOpenFor  = -2;
        _pickerCallback = null;
        StateHasChanged();
    }

    private void DeleteRow(int idx)
    {
        if (idx < 0 || idx >= _rows.Count || _rows[idx].IsStatus) return;
        _rows.RemoveAt(idx);
        SaveAll();
        StateHasChanged();
    }

    // ── Keyboard ─────────────────────────────────────────────────────────
    private void OnNewKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddList(); }

    // ── Panel close ──────────────────────────────────────────────────────
    private void HandleOverlayClick()
    {
        if (_pickerOpen) { ClosePicker(); return; }
        _ = Close();
    }

    private async Task Close() { ClosePicker(); await OnClose.InvokeAsync(); }

    // ── Status key ───────────────────────────────────────────────────────
    private static ListStatus? ParseStatus(string key) => key switch
    {
        "Watching"   => ListStatus.Watching,
        "Rewatching" => ListStatus.Rewatching,
        "Completed"  => ListStatus.Completed,
        "Planning"   => ListStatus.Planning,
        "Paused"     => ListStatus.Paused,
        "Dropped"    => ListStatus.Dropped,
        _            => null
    };
}
