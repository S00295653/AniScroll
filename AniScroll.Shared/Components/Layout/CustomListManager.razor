@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Globalization
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="clm-overlay" @onclick="HandleOverlayClick">

        <div class="clm-panel"
             @ref="_panelRef"
             @onclick:stopPropagation="true"
             @ontouchstart:stopPropagation="true"
             @ontouchmove:stopPropagation="true">

            <!-- ── Header ──────────────────────────────────────────── -->
            <div class="clm-header">
                <div class="clm-handle-bar"></div>
                <div class="clm-header-row">
                    <span class="clm-title">My Lists</span>
                    <button class="clm-close-btn" @onclick="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- ── Body ───────────────────────────────────────────── -->
            <div class="clm-body">

                <!-- NEW LIST ROW -->
                <div class="clm2-row clm2-row-new">

                    <!-- Swatch for the new-list row — uses its own ref -->
                    <div class="clm2-swatch @(string.IsNullOrEmpty(_newColor) ? "clm2-swatch-empty" : "clm2-swatch-filled")"
                         style="@(!string.IsNullOrEmpty(_newColor) ? $"background:{_newColor};" : "")"
                         @ref="_newSwatchRef"
                         @onclick:stopPropagation="true"
                         @onclick="OpenPickerForNewRow">
                        @if (string.IsNullOrEmpty(_newColor))
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        }
                    </div>

                    <input class="clm2-name-input"
                           placeholder="New list name…"
                           value="@_newName"
                           @oninput="e => _newName = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnNewKeyDown"
                           @onclick:stopPropagation="true" />

                    <button class="clm2-add-btn @(CanAdd ? "" : "clm2-add-btn-off")"
                            disabled="@(!CanAdd)"
                            @onclick="AddList"
                            @onclick:stopPropagation="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>

                <!-- LIST ROWS — data-row-index lets JS identify each row during drag -->
                @for (int i = 0; i < _rows.Count; i++)
                {
                    var ri    = i;
                    var row   = _rows[i];
                    var color = row.Color;

                    var cnt = row.IsStatus
                        ? UserListService.Count(ParseStatus(row.Status!.Key))
                        : UserListService.GetCountForCustomList(row.Custom!.Id);

                    <div class="clm2-row" data-row-index="@ri">

                        <!-- Drag handle: touch-action:none prevents browser scroll stealing -->
                        <div class="clm2-drag"
                             style="touch-action:none; cursor:grab;"
                             @ref="_handleRefs[ri]"
                             @onpointerdown="e => OnHandlePointerDown(e, ri)"
                             @onpointerdown:stopPropagation="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <line x1="9"  y1="5"  x2="15" y2="5"></line>
                                <line x1="9"  y1="12" x2="15" y2="12"></line>
                                <line x1="9"  y1="19" x2="15" y2="19"></line>
                            </svg>
                        </div>

                        <!-- Swatch: click opens jscolorpicker anchored to this element -->
                        <div class="clm2-swatch clm2-swatch-filled"
                             style="background:@color;"
                             @ref="_swatchRefs[ri]"
                             @onclick:stopPropagation="true"
                             @onclick="() => OpenPickerForRow(ri, color,
                                           c => { row.SetColor(c); SaveAll(); StateHasChanged(); })">
                        </div>

                        <input class="clm2-name-input"
                               value="@row.Name"
                               @oninput="e => row.SetName(e.Value?.ToString() ?? row.Name)"
                               @onchange="e => { row.SetName(e.Value?.ToString() ?? row.Name); SaveAll(); }"
                               @onclick:stopPropagation="true" />

                        @if (cnt > 0)
                        {
                            <span class="clm2-count"
                                  style="border-color:@(color)66; color:@color;">@cnt</span>
                        }

                        @if (row.IsStatus)
                        {
                            <div class="clm2-lock">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                     stroke="rgba(255,255,255,0.2)" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                        }
                        else
                        {
                            <button class="clm2-delete-btn"
                                    @onclick="() => DeleteRow(ri)"
                                    @onclick:stopPropagation="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </button>
                        }
                    </div>
                }

            </div><!-- /clm-body -->
        </div><!-- /clm-panel -->
    </div><!-- /clm-overlay -->
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // ── Row wrapper ──────────────────────────────────────────────────────
    private class Row
    {
        public bool IsStatus;
        public StatusListSetting? Status;
        public UserCustomList?    Custom;

        public string Color => IsStatus ? (Status!.Color ?? "#6366f1") : (Custom!.Color ?? "#6366f1");
        public string Name  => IsStatus ? Status!.DisplayName           : Custom!.Name;

        public void SetColor(string c) { if (IsStatus) Status!.Color = c; else Custom!.Color = c; }
        public void SetName(string n)  { if (IsStatus) Status!.DisplayName = n; else Custom!.Name = n; }
    }

    private List<Row> _rows = new();

    // Element refs
    private ElementReference   _panelRef;
    private ElementReference   _newSwatchRef;
    private ElementReference[] _swatchRefs  = new ElementReference[64];
    private ElementReference[] _handleRefs  = new ElementReference[64];

    // DotNet ref passed to JS for callbacks
    private DotNetObjectReference<CustomListManager>? _dotNetRef;

    // ── New list form ────────────────────────────────────────────────────
    private string  _newName  = "";
    private string? _newColor = null;
    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName);

    // Pending color-picker callback (whichever swatch was clicked last)
    private Action<string>? _pendingColorCallback;

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override void OnParametersSet()
    {
        if (!IsVisible) return;
        RebuildRows();
        _newName  = "";
        _newColor = null;
    }

    public void Dispose() => _dotNetRef?.Dispose();

    private void RebuildRows()
    {
        _rows = UserListService.GetStatusSettings()
            .Select(s => new Row { IsStatus = true,  Status = s })
            .Concat(UserListService.GetCustomLists()
                .Select(c => new Row { IsStatus = false, Custom = c }))
            .ToList();
    }

    // ── Drag — entirely driven by JS ─────────────────────────────────────
    private async Task OnHandlePointerDown(PointerEventArgs e, int rowIndex)
    {
        try
        {
            // startRowDrag sets up all pointer listeners and animates the rows.
            // On pointerup it calls OnDragComplete once via DotNet interop.
            await JS.InvokeVoidAsync(
                "startRowDrag",
                _dotNetRef,
                _panelRef,
                e.PointerId,
                rowIndex,
                ROW_H);
        }
        catch { }
    }

    // Called by JS after the user releases the dragged row.
    // fromIndex = original position, toIndex = desired final position.
    [JSInvokable]
    public void OnDragComplete(int fromIndex, int toIndex)
    {
        if (fromIndex == toIndex
            || fromIndex < 0 || toIndex < 0
            || fromIndex >= _rows.Count || toIndex >= _rows.Count)
        {
            StateHasChanged();
            return;
        }

        var item = _rows[fromIndex];
        _rows.RemoveAt(fromIndex);

        // toIndex is the FINAL position we want the item at.
        // After removing it, the array shifts by -1 for indices > fromIndex,
        // so the effective insertion point is simply toIndex (clamped).
        //
        // Example: rows=[A,B,C,D], move A(0) → pos 1
        //   Remove A → [B,C,D], insert at 1 → [B,A,C,D] ✓
        //
        // Example: rows=[A,B,C,D], move D(3) → pos 1
        //   Remove D → [A,B,C], insert at 1 → [A,D,B,C] ✓
        int at = Math.Clamp(toIndex, 0, _rows.Count);
        _rows.Insert(at, item);

        SaveAll();
        StateHasChanged();
    }

    private const int ROW_H = 64; // keep in sync with CSS

    // ── Color picker (jscolorpicker.com, driven by JS) ───────────────────

    // New-row swatch
    private async Task OpenPickerForNewRow()
    {
        _pendingColorCallback = c =>
        {
            _newColor = c;
            StateHasChanged();
        };
        await ShowPicker(_newSwatchRef, _newColor ?? "#6366f1");
    }

    // Existing-row swatch
    private async Task OpenPickerForRow(int ri, string currentColor, Action<string> callback)
    {
        _pendingColorCallback = callback;
        await ShowPicker(_swatchRefs[ri], currentColor);
    }

    private async Task ShowPicker(ElementReference anchorRef, string currentColor)
    {
        try
        {
            // showClmColorPicker opens the jscolorpicker dialog anchored to anchorRef,
            // waits for the user to pick (prompt() promise), then calls OnColorSelected.
            await JS.InvokeVoidAsync(
                "showClmColorPicker",
                anchorRef,
                currentColor,
                _dotNetRef);
        }
        catch { }
    }

    // Called by JS when the user confirms a color in the picker.
    [JSInvokable]
    public void OnColorSelected(string hexColor)
    {
        _pendingColorCallback?.Invoke(hexColor);
        _pendingColorCallback = null;
        StateHasChanged();
    }

    // ── Persist ──────────────────────────────────────────────────────────
    private void SaveAll()
    {
        var statusRows = _rows.Where(r => r.IsStatus).Select(r => r.Status!).ToList();
        for (int i = 0; i < statusRows.Count; i++) statusRows[i].Order = i;

        var customRows = _rows.Where(r => !r.IsStatus).Select(r => r.Custom!).ToList();
        for (int i = 0; i < customRows.Count; i++) customRows[i].Order = i;

        UserListService.SaveStatusSettings(statusRows);
        UserListService.SaveCustomLists(customRows);
    }

    // ── Add / Delete ─────────────────────────────────────────────────────
    private void AddList()
    {
        if (!CanAdd) return;
        _rows.Add(new Row
        {
            IsStatus = false,
            Custom   = new UserCustomList
            {
                Id    = Guid.NewGuid().ToString(),
                Name  = _newName.Trim(),
                Color = _newColor ?? "#6366f1",
                Order = _rows.Count
            }
        });
        SaveAll();
        _newName  = "";
        _newColor = null;
        StateHasChanged();
    }

    private void DeleteRow(int idx)
    {
        if (idx < 0 || idx >= _rows.Count || _rows[idx].IsStatus) return;
        _rows.RemoveAt(idx);
        SaveAll();
        StateHasChanged();
    }

    // ── Keyboard ─────────────────────────────────────────────────────────
    private void OnNewKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddList(); }

    // ── Panel close ──────────────────────────────────────────────────────
    private void HandleOverlayClick() => _ = Close();
    private async Task Close() => await OnClose.InvokeAsync();

    // ── Status parser ─────────────────────────────────────────────────────
    private static ListStatus? ParseStatus(string key) => key switch
    {
        "Watching"   => ListStatus.Watching,
        "Rewatching" => ListStatus.Rewatching,
        "Completed"  => ListStatus.Completed,
        "Planning"   => ListStatus.Planning,
        "Paused"     => ListStatus.Paused,
        "Dropped"    => ListStatus.Dropped,
        _            => null
    };
}
