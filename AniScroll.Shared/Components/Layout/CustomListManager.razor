@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using System.Globalization
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="clm-overlay"
         @onclick="HandleOverlayClick">

        <div class="clm-panel"
             @onclick:stopPropagation="true"
             @onpointerdown:stopPropagation="true"
             @onpointerdown="() => _pointerDownOnPanel = true"
             @onpointerup:stopPropagation="true">

            <!-- ── Header ──────────────────────────────────────────── -->
            <div class="clm-header">
                <div class="clm-handle-bar"></div>
                <div class="clm-header-row">
                    <span class="clm-title">My Lists</span>
                    <button class="clm-close-btn" @onclick="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <!-- ── Tab buttons ── -->
                <div class="clm-tab-bar">
                    <div class="clm-tab-slider" style="transform: translateX(@(_activeTab == "custom" ? "100%" : "0%"))"></div>
                    <button class="clm-tab-btn @(_activeTab == "status" ? "clm-tab-active" : "")"
                            @onclick='() => SwitchTab("status")'
                            @onclick:stopPropagation="true">
                        Status
                    </button>
                    <button class="clm-tab-btn @(_activeTab == "custom" ? "clm-tab-active" : "")"
                            @onclick='() => SwitchTab("custom")'
                            @onclick:stopPropagation="true">
                        Custom Lists
                    </button>
                </div>
            </div>

            <!-- ── Body (scrollable rows only, no new-row) ────────── -->
            <div class="clm-body" @ref="_bodyRef">

                @if (_activeTab == "status")
                {
                    @for (int i = 0; i < _statusRows.Count; i++)
                    {
                        var ri = i;
                        var row = _statusRows[i];
                        var color = row.Color;
                        var cnt = row.IsBuiltIn
                        ? UserListService.Count(ParseStatus(row.Status!.Key))
                        : UserListService.GetCountForCustomList(row.Custom!.Id);

                        <div class="clm2-row" data-row-index="@ri">
                            <div class="clm2-drag"
                                 style="touch-action:none; cursor:grab;"
                                 @onpointerdown="e => OnHandlePointerDown(e, ri)"
                                 @onpointerdown:stopPropagation="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <!-- Left column -->
                                    <circle cx="9" cy="6" r="1.6" fill="currentColor" />
                                    <circle cx="9" cy="12" r="1.6" fill="currentColor" />
                                    <circle cx="9" cy="18" r="1.6" fill="currentColor" />
                                    <!-- Right column -->
                                    <circle cx="15" cy="6" r="1.6" fill="currentColor" />
                                    <circle cx="15" cy="12" r="1.6" fill="currentColor" />
                                    <circle cx="15" cy="18" r="1.6" fill="currentColor" />
                                </svg>
                            </div>

                            <div class="clm2-swatch clm2-swatch-filled"
                                 style="background:@color;"
                                 @ref="_statusSwatchRefs[ri]"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => OpenPickerForRow(ri, color, true,
                                 c => { row.SetColor(c); SaveAll(); StateHasChanged(); })">
                </div>

                <input class="clm2-name-input"
                       value="@row.Name"
                       readonly="@row.IsBuiltIn"
                       style="@(row.IsBuiltIn ? "opacity:0.7;cursor:default;" : "")"
                       @oninput="e => { if (!row.IsBuiltIn) row.SetName(e.Value?.ToString() ?? row.Name); }"
                       @onchange="e => { if (!row.IsBuiltIn) { row.SetName(e.Value?.ToString() ?? row.Name); SaveAll(); } }"
                       @onclick:stopPropagation="true" />

                @if (cnt > 0)
                        {
                            <span class="clm2-count"
                                  style="border-color:@(color)66; color:@color;">@cnt</span>
                        }

                        @if (row.IsBuiltIn)
                        {
                            <div class="clm2-lock">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                     stroke="rgba(255,255,255,0.2)" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                        }
                        else
                        {
                            <button class="clm2-delete-btn"
                                    @onclick="() => ShowDeleteConfirm(ri, true)"
                                    @onclick:stopPropagation="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <!-- CUSTOM LIST ROWS -->
                @if (!_customRows.Any())
                {
                    <div class="clm-empty-hint">No custom lists yet. Create one below!</div>
                }

                @for (int i = 0; i < _customRows.Count; i++)
                {
                    var ri = i;
                    var row = _customRows[i];
                    var color = row.Color;
                    var cnt = UserListService.GetCountForCustomList(row.Custom!.Id);

                    <div class="clm2-row" data-row-index="@ri">
                        <div class="clm2-drag"
                             style="touch-action:none; cursor:grab;"
                             @onpointerdown="e => OnHandlePointerDown(e, ri)"
                             @onpointerdown:stopPropagation="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Left column -->
                                <circle cx="9" cy="6" r="1.6" fill="currentColor" />
                                <circle cx="9" cy="12" r="1.6" fill="currentColor" />
                                <circle cx="9" cy="18" r="1.6" fill="currentColor" />
                                <!-- Right column -->
                                <circle cx="15" cy="6" r="1.6" fill="currentColor" />
                                <circle cx="15" cy="12" r="1.6" fill="currentColor" />
                                <circle cx="15" cy="18" r="1.6" fill="currentColor" />
                            </svg>
                        </div>

                        <div class="clm2-swatch clm2-swatch-filled"
                             style="background:@color;"
                             @ref="_customSwatchRefs[ri]"
                             @onclick:stopPropagation="true"
                             @onclick="() => OpenPickerForRow(ri, color, false,
                             c => { row.SetColor(c); SaveAll(); StateHasChanged(); })">
                </div>

                <input class="clm2-name-input"
                       value="@row.Name"
                       @oninput="e => row.SetName(e.Value?.ToString() ?? row.Name)"
                       @onchange="e => { row.SetName(e.Value?.ToString() ?? row.Name); SaveAll(); }"
                       @onclick:stopPropagation="true" />

                @if (cnt > 0)
                    {
                        <span class="clm2-count"
                              style="border-color:@(color)66; color:@color;">@cnt</span>
                    }

                    <button class="clm2-delete-btn"
                            @onclick="() => ShowDeleteConfirm(ri, false)"
                            @onclick:stopPropagation="true">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6l-1 14H6L5 6"></path>
                            <path d="M10 11v6M14 11v6"></path>
                            <path d="M9 6V4h6v2"></path>
                        </svg>
                    </button>
                </div>
            }
                        }

        </div><!-- /clm-body -->
        <!-- ── Footer: new-row always visible, never scrolls away ── -->
        <div class="clm-footer">
            @if (_activeTab == "status")
            {
                <div class="clm2-row clm2-row-new">
                    <div class="clm2-swatch @(string.IsNullOrEmpty(_newColor) ? "clm2-swatch-empty" : "clm2-swatch-filled")"
                         style="@(!string.IsNullOrEmpty(_newColor) ? $"background:{_newColor};" : "")"
                         @ref="_newStatusSwatchRef"
                         @onclick:stopPropagation="true"
                         @onclick="OpenPickerForNewRow">
                        @if (string.IsNullOrEmpty(_newColor))
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        }
                    </div>

                    <input class="clm2-name-input"
                           placeholder="New status name…"
                           value="@_newName"
                           @oninput="e => { _newName = e.Value?.ToString() ?? string.Empty; StateHasChanged(); }"
                           @onkeydown="OnNewKeyDown"
                           @onclick:stopPropagation="true" />

                    <button class="clm2-add-btn @(CanAdd ? "" : "clm2-add-btn-off")"
                            disabled="@(!CanAdd)"
                            @onclick="AddList"
                            @onclick:stopPropagation="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>
            }
            else
            {
                <div class="clm2-row clm2-row-new">
                    <div class="clm2-swatch @(string.IsNullOrEmpty(_newColor) ? "clm2-swatch-empty" : "clm2-swatch-filled")"
                         style="@(!string.IsNullOrEmpty(_newColor) ? $"background:{_newColor};" : "")"
                         @ref="_newCustomSwatchRef"
                         @onclick:stopPropagation="true"
                         @onclick="OpenPickerForNewRow">
                        @if (string.IsNullOrEmpty(_newColor))
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        }
                    </div>

                    <input class="clm2-name-input"
                           placeholder="New list name…"
                           value="@_newName"
                           @oninput="e => { _newName = e.Value?.ToString() ?? string.Empty; StateHasChanged(); }"
                           @onkeydown="OnNewKeyDown"
                           @onclick:stopPropagation="true" />

                    <button class="clm2-add-btn @(CanAdd ? "" : "clm2-add-btn-off")"
                            disabled="@(!CanAdd)"
                            @onclick="AddList"
                            @onclick:stopPropagation="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>
            }
        </div><!-- /clm-footer -->

    </div><!-- /clm-panel -->
</div>

<!-- /clm-overlay -->
<!-- ── Delete confirmation dialog ─────────────────────────────── -->
@if (_confirmDeleteVisible)
{
    <div class="delete-confirm-overlay" @onclick="CancelDelete">
        <div class="delete-confirm-box" @onclick:stopPropagation="true">
            <div class="delete-confirm-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v6M14 11v6"></path>
                    <path d="M9 6V4h6v2"></path>
                </svg>
            </div>
            <div class="delete-confirm-title">Delete "@_confirmDeleteName"?</div>
            <div class="delete-confirm-text">
                This list will be permanently deleted and cannot be restored.
            </div>
            <div class="delete-confirm-btns">
                <button class="delete-confirm-cancel" @onclick="CancelDelete">Cancel</button>
                <button class="delete-confirm-delete" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

<!-- Color picker outside overlay so its clicks don't bubble -->
<ColorPickerPopup IsVisible="_pickerOpen"
                  InitialColor="@_pickerInitColor"
                  AnchorRef="_pickerAnchor"
                  OnColorChanged="OnPickerColorChanged"
                  OnClose="CloseColorPicker" />
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _pointerDownOnPanel;

    // ── Row wrapper ──────────────────────────────────────────────────────
    private class Row
    {
        public bool IsBuiltIn;
        public StatusListSetting? Status;
        public UserCustomList? Custom;

        public string Color => IsBuiltIn ? (Status?.Color ?? "#6366f1") : (Custom?.Color ?? "#6366f1");
        public string Name => IsBuiltIn ? (Status?.DisplayName ?? "") : (Custom?.Name ?? "");

        public void SetColor(string c)
        {
            if (IsBuiltIn) { if (Status != null) Status.Color = c; }
            else { if (Custom != null) Custom.Color = c; }
        }
        public void SetName(string n)
        {
            if (IsBuiltIn) { if (Status != null) Status.DisplayName = n; }
            else { if (Custom != null) Custom.Name = n; }
        }
    }

    private string _activeTab = "status";
    private List<Row> _statusRows = new();
    private List<Row> _customRows = new();

    // Element refs
    private ElementReference _panelRef;
    private ElementReference _bodyRef;

    private ElementReference _newStatusSwatchRef;
    private ElementReference _newCustomSwatchRef;
    private ElementReference[] _statusSwatchRefs = new ElementReference[64];
    private ElementReference[] _customSwatchRefs = new ElementReference[64];

    private DotNetObjectReference<CustomListManager>? _dotNetRef;

    // ── New list form ────────────────────────────────────────────────────
    private string _newName = "";
    private string? _newColor = null;
    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName);

    // ── Color picker state ───────────────────────────────────────────────
    private bool _pickerOpen = false;
    private string _pickerInitColor = "#6366f1";
    private ElementReference _pickerAnchor;
    private Action<string>? _pickerCallback;

    // ── Delete confirmation state ────────────────────────────────────────
    private bool _confirmDeleteVisible = false;
    private int _confirmDeleteIndex = -1;
    private bool _confirmDeleteIsStatus = false;
    private string _confirmDeleteName = "";

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private bool _prevIsVisible = false;

    protected override void OnParametersSet()
    {
        bool justOpened = IsVisible && !_prevIsVisible;
        _prevIsVisible = IsVisible;
        if (!justOpened) return;

        RebuildRows();
        _newName = "";
        _newColor = null;
        _confirmDeleteVisible = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible)
        {
            try { await JS.InvokeVoidAsync("preventWheelScroll", _panelRef); } catch { }
        }
        else
        {
            try { await JS.InvokeVoidAsync("removeWheelScrollPrevention", _panelRef); } catch { }
        }
    }

    public void Dispose() => _dotNetRef?.Dispose();

    // ── RebuildRows ───────────────────────────────────────────────────────
    private void RebuildRows()
    {
        _statusRows = UserListService.GetStatusSettings()
            .Select(s => new Row { IsBuiltIn = true, Status = s })
            .Concat(UserListService.GetStatusTypeLists()
                .Select(c => new Row { IsBuiltIn = false, Custom = c }))
            .OrderBy(r => r.IsBuiltIn ? r.Status!.Order : r.Custom!.Order)
            .ToList();

        _customRows = UserListService.GetRegularCustomLists()
            .Select(c => new Row { IsBuiltIn = false, Custom = c })
            .ToList();
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;
        _newName = "";
        _newColor = null;
        CloseColorPicker();
        StateHasChanged();
    }

    // ── Drag ─────────────────────────────────────────────────────────────
    private async Task OnHandlePointerDown(PointerEventArgs e, int rowIndex)
    {
        try
        {
            await JS.InvokeVoidAsync(
                "startRowDrag",
                _dotNetRef,
                _panelRef,
                _bodyRef,
                e.PointerId,
                rowIndex,
                e.ClientY);
        }
        catch { }
    }

    [JSInvokable]
    public void OnDragComplete(int fromIndex, int toIndex)
    {
        var activeRows = _activeTab == "status" ? _statusRows : _customRows;

        if (fromIndex < 0 || toIndex < 0
            || fromIndex >= activeRows.Count
            || toIndex > activeRows.Count
            || fromIndex == toIndex)
        {
            InvokeAsync(StateHasChanged);
            return;
        }

        var item = activeRows[fromIndex];
        activeRows.RemoveAt(fromIndex);
        activeRows.Insert(Math.Clamp(toIndex, 0, activeRows.Count), item);

        SaveAll();
        InvokeAsync(StateHasChanged);
    }

    // ── Color picker ─────────────────────────────────────────────────────
    private void OpenPickerForNewRow()
    {
        _pickerAnchor = _activeTab == "status" ? _newStatusSwatchRef : _newCustomSwatchRef;
        _pickerInitColor = _newColor ?? "#6366f1";
        _pickerCallback = c => { _newColor = c; StateHasChanged(); };
        _pickerOpen = true;
        StateHasChanged();
    }

    private void OpenPickerForRow(int ri, string currentColor, bool isStatusTab, Action<string> callback)
    {
        _pickerAnchor = isStatusTab ? _statusSwatchRefs[ri] : _customSwatchRefs[ri];
        _pickerInitColor = currentColor;
        _pickerCallback = callback;
        _pickerOpen = true;
        StateHasChanged();
    }

    private void OnPickerColorChanged(string hex) => _pickerCallback?.Invoke(hex);

    private void CloseColorPicker()
    {
        _pickerOpen = false;
        _pickerCallback = null;
        StateHasChanged();
    }

    // ── Persist ───────────────────────────────────────────────────────────
    private void SaveAll()
    {
        var statusSettings = new List<StatusListSetting>();
        var statusTypeCustom = new List<UserCustomList>();

        for (int i = 0; i < _statusRows.Count; i++)
        {
            var row = _statusRows[i];
            if (row.IsBuiltIn)
            {
                row.Status!.Order = i;
                statusSettings.Add(row.Status);
            }
            else
            {
                row.Custom!.Order = i;
                row.Custom.IsStatusList = true;
                statusTypeCustom.Add(row.Custom);
            }
        }

        UserListService.SaveStatusSettings(statusSettings);

        var regularCustom = _customRows.Select(r => r.Custom!).ToList();
        int rcOrder = 0;
        foreach (var c in regularCustom) { c.Order = rcOrder++; c.IsStatusList = false; }

        UserListService.SaveCustomLists(statusTypeCustom.Concat(regularCustom).ToList());
    }

    // ── Add / Delete ─────────────────────────────────────────────────────
    private async Task AddList()
    {
        if (!CanAdd) return;

        string color = _newColor ?? await GetRandomColorAsync();

        var newItem = new UserCustomList
        {
            Id = Guid.NewGuid().ToString(),
            Name = _newName.Trim(),
            Color = color,
            IsStatusList = _activeTab == "status",
            Order = _activeTab == "status" ? _statusRows.Count : _customRows.Count
        };

        if (_activeTab == "status")
            _statusRows.Add(new Row { IsBuiltIn = false, Custom = newItem });
        else
            _customRows.Add(new Row { IsBuiltIn = false, Custom = newItem });

        SaveAll();
        _newName = "";
        _newColor = null;
        StateHasChanged();
    }

    private async Task<string> GetRandomColorAsync()
    {
        try { return await JS.InvokeAsync<string>("cpRandomSwatchColor"); }
        catch { return "#6366f1"; }
    }

    private void ShowDeleteConfirm(int idx, bool isStatus)
    {
        _confirmDeleteIndex = idx;
        _confirmDeleteIsStatus = isStatus;
        _confirmDeleteName = isStatus
            ? (_statusRows.ElementAtOrDefault(idx)?.Name ?? "")
            : (_customRows.ElementAtOrDefault(idx)?.Name ?? "");
        _confirmDeleteVisible = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _confirmDeleteVisible = false;
        StateHasChanged();
    }

    private void ConfirmDelete()
    {
        _confirmDeleteVisible = false;
        if (_confirmDeleteIsStatus)
            DeleteStatusRow(_confirmDeleteIndex);
        else
            DeleteCustomRow(_confirmDeleteIndex);
    }

    private void DeleteStatusRow(int idx)
    {
        if (idx < 0 || idx >= _statusRows.Count || _statusRows[idx].IsBuiltIn) return;
        _statusRows.RemoveAt(idx);
        SaveAll();
        StateHasChanged();
    }

    private void DeleteCustomRow(int idx)
    {
        if (idx < 0 || idx >= _customRows.Count) return;
        _customRows.RemoveAt(idx);
        SaveAll();
        StateHasChanged();
    }

    // ── Keyboard ─────────────────────────────────────────────────────────
    private void OnNewKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") _ = AddList(); }

    // ── Panel close ──────────────────────────────────────────────────────
    // Called when clicking the overlay backdrop. Since @onclick:stopPropagation
    // is set on .clm-panel, clicks inside never reach here — no pointer tracking needed.
    private void HandleOverlayClick()
    {
        if (_confirmDeleteVisible) { CancelDelete(); return; }
        if (_pickerOpen) { CloseColorPicker(); return; }
        _ = Close();
    }

    private async Task Close() => await OnClose.InvokeAsync();

    // ── Status parser ─────────────────────────────────────────────────────
    private static ListStatus? ParseStatus(string key) => key switch
    {
        "Watching" => ListStatus.Watching,
        "Rewatching" => ListStatus.Rewatching,
        "Completed" => ListStatus.Completed,
        "Planning" => ListStatus.Planning,
        "Paused" => ListStatus.Paused,
        "Dropped" => ListStatus.Dropped,
        _ => null
    };
}
