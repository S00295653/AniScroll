@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService

@if (IsVisible)
{
    <div class="clm-overlay" @onclick="Close">
        <div class="clm-panel" @onclick:stopPropagation="true"
             @ontouchstart:stopPropagation="true"
             @ontouchmove:stopPropagation="true">

            <!-- ── Header ──────────────────────────────────────────────── -->
            <div class="clm-header">
                <div class="clm-handle-bar"></div>
                <div class="clm-header-row">
                    <span class="clm-title">My Lists</span>
                    <button class="clm-close-btn" @onclick="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- ── Body ────────────────────────────────────────────────── -->
            <div class="clm-body">

                <!-- ══════════════════════════════════════════
                     CREATE NEW LIST ROW  (always at top)
                     ══════════════════════════════════════════ -->
                <div class="clm2-row clm2-row-new">

                    <!-- color swatch -->
                    <div class="clm2-swatch @(string.IsNullOrEmpty(_newColor) ? "clm2-swatch-empty" : "")"
                         style="@(!string.IsNullOrEmpty(_newColor) ? $"background:{_newColor}20;border-color:{_newColor}60;" : "")"
                         @onclick="() => TogglePicker(-1)"
                         @onclick:stopPropagation="true">

                        @if (!string.IsNullOrEmpty(_newColor))
                        {
                            <div class="clm2-swatch-dot" style="background:@_newColor;"></div>
                        }
                        else
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        }

                        @if (_pickerOpenFor == -1)
                        {
                            <div class="clm2-picker-pop" @onclick:stopPropagation="true">
                                @foreach (var c in _palette)
                                {
                                    var cc = c;
                                    <button class="clm2-pal-btn @(_newColor == cc ? "clm2-pal-sel" : "")"
                                            style="background:@cc;"
                                            @onclick="() => { _newColor = cc; _pickerOpenFor = -2; StateHasChanged(); }">
                                    </button>
                                }
                                <input type="color" class="clm2-color-native"
                                       value="@(_newColor ?? "#6366f1")"
                                       @onchange="e => { _newColor = e.Value?.ToString(); _pickerOpenFor = -2; StateHasChanged(); }" />
                            </div>
                        }
                    </div>

                    <!-- name input -->
                    <input class="clm2-name-input"
                           placeholder="New list name…"
                           value="@_newName"
                           @oninput="e => _newName = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnNewKeyDown" />

                    <!-- add button -->
                    <button class="clm2-add-btn @(CanAdd ? "" : "clm2-add-btn-off")"
                            disabled="@(!CanAdd)"
                            @onclick="AddList"
                            @onclick:stopPropagation="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>

                <!-- ══════════════════════════════════════════
                     STATUS LISTS  (built-in, color+name editable)
                     ══════════════════════════════════════════ -->
                @for (int i = 0; i < _statusSettings.Count; i++)
                {
                    var si  = i;
                    var s   = _statusSettings[i];
                    var cnt = UserListService.Count(ParseStatus(s.Key));
                    var isDragging = _dragStatusIdx == si;
                    var isDragOver = _dragStatusOver == si;

                    <div class="clm2-row @(isDragging ? "clm2-dragging" : "") @(isDragOver ? "clm2-dragover" : "")"
                         draggable="true"
                         @ondragstart="() => { _dragStatusIdx = si; _dragCustomIdx = -1; }"
                         @ondragover:preventDefault="true"
                         @ondragover="() => { _dragStatusOver = si; StateHasChanged(); }"
                         @ondrop="DropStatus"
                         @ondragend="() => { _dragStatusIdx = -1; _dragStatusOver = -1; StateHasChanged(); }">

                        <div class="clm2-drag">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.25)" stroke-width="2" stroke-linecap="round">
                                <line x1="8" y1="6"  x2="16" y2="6"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                                <line x1="8" y1="18" x2="16" y2="18"></line>
                            </svg>
                        </div>

                        <div class="clm2-swatch"
                             style="background:@(s.Color)20;border-color:@(s.Color)60;"
                             @onclick="() => TogglePicker(1000 + si)"
                             @onclick:stopPropagation="true">
                            <div class="clm2-swatch-dot" style="background:@s.Color;"></div>

                            @if (_pickerOpenFor == 1000 + si)
                            {
                                <div class="clm2-picker-pop" @onclick:stopPropagation="true">
                                    @foreach (var c in _palette)
                                    {
                                        var cc = c;
                                        <button class="clm2-pal-btn @(s.Color == cc ? "clm2-pal-sel" : "")"
                                                style="background:@cc;"
                                                @onclick="() => { s.Color = cc; _pickerOpenFor = -2; SaveStatus(); StateHasChanged(); }">
                                        </button>
                                    }
                                    <input type="color" class="clm2-color-native"
                                           value="@s.Color"
                                           @onchange="e => { s.Color = e.Value?.ToString() ?? s.Color; _pickerOpenFor = -2; SaveStatus(); StateHasChanged(); }" />
                                </div>
                            }
                        </div>

                        <input class="clm2-name-input"
                               value="@s.DisplayName"
                               @oninput="e => { s.DisplayName = e.Value?.ToString() ?? s.DisplayName; }"
                               @onchange="e => { s.DisplayName = e.Value?.ToString() ?? s.DisplayName; SaveStatus(); }"
                               @onclick:stopPropagation="true" />

                        @if (cnt > 0)
                        {
                            <span class="clm2-count" style="border-color:@(s.Color)55;color:@s.Color;">@cnt</span>
                        }

                        <div class="clm2-lock">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.18)" stroke-width="2" stroke-linecap="round">
                                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                    </div>
                }

                <!-- ══════════════════════════════════════════
                     CUSTOM LISTS  (user-created)
                     ══════════════════════════════════════════ -->
                @for (int i = 0; i < _customLists.Count; i++)
                {
                    var ci   = i;
                    var list = _customLists[i];
                    var cnt  = UserListService.GetCountForCustomList(list.Id);
                    var isDragging = _dragCustomIdx == ci;
                    var isDragOver = _dragCustomOver == ci;

                    <div class="clm2-row @(isDragging ? "clm2-dragging" : "") @(isDragOver ? "clm2-dragover" : "")"
                         draggable="true"
                         @ondragstart="() => { _dragCustomIdx = ci; _dragStatusIdx = -1; }"
                         @ondragover:preventDefault="true"
                         @ondragover="() => { _dragCustomOver = ci; StateHasChanged(); }"
                         @ondrop="DropCustom"
                         @ondragend="() => { _dragCustomIdx = -1; _dragCustomOver = -1; StateHasChanged(); }">

                        <div class="clm2-drag">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.25)" stroke-width="2" stroke-linecap="round">
                                <line x1="8" y1="6"  x2="16" y2="6"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                                <line x1="8" y1="18" x2="16" y2="18"></line>
                            </svg>
                        </div>

                        <div class="clm2-swatch"
                             style="background:@(list.Color ?? "#6366f1")20;border-color:@(list.Color ?? "#6366f1")60;"
                             @onclick="() => TogglePicker(2000 + ci)"
                             @onclick:stopPropagation="true">
                            <div class="clm2-swatch-dot" style="background:@(list.Color ?? "#6366f1");"></div>

                            @if (_pickerOpenFor == 2000 + ci)
                            {
                                <div class="clm2-picker-pop" @onclick:stopPropagation="true">
                                    @foreach (var c in _palette)
                                    {
                                        var cc = c;
                                        <button class="clm2-pal-btn @(list.Color == cc ? "clm2-pal-sel" : "")"
                                                style="background:@cc;"
                                                @onclick="() => { list.Color = cc; _pickerOpenFor = -2; SaveCustom(); StateHasChanged(); }">
                                        </button>
                                    }
                                    <input type="color" class="clm2-color-native"
                                           value="@(list.Color ?? "#6366f1")"
                                           @onchange="e => { list.Color = e.Value?.ToString() ?? list.Color; _pickerOpenFor = -2; SaveCustom(); StateHasChanged(); }" />
                                </div>
                            }
                        </div>

                        <input class="clm2-name-input"
                               value="@list.Name"
                               @oninput="e => { list.Name = e.Value?.ToString() ?? list.Name; }"
                               @onchange="e => { list.Name = e.Value?.ToString() ?? list.Name; SaveCustom(); }"
                               @onclick:stopPropagation="true" />

                        @if (cnt > 0)
                        {
                            <span class="clm2-count" style="border-color:@(list.Color ?? "#6366f1")55;color:@(list.Color ?? "#6366f1");">@cnt</span>
                        }

                        <button class="clm2-delete-btn"
                                @onclick="() => DeleteCustom(ci)"
                                @onclick:stopPropagation="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v6M14 11v6"></path>
                                <path d="M9 6V4h6v2"></path>
                            </svg>
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<StatusListSetting> _statusSettings = new();
    private List<UserCustomList>    _customLists    = new();

    private string  _newName  = "";
    private string? _newColor = null;
    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName);

    // -2=closed  -1=new row  1000+i=status row  2000+i=custom row
    private int _pickerOpenFor = -2;

    private int _dragStatusIdx  = -1;
    private int _dragStatusOver = -1;
    private int _dragCustomIdx  = -1;
    private int _dragCustomOver = -1;

    private static readonly string[] _palette =
    {
        "#ef4444","#f97316","#f59e0b","#eab308",
        "#84cc16","#22c55e","#10b981","#06b6d4",
        "#3b82f6","#6366f1","#8b5cf6","#a855f7",
        "#ec4899","#f43f5e","#64748b","#78716c"
    };

    protected override void OnParametersSet()
    {
        if (!IsVisible) return;
        _statusSettings = UserListService.GetStatusSettings();
        _customLists    = UserListService.GetCustomLists();
        _newName        = "";
        _newColor       = null;
        _pickerOpenFor  = -2;
    }

    private void TogglePicker(int idx)
    {
        _pickerOpenFor = _pickerOpenFor == idx ? -2 : idx;
        StateHasChanged();
    }

    private void SaveStatus() => UserListService.SaveStatusSettings(_statusSettings);
    private void SaveCustom()
    {
        for (int i = 0; i < _customLists.Count; i++) _customLists[i].Order = i;
        UserListService.SaveCustomLists(_customLists);
    }

    private void AddList()
    {
        if (!CanAdd) return;
        _customLists.Add(new UserCustomList
        {
            Id    = Guid.NewGuid().ToString(),
            Name  = _newName.Trim(),
            Color = _newColor ?? "#6366f1",
            Order = _customLists.Count
        });
        SaveCustom();
        _newName       = "";
        _newColor      = null;
        _pickerOpenFor = -2;
        StateHasChanged();
    }

    private void DeleteCustom(int idx)
    {
        if (idx < 0 || idx >= _customLists.Count) return;
        _customLists.RemoveAt(idx);
        SaveCustom();
        StateHasChanged();
    }

    private void DropStatus()
    {
        if (_dragStatusIdx < 0 || _dragStatusOver < 0 || _dragStatusIdx == _dragStatusOver) return;
        var item = _statusSettings[_dragStatusIdx];
        _statusSettings.RemoveAt(_dragStatusIdx);
        int at = _dragStatusOver > _dragStatusIdx ? _dragStatusOver - 1 : _dragStatusOver;
        _statusSettings.Insert(at, item);
        for (int i = 0; i < _statusSettings.Count; i++) _statusSettings[i].Order = i;
        SaveStatus();
        _dragStatusIdx = -1; _dragStatusOver = -1;
        StateHasChanged();
    }

    private void DropCustom()
    {
        if (_dragCustomIdx < 0 || _dragCustomOver < 0 || _dragCustomIdx == _dragCustomOver) return;
        var item = _customLists[_dragCustomIdx];
        _customLists.RemoveAt(_dragCustomIdx);
        int at = _dragCustomOver > _dragCustomIdx ? _dragCustomOver - 1 : _dragCustomOver;
        _customLists.Insert(at, item);
        SaveCustom();
        _dragCustomIdx = -1; _dragCustomOver = -1;
        StateHasChanged();
    }

    private void OnNewKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddList(); }

    private static ListStatus? ParseStatus(string key) => key switch
    {
        "Watching"   => ListStatus.Watching,
        "Rewatching" => ListStatus.Rewatching,
        "Completed"  => ListStatus.Completed,
        "Planning"   => ListStatus.Planning,
        "Paused"     => ListStatus.Paused,
        "Dropped"    => ListStatus.Dropped,
        _            => null
    };

    private async Task Close() { _pickerOpenFor = -2; await OnClose.InvokeAsync(); }
}
