@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService

@if (IsVisible)
{
    <div class="clm-overlay" @onclick="HandleOverlayClick">
        <div class="clm-panel"
             @onclick:stopPropagation="true"
             @ontouchstart:stopPropagation="true"
             @ontouchmove:stopPropagation="true">

            <!-- ── Header ─────────────────────────────────────────── -->
            <div class="clm-header">
                <div class="clm-handle-bar"></div>
                <div class="clm-header-row">
                    <span class="clm-title">My Lists</span>
                    <button class="clm-close-btn" @onclick="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- ── Body ───────────────────────────────────────────── -->
            <div class="clm-body"
                 @ondragover:preventDefault="true"
                 @ondrop="CommitDrop"
                 @ondragend="CancelDrag">

                <!-- NEW LIST ROW -->
                <div class="clm2-row clm2-row-new">

                    <!-- swatch: filled with color when chosen, dashed + icon when empty -->
                    <div class="clm2-swatch @(string.IsNullOrEmpty(_newColor) ? "clm2-swatch-empty" : "clm2-swatch-filled")"
                         style="@(!string.IsNullOrEmpty(_newColor) ? $"background:{_newColor};" : "")"
                         @onclick:stopPropagation="true"
                         @onclick="() => OpenPicker(-1, _newColor ?? string.Empty, c => { _newColor = c; StateHasChanged(); })">
                        @if (string.IsNullOrEmpty(_newColor))
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        }
                    </div>

                    <input class="clm2-name-input"
                           placeholder="New list name…"
                           value="@_newName"
                           @oninput="e => _newName = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnNewKeyDown"
                           @onclick:stopPropagation="true" />

                    <button class="clm2-add-btn @(CanAdd ? "" : "clm2-add-btn-off")"
                            disabled="@(!CanAdd)"
                            @onclick="AddList"
                            @onclick:stopPropagation="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                </div>

                <!-- LIST ROWS — each shifts via CSS transform while dragging -->
                @for (int i = 0; i < _rows.Count; i++)
                {
                    var ri     = i;
                    var row    = _rows[i];
                    var color  = row.Color;
                    var isDrag = _dragIdx == ri;
                    var shift  = GetShift(ri);    // "0px", "64px", or "-64px"

                    var cnt = row.IsStatus
                        ? UserListService.Count(ParseStatus(row.Status!.Key))
                        : UserListService.GetCountForCustomList(row.Custom!.Id);

                    <div class="clm2-row @(isDrag ? "clm2-dragging" : "") clm2-row-anim"
                         style="transform:translateY(@shift); z-index:@(isDrag ? 10 : 1);"
                         draggable="true"
                         @ondragstart="() => StartDrag(ri)"
                         @ondragenter:preventDefault="true"
                         @ondragenter="() => EnterRow(ri)"
                         @ondragover:preventDefault="true"
                         @ondrop:stopPropagation="true"
                         @ondrop="CommitDrop"
                         @ondragend="CancelDrag">

                        <!-- drag handle -->
                        <div class="clm2-drag">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <line x1="9"  y1="5"  x2="15" y2="5"></line>
                                <line x1="9"  y1="12" x2="15" y2="12"></line>
                                <line x1="9"  y1="19" x2="15" y2="19"></line>
                            </svg>
                        </div>

                        <!-- swatch: filled with color -->
                        <div class="clm2-swatch clm2-swatch-filled"
                             style="background:@color;"
                             @onclick:stopPropagation="true"
                             @onclick="() => OpenPicker(ri, color, c => { row.SetColor(c); SaveAll(); StateHasChanged(); })">
                        </div>

                        <!-- editable name -->
                        <input class="clm2-name-input"
                               value="@row.Name"
                               @oninput="e => row.SetName(e.Value?.ToString() ?? row.Name)"
                               @onchange="e => { row.SetName(e.Value?.ToString() ?? row.Name); SaveAll(); }"
                               @onclick:stopPropagation="true" />

                        <!-- entry count -->
                        @if (cnt > 0)
                        {
                            <span class="clm2-count" style="border-color:@(color)66;color:@color;">@cnt</span>
                        }

                        <!-- lock (status) OR delete (custom) -->
                        @if (row.IsStatus)
                        {
                            <div class="clm2-lock">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                     stroke="rgba(255,255,255,0.2)" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                        }
                        else
                        {
                            <button class="clm2-delete-btn"
                                    @onclick="() => DeleteRow(ri)"
                                    @onclick:stopPropagation="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </button>
                        }
                    </div>
                }

            </div><!-- /clm-body -->
        </div><!-- /clm-panel -->
    </div><!-- /clm-overlay -->

    <!-- ══════════════════════════════════════════
         COLOR PICKER  — fixed, centered in viewport
         Rendered outside .clm-panel so nothing clips it
         ══════════════════════════════════════════ -->
    @if (_pickerOpen && _pickerCallback != null)
    {
        <div class="clm2-picker-backdrop" @onclick="ClosePicker" @onclick:stopPropagation="true"></div>
        <div class="clm2-picker-fixed" @onclick:stopPropagation="true">
            <div class="clm2-picker-grid">
                @foreach (var c in _palette)
                {
                    var cc = c;
                    <button class="clm2-pal-btn @(_pickerCurrentColor == cc ? "clm2-pal-sel" : "")"
                            style="background:@cc;"
                            @onclick="() => PickColor(cc)">
                    </button>
                }
            </div>
            <input type="color" class="clm2-color-native"
                   value="@(_pickerCurrentColor.Length > 0 ? _pickerCurrentColor : "#6366f1")"
                   @onchange="e => PickColor(e.Value?.ToString() ?? string.Empty)" />
        </div>
    }
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // ── Row wrapper ──────────────────────────────────────────────────────
    private class Row
    {
        public bool IsStatus;
        public StatusListSetting? Status;
        public UserCustomList?    Custom;

        public string Color => IsStatus ? (Status!.Color ?? "#6366f1") : (Custom!.Color ?? "#6366f1");
        public string Name  => IsStatus ? Status!.DisplayName           : Custom!.Name;

        public void SetColor(string c) { if (IsStatus) Status!.Color = c; else Custom!.Color = c; }
        public void SetName(string n)  { if (IsStatus) Status!.DisplayName = n; else Custom!.Name = n; }
    }

    private List<Row> _rows = new();

    // ── New list form ────────────────────────────────────────────────────
    private string  _newName  = "";
    private string? _newColor = null;
    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName);

    // ── Picker ───────────────────────────────────────────────────────────
    private bool            _pickerOpen         = false;
    private int             _pickerOpenFor      = -2;   // -2=closed -1=new-row >=0=row
    private string          _pickerCurrentColor = "";
    private Action<string>? _pickerCallback;

    // ── Drag ─────────────────────────────────────────────────────────────
    // _dragIdx:      row currently being dragged (-1 = none)
    // _insertBefore: insertion target index      (-1 = none)
    //
    // Visual shift logic (same as codesandbox k260nyxq9v):
    //   • Dragging DOWN (dragIdx < insertBefore):
    //       rows in (dragIdx, insertBefore)  →  shift UP   by -ROW_H
    //   • Dragging UP   (dragIdx > insertBefore):
    //       rows in [insertBefore, dragIdx)  →  shift DOWN by +ROW_H
    private int _dragIdx      = -1;
    private int _insertBefore = -1;

    // Height of one row (px) — keep in sync with CSS (.clm2-row height + margin)
    private const int ROW_H = 64;

    // ── Palette ──────────────────────────────────────────────────────────
    private static readonly string[] _palette =
    {
        "#ef4444","#f97316","#f59e0b","#eab308",
        "#84cc16","#22c55e","#10b981","#06b6d4",
        "#3b82f6","#6366f1","#8b5cf6","#a855f7",
        "#ec4899","#f43f5e","#64748b","#78716c"
    };

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnParametersSet()
    {
        if (!IsVisible) return;
        RebuildRows();
        _newName        = "";
        _newColor       = null;
        _pickerOpen     = false;
        _pickerOpenFor  = -2;
        _pickerCallback = null;
        _dragIdx        = -1;
        _insertBefore   = -1;
    }

    private void RebuildRows()
    {
        _rows = UserListService.GetStatusSettings()
            .Select(s => new Row { IsStatus = true,  Status = s })
            .Concat(UserListService.GetCustomLists()
                .Select(c => new Row { IsStatus = false, Custom = c }))
            .ToList();
    }

    // ── Shift calculation for the drag animation ─────────────────────────
    // Returns a CSS translateY value string for row at index `i`.
    private string GetShift(int i)
    {
        if (_dragIdx < 0 || _insertBefore < 0 || i == _dragIdx) return "0px";

        // Dragging DOWN: src < tgt → rows between src+1 and tgt-1 shift UP
        if (_dragIdx < _insertBefore && i > _dragIdx && i < _insertBefore)
            return $"{-ROW_H}px";

        // Dragging UP: src > tgt → rows between tgt and src-1 shift DOWN
        if (_dragIdx > _insertBefore && i >= _insertBefore && i < _dragIdx)
            return $"{ROW_H}px";

        return "0px";
    }

    // ── Picker ───────────────────────────────────────────────────────────
    private void OpenPicker(int forIdx, string currentColor, Action<string> callback)
    {
        if (_pickerOpenFor == forIdx && _pickerOpen) { ClosePicker(); return; }
        _pickerOpen         = true;
        _pickerOpenFor      = forIdx;
        _pickerCurrentColor = currentColor;
        _pickerCallback     = callback;
        StateHasChanged();
    }

    private void PickColor(string color)
    {
        if (string.IsNullOrEmpty(color)) return;
        _pickerCurrentColor = color;
        _pickerCallback?.Invoke(color);
        ClosePicker();
    }

    private void ClosePicker()
    {
        _pickerOpen     = false;
        _pickerOpenFor  = -2;
        _pickerCallback = null;
        StateHasChanged();
    }

    // ── Persist ──────────────────────────────────────────────────────────
    private void SaveAll()
    {
        var statusRows = _rows.Where(r => r.IsStatus).Select(r => r.Status!).ToList();
        for (int i = 0; i < statusRows.Count; i++) statusRows[i].Order = i;

        var customRows = _rows.Where(r => !r.IsStatus).Select(r => r.Custom!).ToList();
        for (int i = 0; i < customRows.Count; i++) customRows[i].Order = i;

        UserListService.SaveStatusSettings(statusRows);
        UserListService.SaveCustomLists(customRows);
    }

    // ── Add / Delete ─────────────────────────────────────────────────────
    private void AddList()
    {
        if (!CanAdd) return;
        _rows.Add(new Row
        {
            IsStatus = false,
            Custom   = new UserCustomList
            {
                Id    = Guid.NewGuid().ToString(),
                Name  = _newName.Trim(),
                Color = _newColor ?? "#6366f1",
                Order = _rows.Count
            }
        });
        SaveAll();
        _newName        = "";
        _newColor       = null;
        _pickerOpen     = false;
        _pickerOpenFor  = -2;
        _pickerCallback = null;
        StateHasChanged();
    }

    private void DeleteRow(int idx)
    {
        if (idx < 0 || idx >= _rows.Count || _rows[idx].IsStatus) return;
        _rows.RemoveAt(idx);
        SaveAll();
        StateHasChanged();
    }

    // ── Drag & drop ──────────────────────────────────────────────────────
    private void StartDrag(int idx)
    {
        _dragIdx      = idx;
        _insertBefore = idx;    // start with no shift
        StateHasChanged();
    }

    private void EnterRow(int idx)
    {
        if (_dragIdx < 0 || idx == _dragIdx) return;

        // Convert hovered row to an insertion position:
        // Entering a row BELOW the drag source → insert after that row → insertBefore = idx+1
        // Entering a row ABOVE the drag source → insert before that row → insertBefore = idx
        int newInsert = idx > _dragIdx ? idx + 1 : idx;

        if (newInsert != _insertBefore)
        {
            _insertBefore = newInsert;
            StateHasChanged();
        }
    }

    private void CommitDrop()
    {
        if (_dragIdx < 0 || _insertBefore < 0)
        {
            CancelDrag();
            return;
        }

        int tgt = Math.Clamp(_insertBefore, 0, _rows.Count);

        // No actual movement
        if (tgt == _dragIdx || tgt == _dragIdx + 1)
        {
            CancelDrag();
            return;
        }

        var item = _rows[_dragIdx];
        _rows.RemoveAt(_dragIdx);

        // Adjust index after removal
        int at = tgt > _dragIdx ? tgt - 1 : tgt;
        at = Math.Clamp(at, 0, _rows.Count);

        _rows.Insert(at, item);
        SaveAll();
        _dragIdx      = -1;
        _insertBefore = -1;
        StateHasChanged();
    }

    private void CancelDrag()
    {
        _dragIdx      = -1;
        _insertBefore = -1;
        StateHasChanged();
    }

    // ── Keyboard ─────────────────────────────────────────────────────────
    private void OnNewKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddList(); }

    // ── Panel close ──────────────────────────────────────────────────────
    private void HandleOverlayClick()
    {
        if (_pickerOpen) { ClosePicker(); return; }
        _ = Close();
    }

    private async Task Close() { ClosePicker(); await OnClose.InvokeAsync(); }

    // ── Status key ───────────────────────────────────────────────────────
    private static ListStatus? ParseStatus(string key) => key switch
    {
        "Watching"   => ListStatus.Watching,
        "Rewatching" => ListStatus.Rewatching,
        "Completed"  => ListStatus.Completed,
        "Planning"   => ListStatus.Planning,
        "Paused"     => ListStatus.Paused,
        "Dropped"    => ListStatus.Dropped,
        _            => null
    };
}
