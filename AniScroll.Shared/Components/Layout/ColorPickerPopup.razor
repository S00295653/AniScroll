@using System.Globalization
@inject IJSRuntime JS
@implements IDisposable

@if (IsVisible)
{
    <div class="cp-overlay" @onclick="HandleClose"></div>

    <div class="cp-popup" style="@_posStyle"
         @onclick:stopPropagation="true"
         @ontouchstart:stopPropagation="true"
         @ontouchmove:stopPropagation="true"
         @ontouchend:stopPropagation="true">

        <!-- ── Saturation / Value square ──────────────────────────── -->
        <div class="cp-sv"
             @ref="_svRef"
             style="background: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%),
                                linear-gradient(to right, rgba(255,255,255,1) 0%, hsl(@F0(_h), 100%, 50%) 100%);"
             @onpointerdown="SvPointerDown">
            <div class="cp-sv-dot" style="left:@Pct(_s);top:@Pct(1.0 - _v);"></div>
        </div>

        <!-- ── Hue slider ─────────────────────────────────────────── -->
        <div class="cp-hue-track"
             @ref="_hueRef"
             @onpointerdown="HuePointerDown">
            <div class="cp-hue-thumb" style="left:@Pct(_h / 360.0);"></div>
        </div>

        <!-- ── Preview + Presets ──────────────────────────────────── -->
        <div class="cp-preview-row">
            <div class="cp-color-dot" style="background:@HexColor;"></div>
            <div class="cp-swatches">
                @foreach (var p in _presets)
                {
                    var px = p;
                    <button class="cp-swatch" style="background:@px;" @onclick="() => SetFromHex(px)"></button>
                }
            </div>
        </div>

        <!-- ── Mode tabs ──────────────────────────────────────────── -->
        <div class="cp-tabs">
            @foreach (var t in _tabs)
            {
                var tx = t;
                <button class="cp-tab @(_tab == tx ? "cp-tab-on" : "")" @onclick="() => _tab = tx">@tx</button>
            }
        </div>

        <!-- ── Inputs ─────────────────────────────────────────────── -->
        <div class="cp-inputs">

            @if (_tab == "HEX")
            {
                <div class="cp-hex-row">
                    <input class="cp-hex-in" value="@_hexInput" maxlength="7"
                           @oninput="HexTyping" @onchange="HexCommit" />
                    <button class="cp-clear-btn" @onclick="ResetBlack">⌫</button>
                </div>
            }

            @if (_tab == "RGB")
            {
                var (rr, gg, bb) = HsvToRgb(_h, _s, _v);
                var rInt = Ri(rr); var gInt = Ri(gg); var bInt = Ri(bb);
                <div class="cp-chan-row">
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="255" value="@rInt"
                               @onchange="e => SetFromRgb(Clamp(e.Value, 0, 255, rInt), gInt, bInt)" />
                        <span class="cp-chan-lbl">R</span>
                    </div>
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="255" value="@gInt"
                               @onchange="e => SetFromRgb(rInt, Clamp(e.Value, 0, 255, gInt), bInt)" />
                        <span class="cp-chan-lbl">G</span>
                    </div>
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="255" value="@bInt"
                               @onchange="e => SetFromRgb(rInt, gInt, Clamp(e.Value, 0, 255, bInt))" />
                        <span class="cp-chan-lbl">B</span>
                    </div>
                </div>
            }

            @if (_tab == "HSV")
            {
                var hsvH = (int)Math.Round(_h);
                var hsvS = (int)Math.Round(_s * 100);
                var hsvV = (int)Math.Round(_v * 100);
                <div class="cp-chan-row">
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="360" value="@hsvH"
                               @onchange="e => { _h = ClampD(e.Value, 0, 360, _h); SyncHex(); Emit(); }" />
                        <span class="cp-chan-lbl">H</span>
                    </div>
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="100" value="@hsvS"
                               @onchange="e => { _s = ClampD(e.Value, 0, 100, _s * 100) / 100.0; SyncHex(); Emit(); }" />
                        <span class="cp-chan-lbl">S</span>
                    </div>
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="100" value="@hsvV"
                               @onchange="e => { _v = ClampD(e.Value, 0, 100, _v * 100) / 100.0; SyncHex(); Emit(); }" />
                        <span class="cp-chan-lbl">V</span>
                    </div>
                </div>
            }

            @if (_tab == "HSL")
            {
                var (hslH, hslS, hslL) = HsvToHsl(_h, _s, _v);
                var hslHi = (int)Math.Round(hslH);
                var hslSi = (int)Math.Round(hslS * 100);
                var hslLi = (int)Math.Round(hslL * 100);
                <div class="cp-chan-row">
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="360" value="@hslHi"
                               @onchange="e => SetFromHsl(ClampD(e.Value, 0, 360, hslH), hslS, hslL)" />
                        <span class="cp-chan-lbl">H</span>
                    </div>
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="100" value="@hslSi"
                               @onchange="e => SetFromHsl(hslH, ClampD(e.Value, 0, 100, hslS * 100) / 100.0, hslL)" />
                        <span class="cp-chan-lbl">S</span>
                    </div>
                    <div class="cp-chan">
                        <input class="cp-chan-in" type="number" min="0" max="100" value="@hslLi"
                               @onchange="e => SetFromHsl(hslH, hslS, ClampD(e.Value, 0, 100, hslL * 100) / 100.0)" />
                        <span class="cp-chan-lbl">L</span>
                    </div>
                </div>
            }

        </div>
    </div>
}

<style>
    .cp-overlay  { position:fixed;inset:0;z-index:9990;background:transparent; }
    .cp-popup    { position:fixed;z-index:9991;width:min(280px, calc(100vw - 24px));background:#2b2b2b;border-radius:10px;
                   padding:10px;box-shadow:0 8px 32px rgba(0,0,0,.65);user-select:none; }

    /* SV square — height via aspect-ratio so getBoundingClientRect has real height */
    .cp-sv       { position:relative;width:100%;aspect-ratio:5/3;border-radius:6px;
                   cursor:crosshair;touch-action:none;overflow:visible; }
    .cp-sv-dot   { position:absolute;width:14px;height:14px;border-radius:50%;
                   border:2.5px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.5),0 2px 4px rgba(0,0,0,.4);
                   transform:translate(-50%,-50%);pointer-events:none;z-index:2; }

    /* Hue strip */
    .cp-hue-track { position:relative;height:14px;border-radius:7px;margin-top:10px;touch-action:none;
                    background:linear-gradient(to right,
                      hsl(0,100%,50%),hsl(30,100%,50%),hsl(60,100%,50%),hsl(90,100%,50%),
                      hsl(120,100%,50%),hsl(150,100%,50%),hsl(180,100%,50%),hsl(210,100%,50%),
                      hsl(240,100%,50%),hsl(270,100%,50%),hsl(300,100%,50%),hsl(330,100%,50%),
                      hsl(360,100%,50%));cursor:pointer; }
    .cp-hue-thumb { position:absolute;top:50%;width:16px;height:16px;border-radius:50%;background:#fff;
                    border:2px solid rgba(0,0,0,.3);box-shadow:0 1px 4px rgba(0,0,0,.5);
                    transform:translate(-50%,-50%);pointer-events:none; }

    /* Preview + presets */
    .cp-preview-row { display:flex;align-items:center;gap:8px;margin-top:10px; }
    .cp-color-dot   { width:32px;height:32px;border-radius:50%;flex-shrink:0;
                      border:2px solid rgba(255,255,255,.15); }
    .cp-swatches    { display:grid;grid-template-columns:repeat(8,1fr);gap:4px;flex:1; }
    .cp-swatch      { width:100%;aspect-ratio:1;border-radius:3px;border:none;cursor:pointer;
                      padding:0;transition:transform .1s,box-shadow .1s; }
    .cp-swatch:hover { transform:scale(1.18);box-shadow:0 0 0 2px rgba(255,255,255,.4); }

    /* Tabs */
    .cp-tabs     { display:flex;gap:2px;margin-top:10px;background:#222;border-radius:6px;padding:2px; }
    .cp-tab      { flex:1;background:transparent;border:none;color:rgba(255,255,255,.45);font-size:11px;
                   font-weight:600;padding:5px 0;border-radius:4px;cursor:pointer;transition:all .15s; }
    .cp-tab-on   { background:#444;color:#fff; }

    /* Inputs */
    .cp-inputs   { margin-top:8px; }
    .cp-hex-row  { display:flex;gap:6px;align-items:center; }
    .cp-hex-in   { flex:1;background:#1a1a1a;border:1px solid #444;color:#fff;padding:7px 10px;
                   border-radius:6px;font-size:13px;font-family:monospace;letter-spacing:.05em;outline:none; }
    .cp-hex-in:focus { border-color:#666; }
    .cp-clear-btn { background:#333;border:1px solid #444;color:rgba(255,255,255,.5);width:32px;height:34px;
                    border-radius:6px;cursor:pointer;font-size:14px;display:flex;align-items:center;
                    justify-content:center;flex-shrink:0;transition:color .15s; }
    .cp-clear-btn:hover { color:#fff; }
    .cp-chan-row  { display:flex;gap:6px; }
    .cp-chan      { display:flex;flex-direction:column;align-items:center;gap:3px;flex:1; }
    .cp-chan-in   { width:100%;background:#1a1a1a;border:1px solid #444;color:#fff;padding:6px 4px;
                   border-radius:5px;font-size:12px;text-align:center;outline:none; }
    .cp-chan-in:focus { border-color:#666; }
    .cp-chan-lbl  { color:rgba(255,255,255,.3);font-size:10px;font-weight:600;letter-spacing:.05em; }
    .cp-chan-in::-webkit-outer-spin-button,
    .cp-chan-in::-webkit-inner-spin-button { -webkit-appearance:none;margin:0; }
    .cp-chan-in[type=number] { -moz-appearance:textfield; }
</style>

@code {
    /* ─── Parameters ──────────────────────────────────────────────────────── */
    [Parameter] public bool                  IsVisible      { get; set; }
    [Parameter] public string                InitialColor   { get; set; } = "#6366f1";
    [Parameter] public ElementReference      AnchorRef      { get; set; }
    [Parameter] public EventCallback<string> OnColorChanged { get; set; }
    [Parameter] public EventCallback         OnClose        { get; set; }

    /* ─── State ───────────────────────────────────────────────────────────── */
    private static readonly CultureInfo IC = CultureInfo.InvariantCulture;

    private double _h = 0, _s = 0, _v = 1;
    private string _hexInput = "#ffffff";
    private string _tab      = "HEX";
    private string _posStyle = "left:50%;top:50%;transform:translate(-50%,-50%);";

    private ElementReference _svRef, _hueRef;
    private bool _prevVisible;

    private DotNetObjectReference<ColorPickerPopup>? _dotNetRef;

    private static readonly string[] _tabs = { "HEX", "RGB", "HSV", "HSL" };

    // 24 swatches: 3 rows of 8 — reds · oranges · yellows · greens · cyans · blues · purples · pinks
    private static readonly string[] _presets =
    {
        // row 1 — warm
        "#ef4444", "#f97316", "#f59e0b", "#eab308",
        "#84cc16", "#22c55e", "#10b981", "#14b8a6",
        // row 2 — cool
        "#06b6d4", "#0ea5e9", "#3b82f6", "#6366f1",
        "#8b5cf6", "#a855f7", "#d946ef", "#ec4899",
        // row 3 — neutrals & extras
        "#ffffff", "#d1d5db", "#6b7280", "#374151",
        "#1f2937", "#111827", "#000000", "#713f12",
    };

    /* ─── Computed ────────────────────────────────────────────────────────── */
    private string HexColor
    {
        get { var (r, g, b) = HsvToRgb(_h, _s, _v); return $"#{Ri(r):x2}{Ri(g):x2}{Ri(b):x2}"; }
    }

    /* ─── Lifecycle ───────────────────────────────────────────────────────── */
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("cpStopDrag");
        _dotNetRef?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !_prevVisible)
        {
            if (TryParseHex(InitialColor, out var h, out var s, out var v))
            { _h = h; _s = s; _v = v; _hexInput = HexColor; }
            await PositionAsync();
        }
        if (!IsVisible && _prevVisible)
        {
            await JS.InvokeVoidAsync("cpStopDrag");
        }
        _prevVisible = IsVisible;
    }

    /* ─── Positioning: smart anchor-aware, mobile-safe ──────────────────── */
    private async Task PositionAsync()
    {
        try
        {
            await Task.Delay(30);
            var pos = await JS.InvokeAsync<PickerPos>("cpGetPosition", AnchorRef, 290, 420);
            _posStyle = $"left:{pos.Left.ToString(IC)}px;top:{pos.Top.ToString(IC)}px;";
            StateHasChanged();
        }
        catch
        {
            _posStyle = "left:50%;top:50%;transform:translate(-50%,-50%);";
        }
    }

    /* ─── JS-driven drag: SV ─────────────────────────────────────────────── */
    private async Task SvPointerDown(PointerEventArgs e)
    {
        await UpdateSvFromClient(e.ClientX, e.ClientY);
        await JS.InvokeVoidAsync("cpStartSvDrag", _svRef, _dotNetRef);
    }

    [JSInvokable]
    public void OnSvDrag(double pctX, double pctY)
    {
        _s = Math.Clamp(pctX, 0, 1);
        _v = Math.Clamp(1.0 - pctY, 0, 1);
        SyncHex(); Emit();
    }

    private async Task UpdateSvFromClient(double cx, double cy)
    {
        try
        {
            var b = await JS.InvokeAsync<ElemRect>("cpGetRect", _svRef);
            _s = Math.Clamp((cx - b.Left) / b.Width,  0, 1);
            _v = Math.Clamp(1.0 - (cy - b.Top) / b.Height, 0, 1);
            SyncHex(); Emit();
        }
        catch { }
    }

    /* ─── JS-driven drag: Hue ────────────────────────────────────────────── */
    private async Task HuePointerDown(PointerEventArgs e)
    {
        await UpdateHueFromClient(e.ClientX);
        await JS.InvokeVoidAsync("cpStartHueDrag", _hueRef, _dotNetRef);
    }

    [JSInvokable]
    public void OnHueDrag(double pctX)
    {
        _h = Math.Clamp(pctX, 0, 1) * 360;
        SyncHex(); Emit();
    }

    private async Task UpdateHueFromClient(double cx)
    {
        try
        {
            var b = await JS.InvokeAsync<ElemRect>("cpGetRect", _hueRef);
            _h = Math.Clamp((cx - b.Left) / b.Width, 0, 1) * 360;
            SyncHex(); Emit();
        }
        catch { }
    }

    /* ─── Hex input ───────────────────────────────────────────────────────── */
    private void HexTyping(ChangeEventArgs e)
    {
        _hexInput = e.Value?.ToString() ?? _hexInput;
        if (TryParseHex(_hexInput, out var h, out var s, out var v))
        { _h = h; _s = s; _v = v; Emit(); }
    }
    private void HexCommit(ChangeEventArgs e)
    {
        if (TryParseHex(e.Value?.ToString() ?? "", out var h, out var s, out var v))
        { _h = h; _s = s; _v = v; }
        _hexInput = HexColor; Emit();
    }
    private void ResetBlack() { _h = 0; _s = 0; _v = 0; _hexInput = "#000000"; Emit(); }

    /* ─── Presets & setters ──────────────────────────────────────────────── */
    private void SetFromHex(string hex)
    {
        if (!TryParseHex(hex, out var h, out var s, out var v)) return;
        _h = h; _s = s; _v = v; SyncHex(); Emit();
    }
    private void SetFromRgb(int r, int g, int b)
    { (_h, _s, _v) = RgbToHsv(r, g, b); SyncHex(); Emit(); }
    private void SetFromHsl(double h, double sl, double l)
    {
        var v = l + sl * Math.Min(l, 1.0 - l);
        var s = v == 0 ? 0 : 2.0 * (1.0 - l / v);
        _h = Math.Clamp(h, 0, 360); _s = Math.Clamp(s, 0, 1); _v = Math.Clamp(v, 0, 1);
        SyncHex(); Emit();
    }

    /* ─── Helpers ─────────────────────────────────────────────────────────── */
    private void SyncHex() => _hexInput = HexColor;
    private void Emit()    { _ = OnColorChanged.InvokeAsync(HexColor); StateHasChanged(); }
    private void HandleClose() => _ = OnClose.InvokeAsync();

    private static string Pct(double v) => (v * 100.0).ToString("F2", IC) + "%";
    private static string F0(double v)  => v.ToString("F0", IC);
    private static int    Ri(double v)  => (int)Math.Round(Math.Clamp(v, 0, 255));
    private static int    Clamp(object? raw, int min, int max, int fallback)
        => int.TryParse(raw?.ToString(), out var n) ? Math.Clamp(n, min, max) : fallback;
    private static double ClampD(object? raw, double min, double max, double fallback)
        => double.TryParse(raw?.ToString(), NumberStyles.Any, IC, out var n)
           ? Math.Clamp(n, min, max) : fallback;

    /* ─── Color math ──────────────────────────────────────────────────────── */
    private static (double r, double g, double b) HsvToRgb(double h, double s, double v)
    {
        if (s <= 0) { var c = v * 255; return (c, c, c); }
        var hh = h / 60.0; var i = (int)hh; var ff = hh - i;
        var p = v*(1-s); var q = v*(1-s*ff); var t = v*(1-s*(1-ff));
        return i switch
        {
            0 => (v*255, t*255, p*255), 1 => (q*255, v*255, p*255),
            2 => (p*255, v*255, t*255), 3 => (p*255, q*255, v*255),
            4 => (t*255, p*255, v*255), _ => (v*255, p*255, q*255)
        };
    }
    private static (double h, double s, double v) RgbToHsv(double r, double g, double b)
    {
        r /= 255; g /= 255; b /= 255;
        var max = Math.Max(r, Math.Max(g, b)); var min = Math.Min(r, Math.Min(g, b));
        var delta = max - min;
        double h = 0, s = max == 0 ? 0 : delta / max, v = max;
        if (delta > 0)
        {
            if      (max == r) h = (g - b) / delta % 6;
            else if (max == g) h = (b - r) / delta + 2;
            else               h = (r - g) / delta + 4;
            h *= 60; if (h < 0) h += 360;
        }
        return (h, s, v);
    }
    private static (double h, double s, double l) HsvToHsl(double h, double s, double v)
    {
        var l  = v * (1.0 - s / 2.0);
        var sl = (l == 0 || l == 1) ? 0 : (v - l) / Math.Min(l, 1.0 - l);
        return (h, sl, l);
    }
    private static bool TryParseHex(string hex, out double h, out double s, out double v)
    {
        h = s = v = 0;
        if (string.IsNullOrWhiteSpace(hex)) return false;
        hex = hex.Trim().TrimStart('#');
        if (hex.Length == 3) hex = $"{hex[0]}{hex[0]}{hex[1]}{hex[1]}{hex[2]}{hex[2]}";
        if (hex.Length != 6) return false;
        try
        {
            var r = Convert.ToInt32(hex[0..2], 16);
            var g = Convert.ToInt32(hex[2..4], 16);
            var b = Convert.ToInt32(hex[4..6], 16);
            (h, s, v) = RgbToHsv(r, g, b); return true;
        }
        catch { return false; }
    }

    /* ─── JS interop models ──────────────────────────────────────────────── */
    private class ElemRect
    {
        public double Left   { get; set; }
        public double Top    { get; set; }
        public double Width  { get; set; }
        public double Height { get; set; }
    }
    private class PickerPos
    {
        public double Left { get; set; }
        public double Top  { get; set; }
    }
}
