@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsActive)
{
    @if (_s == null || _s.Total == 0)
    {
        <div class="st-empty">
            <div class="st-empty-icon">📊</div>
            <p class="st-empty-title">No data yet</p>
            <p class="st-empty-sub">Add anime to your list to unlock your stats.</p>
        </div>
    }
    else
    {
        <!-- ══ HERO ══ -->
        <div class="st-hero">
            <div class="st-hero-main">
                <span class="st-hero-num">@_s.Total</span>
                <span class="st-hero-lbl">total anime</span>
            </div>

            <div class="st-hero-right">
                <div class="st-hero-sub">
                    <span class="st-hero-sub-num">@FormatDays(_s.TotalMinutes)</span>
                    <span class="st-hero-sub-lbl">days watched</span>
                </div>
                <div class="st-hero-sub">
                    <span class="st-hero-sub-num">@_s.TotalEpisodes.ToString("N0")</span>
                    <span class="st-hero-sub-lbl">episodes</span>
                </div>

                <!-- ── Stats filter dropdown ── -->
                <div class="st-filter-wrap" @onclick:stopPropagation="true">
                    <button class="st-filter-trigger"
                            @onclick="() => { _filterDropdownOpen = !_filterDropdownOpen; StateHasChanged(); }">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="flex-shrink:0;">
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="6" y1="12" x2="18" y2="12" />
                            <line x1="9" y1="18" x2="15" y2="18" />
                        </svg>
                        <span class="st-filter-trigger-label">Stats for</span>
                        <span class="st-filter-badge">@(_statFilter.Count + _statFilterCustomIds.Count)</span>
                        <span style="flex:1;"></span>
                        <svg class="st-filter-chevron @(_filterDropdownOpen ? "open" : "")"
                             width="11" height="11" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_filterDropdownOpen)
                    {
                        <div class="st-filter-menu">
                            @{
                                var _ddStatusRows = UserListService.GetStatusSettings()
                                    .Select(s => (isBuiltIn: true, setting: s, custom: (UserCustomList?)null))
                                    .Concat(UserListService.GetStatusTypeLists()
                                        .Select(c => (isBuiltIn: false, setting: (StatusListSetting?)null, custom: (UserCustomList?)c)))
                                    .OrderBy(x => x.isBuiltIn ? x.setting!.Order : x.custom!.Order)
                                    .ToList();
                            }
                            @foreach (var item in _ddStatusRows)
                            {
                                @if (item.isBuiltIn)
                                {
                                    var s = item.setting!;
                                    if (!Enum.TryParse<ListStatus>(s.Key, out var ls)) { continue; }
                                    var isOn = _statFilter.Contains(ls);
                                    <button class="st-filter-option @(isOn ? "st-filter-option-on" : "")"
                                            style="@(isOn ? $"background:color-mix(in srgb,{s.Color} 10%,transparent);border-color:color-mix(in srgb,{s.Color} 40%,transparent);color:{s.Color};" : "")"
                                            @onclick="() => ToggleStatFilter(ls)">
                                        <span class="st-filter-dot" style="background:@s.Color;box-shadow:0 0 5px @(s.Color)88;"></span>
                                        <span class="st-filter-name">@s.DisplayName</span>
                                        <span class="st-filter-count">@UserListService.Count(ls)</span>
                                        @if (isOn) { <svg class="st-filter-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                    </button>
                                }
                                else
                                {
                                    var cl = item.custom!;
                                    var isOnCl = _statFilterCustomIds.Contains(cl.Id);
                                    <button class="st-filter-option @(isOnCl ? "st-filter-option-on" : "")"
                                            style="@(isOnCl ? $"background:color-mix(in srgb,{cl.Color} 10%,transparent);border-color:color-mix(in srgb,{cl.Color} 40%,transparent);color:{cl.Color};" : "")"
                                            @onclick="() => ToggleStatFilterCustom(cl.Id)">
                                        <span class="st-filter-dot" style="background:@cl.Color;box-shadow:0 0 5px @(cl.Color)88;"></span>
                                        <span class="st-filter-name">@cl.Name</span>
                                        <span class="st-filter-count">@UserListService.GetCountForCustomList(cl.Id)</span>
                                        @if (isOnCl) { <svg class="st-filter-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                    </button>
                                }
                            }

                            @{
                                var _ddRegularLists = UserListService.GetRegularCustomLists();
                            }
                            @if (_ddRegularLists.Any())
                            {
                                <div class="st-filter-sep"></div>
                                @foreach (var cl in _ddRegularLists)
                                {
                                    var isOnCl = _statFilterCustomIds.Contains(cl.Id);
                                    <button class="st-filter-option @(isOnCl ? "st-filter-option-on" : "")"
                                            style="@(isOnCl ? $"background:color-mix(in srgb,{cl.Color} 10%,transparent);border-color:color-mix(in srgb,{cl.Color} 40%,transparent);color:{cl.Color};" : "")"
                                            @onclick="() => ToggleStatFilterCustom(cl.Id)">
                                        <span class="st-filter-dot" style="background:@cl.Color;box-shadow:0 0 5px @(cl.Color)88;"></span>
                                        <span class="st-filter-name">@cl.Name</span>
                                        <span class="st-filter-count">@UserListService.GetCountForCustomList(cl.Id)</span>
                                        @if (isOnCl) { <svg class="st-filter-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                    </button>
                                }
                            }

                            <div class="st-filter-actions">
                                <button class="st-filter-action-btn" @onclick="() => {
                                    _statFilter = new HashSet<ListStatus>(Enum.GetValues<ListStatus>());
                                    _statFilterCustomIds = new HashSet<string>(
                                        UserListService.GetStatusTypeLists().Select(c => c.Id)
                                        .Concat(UserListService.GetRegularCustomLists().Select(c => c.Id)));
                                    ComputeStats(); _filterDropdownOpen = false; StateHasChanged(); }">All</button>
                                <button class="st-filter-action-btn" @onclick="() => {
                                    _statFilter = new HashSet<ListStatus> { ListStatus.Completed, ListStatus.Watching };
                                    _statFilterCustomIds = new(); ComputeStats(); _filterDropdownOpen = false; StateHasChanged(); }">Reset</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ══ STATUS / LISTS ══ -->
        <div class="st-section">
            <div class="st-section-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
                Lists
            </div>

            @{
                var _listsOrdered = UserListService.GetStatusSettings()
                    .Select(s => (isBuiltIn: true, isStatus: true, setting: s, custom: (UserCustomList?)null))
                    .Concat(UserListService.GetStatusTypeLists()
                        .Select(c => (isBuiltIn: false, isStatus: true, setting: (StatusListSetting?)null, custom: (UserCustomList?)c)))
                    .OrderBy(x => x.isBuiltIn ? x.setting!.Order : x.custom!.Order)
                    .Concat(UserListService.GetRegularCustomLists()
                        .Select(c => (isBuiltIn: false, isStatus: false, setting: (StatusListSetting?)null, custom: (UserCustomList?)c)))
                    .ToList();

                var _statusItems = new List<(string name, string color, int count)>();
                var _customItems = new List<(string name, string color, int count)>();

                foreach (var item in _listsOrdered)
                {
                    if (item.isBuiltIn)
                    {
                        if (!Enum.TryParse<ListStatus>(item.setting!.Key, out var ls)) continue;
                        var cnt = _s.ByStatus.GetValueOrDefault(ls, 0);
                        _statusItems.Add((item.setting.DisplayName, item.setting.Color, cnt));
                    }
                    else
                    {
                        var cnt = UserListService.GetCountForCustomList(item.custom!.Id);
                        if (item.isStatus) _statusItems.Add((item.custom.Name, item.custom.Color, cnt));
                        else _customItems.Add((item.custom.Name, item.custom.Color, cnt));
                    }
                }

                var _maxListCount = _statusItems.Concat(_customItems).DefaultIfEmpty().Max(x => x == default ? 0 : x.count);
            }

            <div class="st-status-grid">
                @foreach (var (name, color, count) in _statusItems)
                {
                    var pct = _maxListCount > 0 ? count * 100.0 / _maxListCount : 0;
                    <div class="st-status-row">
                        <span class="st-status-dot" style="background:@color;box-shadow:0 0 5px @(color)88;"></span>
                        <span class="st-status-name">@name</span>
                        <div class="st-status-bar-wrap"><div class="st-status-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@color;"></div></div>
                        <span class="st-status-count">@count</span>
                    </div>
                }
            </div>

            @if (_customItems.Any())
            {
                <div class="st-filter-sep" style="margin: 8px 0;"></div>
                <div class="st-status-grid">
                    @foreach (var (name, color, count) in _customItems)
                    {
                        var pct = _maxListCount > 0 ? count * 100.0 / _maxListCount : 0;
                        <div class="st-status-row">
                            <span class="st-status-dot" style="background:@color;box-shadow:0 0 5px @(color)88;"></span>
                            <span class="st-status-name">@name</span>
                            <div class="st-status-bar-wrap"><div class="st-status-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@color;"></div></div>
                            <span class="st-status-count">@count</span>
                        </div>
                    }
                </div>
            }

            <div class="st-completion-row">
                <span class="st-status-dot" style="background:transparent;box-shadow:none;"></span>
                <span class="st-completion-lbl">Completion</span>
                <div class="st-completion-bar-wrap"><div class="st-completion-bar" style="width:@_s.CompletionRate.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                <span class="st-status-count" style="color:#93c5fd;">@_s.CompletionRate.ToString("F0")%</span>
            </div>
        </div>

        <!-- ══ SCORES ══ -->
        @if (_s.ScoredCount > 0)
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                    Scores
                    <span class="st-section-meta">@_s.ScoredCount scored · avg <strong style="color:@GetScoreColor(_s.AvgScore)">@_s.AvgScore.ToString("F1")</strong></span>
                </div>
                <div class="st-score-chart">
                    @{ var maxScoreCount = _s.ScoreDist2.Values.DefaultIfEmpty(1).Max(); }
                    @for (decimal sc = 10m; sc >= 0.5m; sc -= 0.5m)
                    {
                        var key = sc.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                        var count = _s.ScoreDist2.GetValueOrDefault(key, 0);
                        if (count == 0) { continue; }
                        var barPct = maxScoreCount > 0 ? Math.Max(3.0, count * 100.0 / maxScoreCount) : 0;
                        <div class="st-score-row">
                            <span class="st-score-label">@key</span>
                            <div class="st-score-bar-wrap"><div class="st-score-bar-fill" style="width:@barPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@GetScoreBarColorDouble((double)sc);"></div></div>
                            <span class="st-score-count">@count</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ WATCH TIME ══ -->
        @if (_s.TotalMinutes > 0)
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                    </svg>
                    Watch Time
                </div>
                <div class="st-time-grid">
                    <div class="st-time-cell"><span class="st-time-val">@FormatHours(_s.TotalMinutes)</span><span class="st-time-lbl">hours total</span></div>
                    <div class="st-time-cell"><span class="st-time-val">@FormatDays(_s.TotalMinutes)</span><span class="st-time-lbl">days total</span></div>
                    @if (_s.DaysPlanned > 0) { <div class="st-time-cell"><span class="st-time-val">@_s.DaysPlanned.ToString("F1")</span><span class="st-time-lbl">days planned</span></div> }
                    @if (_s.Rewatched > 0) { <div class="st-time-cell"><span class="st-time-val">@_s.Rewatched</span><span class="st-time-lbl">rewatched</span></div> }
                </div>
                @if (_s.LongestAnime != null)
                {
                    <div class="st-longest-row">
                        <span class="st-longest-lbl">⏱ Most time spent</span>
                        <span class="st-longest-title">@TruncateTitle(_s.LongestAnime.Anime.Title)</span>
                        <span class="st-longest-dur">@FormatMinutes(GetAnimeMinutes(_s.LongestAnime.Anime))</span>
                    </div>
                }
            </div>
        }

        <!-- ══ GENRES ══ -->
        @if (_s.TopGenres.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" />
                        <circle cx="3" cy="6" r="1" fill="currentColor" stroke="none" /><circle cx="3" cy="12" r="1" fill="currentColor" stroke="none" /><circle cx="3" cy="18" r="1" fill="currentColor" stroke="none" />
                    </svg>
                    Genres
                    <span class="st-section-meta">@_s.UniqueGenres unique</span>
                </div>
                <div class="st-genre-radar-wrap">@((MarkupString)BuildGenreRadarSvg(_s.TopGenres))</div>
            </div>
        }

        <!-- ══ FORMATS — bar chart, only formats with count > 0 ══ -->
        @if (_s.ByFormat.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 3H8" />
                    </svg>
                    Formats
                </div>
                <div class="st-bar-list">
                    @{ var maxFmt = _s.ByFormat.Values.Max(); }
                    @foreach (var kv in _s.ByFormat.OrderByDescending(x => x.Value).Where(x => x.Value > 0))
                    {
                        var pct = maxFmt > 0 ? kv.Value * 100.0 / maxFmt : 0;
                        <div class="st-bar-row">
                            <span class="st-bar-name">@kv.Key</span>
                            <div class="st-bar-track">
                                <div class="st-bar-fill st-bar-format" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                            <span class="st-bar-val">@kv.Value</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ STUDIOS ══ -->
        @if (_s.TopStudios.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" />
                    </svg>
                    Studios
                    <span class="st-section-meta">@_s.UniqueStudios unique</span>
                </div>
                <div class="st-bar-list">
                    @{ var maxS = _s.TopStudios.FirstOrDefault().Value; }
                    @foreach (var kv in _s.TopStudios.Take(8))
                    {
                        var pct = maxS > 0 ? kv.Value * 100.0 / maxS : 0;
                        <div class="st-bar-row">
                            <span class="st-bar-name">@kv.Key</span>
                            <div class="st-bar-track"><div class="st-bar-fill st-bar-studio" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                            <span class="st-bar-val">@kv.Value</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ RELEASE YEAR ══ -->
        @if (_s.ByYear.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    Release Year
                    <span class="st-section-meta">@_s.ByYear.Count years</span>
                </div>
                <div class="st-year-anilist" @ref="_yearChartRef">
                    @{ var yearsSorted = _s.ByYear.OrderBy(x => x.Key).ToList(); var maxY = yearsSorted.Max(x => x.Value); }
                    @foreach (var kv in yearsSorted)
                    {
                        var pct = maxY > 0 ? kv.Value * 100.0 / maxY : 0;
                        <div class="st-year-al-col" title="@kv.Key: @kv.Value anime">
                            <span class="st-year-al-count @(kv.Value == maxY ? "st-year-al-peak" : "")">@(kv.Value > 0 ? kv.Value.ToString() : "")</span>
                            <div class="st-year-al-bar-wrap"><div class="st-year-al-bar-fill @(kv.Value == maxY ? "st-year-al-fill-peak" : "")" style="height:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                            <span class="st-year-al-lbl">@kv.Key</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ SEASONS ══ -->
        @if (_s.BySeason.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                    Seasons
                </div>
                <div class="st-season-grid">
                    @{ var maxSeason = _s.BySeason.Values.DefaultIfEmpty(0).Max(); var seasonTot = _s.BySeason.Values.Sum(); }
                    @foreach (var season in new[] { "WINTER", "SPRING", "SUMMER", "FALL" })
                    {
                        var count = _s.BySeason.GetValueOrDefault(season, 0);
                        var pct = seasonTot > 0 ? count * 100.0 / seasonTot : 0;
                        <div class="st-season-cell @(count == maxSeason && count > 0 ? "st-season-top" : "")">
                            <span class="st-season-name">@(season[0] + season[1..].ToLower())</span>
                            <span class="st-season-count">@count</span>
                            <span class="st-season-pct">@pct.ToString("F0")%</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ SOURCE MATERIAL ══ -->
        @if (_s.BySource.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </svg>
                    Source Material
                </div>
                <div class="st-bar-list">
                    @{ var maxSrc = _s.BySource.Values.DefaultIfEmpty(1).Max(); }
                    @foreach (var kv in _s.BySource.OrderByDescending(x => x.Value))
                    {
                        var pct = maxSrc > 0 ? kv.Value * 100.0 / maxSrc : 0;
                        <div class="st-bar-row">
                            <span class="st-bar-name">@kv.Key</span>
                            <div class="st-bar-track"><div class="st-bar-fill st-bar-source" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                            <span class="st-bar-val">@kv.Value</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ COUNTRY ══ -->
        @if (_s.ByCountry.Count > 1)
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" />
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                    Country of Origin
                </div>
                @{ var countrySorted = _s.ByCountry.OrderByDescending(x => x.Value).ToList(); }
                <div class="st-pie-wrap">@((MarkupString)BuildPieSvg(countrySorted))</div>
                <div class="st-radar-legend">
                    @{ var pieColors = new[] { "#E94560", "#3b82f6", "#22c55e", "#f97316", "#a855f7", "#06b6d4" }; int ci = 0; }
                    @foreach (var kv in countrySorted)
                    {
                        var name = kv.Key switch { "JP" => "Japan", "CN" => "China", "KR" => "South Korea", "TW" => "Taiwan", _ => kv.Key };
                        var pctC = _s.FilteredTotal > 0 ? kv.Value * 100.0 / _s.FilteredTotal : 0;
                        var color = pieColors[ci % pieColors.Length]; ci++;
                        <div class="st-radar-legend-item">
                            <span class="st-radar-legend-dot" style="background:@color;"></span>
                            <span class="st-radar-legend-name">@name</span>
                            <span class="st-radar-legend-val">@kv.Value <span class="st-radar-legend-pct">(@pctC.ToString("F0")%)</span></span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ TAGS ══ -->
        @if (_s.TopTags.Any())
        {
            <div class="st-section">
                <div class="st-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" />
                    </svg>
                    Top Tags
                </div>
                <div class="st-tags-wrap">
                    @foreach (var kv in _s.TopTags.Take(24))
                    {
                        <span class="st-tag">@kv.Key<span class="st-tag-count">@kv.Value</span></span>
                    }
                </div>
            </div>
        }

        <!-- ══ ENGAGEMENT ══ -->
        <div class="st-section">
            <div class="st-section-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
                Engagement
            </div>
            <div class="st-engage-grid">
                <div class="st-engage-cell"><span class="st-engage-val">@_s.WithNotes</span><span class="st-engage-lbl">with notes</span></div>
                <div class="st-engage-cell"><span class="st-engage-val">@_s.Rewatched</span><span class="st-engage-lbl">rewatched</span></div>
                <div class="st-engage-cell"><span class="st-engage-val">@_s.TotalMovies</span><span class="st-engage-lbl">movies</span></div>
                <div class="st-engage-cell"><span class="st-engage-val">@_s.DropRate.ToString("F0")%</span><span class="st-engage-lbl">drop rate</span></div>
                <div class="st-engage-cell"><span class="st-engage-val">@_s.Private</span><span class="st-engage-lbl">private</span></div>
                <div class="st-engage-cell"><span class="st-engage-val">@_s.Favorited</span><span class="st-engage-lbl">favourited</span></div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public bool IsActive { get; set; }

    private bool _prevActive = false;
    private HashSet<ListStatus> _statFilter = new() { ListStatus.Completed, ListStatus.Watching };
    private HashSet<string> _statFilterCustomIds = new();
    private bool _filterDropdownOpen = false;
    private ElementReference _yearChartRef;
    private bool _scrollYearToRight = false;
    private StatsSnapshot? _s;

    protected override void OnInitialized() => UserListService.OnChanged += HandleStatsRefresh;
    public void Dispose() => UserListService.OnChanged -= HandleStatsRefresh;

    protected override void OnParametersSet()
    {
        bool justActivated = IsActive && !_prevActive;
        _prevActive = IsActive;
        if (justActivated) ComputeStats();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollYearToRight)
        {
            _scrollYearToRight = false;
            try { await JS.InvokeVoidAsync("eval", "setTimeout(()=>{const e=document.querySelector('.st-year-anilist');if(e)e.scrollLeft=e.scrollWidth;},50)"); }
            catch { }
        }
    }

    private void HandleStatsRefresh()
    {
        if (IsActive) { ComputeStats(); InvokeAsync(StateHasChanged); }
    }

    private void ToggleStatFilter(ListStatus status)
    {
        if (!_statFilter.Remove(status)) _statFilter.Add(status);
        ComputeStats(); StateHasChanged();
    }

    private void ToggleStatFilterCustom(string id)
    {
        if (!_statFilterCustomIds.Remove(id)) _statFilterCustomIds.Add(id);
        ComputeStats(); StateHasChanged();
    }

    private void ComputeStats()
    {
        var all = UserListService.GetAll()
            .Where(e => e.Status.HasValue || e.CustomListIds.Any())
            .GroupBy(e => e.Anime.Id)
            .Select(g => g.OrderByDescending(e => e.UpdatedAt).First())
            .ToList();

        var s = new StatsSnapshot { Total = all.Count };
        if (s.Total == 0) { _s = s; return; }

        s.Favorited = UserListService.GetFavoriteIds().Count;

        foreach (var e in all)
        {
            if (e.Status.HasValue)
                s.ByStatus[e.Status.Value] = s.ByStatus.GetValueOrDefault(e.Status.Value) + 1;

            int totalEp = GetTotalEpsFromString(e.Anime.Episodes);
            int baseEp  = e.EpisodesWatched;

            bool isMovie   = string.Equals(e.Anime.Format, "Movie",    StringComparison.OrdinalIgnoreCase);
            bool isMusic   = string.Equals(e.Anime.Format, "Music",    StringComparison.OrdinalIgnoreCase);
            bool isTvShort = string.Equals(e.Anime.Format, "TV Short", StringComparison.OrdinalIgnoreCase);

            // AniList stores progress=0 for completed entries — fall back to totalEp.
            if (baseEp == 0 && totalEp > 0 &&
                (e.Status == ListStatus.Completed || e.Status == ListStatus.Rewatching))
            {
                baseEp = totalEp;
            }

            // Movie counter (Completed / Watching / Rewatching only)
            if (isMovie &&
                (e.Status == ListStatus.Completed ||
                 e.Status == ListStatus.Watching  ||
                 e.Status == ListStatus.Rewatching))
            {
                s.TotalMovies++;
            }

            // Rewatching: the original watch is not yet in TotalRewatches — add 1.
            bool isRewatchingNow    = e.Status == ListStatus.Rewatching;
            int  effectiveRewatches = e.TotalRewatches + (isRewatchingNow ? 1 : 0);

            // Episode counter: skip Movie, Music and TV Short
            if (!isMovie && !isMusic && !isTvShort)
            {
                int rwEp = 0;
                if (effectiveRewatches > 0 && e.Status != ListStatus.Planning)
                {
                    if (totalEp > 0) rwEp = effectiveRewatches * totalEp;
                    else if (baseEp > 0) rwEp = effectiveRewatches * baseEp;
                }
                s.TotalEpisodes += baseEp + rwEp;
            }

            // Watch time: all formats (movies contribute their runtime too)
            if (e.Status != ListStatus.Planning)
            {
                int dur = e.Anime.Duration ?? (isMovie ? 90 : 24);
                s.TotalMinutes += (long)baseEp * dur;
                if (effectiveRewatches > 0)
                {
                    if (totalEp > 0) s.TotalMinutes += (long)effectiveRewatches * totalEp * dur;
                    else if (baseEp > 0) s.TotalMinutes += (long)effectiveRewatches * baseEp * dur;
                }
            }

            if (e.Status == ListStatus.Planning)
            {
                // Count only episodes not yet watched, so partially-started planning
                // entries don't inflate the planned time.
                int remaining = totalEp > 0 ? Math.Max(0, totalEp - baseEp) : 0;
                if (remaining > 0)
                    s.DaysPlanned += remaining * (e.Anime.Duration ?? (isMovie ? 90 : 24)) / 1440.0;
            }

            if (!string.IsNullOrEmpty(e.Notes)) s.WithNotes++;
            if (e.TotalRewatches > 0) s.Rewatched++;
            if (e.IsPrivate) s.Private++;
        }

        int completed = s.ByStatus.GetValueOrDefault(ListStatus.Completed);
        int dropped   = s.ByStatus.GetValueOrDefault(ListStatus.Dropped);
        int watching  = s.ByStatus.GetValueOrDefault(ListStatus.Watching)
                      + s.ByStatus.GetValueOrDefault(ListStatus.Rewatching);
        int paused    = s.ByStatus.GetValueOrDefault(ListStatus.Paused);
        int denom     = completed + watching + paused + dropped;
        s.CompletionRate = denom > 0 ? completed * 100.0 / denom : 0;
        s.DropRate       = s.Total > 0 ? dropped * 100.0 / s.Total : 0;

        s.LongestAnime = all
            .Where(e => e.Anime.Duration.HasValue && e.EpisodesWatched > 0 && e.Status != ListStatus.Planning)
            .OrderByDescending(e => e.EpisodesWatched * (e.Anime.Duration ?? 0))
            .FirstOrDefault();

        IEnumerable<UserListEntry> filteredQuery = all;
        if (_statFilter.Any() || _statFilterCustomIds.Any())
        {
            filteredQuery = all.Where(e =>
            {
                bool statusMatch = _statFilter.Any() && e.Status.HasValue && _statFilter.Contains(e.Status.Value);
                bool customMatch = _statFilterCustomIds.Any() && e.CustomListIds.Any(id => _statFilterCustomIds.Contains(id));
                if (_statFilter.Any() && _statFilterCustomIds.Any()) return statusMatch || customMatch;
                if (_statFilter.Any()) return statusMatch;
                if (_statFilterCustomIds.Any()) return customMatch;
                return true;
            });
        }
        var filtered = filteredQuery.ToList();
        s.FilteredTotal = filtered.Count;

        foreach (var e in filtered)
        {
            if (e.Score <= 0) continue;
            s.ScoredCount++;
            s.AvgScore += e.Score;
            decimal scoreD  = (decimal)Math.Round(e.Score, 1);
            decimal rounded = Math.Round(scoreD * 2m, MidpointRounding.AwayFromZero) / 2m;
            rounded = Math.Clamp(rounded, 0.5m, 10.0m);
            string key = rounded.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
            s.ScoreDist2[key] = s.ScoreDist2.GetValueOrDefault(key) + 1;
            int bucket = Math.Clamp((int)Math.Round(e.Score, MidpointRounding.AwayFromZero), 1, 10);
            s.ScoreDist[bucket] = s.ScoreDist.GetValueOrDefault(bucket) + 1;
        }
        if (s.ScoredCount > 0) s.AvgScore /= s.ScoredCount;

        foreach (var e in filtered)
        {
            var seenG = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var g in e.Anime.Genres ?? new())
                if (seenG.Add(g)) s.TopGenres[g] = s.TopGenres.GetValueOrDefault(g) + 1;

            if (!string.IsNullOrEmpty(e.Anime.Format))
                s.ByFormat[e.Anime.Format] = s.ByFormat.GetValueOrDefault(e.Anime.Format) + 1;

            var seenSt = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var st in e.Anime.Studios ?? new())
                if (!string.IsNullOrEmpty(st.Name) && seenSt.Add(st.Name))
                    s.TopStudios[st.Name] = s.TopStudios.GetValueOrDefault(st.Name) + 1;

            if (e.Anime.Year.HasValue)
                s.ByYear[e.Anime.Year.Value] = s.ByYear.GetValueOrDefault(e.Anime.Year.Value) + 1;
            if (!string.IsNullOrEmpty(e.Anime.Season))
                s.BySeason[e.Anime.Season] = s.BySeason.GetValueOrDefault(e.Anime.Season) + 1;
            if (!string.IsNullOrEmpty(e.Anime.Source))
                s.BySource[e.Anime.Source] = s.BySource.GetValueOrDefault(e.Anime.Source) + 1;
            if (!string.IsNullOrEmpty(e.Anime.CountryOfOrigin))
                s.ByCountry[e.Anime.CountryOfOrigin] = s.ByCountry.GetValueOrDefault(e.Anime.CountryOfOrigin) + 1;

            var seenT = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var t in e.Anime.Tags?.Where(t => !t.IsMediaSpoiler) ?? Enumerable.Empty<AnimeTag>())
                if (seenT.Add(t.Name)) s.TopTags[t.Name] = s.TopTags.GetValueOrDefault(t.Name) + 1;
        }

        s.UniqueGenres  = s.TopGenres.Count;
        s.UniqueStudios = s.TopStudios.Count;
        s.TopGenres  = s.TopGenres.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);
        s.TopStudios = s.TopStudios.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);
        s.TopTags    = s.TopTags.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);

        _scrollYearToRight = s.ByYear.Any();
        _s = s;
    }

    // ── Genre radar chart ─────────────────────────────────────────────────
    private static readonly string[] _genreOrder =
    {
        "Action","Adventure","Comedy","Drama","Ecchi","Fantasy","Hentai","Horror",
        "Mahou Shoujo","Mecha","Music","Mystery","Psychological","Romance","Sci-Fi",
        "Slice of Life","Sports","Supernatural","Thriller","Avant Garde",
        "Award Winning","Boys Love","Girls Love","Gourmet","Erotica","Suspense",
    };

    private static string BuildGenreRadarSvg(Dictionary<string, int> genres)
    {
        var ordered = _genreOrder
            .Where(g => genres.ContainsKey(g))
            .Select(g => new KeyValuePair<string, int>(g, genres[g]))
            .ToList();

        foreach (var kv in genres)
            if (!_genreOrder.Contains(kv.Key, StringComparer.OrdinalIgnoreCase))
                ordered.Add(kv);

        var items = ordered.Take(16).ToList();
        int n = items.Count;
        if (n < 3) return "";

        double maxVal = items.Max(x => x.Value);
        if (maxVal == 0) return "";

        const double cx = 140, cy = 140, r = 88;

        const string userStroke = "#E94560";
        const string userFill   = "rgba(233,69,96,0.15)";
        const string axisStroke = "rgba(255,255,255,0.12)";
        const string nameCol    = "rgba(255,255,255,0.70)";
        const string countCol   = "rgba(233,69,96,0.85)";

        string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        double Angle(int i) => 2 * Math.PI * i / n - Math.PI / 2;
        double Px(double frac, int i) => cx + r * frac * Math.Cos(Angle(i));
        double Py(double frac, int i) => cy + r * frac * Math.Sin(Angle(i));

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 280 280\" xmlns=\"http://www.w3.org/2000/svg\" class=\"st-genre-radar-svg\">");

        // ── Axis lines ───────────────────────────────────────────────────
        for (int i = 0; i < n; i++)
            sb.Append($"<line x1=\"{F(cx)}\" y1=\"{F(cy)}\" x2=\"{F(Px(1, i))}\" y2=\"{F(Py(1, i))}\" stroke=\"{axisStroke}\" stroke-width=\"0.8\"/>");

        // ── User polygon ─────────────────────────────────────────────────
        var userPts = string.Join(" ", Enumerable.Range(0, n)
            .Select(i => $"{F(Px(items[i].Value / maxVal, i))},{F(Py(items[i].Value / maxVal, i))}"));
        sb.Append($"<polygon points=\"{userPts}\" fill=\"{userFill}\" stroke=\"{userStroke}\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>");

        // ── Dots ─────────────────────────────────────────────────────────
        for (int i = 0; i < n; i++)
        {
            double frac = items[i].Value / maxVal;
            sb.Append($"<circle cx=\"{F(Px(frac, i))}\" cy=\"{F(Py(frac, i))}\" r=\"2.8\" fill=\"{userStroke}\" stroke=\"#0e1420\" stroke-width=\"1\"/>");
        }

        // ── Full name + count labels ──────────────────────────────────────
        for (int i = 0; i < n; i++)
        {
            double lFrac = 1.22;
            double lx = cx + r * lFrac * Math.Cos(Angle(i));
            double ly = cy + r * lFrac * Math.Sin(Angle(i));
            string anchor = lx < cx - 3 ? "end" : lx > cx + 3 ? "start" : "middle";
            string name  = System.Net.WebUtility.HtmlEncode(items[i].Key);
            string count = items[i].Value.ToString();
            sb.Append($"<text x=\"{F(lx)}\" y=\"{F(ly - 5)}\" text-anchor=\"{anchor}\" dominant-baseline=\"middle\" font-size=\"7.5\" font-weight=\"600\" fill=\"{nameCol}\" font-family=\"system-ui,-apple-system,sans-serif\">{name}</text>");
            sb.Append($"<text x=\"{F(lx)}\" y=\"{F(ly + 5)}\" text-anchor=\"{anchor}\" dominant-baseline=\"middle\" font-size=\"7\" font-weight=\"700\" fill=\"{countCol}\" font-family=\"system-ui,-apple-system,sans-serif\">{count}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

    // ── Pie / donut — parallel edges via background-colour stroke ────────
    private static string BuildPieSvg(List<KeyValuePair<string, int>> items)
    {
        if (!items.Any()) return "";
        var colors = new[] { "#E94560", "#3b82f6", "#22c55e", "#f97316", "#a855f7", "#06b6d4" };
        double total = items.Sum(x => x.Value);
        if (total == 0) return "";
        const double cx = 100, cy = 100, outerR = 76, innerR = 48;
        string F(double v) => v.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\" class=\"st-pie-svg\">");
        // Draw all filled slices with no angular gap
        double angle = -Math.PI / 2;
        for (int i = 0; i < items.Count; i++)
        {
            double sw = 2 * Math.PI * items[i].Value / total;
            double ea = angle + sw;
            double x1  = cx + outerR * Math.Cos(angle), y1  = cy + outerR * Math.Sin(angle);
            double x2  = cx + outerR * Math.Cos(ea),    y2  = cy + outerR * Math.Sin(ea);
            double xi1 = cx + innerR * Math.Cos(angle), yi1 = cy + innerR * Math.Sin(angle);
            double xi2 = cx + innerR * Math.Cos(ea),    yi2 = cy + innerR * Math.Sin(ea);
            int large  = sw > Math.PI ? 1 : 0;
            string pathD = $"M {F(xi1)} {F(yi1)} L {F(x1)} {F(y1)} A {F(outerR)} {F(outerR)} 0 {large} 1 {F(x2)} {F(y2)} L {F(xi2)} {F(yi2)} A {F(innerR)} {F(innerR)} 0 {large} 0 {F(xi1)} {F(yi1)} Z";
            sb.Append($"<path d=\"{pathD}\" fill=\"{colors[i % colors.Length]}\"/>");
            angle += sw;
        }
        // Overlay radial lines in background colour → perfectly parallel edges at every depth
        angle = -Math.PI / 2;
        for (int i = 0; i < items.Count; i++)
        {
            double sw = 2 * Math.PI * items[i].Value / total;
            double lx1 = cx + innerR * Math.Cos(angle), ly1 = cy + innerR * Math.Sin(angle);
            double lx2 = cx + outerR * Math.Cos(angle), ly2 = cy + outerR * Math.Sin(angle);
            sb.Append($"<line x1=\"{F(lx1)}\" y1=\"{F(ly1)}\" x2=\"{F(lx2)}\" y2=\"{F(ly2)}\" stroke=\"#14141f\" stroke-width=\"2.5\"/>");
            angle += sw;
        }
        // Center hole
        sb.Append($"<circle cx=\"100\" cy=\"100\" r=\"{F(innerR)}\" fill=\"#14141f\"/>");
        sb.Append("<text x=\"100\" y=\"94\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"20\" font-weight=\"800\" fill=\"rgba(255,255,255,0.92)\">" + (int)total + "</text>");
        sb.Append("<text x=\"100\" y=\"110\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"8\" font-weight=\"600\" fill=\"rgba(255,255,255,0.28)\" letter-spacing=\"0.8\">ANIME</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    // ── Static helpers ────────────────────────────────────────────────────

    private static int GetTotalEpsFromString(string? s)
    {
        if (string.IsNullOrWhiteSpace(s) || s == "N/A") return 0;
        var p = s.Split('/').Last().Trim().TrimEnd('+', '?');
        return int.TryParse(p, out int v) && v > 0 ? v : 0;
    }

    private static string FormatDays(long min)  { double d = min / 1440.0; return d >= 1 ? d.ToString("F1") : (min / 60.0).ToString("F1"); }
    private static string FormatHours(long min) => (min / 60.0).ToString("F0");
    private static string FormatMinutes(long min)
    {
        if (min >= 1440) return (min / 1440.0).ToString("F1") + " days";
        if (min >= 60)   return (min / 60.0).ToString("F0") + " hrs";
        return min + " min";
    }
    private static long GetAnimeMinutes(AnimeCard a)
    {
        int eps = 1;
        if (!string.IsNullOrEmpty(a.Episodes) && a.Episodes != "N/A")
        {
            var p = a.Episodes.Split('/').Last().Trim().TrimEnd('+', '?');
            if (int.TryParse(p, out int v) && v > 0) eps = v;
        }
        bool isMovie = string.Equals(a.Format, "Movie", StringComparison.OrdinalIgnoreCase);
        return eps * (long)(a.Duration ?? (isMovie ? 90 : 24));
    }
    private static string TruncateTitle(string t)           => t.Length > 28 ? t[..26] + "…" : t;
    private static string GetScoreColor(double sc)          => sc >= 8.5 ? "#22c55e" : sc >= 7 ? "#84cc16" : sc >= 5 ? "#eab308" : sc >= 3 ? "#f97316" : "#ef4444";
    private static string GetScoreBarColorDouble(double sc) => sc >= 9 ? "#22c55e" : sc >= 7 ? "#84cc16" : sc >= 5 ? "#eab308" : sc >= 3 ? "#f97316" : "#ef4444";

    // ── StatsSnapshot ─────────────────────────────────────────────────────

    private class StatsSnapshot
    {
        public int    Total          { get; set; }
        public int    TotalEpisodes  { get; set; }
        public int    TotalMovies    { get; set; }
        public long   TotalMinutes   { get; set; }
        public int    Favorited      { get; set; }
        public int    Rewatched      { get; set; }
        public int    Private        { get; set; }
        public int    WithNotes      { get; set; }
        public double DaysPlanned    { get; set; }
        public double CompletionRate { get; set; }
        public double DropRate       { get; set; }
        public Dictionary<ListStatus, int> ByStatus     { get; set; } = new();
        public UserListEntry?              LongestAnime { get; set; }
        public int    FilteredTotal  { get; set; }
        public int    ScoredCount    { get; set; }
        public double AvgScore       { get; set; }
        public int    UniqueGenres   { get; set; }
        public int    UniqueStudios  { get; set; }
        public Dictionary<string, int> ScoreDist2  { get; set; } = new();
        public Dictionary<int,    int> ScoreDist   { get; set; } = new();
        public Dictionary<string, int> TopGenres   { get; set; } = new();
        public Dictionary<string, int> ByFormat    { get; set; } = new();
        public Dictionary<string, int> TopStudios  { get; set; } = new();
        public Dictionary<int,    int> ByYear      { get; set; } = new();
        public Dictionary<string, int> BySeason    { get; set; } = new();
        public Dictionary<string, int> BySource    { get; set; } = new();
        public Dictionary<string, int> ByCountry   { get; set; } = new();
        public Dictionary<string, int> TopTags     { get; set; } = new();
    }
}
