@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject HttpClient Http
@inject AniListService AniListService
@implements IDisposable

@if (IsVisible)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.97);z-index:9999;overflow-y:auto;padding:16px;font-family:monospace;font-size:11px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <span style="color:#E94560;font-weight:bold;font-size:15px;">Debug Panel v7</span>
            <button @onclick="Hide" style="background:#333;border:none;color:white;padding:6px 14px;border-radius:6px;cursor:pointer;">Close</button>
        </div>

        <!-- ═══════════════════════════════ RATE LIMITS ═══════════════════════════ -->
        <div style="background:#1a1a2e;border:1px solid #333;border-radius:8px;padding:12px;margin-bottom:10px;">
            <div style="color:#ffd43b;font-weight:bold;margin-bottom:10px;">RATE LIMIT STATUS</div>

            @{ RenderRateLimitBar("AniList GraphQL", "#02a9ff", AniListService.AniListRateLimit); }
            <div style="height:10px;"></div>
            @{ RenderRateLimitBar("Jikan REST", "#ff9f43", AniListService.JikanRateLimit); }
        </div>

        <!-- ═══════════════════════════════ TEST 1 ════════════════════════════════ -->
        <div style="background:#1a1a2e;border:1px solid #333;border-radius:8px;padding:10px;margin-bottom:10px;">
            <div style="color:#ffd43b;font-weight:bold;margin-bottom:6px;">TEST — GetAnimeByMalIdAsync</div>
            <div style="display:flex;gap:8px;">
                <input @bind="testMalId" style="flex:1;background:#0d0d1a;border:1px solid #444;color:white;padding:6px;border-radius:5px;font-family:monospace;" placeholder="MAL ID (e.g. 21)" />
                <button @onclick="TestViaService" disabled="@isTesting"
                        style="background:#E94560;border:none;color:white;padding:6px 12px;border-radius:5px;cursor:pointer;">
                    @(isTesting ? "..." : "Run")
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════ TEST 2 ════════════════════════════════ -->
        <div style="background:#1a1a2e;border:1px solid #333;border-radius:8px;padding:10px;margin-bottom:10px;">
            <div style="color:#ffd43b;font-weight:bold;margin-bottom:6px;">TEST — PostGraphQL + header dump</div>
            <div style="display:flex;gap:8px;">
                <input @bind="testMalId2" style="flex:1;background:#0d0d1a;border:1px solid #444;color:white;padding:6px;border-radius:5px;font-family:monospace;" placeholder="MAL ID" />
                <button @onclick="TestPostGraphQLClone" disabled="@isTesting"
                        style="background:#0ea5e9;border:none;color:white;padding:6px 12px;border-radius:5px;cursor:pointer;">
                    @(isTesting ? "..." : "Run + Headers")
                </button>
            </div>
            <div style="color:#555;font-size:10px;margin-top:4px;">Dumps all response headers to logs for inspection.</div>
        </div>

        <!-- ═══════════════════════════════ LOGS ══════════════════════════════════ -->
        <div style="background:#0a0a0f;border:1px solid #222;border-radius:8px;padding:10px;min-height:100px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                <span style="color:#888;font-size:10px;">LOGS (@logs.Count)</span>
                <button @onclick="() => logs.Clear()" style="background:transparent;border:1px solid #333;color:#666;padding:2px 8px;border-radius:4px;cursor:pointer;font-size:10px;">Clear</button>
            </div>
            @foreach (var log in logs)
            {
                var col = log.StartsWith("ERR") || log.StartsWith("NULL") || log.StartsWith("FAIL") || log.StartsWith("EXC") ? "#ff6b6b"
                        : log.StartsWith("OK") || log.StartsWith("FOUND") || log.StartsWith("SUCCESS")                       ? "#51cf66"
                        : log.StartsWith("===") || log.StartsWith("---")                                                       ? "#ffd43b"
                        : log.StartsWith("WARN") || log.StartsWith("HDR")                                                     ? "#ff9f43"
                        : "#c8c8c8";
                <div style="color:@col;padding:2px 0;border-bottom:1px solid #111;word-break:break-all;line-height:1.5;">@log</div>
            }
        </div>
    </div>
}

@* ─── Render helper (called inside markup — returns void, writes to DOM via Blazor) ─── *@
@code {

    private void RenderRateLimitBar(string label, string accentColor, RateLimitInfo info)
    {
        // This is rendered inline above via RenderFragment delegation via StateHasChanged
        // Actual rendering is done with direct style below
    }

    // Build bar HTML as MarkupString so we can call it from @{ } blocks in markup
    private RenderFragment RateLimitBar(string label, string accent, RateLimitInfo info) => builder =>
    {
        double pct = info.UsedPercent;
        string barColor = info.IsLimited ? "#ff6b6b"
                        : pct >= 85 ? "#ff6b6b"
                        : pct >= 60 ? "#ffd43b"
                        : "#51cf66";

        string limitedBadge = info.IsLimited ? " 🚫 RATE LIMITED" : "";

        builder.OpenElement(0, "div");
            // Row: label left, count right
            builder.OpenElement(1, "div");
            builder.AddAttribute(2, "style", "display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;");
                builder.OpenElement(3, "span");
                builder.AddAttribute(4, "style", $"color:{accent};font-weight:bold;font-size:11px;");
                builder.AddContent(5, label + limitedBadge);
                builder.CloseElement();

                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "style", $"color:{barColor};font-weight:bold;font-size:12px;");
                builder.AddContent(8, info.Label);
                builder.CloseElement();
            builder.CloseElement();

            // Progress track
            builder.OpenElement(9, "div");
            builder.AddAttribute(10, "style", "background:#0d0d1a;border-radius:4px;height:7px;overflow:hidden;");
                builder.OpenElement(11, "div");
                builder.AddAttribute(12, "style", $"height:100%;width:{pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%;background:{barColor};border-radius:4px;transition:width 0.4s ease;");
                builder.CloseElement();
            builder.CloseElement();

            // Reset / sent counters
            builder.OpenElement(13, "div");
            builder.AddAttribute(14, "style", "display:flex;justify-content:space-between;margin-top:3px;");
                // Left: countdown
                builder.OpenElement(15, "span");
                builder.AddAttribute(16, "style", "color:#888;font-size:10px;");
                if (info.ResetAt.HasValue)
                    builder.AddContent(17, $"Reset in {FormatSeconds(info.SecondsUntilReset)}");
                else
                    builder.AddContent(17, "No header data yet");
                builder.CloseElement();
                // Right: sent counter
                builder.OpenElement(18, "span");
                builder.AddAttribute(19, "style", "color:#555;font-size:10px;");
                builder.AddContent(20, $"{info.RequestsSent} req sent");
                builder.CloseElement();
            builder.CloseElement();

        builder.CloseElement();
    };

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnHide { get; set; }

    private string testMalId  = "21";
    private string testMalId2 = "21";
    private bool isTesting    = false;
    private List<string> logs = new();
    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        _refreshTimer = new System.Threading.Timer(
            async _ => await InvokeAsync(StateHasChanged),
            null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose() => _refreshTimer?.Dispose();
    private void Hide() => OnHide.InvokeAsync();

    private static string FormatSeconds(int s)
    {
        if (s <= 0) return "now";
        if (s < 60) return $"{s}s";
        return $"{s / 60}m {s % 60}s";
    }

    // ── Test 1 ───────────────────────────────────────────────────────────────

    private async Task TestViaService()
    {
        logs.Clear(); isTesting = true; StateHasChanged();
        logs.Add("=== GetAnimeByMalIdAsync ===");
        AddRateLimitSnapshot("BEFORE");

        if (!int.TryParse(testMalId, out int malId))
        {
            logs.Add("ERROR: invalid MAL ID"); isTesting = false; StateHasChanged(); return;
        }

        try
        {
            var result = await AniListService.GetAnimeByMalIdAsync(malId);
            AddRateLimitSnapshot("AFTER ");

            var err = AniListService.LastError;
            if (!string.IsNullOrEmpty(err)) logs.Add("WARN LastError: " + err);

            if (result == null)
                logs.Add("NULL: returned null");
            else
            {
                logs.Add($"SUCCESS: {result.Title}");
                logs.Add($"  Status={result.Status}  Ep={result.Episodes}  Score={result.Score}");
                logs.Add($"  Desc={result.Description?.Length ?? 0} chars  Relations={result.Relations.Count}");
                logs.Add($"  Tags={result.Tags.Count}  Links={result.ExternalLinks.Count}  Rankings={result.Rankings.Count}");
            }
        }
        catch (Exception ex) { logs.Add("EXCEPTION: " + ex.Message); }

        isTesting = false; StateHasChanged();
    }

    private void AddRateLimitSnapshot(string prefix)
    {
        var al = AniListService.AniListRateLimit;
        var jk = AniListService.JikanRateLimit;
        logs.Add($"  {prefix} AniList: {al.Label}  sent={al.RequestsSent}  limited={al.IsLimited}  resetIn={FormatSeconds(al.SecondsUntilReset)}");
        logs.Add($"  {prefix} Jikan  : {jk.Label}  sent={jk.RequestsSent}  limited={jk.IsLimited}  resetIn={FormatSeconds(jk.SecondsUntilReset)}");
    }

    // ── Test 2 ───────────────────────────────────────────────────────────────

    private async Task TestPostGraphQLClone()
    {
        logs.Clear(); isTesting = true; StateHasChanged();

        if (!int.TryParse(testMalId2, out int malId))
        {
            logs.Add("ERROR: invalid MAL ID"); isTesting = false; StateHasChanged(); return;
        }

        logs.Add("=== PostGraphQL clone + full header dump ===");
        AddRateLimitSnapshot("BEFORE");

        var query   = $"query {{ Media(idMal: {malId}, type: ANIME) {{ id title {{ english romaji }} averageScore status }} }}";
        var payload = new { query };
        var json    = Newtonsoft.Json.JsonConvert.SerializeObject(payload);
        var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

        try
        {
            logs.Add("Sending PostAsync to graphql.anilist.co …");
            var response = await Http.PostAsync("https://graphql.anilist.co", content);
            logs.Add($"HTTP {(int)response.StatusCode} {response.StatusCode}");

            // ── Dump ALL response headers ───────────────────────────────────────
            logs.Add("--- Response headers ---");
            bool anyRateLimit = false;
            foreach (var h in response.Headers)
            {
                var val = string.Join(", ", h.Value);
                var hl  = h.Key.ToLowerInvariant();
                bool isRL = hl.Contains("rate") || hl.Contains("limit") || hl.Contains("retry");
                logs.Add($"  HDR {h.Key}: {val}");
                if (isRL) anyRateLimit = true;
            }
            if (!anyRateLimit)
                logs.Add("  (no rate-limit headers found in response headers)");

            // ── Also check content headers ──────────────────────────────────────
            if (response.Content != null)
            {
                bool anyCH = false;
                foreach (var h in response.Content.Headers)
                {
                    var hl = h.Key.ToLowerInvariant();
                    if (hl.Contains("rate") || hl.Contains("limit") || hl.Contains("retry"))
                    {
                        logs.Add($"  HDR(content) {h.Key}: {string.Join(", ", h.Value)}");
                        anyCH = true;
                    }
                }
                if (!anyCH) logs.Add("  (no rate-limit headers in content headers either)");
            }

            logs.Add("--- End headers ---");
            AddRateLimitSnapshot("AFTER ");

            if (response.IsSuccessStatusCode)
            {
                var body  = await response.Content!.ReadAsStringAsync();
                var data  = JObject.Parse(body);
                var media = data["data"]?["Media"];
                if (media != null && media.Type != JTokenType.Null)
                    logs.Add($"SUCCESS: id={media["id"]}  title={media["title"]?["english"] ?? media["title"]?["romaji"]}  score={media["averageScore"]}");
                else
                    logs.Add("NULL: data.Media is null");
            }
        }
        catch (Exception ex)
        {
            logs.Add($"EXCEPTION: {ex.GetType().Name}: {ex.Message}");
            if (ex.InnerException != null)
                logs.Add($"  Inner: {ex.InnerException.Message}");
        }

        isTesting = false; StateHasChanged();
    }
}
