@* AniScroll.Shared/Components/Layout/ScrollerSettingsPanel.razor *@
@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@using AniScroll.Shared.Helpers
@inject UserListService UserListService

@if (IsVisible)
{
    <div class="swset-overlay" @onclick="Close">
        <div class="swset-screen" @onclick:stopPropagation="true">

            <!-- ══ MAIN SETTINGS ══════════════════════════════════ -->
            <div class="swset-topbar">
                <div style="width:38px;"></div>
                <div class="swset-topbar-center">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="color:rgba(255,255,255,0.4);flex-shrink:0;">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                    <span class="swset-title">Swipe Settings</span>
                </div>
                <button class="swset-close-btn" @onclick="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>

            <!-- ── Preview section ── -->
            <div class="swset-section-block">
                @{
                    var lc = GetEffectiveColor(false);
                    var rc = GetEffectiveColor(true);
                    var leftLabel  = GetEffectiveLabel(false);
                    var rightLabel = GetEffectiveLabel(true);
                }
                <div class="swset-row">

                    <!-- gradient left -->
                    <div class="swset-grad-overlay swset-grad-left"
                         style="background:linear-gradient(to right,color-mix(in srgb,@lc 42%,#08080f) 0%,color-mix(in srgb,@lc 22%,transparent) 38%,color-mix(in srgb,@lc 8%,transparent) 65%,transparent 100%);"></div>

                    <!-- zone left -->
                    <div class="swset-zone swset-zone-left" style="--zc:@lc;">
                        <div class="swset-zone-content">
                            <div class="swset-zone-hint" style="color:@lc;border-color:@(lc)80;">
                                @((MarkupString)GetSvgIcon(_leftStatus))
                                <span>@leftLabel</span>
                            </div>
                            <button class="swset-zone-edit" @onclick="() => OpenPicker(false)">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                </svg>
                                Edit
                            </button>
                        </div>
                    </div>

                    <!-- skeleton -->
                    <div class="swset-skeleton">
                        <div class="swset-sk-img"><div class="swset-sk-poster"></div></div>
                        <div class="swset-sk-info">
                            <div class="swset-sk-line swset-sk-title"  style="width:72%;animation-delay:.05s;"></div>
                            <div class="swset-sk-line swset-sk-season" style="width:34%;animation-delay:.09s;"></div>
                            <div class="swset-sk-genres" style="animation-delay:.13s;">
                                <div class="swset-sk-genre" style="width:46px;"></div>
                                <div class="swset-sk-genre" style="width:38px;"></div>
                                <div class="swset-sk-genre" style="width:52px;"></div>
                            </div>
                            <div class="swset-sk-stats" style="animation-delay:.17s;">
                                <div class="swset-sk-badge-score"></div>
                                <div class="swset-sk-badge-ep"></div>
                            </div>
                            <div class="swset-sk-desc-wrap">
                                <div class="swset-sk-line swset-sk-desc" style="width:100%;animation-delay:.21s;"></div>
                                <div class="swset-sk-line swset-sk-desc" style="width:92%;animation-delay:.24s;"></div>
                                <div class="swset-sk-line swset-sk-desc" style="width:80%;animation-delay:.27s;"></div>
                            </div>
                            <div class="swset-sk-readmore" style="animation-delay:.31s;"></div>
                        </div>
                    </div>

                    <!-- gradient right -->
                    <div class="swset-grad-overlay swset-grad-right"
                         style="background:linear-gradient(to left,color-mix(in srgb,@rc 42%,#08080f) 0%,color-mix(in srgb,@rc 22%,transparent) 38%,color-mix(in srgb,@rc 8%,transparent) 65%,transparent 100%);"></div>

                    <!-- zone right -->
                    <div class="swset-zone swset-zone-right" style="--zc:@rc;">
                        <div class="swset-zone-content swset-zone-content-r">
                            <div class="swset-zone-hint swset-zone-hint-r" style="color:@rc;border-color:@(rc)80;">
                                <span>@rightLabel</span>
                                @((MarkupString)GetSvgIcon(_rightStatus))
                            </div>
                            <button class="swset-zone-edit" @onclick="() => OpenPicker(true)">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                </svg>
                                Edit
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Future settings -->
            <div class="swset-future-sections"></div>

            <!-- ══ PICKER — bottom sheet inside .swset-screen ══════ -->
            @if (_pickerOpen)
            {
              
                var badgeColor = GetEffectiveColor(_pickingRight);
            

                <!-- dim backdrop covering the settings screen -->
                <div class="swset-picker-backdrop" @onclick="ClosePicker"></div>

                <!-- bottom sheet -->
                <div class="swset-picker-screen" @onclick:stopPropagation="true">

                    <!-- drag handle -->
                    <div class="swset-picker-handle-zone">
                        <div class="swset-picker-handle-bar"></div>
                    </div>

                    <!-- header row: direction badge (left) + X (right) -->
                    <div class="swset-picker-header">
                        <div class="swset-picker-direction-badge"
                             style="background:color-mix(in srgb,@badgeColor 12%,transparent);
                                    border:1px solid color-mix(in srgb,@badgeColor 35%,transparent);
                                    color:@badgeColor;">
                            @if (_pickingRight)
                            {
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                                <span>Swipe Right</span>
                            }
                            else
                            {
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
                                <span>Swipe Left</span>
                            }
                        </div>
                        <button class="swset-close-btn" @onclick="ClosePicker">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>

                    <div class="swset-picker-scroll">

                        <!-- All status items merged + sorted (same order as My Lists) -->
                        <div class="swset-picker-section-label">Status Lists</div>
                        <div class="swset-picker-grid">
                            @{
                                var allStatusItems = UserListService.GetStatusSettings()
                                    .Select(s => (isBuiltIn: true, setting: s, custom: (UserCustomList?)null))
                                    .Concat(UserListService.GetStatusTypeLists()
                                        .Select(c => (isBuiltIn: false, setting: (StatusListSetting?)null, custom: (UserCustomList?)c)))
                                    .OrderBy(x => x.isBuiltIn ? x.setting!.Order : x.custom!.Order)
                                    .ToList();
                            }
                            @foreach (var item in allStatusItems)
                            {
                                @if (item.isBuiltIn)
                                {
                                    var s = item.setting!;
                                    if (!Enum.TryParse<ListStatus>(s.Key, out var ls)) { continue; }
                                    var lsCapture = ls;
                                    bool isSel = _pickingRight
                                        ? (_rightStatus == lsCapture && _rightCustomId == null)
                                        : (_leftStatus  == lsCapture && _leftCustomId  == null);
                                    <button class="swset-picker-item @(isSel ? "swset-picker-item-sel" : "")"
                                            style="@(isSel ? $"border-color:{s.Color}55;background:color-mix(in srgb,{s.Color} 14%,transparent);color:{s.Color};" : "")"
                                            @onclick="() => PickStatus(lsCapture, null)">
                                        <span class="swset-picker-dot" style="background:@s.Color;box-shadow:0 0 5px @(s.Color)88;"></span>
                                        <span class="swset-picker-name">@s.DisplayName</span>
                                        @if (isSel) { <svg class="swset-picker-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg> }
                                    </button>
                                }
                                else
                                {
                                    var cll = item.custom!;
                                    bool isSel = _pickingRight ? _rightCustomId == cll.Id : _leftCustomId == cll.Id;
                                    <button class="swset-picker-item @(isSel ? "swset-picker-item-sel" : "")"
                                            style="@(isSel ? $"border-color:{cll.Color}55;background:color-mix(in srgb,{cll.Color} 14%,transparent);color:{cll.Color};" : "")"
                                            @onclick="() => PickStatus(null, cll.Id)">
                                        <span class="swset-picker-dot" style="background:@cll.Color;box-shadow:0 0 5px @(cll.Color)88;"></span>
                                        <span class="swset-picker-name">@cll.Name</span>
                                        @if (isSel) { <svg class="swset-picker-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg> }
                                    </button>
                                }
                            }
                        </div>

                        @{
                            var rcl = UserListService.GetRegularCustomLists();
                        }
                        @if (rcl.Any())
                        {
                            <div class="swset-picker-section-label" style="margin-top:18px;">Custom Lists</div>
                            <div class="swset-picker-grid">
                                @foreach (var cl in rcl)
                                {
                                    var cll = cl;
                                    bool isSel = _pickingRight ? _rightCustomId == cll.Id : _leftCustomId == cll.Id;
                                    <button class="swset-picker-item @(isSel ? "swset-picker-item-sel" : "")"
                                            style="@(isSel ? $"border-color:{cll.Color}55;background:color-mix(in srgb,{cll.Color} 14%,transparent);color:{cll.Color};" : "")"
                                            @onclick="() => PickStatus(null, cll.Id)">
                                        <span class="swset-picker-dot" style="background:@cll.Color;box-shadow:0 0 5px @(cll.Color)88;"></span>
                                        <span class="swset-picker-name">@cll.Name</span>
                                        @if (isSel) { <svg class="swset-picker-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg> }
                                    </button>
                                }
                            </div>
                        }

                    </div>
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public SwipeSettings Current { get; set; } = new();
    [Parameter] public EventCallback<SwipeSettings> OnChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ListStatus _rightStatus  = ListStatus.Completed;
    private ListStatus _leftStatus   = ListStatus.Planning;
    private string?    _rightCustomId = null;
    private string?    _leftCustomId  = null;
    private bool       _pickerOpen    = false;
    private bool       _pickingRight  = true;

    protected override void OnParametersSet()
    {
        _rightStatus   = Current.RightStatus;
        _leftStatus    = Current.LeftStatus;
        _rightCustomId = Current.RightCustomId;
        _leftCustomId  = Current.LeftCustomId;
    }

    private void OpenPicker(bool isRight) { _pickingRight = isRight; _pickerOpen = true; }
    private void ClosePicker() => _pickerOpen = false;

    private async Task PickStatus(ListStatus? status, string? customId)
    {
        ListStatus resolved = status ?? ListStatus.Planning;
        if (_pickingRight) { _rightStatus = resolved; _rightCustomId = customId; }
        else               { _leftStatus  = resolved; _leftCustomId  = customId; }
        _pickerOpen = false;
        Current.RightStatus   = _rightStatus;
        Current.LeftStatus    = _leftStatus;
        Current.RightCustomId = _rightCustomId;
        Current.LeftCustomId  = _leftCustomId;
        await OnChanged.InvokeAsync(Current);
        StateHasChanged();
    }

    private string GetEffectiveColor(bool isRight)
    {
        var customId = isRight ? _rightCustomId : _leftCustomId;
        if (customId != null)
        {
            var cl = UserListService.GetCustomLists().FirstOrDefault(l => l.Id == customId);
            if (cl != null) return cl.Color;
        }
        var s = isRight ? _rightStatus : _leftStatus;
        return UiHelpers.GetStatusColor(s, UserListService.GetStatusSettings());
    }

    private string GetEffectiveLabel(bool isRight)
    {
        var customId = isRight ? _rightCustomId : _leftCustomId;
        if (customId != null)
        {
            var cl = UserListService.GetCustomLists().FirstOrDefault(l => l.Id == customId);
            if (cl != null) return cl.Name;
        }
        var s = isRight ? _rightStatus : _leftStatus;
        var setting = UserListService.GetStatusSettings().FirstOrDefault(x => x.Key == s.ToString());
        return setting?.DisplayName ?? UiHelpers.GetStatusLabel(s);
    }

    private string GetSvgIcon(ListStatus s) => s switch
    {
        ListStatus.Watching   => "<svg width=\"15\" height=\"15\" viewBox=\"0 0 512 512\" fill=\"none\" stroke=\"currentColor\" stroke-miterlimit=\"10\" stroke-width=\"32\"><path d=\"M112 111v290c0 17.44 17 28.52 31 20.16l247.9-148.37c12.12-7.25 12.12-26.33 0-33.58L143 90.84c-14-8.36-31 2.72-31 20.16z\"/></svg>",
        ListStatus.Rewatching => "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"/><path d=\"M3.51 15a9 9 0 1 0 .49-4.5\"/></svg>",
        ListStatus.Completed  => "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>",
        ListStatus.Planning   => "<svg width=\"13\" height=\"15\" viewBox=\"0 0 512 512\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"32\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M352 48H160a48 48 0 00-48 48v368l144-128 144 128V96a48 48 0 00-48-48z\"/></svg>",
        ListStatus.Paused     => "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"7\" y1=\"4\" x2=\"7\" y2=\"20\"/><line x1=\"17\" y1=\"4\" x2=\"17\" y2=\"20\"/></svg>",
        ListStatus.Dropped    => "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg>",
        _                     => ""
    };

    private void Close() => OnClose.InvokeAsync();
}
