@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject IJSRuntime JS
@inject UserListService UserListService
@implements IDisposable

@if (IsVisible && CurrentAnime != null)
{
    <div class="anime-detail-overlay" @onclick="OnOverlayClick">
        <div class="anime-detail-modal"
             @onclick:stopPropagation="true"
             style="transform: translateX(@(edgeSwipeOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px) translateY(@((isEdgeSwiping || isEdgeSwipeTrackingActive ? 0 : pullOffset).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px); transition: @(GetModalTransition());">

            <button class="modal-close-btn" @onclick="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="modal-scroll-container"
                 @ref="scrollContainerRef"
                 style="@(isEdgeSwipeTrackingActive || isEdgeSwiping ? "overflow:hidden;touch-action:none;" : "")"
                 @ontouchstart="HandleModalTouchStart"
                 @ontouchmove="HandleModalTouchMove"
                 @ontouchend="HandleModalTouchEnd">

                <div class="modal-header">
                    <div class="modal-banner" style="@(string.IsNullOrEmpty(CurrentAnime.BannerUrl) ? "background:linear-gradient(135deg,#1a1a2e,#16213e);" : $"background-image:url('{CurrentAnime.BannerUrl}');")"></div>

                    <div class="modal-header-content">
                        <div class="modal-poster-section">
                            <div class="modal-poster"
                                 style="background-image: url('@CurrentAnime.ImageUrl');
                                        @(!string.IsNullOrEmpty(CurrentAnime.CoverColor) ? $"background-color:{CurrentAnime.CoverColor};" : "")">
                            </div>

                            <div class="modal-action-buttons">
                                <button class="btn-add-to-list @(isInList && currentListStatus.HasValue ? "btn-in-list btn-status-" + GetStatusCssKey(currentListStatus.Value) : "")"
                                        @onclick="OpenListEditor">
                                    <div class="btn-add-to-list-inner">
                                        @if (isInList && currentListStatus.HasValue)
                                        {
                                            @StatusDotMarkup(currentListStatus.Value, true)
                                            <span>@GetStatusLabel(currentListStatus.Value)</span>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                            <span>Add to List</span>
                                        }
                                        <svg class="btn-list-chevron"
                                             width="12" height="12" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </div>
                                </button>

                                <div class="modal-secondary-btns">
                                    <button class="btn-share" @onclick="OnShare">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="18" cy="5" r="3"></circle>
                                            <circle cx="6" cy="12" r="3"></circle>
                                            <circle cx="18" cy="19" r="3"></circle>
                                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                        </svg>
                                        Share
                                    </button>
                                    <button class="btn-favorite @(isFavorited ? "is-favorited" : "")" @onclick="OnFavorite">
                                        <svg width="16" height="16" viewBox="0 0 24 24"
                                             fill="@(isFavorited ? "currentColor" : "none")"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="modal-info-section">
                            <h1 class="modal-title">@CurrentAnime.Title</h1>

                            @if (!string.IsNullOrEmpty(CurrentAnime.Season) && CurrentAnime.Year.HasValue)
                            {
                                <div class="modal-airing-info">
                                    @if (CurrentAnime.Status == "RELEASING")
                                    {
                                        <span class="popup-status-dot popup-dot-releasing"></span>
                                        <span>@CurrentAnime.Season @CurrentAnime.Year · Airing</span>
                                    }
                                    else if (CurrentAnime.Status == "NOT_YET_RELEASED")
                                    {
                                        <span class="popup-status-dot popup-dot-upcoming"></span>
                                        <span>@CurrentAnime.Season @CurrentAnime.Year · Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="modal-season-plain">@CurrentAnime.Season @CurrentAnime.Year</span>
                                    }
                                </div>
                            }

                            @if (CurrentAnime.Status == "RELEASING" && CurrentAnime.NextAiringEpisodeNum.HasValue)
                            {
                                <div class="next-ep-banner">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span class="next-ep-ep">Ep. @CurrentAnime.NextAiringEpisodeNum</span>
                                    @if (CurrentAnime.NextAiringTimeUntil.HasValue)
                                    {
                                        <span class="next-ep-time">in @FormatCountdown(CurrentAnime.NextAiringTimeUntil.Value)</span>
                                    }
                                </div>
                            }

                            @{
                                var topRankings = CurrentAnime.Rankings?
                                .Where(r => r.AllTime)
                                .OrderBy(r => r.Rank)
                                .Take(2)
                                .ToList();
                            }
                            @if (topRankings?.Any() == true)
                            {
                                <div class="rank-row">
                                    @foreach (var r in topRankings)
                                    {
                                        <span class="rank-badge @(r.Type == "RATED" ? "rank-rated" : "rank-popular")">
                                            @(r.Type == "RATED" ? "⭐" : "❤️") #@r.Rank @(r.Type == "RATED" ? "Rated" : "Popular") All Time
                                        </span>
                                    }
                                </div>
                            }

                            <div class="modal-info-grid">
                                <div class="info-col">
                                    <div class="info-field">
                                        <span class="info-lbl">Score</span>
                                        <span class="info-val">@CurrentAnime.Score</span>
                                    </div>
                                    @if (CurrentAnime.Favourites.HasValue)
                                    {
                                        <div class="info-field">
                                            <span class="info-lbl">Favorites</span>
                                            <span class="info-val">@CurrentAnime.Favourites.Value.ToString("N0")</span>
                                        </div>
                                    }
                                    <div class="info-field">
                                        <span class="info-lbl">Status</span>
                                        <span class="info-val">@GetStatusText(CurrentAnime.Status)</span>
                                    </div>
                                </div>
                                <div class="info-col">
                                    <div class="info-field">
                                        <span class="info-lbl">Episodes</span>
                                        <span class="info-val">@CurrentAnime.Episodes</span>
                                    </div>
                                    @if (CurrentAnime.Duration.HasValue)
                                    {
                                        <div class="info-field">
                                            <span class="info-lbl">Duration</span>
                                            <span class="info-val">@CurrentAnime.Duration min</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(CurrentAnime.Source))
                                    {
                                        <div class="info-field">
                                            <span class="info-lbl">Source</span>
                                            <span class="info-val">@CurrentAnime.Source</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-content">

                    @if (!string.IsNullOrEmpty(CurrentAnime.Description))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Synopsis</h3>
                            <p class="synopsis-text">@CurrentAnime.Description</p>
                        </div>
                    }

                    @{
                        var relationOrder = new Dictionary<string, int>
                        {
                            {"Source", 1}, {"Adaptation", 2}, {"Prequel", 3}, {"Parent", 4},
                            {"Sequel", 5}, {"Side Story", 6}, {"Spin-off", 7},
                            {"Alternative", 8}, {"Character", 9}, {"Summary", 10},
                            {"Compilation", 11}, {"Contains", 12}, {"Other", 99}
                        };
                        var sortedRelations = CurrentAnime.Relations?
                            .OrderBy(r => relationOrder.TryGetValue(r.RelationType, out var o) ? o : 99)
                            .ThenBy(r => r.Title)
                            .ToList();
                    }
                    @if (sortedRelations?.Any() == true && CurrentAnime.Relations != null)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Related <span class="relation-count">(@sortedRelations.Count)</span></h3>
                            <div class="relations-scroll">
                                @foreach (var rel in sortedRelations)
                                {
                                    <div class="relation-card">
                                        <div class="relation-cover" style="background-image: url('@rel.ImageUrl');"></div>
                                        <div class="relation-info">
                                            <div class="relation-type">@rel.RelationType</div>
                                            @if (!string.IsNullOrEmpty(rel.Format))
                                            {
                                                <div class="relation-format">@rel.Format</div>
                                            }
                                            <div class="relation-title">@rel.Title</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (CurrentAnime.Genres?.Any() == true)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Genres</h3>
                            <div class="genres-container">
                                @foreach (var genre in CurrentAnime.Genres)
                                {
                                    <span class="genre-pill">@genre</span>
                                }
                            </div>
                        </div>
                    }

                    @if (CurrentAnime.Studios?.Any() == true)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Studios</h3>
                            <div class="studios-container">
                                @foreach (var studio in CurrentAnime.Studios)
                                {
                                    <span class="studio-badge">@studio.Name</span>
                                }
                            </div>
                        </div>
                    }

                    @{
                        var videoId = GetYouTubeVideoId(CurrentAnime.TrailerUrl ?? "");
                    }
                    @if (!string.IsNullOrEmpty(videoId))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Trailer</h3>
                            <div class="trailer-container">
                                <div class="youtube-embed-wrapper">
                                    <iframe src="https://www.youtube-nocookie.com/embed/@videoId?rel=0&autoplay=0&modestbranding=1"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>
                    }

                    @{
                        var seasonRankings = CurrentAnime.Rankings?.Where(r => !r.AllTime).Take(2).ToList();
                        bool showNativeTitle = !string.IsNullOrWhiteSpace(CurrentAnime.NativeTitle)
                                              && !ContainsNonLatinScript(CurrentAnime.NativeTitle);
                        bool hasDetails = showNativeTitle
                            || !string.IsNullOrEmpty(CurrentAnime.Format)
                            || !string.IsNullOrEmpty(CurrentAnime.StartDate)
                            || !string.IsNullOrEmpty(CurrentAnime.EndDate)
                            || CurrentAnime.Popularity.HasValue
                            || (seasonRankings?.Any() == true);
                    }
                    @if (hasDetails)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Details</h3>
                            <div class="details-grid">
                                @if (showNativeTitle)
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Native Title</span>
                                        <span class="detail-val detail-val-native">@CurrentAnime.NativeTitle</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.Format))
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Format</span>
                                        <span class="detail-val">@CurrentAnime.Format</span>
                                    </div>
                                }
                                @if (CurrentAnime.Popularity.HasValue)
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Popularity</span>
                                        <span class="detail-val">@CurrentAnime.Popularity.Value.ToString("N0") users</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.StartDate))
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Start Date</span>
                                        <span class="detail-val">@CurrentAnime.StartDate</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.EndDate))
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">End Date</span>
                                        <span class="detail-val">@CurrentAnime.EndDate</span>
                                    </div>
                                }
                                @if (seasonRankings?.Any() == true)
                                {
                                    @foreach (var sr in seasonRankings)
                                    {
                                        <div class="detail-row">
                                            <span class="detail-lbl">@(sr.Type == "RATED" ? "Seasonal Rating" : "Seasonal Popularity")</span>
                                            <span class="detail-val">#@sr.Rank · @sr.Season @sr.Year</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @{
                        var visibleTags = CurrentAnime.Tags?
                            .Where(t => !t.IsMediaSpoiler)
                            .OrderByDescending(t => t.Rank)
                            .Take(20)
                            .ToList();
                        var spoilerTags = CurrentAnime.Tags?
                            .Where(t => t.IsMediaSpoiler)
                            .OrderByDescending(t => t.Rank)
                            .ToList();
                        int spoilerCount = spoilerTags?.Count ?? 0;

                        var allTagsSorted = (visibleTags ?? new())
                            .Select(t => (tag: t, isSpoiler: false))
                            .Concat((spoilerTags ?? new()).Select(t => (tag: t, isSpoiler: true)))
                            .OrderByDescending(x => x.tag.Rank)
                            .ToList();
                    }
                    @if ((visibleTags?.Any() == true) || spoilerCount > 0)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Tags</h3>

                            @if (!showSpoilers)
                            {
                                <div class="tags-wrap">
                                    @foreach (var tag in visibleTags ?? new())
                                    {
                                        <span class="tag-pill">
                                            @tag.Name<span class="tag-pct">@tag.Rank%</span>
                                        </span>
                                    }
                                </div>

                                @if (spoilerCount > 0)
                                {
                                    <div style="display:flex;justify-content:center;margin-top:10px;">
                                        <button class="tag-spoiler-btn"
                                                @onclick="() => showSpoilers = true">
                                            @spoilerCount spoiler@(spoilerCount > 1 ? "s" : "") hidden — tap to reveal
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="tags-wrap">
                                    @foreach (var entry in allTagsSorted)
                                    {
                                        @if (!entry.isSpoiler)
                                        {
                                            <span class="tag-pill">
                                                @entry.tag.Name<span class="tag-pct">@entry.tag.Rank%</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="tag-pill tag-pill-spoiler-revealed">
                                                @entry.tag.Name<span class="tag-pct">@entry.tag.Rank%</span>
                                            </span>
                                        }
                                    }
                                </div>

                                <div style="display:flex;justify-content:center;margin-top:10px;">
                                    <button class="tag-spoiler-btn"
                                            @onclick="() => showSpoilers = false">
                                        Hide spoilers
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @{
                        var streamingLinks = CurrentAnime.ExternalLinks?.Where(l => l.Type == "STREAMING").ToList();
                        var otherLinks = CurrentAnime.ExternalLinks?.Where(l => l.Type == "INFO" || l.Type == "SOCIAL").Take(4).ToList();
                    }
                    <div class="modal-section">
                        <h3 class="section-title">Watch &amp; More</h3>

                        @if (streamingLinks?.Any() == true)
                        {
                            <p class="links-sublabel">Where to watch</p>
                            <div class="platform-list">
                                @foreach (var link in streamingLinks)
                                {
                                    var pc = (!string.IsNullOrEmpty(link.Color) && link.Color != "#000000" && link.Color.StartsWith("#"))
                                        ? link.Color : "#7c7c99";
                                    <a href="@link.Url" target="_blank" class="platform-row" style="--pc: @pc;">
                                        <span class="platform-icon-box">
                                            @GetPlatformIconMarkup(link.Icon, link.Color, link.Site)
                                        </span>
                                        <span class="platform-name-label">@link.Site</span>
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                             stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round">
                                            <path d="m9 18 6-6-6-6"></path>
                                        </svg>
                                    </a>
                                }
                            </div>
                        }

                        <div class="info-chip-row">
                            <a href="https://anilist.co/anime/@CurrentAnime.Id" target="_blank" class="info-chip">
                                <span class="chip-dot" style="background:#02a9ff;"></span>AniList
                            </a>
                            @if (otherLinks?.Any() == true)
                            {
                                @foreach (var ol in otherLinks)
                                {
                                    var c = (!string.IsNullOrEmpty(ol.Color) && ol.Color != "#000000" && ol.Color.StartsWith("#"))
                                        ? ol.Color : "#7c7c99";
                                    <a href="@ol.Url" target="_blank" class="info-chip">
                                        <span class="chip-dot" style="background:@c;"></span>@ol.Site
                                    </a>
                                }
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════
     LIST EDITOR MODAL
     ══════════════════════════════════════════════════════════════ -->
@if (showListEditor && CurrentAnime != null)
{
    <div class="list-editor-overlay"
         @ref="_listEditorOverlayRef"
         style="touch-action:none;overscroll-behavior:contain;"
         @onwheel:stopPropagation="true"
         @onpointerdown="() => _pointerDownOnModal = false"
         @onclick="async () => { if (!_pointerDownOnModal) await CloseAndSave(); _pointerDownOnModal = false; }"
         @ontouchstart:stopPropagation="true"
         @ontouchmove:stopPropagation="true"
         @ontouchend:stopPropagation="true">
        <div class="list-editor-modal"
             style="touch-action:pan-y;overscroll-behavior:contain;"
             @onwheel:stopPropagation="true"
             @onpointerdown="() => _pointerDownOnModal = true"
             @onpointerdown:stopPropagation="true"
             @onclick:stopPropagation="true">

            <!-- Header: banner + poster + title + fav + save -->
            <div class="list-editor-header">
                <div class="list-editor-banner"
                     style="@(string.IsNullOrEmpty(CurrentAnime.BannerUrl)
                                ? $"background-image:url('{CurrentAnime.ImageUrl}');"
                                : $"background-image:url('{CurrentAnime.BannerUrl}');")">
                </div>
                <div class="list-editor-header-content">
                    <div class="list-editor-poster"
                         style="background-image: url('@CurrentAnime.ImageUrl');
                                @(!string.IsNullOrEmpty(CurrentAnime.CoverColor) ? $"background-color:{CurrentAnime.CoverColor};" : "")">
                    </div>
                    <span class="list-editor-title">@CurrentAnime.Title</span>
                    <button class="list-editor-fav-btn @(isFavorited ? "is-fav" : "")" @onclick="OnFavorite" @onclick:stopPropagation="true">
                        <svg width="18" height="18" viewBox="0 0 24 24"
                             fill="@(isFavorited ? "currentColor" : "none")"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                    <button class="list-editor-save-btn" @onclick="async () => await CloseAndSave()">Save</button>
                </div>
            </div>

            <!-- Body -->
            <div class="list-editor-body">

                <!-- ── Status Dropdown (standards + custom lists) ── -->
                <div class="le-dd-field" @onclick:stopPropagation="true">
                    <span class="list-editor-label">STATUS</span>

                    <button class="le-dd-trigger @(editStatus.HasValue ? "le-dd-trigger-" + editStatus.Value.ToString().ToLower() : "")"
                            @onclick="() => { _statusDropdownOpen = !_statusDropdownOpen; StateHasChanged(); }">
                        @if (editStatus.HasValue)
                        {
                            @GlowDot(GetStatusHexColor(editStatus.Value))
                        }
                        else
                        {
                            <span class="le-dd-dot le-dd-dot-none"></span>
                        }
                        <span class="le-dd-trigger-text">@(editStatus.HasValue ? GetStatusLabel(editStatus.Value) : "Not in list")</span>
                        <svg class="le-dd-chevron @(_statusDropdownOpen ? "open" : "")" width="14" height="14"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_statusDropdownOpen)
                    {
                        <div class="le-dd-list">

                            <!-- Statuts standards -->
                            @foreach (var s in GetAvailableStatuses())
                            {
                                bool isSel = editStatus == s;
                                <button class="le-dd-option @(isSel ? "selected le-opt-" + s.ToString().ToLower() : "")"
                                        @onclick="async () => {
                                            var prev = editStatus;
                                            editStatus = s;
                                            if (s == ListStatus.Completed) {
                                                int tot = GetTotalEpisodes();
                                                if (tot > 0) editEpisodes = tot;
                                            }
                                            ApplyAutoDate(prev, editStatus);
                                            _statusDropdownOpen = false;
                                            await AutoSave();
                                            StateHasChanged();
                                        }"
                                        @onclick:stopPropagation="true">
                                    @GlowDot(GetStatusHexColor(s))
                                    <span class="le-dd-option-text">@GetStatusLabel(s)</span>
                                    @if (isSel)
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="3" stroke-linecap="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                            }

                            <!-- Séparateur + Custom lists -->
                            @{
                                var customLists = UserListService.GetCustomLists().ToList();
                            }
                            @if (customLists.Any())
                            {
                                <div style="height:1px;background:rgba(255,255,255,0.07);margin:4px 0;"></div>

                                @foreach (var cl in customLists)
                                {
                                    bool isInCl = editAnime != null && UserListService.IsInCustomList(editAnime.Id, cl.Id);
                                    <button class="le-dd-option @(isInCl ? "selected" : "")"
                                            style="@(isInCl ? $"background:color-mix(in srgb,{cl.Color} 8%,transparent);color:{cl.Color};" : "")"
                                            @onclick="() => ToggleCustomList(cl.Id)"
                                            @onclick:stopPropagation="true">
                                        @GlowDot(cl.Color)
                                        <span class="le-dd-option-text">@cl.Name</span>
                                        @if (isInCl)
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="3" stroke-linecap="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                    </button>
                                }
                            }

                        </div>
                    }
                </div>

                <!-- Score & Episode Progress -->
                <div class="list-editor-grid list-editor-grid-2">

                    <!-- Score: − | editable input | + with draggable bar -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Score</span>
                        <div class="le-score-controls">
                            <button class="le-score-step-btn"
                                    @onclick="async () => { ChangeScore(-0.5); await AutoSave(); }">−</button>
                            <input type="text"
                                   inputmode="decimal"
                                   @ref="scoreInputRef"
                                   class="le-score-input @(editScore > 0 ? "le-score-input-" + GetScoreColorClass(editScore) : "")"
                                   value="@(editScore > 0 ? (_scoreBarDragging ? ((int)Math.Round(editScore)).ToString() : FormatScore(editScore)) : "")"
                                   placeholder="—"
                                   @onfocus="HandleScoreInputFocus"
                                   @onchange="HandleScoreTextChange" />
                            <button class="le-score-step-btn"
                                    @onclick="async () => { ChangeScore(0.5); await AutoSave(); }">+</button>
                        </div>
                        <!-- Draggable progress bar -->
                        <div class="le-score-bar-click @(_scoreBarDragging ? "dragging" : "")"
                             @ref="scoreBarRef"
                             @onpointerdown="HandleScoreBarPointerDown"
                             @onpointermove="HandleScoreBarPointerMove"
                             @onpointerup="HandleScoreBarPointerUp"
                             @onpointercancel="@(() => _scoreBarDragging = false)">
                            <div class="le-score-bar-fill-click"
                                 style="width:@((editScore / 10.0 * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                                        background:@GetScoreHexColor(editScore);">
                            </div>
                        </div>
                    </div>

                    <!-- Episode Progress -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Episode Progress</span>
                        @{
                            int totalEp = GetTotalEpisodes();
                            string epInputVal = totalEp > 0
                                ? $"{editEpisodes}/{totalEp}"
                                : editEpisodes.ToString();
                            int epPct = totalEp > 0
                                ? Math.Min(100, (int)Math.Round(editEpisodes / (double)totalEp * 100))
                                : 0;
                        }
                        <div class="le-score-controls">
                            <button class="le-score-step-btn"
                                    disabled="@IsNotYetReleased"
                                    @onclick="async () => { if (!IsNotYetReleased) { ChangeEpisodes(-1); await AutoSave(); } }">−</button>
                            <input type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   @ref="epInputRef"
                                   class="le-score-input le-ep-input"
                                   value="@epInputVal"
                                   placeholder="0"
                                   disabled="@IsNotYetReleased"
                                   @onfocus="HandleEpInputFocus"
                                   @onchange="HandleEpTextChange" />
                            <button class="le-score-step-btn"
                                    disabled="@IsNotYetReleased"
                                    @onclick="async () => { if (!IsNotYetReleased) { ChangeEpisodes(1); await AutoSave(); } }">+</button>
                        </div>
                        <div class="list-editor-ep-bar @(IsNotYetReleased ? "le-ep-bar-disabled" : "le-ep-bar-clickable") @(_epBarDragging ? "dragging" : "")"
                             @ref="epBarRef"
                             @onpointerdown="HandleEpBarPointerDown"
                             @onpointermove="HandleEpBarPointerMove"
                             @onpointerup="HandleEpBarPointerUp"
                             @onpointercancel="@(() => _epBarDragging = false)">
                            <div class="list-editor-ep-fill"
                                 style="width: @epPct%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Dates | Rewatches | Options -->
                <div class="list-editor-grid">

                    <!-- Start Date -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Start Date</span>
                        <div class="list-editor-date-wrapper">
                            <input type="date" class="list-editor-date-input"
                                   min="1900-01-01" max="2099-12-31"
                                   value="@(editStartDate.HasValue ? editStartDate.Value.ToString("yyyy-MM-dd") : "")"
                                   @onchange="async e => { var s = e.Value?.ToString(); editStartDate = (!string.IsNullOrEmpty(s) && DateTime.TryParse(s, out var d)) ? d : null; await AutoSave(); }" />
                        </div>
                    </div>

                    <!-- Finish Date -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Finish Date</span>
                        <div class="list-editor-date-wrapper">
                            <input type="date" class="list-editor-date-input"
                                   min="1900-01-01" max="2099-12-31"
                                   value="@(editFinishDate.HasValue ? editFinishDate.Value.ToString("yyyy-MM-dd") : "")"
                                   @onchange="async e => { var s = e.Value?.ToString(); editFinishDate = (!string.IsNullOrEmpty(s) && DateTime.TryParse(s, out var d)) ? d : null; await AutoSave(); }" />
                        </div>
                    </div>

                    <!-- Total Rewatches -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Rewatches</span>
                        <div class="le-score-controls">
                            <button class="le-score-step-btn"
                                    disabled="@IsNotYetReleased"
                                    @onclick="async () => { if (!IsNotYetReleased) { int prev = editRewatches; editRewatches = Math.Max(0, editRewatches - 1); ApplyRewatchAutoStatus(prev); await AutoSave(); } }">−</button>
                            <input type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   @ref="rewatchInputRef"
                                   class="le-score-input le-rewatch-input"
                                   value="@editRewatches"
                                   disabled="@IsNotYetReleased"
                                   @onfocus="HandleRewatchInputFocus"
                                   @onchange="HandleRewatchTextChange" />
                            <button class="le-score-step-btn"
                                    disabled="@IsNotYetReleased"
                                    @onclick="async () => { if (!IsNotYetReleased) { int prev = editRewatches; editRewatches = Math.Max(0, editRewatches + 1); ApplyRewatchAutoStatus(prev); await AutoSave(); } }">+</button>
                        </div>
                    </div>

                    <!-- Privacy options -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Options</span>
                        <div class="list-editor-custom-lists">
                            <label class="list-editor-checkbox-row">
                                <input type="checkbox" checked="@editHideFromLists"
                                       @onchange="async e => { editHideFromLists = e.Value is bool b1 ? b1 : false; await AutoSave(); }" />
                                <span>Hide from status lists</span>
                            </label>
                            <label class="list-editor-checkbox-row">
                                <input type="checkbox" checked="@editIsPrivate"
                                       @onchange="async e => { editIsPrivate = e.Value is bool b2 ? b2 : false; await AutoSave(); }" />
                                <span>Private</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="list-editor-field">
                    <span class="list-editor-label">Notes</span>
                    <textarea class="list-editor-textarea"
                              placeholder="Add notes..."
                              value="@editNotes"
                              @oninput="e => editNotes = e.Value?.ToString() ?? string.Empty"
                              @onchange="async e => { editNotes = e.Value?.ToString() ?? string.Empty; await AutoSave(); }"></textarea>
                </div>

                <!-- Delete button -->
                @{ var _deleteCls = "le-delete-section" + (_deleteAnimVisible ? " le-delete-visible" : ""); }
                <div class="@_deleteCls">
                    <button class="le-delete-btn" @onclick="PromptDelete" @onclick:stopPropagation="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6l-1 14H6L5 6"></path>
                            <path d="M10 11v6M14 11v6"></path>
                            <path d="M9 6V4h6v2"></path>
                        </svg>
                        Remove from list
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════
     DELETE CONFIRMATION
     ══════════════════════════════════════════════════════════════ -->
@if (showDeleteConfirm && CurrentAnime != null)
{
    <div class="delete-confirm-overlay" @onclick="CancelDelete">
        <div class="delete-confirm-box" @onclick:stopPropagation="true">
            <div class="delete-confirm-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                     stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v6M14 11v6"></path>
                    <path d="M9 6V4h6v2"></path>
                </svg>
            </div>
            <p class="delete-confirm-title">Remove from list?</p>
            <p class="delete-confirm-text">
                <strong style="color:rgba(255,255,255,0.8);">@CurrentAnime.Title</strong> will be removed from your list. This can't be undone.
            </p>
            <div class="delete-confirm-btns">
                <button class="delete-confirm-cancel" @onclick="CancelDelete">Cancel</button>
                <button class="delete-confirm-delete" @onclick="ConfirmDelete">Remove</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AnimeCard? CurrentAnime { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // Alias used in custom list toggle (same reference as CurrentAnime)
    private AnimeCard? editAnime => CurrentAnime;

    private bool isFavorited = false;
    private bool showSpoilers = false;
    private int? _lastAnimeId = null;

    // List state
    private bool isInList = false;
    private ListStatus? currentListStatus = null;

    private static readonly ListStatus[] _allStatuses =
    {
        ListStatus.Watching, ListStatus.Rewatching, ListStatus.Completed,
        ListStatus.Planning, ListStatus.Paused, ListStatus.Dropped
    };

    private bool IsNotYetReleased => CurrentAnime?.Status == "NOT_YET_RELEASED";

    private IEnumerable<ListStatus> GetAvailableStatuses()
    {
        if (IsNotYetReleased) { yield return ListStatus.Planning; yield break; }
        foreach (var s in _allStatuses) yield return s;
    }

    // List Editor state
    private bool showListEditor = false;
    private bool showDeleteConfirm = false;
    private bool _deleteAnimVisible = false;
    private bool _statusDropdownOpen = false;
    private bool _pointerDownOnModal = false;

    private bool _edgeInterceptorRegistered = false;

    // Edit form fields
    private ListStatus? editStatus = null;
    private double editScore = 0;
    private int editEpisodes = 0;
    private int editRewatches = 0;
    private string editNotes = "";
    private DateTime? editStartDate = null;
    private DateTime? editFinishDate = null;
    private bool editIsPrivate = false;
    private bool editHideFromLists = false;

    // Element refs
    private ElementReference _listEditorOverlayRef;
    private bool _wheelListenerActive = false;
    private ElementReference scoreBarRef;
    private ElementReference epBarRef;
    private ElementReference scoreInputRef;
    private ElementReference epInputRef;
    private ElementReference rewatchInputRef;

    // Slider drag state
    private bool _scoreBarDragging = false;
    private bool _epBarDragging = false;

    private ElementBounds? _cachedScoreBounds;
    private ElementBounds? _cachedEpBounds;

    // Swipe-down-to-close
    private ElementReference scrollContainerRef;
    private double pullOffset = 0;
    private double pullStartY = 0;
    private bool isPulling = false;
    private bool isPullTrackingActive = false;
    private const double PULL_CLOSE_THRESHOLD = 40;

    // Swipe-left-edge-to-close
    private double edgeSwipeStartX = 0;
    private double edgeSwipeStartY = 0;
    private double edgeSwipeOffset = 0;
    private bool isEdgeSwiping = false;
    private bool isEdgeSwipeTrackingActive = false;
    private const double EDGE_ZONE_WIDTH = 40;
    private const double EDGE_SWIPE_CLOSE_THRESHOLD = 90;

    private class ElementBounds
    {
        public double Left { get; set; }
        public double Width { get; set; }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        UserListService.OnChanged += HandleListChanged;
    }

    public void Dispose()
    {
        UserListService.OnChanged -= HandleListChanged;
        try { _ = JS.InvokeVoidAsync("unregisterEdgeSwipeInterceptor"); } catch { }
    }

    private void HandleListChanged()
    {
        RefreshListState();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (CurrentAnime?.Id != _lastAnimeId)
        {
            isFavorited = false;
            showSpoilers = false;
            showListEditor = false;
            showDeleteConfirm = false;
            pullOffset = 0;
            isPulling = false;
            isPullTrackingActive = false;
            edgeSwipeOffset = 0;
            isEdgeSwiping = false;
            isEdgeSwipeTrackingActive = false;
            _scoreBarDragging = false;
            _epBarDragging = false;
            _lastAnimeId = CurrentAnime?.Id;
            RefreshListState();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showListEditor && !_wheelListenerActive)
        {
            _wheelListenerActive = true;
            try { await JS.InvokeVoidAsync("preventWheelScroll", _listEditorOverlayRef); } catch { }
        }
        else if (!showListEditor && _wheelListenerActive)
        {
            _wheelListenerActive = false;
            try { await JS.InvokeVoidAsync("removeWheelScrollPrevention", _listEditorOverlayRef); } catch { }
        }

        if (IsVisible && !_edgeInterceptorRegistered)
        {
            _edgeInterceptorRegistered = true;
            try
            {
                await JS.InvokeVoidAsync("registerEdgeSwipeInterceptor", scrollContainerRef, (int)EDGE_ZONE_WIDTH);
            }
            catch { }
        }
        else if (!IsVisible && _edgeInterceptorRegistered)
        {
            _edgeInterceptorRegistered = false;
            try { await JS.InvokeVoidAsync("unregisterEdgeSwipeInterceptor"); }
            catch { }
        }
    }

    private void RefreshListState()
    {
        if (CurrentAnime == null) { isInList = false; currentListStatus = null; return; }
        var entry = UserListService.GetEntry(CurrentAnime.Id);
        isInList = entry != null;
        currentListStatus = entry?.Status;
    }

    // ── Auto-save ─────────────────────────────────────────────────────────────
    private async Task AutoSave()
    {
        if (CurrentAnime == null) return;

        bool hasContent = editStatus.HasValue
            || editScore > 0
            || editEpisodes > 0
            || editRewatches > 0
            || !string.IsNullOrEmpty(editNotes)
            || editStartDate.HasValue
            || editFinishDate.HasValue;

        if (!hasContent) return;

        var existing = UserListService.GetEntry(CurrentAnime.Id) ?? new UserListEntry
        {
            Anime   = CurrentAnime,
            AddedAt = DateTime.Now
        };

        existing.Status              = editStatus;
        existing.Score               = editScore;
        existing.EpisodesWatched     = editEpisodes;
        existing.TotalRewatches      = editRewatches;
        existing.Notes               = editNotes;
        existing.StartDate           = editStartDate;
        existing.FinishDate          = editFinishDate;
        existing.IsPrivate           = editIsPrivate;
        existing.HideFromStatusLists = editHideFromLists;

        UserListService.SaveEntry(existing);
        currentListStatus = editStatus;
        isInList = true;

        if (!_deleteAnimVisible && showListEditor)
            _ = TriggerDeleteAnimAsync();

        StateHasChanged();
        await Task.CompletedTask;
    }

    // ── Close + save ──────────────────────────────────────────────────────────
    private async Task CloseAndSave()
    {
        if (CurrentAnime != null) await AutoSave();
        showListEditor      = false;
        _statusDropdownOpen = false;
        _scoreBarDragging   = false;
        _epBarDragging      = false;
        _cachedScoreBounds  = null;
        _cachedEpBounds     = null;
        StateHasChanged();
    }

    // ── List Editor ──────────────────────────────────────────────────────────
    private void OpenListEditor()
    {
        if (CurrentAnime == null) return;

        var existing = UserListService.GetEntry(CurrentAnime.Id);
        if (existing != null)
        {
            editStatus        = existing.Status;
            editScore         = existing.Score;
            editEpisodes      = existing.EpisodesWatched;
            editRewatches     = existing.TotalRewatches;
            editNotes         = existing.Notes;
            editStartDate     = existing.StartDate;
            editFinishDate    = existing.FinishDate;
            editIsPrivate     = existing.IsPrivate;
            editHideFromLists = existing.HideFromStatusLists;
        }
        else
        {
            editStatus        = null;
            editScore         = 0;
            editEpisodes      = 0;
            editRewatches     = 0;
            editNotes         = "";
            editStartDate     = null;
            editFinishDate    = null;
            editIsPrivate     = false;
            editHideFromLists = false;
        }

        if (CurrentAnime.Status == "NOT_YET_RELEASED")
        {
            editEpisodes  = 0;
            editRewatches = 0;
        }

        _statusDropdownOpen = false;
        _deleteAnimVisible  = false;
        showListEditor      = true;
        StateHasChanged();
        if (isInList) _ = TriggerDeleteAnimAsync();
    }

    private async Task TriggerDeleteAnimAsync()
    {
        await Task.Delay(60);
        _deleteAnimVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private void PromptDelete()  { showDeleteConfirm = true;  StateHasChanged(); }
    private void CancelDelete()  { showDeleteConfirm = false; StateHasChanged(); }

    private void ConfirmDelete()
    {
        if (CurrentAnime == null) return;
        UserListService.Remove(CurrentAnime.Id);
        isInList = false;
        currentListStatus = null;
        showDeleteConfirm = false;
        showListEditor = false;
        StateHasChanged();
    }

    // ── Custom Lists ──────────────────────────────────────────────────────────
    private void ToggleCustomList(string customListId)
    {
        if (editAnime == null) return;
        if (UserListService.IsInCustomList(editAnime.Id, customListId))
            UserListService.RemoveFromCustomList(editAnime.Id, customListId);
        else
            UserListService.AddToCustomList(editAnime.Id, customListId);
        StateHasChanged();
    }

    // ── Score ─────────────────────────────────────────────────────────────────
    private void ChangeScore(double delta)
    {
        editScore = Math.Max(0, Math.Min(10, Math.Round((editScore + delta) * 2) / 2));
        StateHasChanged();
    }

    private async Task HandleScoreInputFocus()
    {
        try
        {
            var val = editScore > 0 ? FormatScore(editScore) : "";
            await JS.InvokeVoidAsync("setAndSelectInput", scoreInputRef, val);
        }
        catch { }
    }

    private async Task HandleScoreTextChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(raw))
        {
            editScore = 0;
            try { await JS.InvokeVoidAsync("setInputValue", scoreInputRef, ""); } catch { }
        }
        else if (double.TryParse(raw.Replace(',', '.'), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out double v) && v >= 0 && v <= 10)
        {
            editScore = Math.Max(0, Math.Min(10, Math.Round(v * 2) / 2));
        }
        else
        {
            try { await JS.InvokeVoidAsync("setInputValue", scoreInputRef, editScore > 0 ? FormatScore(editScore) : ""); } catch { }
        }
        await AutoSave();
        StateHasChanged();
    }

    private async Task HandleScoreBarPointerDown(PointerEventArgs e)
    {
        _scoreBarDragging = true;
        try
        {
            _cachedScoreBounds = await JS.InvokeAsync<ElementBounds>("getElementBounds", scoreBarRef);
            await JS.InvokeVoidAsync("capturePointer", scoreBarRef, e.PointerId);
        }
        catch { }
        ApplyScoreFromX(e.ClientX);
        StateHasChanged();
    }

    private void HandleScoreBarPointerMove(PointerEventArgs e)
    {
        if (!_scoreBarDragging || _cachedScoreBounds == null) return;
        ApplyScoreFromX(e.ClientX);
        JS.InvokeVoidAsync("setBarWidth", scoreBarRef, ".le-score-bar-fill-click",
            editScore / 10.0 * 100, GetScoreHexColor(editScore));
        JS.InvokeVoidAsync("setInputValue", scoreInputRef,
            editScore > 0 ? ((int)editScore).ToString() : "");
    }

    private async Task HandleScoreBarPointerUp(PointerEventArgs e)
    {
        if (!_scoreBarDragging) return;
        _scoreBarDragging  = false;
        _cachedScoreBounds = null;
        await AutoSave();
        StateHasChanged();
    }

    private void ApplyScoreFromX(double clientX)
    {
        if (_cachedScoreBounds == null || _cachedScoreBounds.Width <= 0) return;
        double pct = Math.Clamp((clientX - _cachedScoreBounds.Left) / _cachedScoreBounds.Width, 0, 1);
        editScore = Math.Round(pct * 10);
    }

    // ── Episodes ──────────────────────────────────────────────────────────────
    private int GetTotalEpisodes()
    {
        if (CurrentAnime == null) return 0;
        var epRaw = CurrentAnime.Episodes ?? "";
        foreach (var part in epRaw.Split('/').Reverse())
        {
            var cleaned = new string(part.Trim().TakeWhile(char.IsDigit).ToArray());
            if (int.TryParse(cleaned, out int parsed) && parsed > 0) return parsed;
        }
        return 0;
    }

    private string GetEpInputDisplay()
    {
        int total = GetTotalEpisodes();
        return total > 0 ? $"{editEpisodes}/{total}" : editEpisodes.ToString();
    }

    private void ChangeEpisodes(int delta)
    {
        if (CurrentAnime?.Status == "NOT_YET_RELEASED") return;
        int total = GetTotalEpisodes();
        int next  = editEpisodes + delta;
        if (next < 0) return;
        if (total > 0 && next > total) return;
        editEpisodes = next;
        var prev = editStatus;
        if (editEpisodes > 0 && !editStatus.HasValue) editStatus = ListStatus.Watching;
        if (total > 0 && editEpisodes == total) editStatus = ListStatus.Completed;
        ApplyAutoDate(prev, editStatus);
        StateHasChanged();
    }

    private async Task HandleEpInputFocus()
    {
        try { await JS.InvokeVoidAsync("selectInputContent", epInputRef); } catch { }
    }

    private async Task HandleEpTextChange(ChangeEventArgs e)
    {
        if (CurrentAnime?.Status == "NOT_YET_RELEASED")
        {
            editEpisodes = 0;
            try { await JS.InvokeVoidAsync("setInputValue", epInputRef, GetEpInputDisplay()); } catch { }
            StateHasChanged();
            return;
        }
        var raw    = e.Value?.ToString() ?? "";
        var part   = raw.Split('/')[0].Trim();
        int totalEp = GetTotalEpisodes();
        bool valid  = int.TryParse(part, out int v) && v >= 0 && (totalEp <= 0 || v <= totalEp);
        if (valid)
        {
            editEpisodes = v;
            var prev = editStatus;
            if (editEpisodes > 0 && !editStatus.HasValue) editStatus = ListStatus.Watching;
            if (totalEp > 0 && editEpisodes == totalEp) editStatus = ListStatus.Completed;
            ApplyAutoDate(prev, editStatus);
        }
        else
        {
            try { await JS.InvokeVoidAsync("setInputValue", epInputRef, GetEpInputDisplay()); } catch { }
        }
        await AutoSave();
        StateHasChanged();
    }

    // ── Rewatches ─────────────────────────────────────────────────────────────
    private async Task HandleRewatchInputFocus()
    {
        try { await JS.InvokeVoidAsync("selectInputContent", rewatchInputRef); } catch { }
    }

    private async Task HandleRewatchTextChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        if (int.TryParse(raw.Trim(), out int v) && v >= 0)
        {
            int prev = editRewatches;
            editRewatches = v;
            ApplyRewatchAutoStatus(prev);
        }
        else
        {
            try { await JS.InvokeVoidAsync("setInputValue", rewatchInputRef, editRewatches.ToString()); } catch { }
        }
        await AutoSave();
        StateHasChanged();
    }

    private void ApplyAutoDate(ListStatus? previousStatus, ListStatus? newStatus)
    {
        if (newStatus == ListStatus.Watching && previousStatus != ListStatus.Watching && !editStartDate.HasValue)
            editStartDate = DateTime.Today;
        if (newStatus == ListStatus.Completed && previousStatus != ListStatus.Completed && !editFinishDate.HasValue)
            editFinishDate = DateTime.Today;
    }

    private void ApplyRewatchAutoStatus(int previousRewatches)
    {
        if (editRewatches > 0 && previousRewatches == 0 && !editStatus.HasValue)
        {
            var prev = editStatus;
            editStatus = ListStatus.Completed;
            int total = GetTotalEpisodes();
            if (total > 0) editEpisodes = total;
            ApplyAutoDate(prev, editStatus);
        }
    }

    // ── Episode bar ───────────────────────────────────────────────────────────
    private async Task HandleEpBarPointerDown(PointerEventArgs e)
    {
        if (CurrentAnime?.Status == "NOT_YET_RELEASED") return;
        int totalEp = GetTotalEpisodes();
        if (totalEp <= 0) return;
        _epBarDragging = true;
        try
        {
            _cachedEpBounds = await JS.InvokeAsync<ElementBounds>("getElementBounds", epBarRef);
            await JS.InvokeVoidAsync("capturePointer", epBarRef, e.PointerId);
        }
        catch { }
        ApplyEpFromX(e.ClientX, totalEp);
        StateHasChanged();
    }

    private void HandleEpBarPointerMove(PointerEventArgs e)
    {
        if (!_epBarDragging || _cachedEpBounds == null) return;
        int totalEp = GetTotalEpisodes();
        if (totalEp <= 0) return;
        ApplyEpFromX(e.ClientX, totalEp);
        double fillPct = (double)editEpisodes / totalEp * 100;
        JS.InvokeVoidAsync("setBarWidth", epBarRef, ".list-editor-ep-fill", fillPct, null);
        JS.InvokeVoidAsync("setInputValue", epInputRef, $"{editEpisodes}/{totalEp}");
    }

    private async Task HandleEpBarPointerUp(PointerEventArgs e)
    {
        if (!_epBarDragging) return;
        _epBarDragging  = false;
        _cachedEpBounds = null;
        int totalEp = GetTotalEpisodes();
        var prev = editStatus;
        if (editEpisodes > 0 && !editStatus.HasValue) editStatus = ListStatus.Watching;
        if (totalEp > 0 && editEpisodes == totalEp) editStatus = ListStatus.Completed;
        ApplyAutoDate(prev, editStatus);
        await AutoSave();
        StateHasChanged();
    }

    private void ApplyEpFromX(double clientX, int totalEp)
    {
        if (_cachedEpBounds == null || _cachedEpBounds.Width <= 0) return;
        double pct = Math.Clamp((clientX - _cachedEpBounds.Left) / _cachedEpBounds.Width, 0, 1);
        editEpisodes = (int)Math.Round(pct * totalEp);
    }

    // ── Touch handlers ────────────────────────────────────────────────────────
    private string GetModalTransition()
    {
        if (isPulling || isEdgeSwiping) return "none";
        return "transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94)";
    }

    private async Task HandleModalTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        var touch = e.Touches[0];

        if (touch.ClientX <= EDGE_ZONE_WIDTH)
        {
            isPullTrackingActive      = false;
            isPulling                 = false;
            pullOffset                = 0;
            isEdgeSwipeTrackingActive = true;
            isEdgeSwiping             = false;
            edgeSwipeStartX           = touch.ClientX;
            edgeSwipeStartY           = touch.ClientY;
            edgeSwipeOffset           = 0;
            StateHasChanged();
            return;
        }

        bool atTop = await JS.InvokeAsync<bool>("isModalScrollAtTop", scrollContainerRef);
        if (!atTop) return;
        isPullTrackingActive = true;
        isPulling            = false;
        pullStartY           = touch.ClientY;
        pullOffset           = 0;
    }

    private void HandleModalTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        var touch = e.Touches[0];

        if (isEdgeSwipeTrackingActive)
        {
            double dx = touch.ClientX - edgeSwipeStartX;
            double dy = touch.ClientY - edgeSwipeStartY;
            if (!isEdgeSwiping && Math.Abs(dy) > Math.Abs(dx) + 10)
            {
                isEdgeSwipeTrackingActive = false;
                StateHasChanged();
                return;
            }
            if (dx > 0)
            {
                isEdgeSwiping = true;
                edgeSwipeOffset = dx <= EDGE_SWIPE_CLOSE_THRESHOLD
                    ? dx
                    : EDGE_SWIPE_CLOSE_THRESHOLD + (dx - EDGE_SWIPE_CLOSE_THRESHOLD) * 0.25;
                StateHasChanged();
            }
            return;
        }

        if (!isPullTrackingActive) return;
        double delta = touch.ClientY - pullStartY;
        if (delta <= 0) { isPulling = false; pullOffset = 0; return; }
        isPulling  = true;
        pullOffset = Math.Sqrt(delta) * 6;
        StateHasChanged();
    }

    private async Task HandleModalTouchEnd(TouchEventArgs e)
    {
        if (isEdgeSwipeTrackingActive)
        {
            isEdgeSwipeTrackingActive = false;
            isEdgeSwiping             = false;
            if (edgeSwipeOffset >= EDGE_SWIPE_CLOSE_THRESHOLD)
            {
                edgeSwipeOffset = 500;
                StateHasChanged();
                await Task.Delay(260);
                edgeSwipeOffset = 0;
                await OnClose.InvokeAsync();
            }
            else { edgeSwipeOffset = 0; StateHasChanged(); }
            return;
        }

        if (!isPullTrackingActive) return;
        isPullTrackingActive = false;
        isPulling            = false;

        if (pullOffset >= PULL_CLOSE_THRESHOLD)
        {
            pullOffset = 900;
            StateHasChanged();
            await Task.Delay(260);
            pullOffset = 0;
            await OnClose.InvokeAsync();
        }
        else { pullOffset = 0; StateHasChanged(); }
    }

