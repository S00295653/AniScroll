@code {
    [Parameter] public AnimeCard? CurrentAnime { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool isFavorited = false;
    private bool showSpoilers = false;
    private int? _lastAnimeId = null;

    // ─── List state ───────────────────────────────────────────────────────────
    private bool isInList = false;
    private ListStatus? currentListStatus = null;

    private static readonly ListStatus[] _allStatuses =
    {
        ListStatus.Watching, ListStatus.Rewatching, ListStatus.Completed,
        ListStatus.Planning, ListStatus.Paused, ListStatus.Dropped
    };

    // ─── List Editor state ────────────────────────────────────────────────────
    private bool showListEditor = false;
    private bool showDeleteConfirm = false;

    // Edit form fields
    private ListStatus editStatus = ListStatus.Planning;
    private int editScore = 0;
    private int editEpisodes = 0;
    private int editRewatches = 0;
    private string editNotes = "";
    private DateTime? editStartDate = null;
    private DateTime? editFinishDate = null;
    private bool editIsPrivate = false;
    private bool editHideFromLists = false;
    private bool editWatchSoon = false;
    private bool editMovies = false;

    // ─── Swipe-DOWN-to-close state ────────────────────────────────────────────
    private ElementReference scrollContainerRef;
    private double pullOffset = 0;
    private double pullStartY = 0;
    private bool isPulling = false;
    private bool isPullTrackingActive = false;
    private const double PULL_CLOSE_THRESHOLD = 40;

    // ─── Swipe-LEFT-EDGE-to-close state ──────────────────────────────────────
    private double edgeSwipeStartX = 0;
    private double edgeSwipeStartY = 0;
    private double edgeSwipeOffset = 0;
    private bool isEdgeSwiping = false;
    private bool isEdgeSwipeTrackingActive = false;
    private const double EDGE_ZONE_WIDTH = 40;
    private const double EDGE_SWIPE_CLOSE_THRESHOLD = 90;

    // ─── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        UserListService.OnChanged += HandleListChanged;
    }

    public void Dispose() => UserListService.OnChanged -= HandleListChanged;

    private void HandleListChanged()
    {
        RefreshListState();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (CurrentAnime?.Id != _lastAnimeId)
        {
            isFavorited = false;
            showSpoilers = false;
            showListEditor = false;
            showDeleteConfirm = false;
            pullOffset = 0;
            isPulling = false;
            isPullTrackingActive = false;
            edgeSwipeOffset = 0;
            isEdgeSwiping = false;
            isEdgeSwipeTrackingActive = false;
            _lastAnimeId = CurrentAnime?.Id;
            RefreshListState();
        }
    }

    private void RefreshListState()
    {
        if (CurrentAnime == null) { isInList = false; currentListStatus = null; return; }
        var status = UserListService.GetStatus(CurrentAnime.Id);
        isInList = status.HasValue;
        currentListStatus = status;
    }

    // ─── List Editor ──────────────────────────────────────────────────────────

    private void OpenListEditor()
    {
        if (CurrentAnime == null) return;

        // Populate form from existing entry or defaults
        var existing = UserListService.GetEntry(CurrentAnime.Id);
        if (existing != null)
        {
            editStatus      = existing.Status;
            editScore       = existing.Score;
            editEpisodes    = existing.EpisodesWatched;
            editRewatches   = existing.TotalRewatches;
            editNotes       = existing.Notes;
            editStartDate   = existing.StartDate;
            editFinishDate  = existing.FinishDate;
            editIsPrivate   = existing.IsPrivate;
            editHideFromLists = existing.HideFromStatusLists;
            editWatchSoon   = existing.WatchSoon;
            editMovies      = existing.Movies;
        }
        else
        {
            editStatus      = ListStatus.Planning;
            editScore       = 0;
            editEpisodes    = 0;
            editRewatches   = 0;
            editNotes       = "";
            editStartDate   = null;
            editFinishDate  = null;
            editIsPrivate   = false;
            editHideFromLists = false;
            editWatchSoon   = false;
            editMovies      = false;
        }

        showListEditor = true;
        StateHasChanged();
    }

    private void CloseListEditor()
    {
        showListEditor = false;
        StateHasChanged();
    }

    private void SaveListEntry()
    {
        if (CurrentAnime == null) return;

        var existing = UserListService.GetEntry(CurrentAnime.Id) ?? new UserListEntry
        {
            Anime   = CurrentAnime,
            AddedAt = DateTime.Now
        };

        existing.Status              = editStatus;
        existing.Score               = editScore;
        existing.EpisodesWatched     = editEpisodes;
        existing.TotalRewatches      = editRewatches;
        existing.Notes               = editNotes;
        existing.StartDate           = editStartDate;
        existing.FinishDate          = editFinishDate;
        existing.IsPrivate           = editIsPrivate;
        existing.HideFromStatusLists = editHideFromLists;
        existing.WatchSoon           = editWatchSoon;
        existing.Movies              = editMovies;

        UserListService.SaveEntry(existing);
        currentListStatus = editStatus;
        isInList = true;
        showListEditor = false;
        StateHasChanged();
    }

    private void PromptDelete()
    {
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        StateHasChanged();
    }

    private void ConfirmDelete()
    {
        if (CurrentAnime == null) return;
        UserListService.Remove(CurrentAnime.Id);
        isInList = false;
        currentListStatus = null;
        showDeleteConfirm = false;
        showListEditor = false;
        StateHasChanged();
    }

    // ─── Score helpers ────────────────────────────────────────────────────────

    private void ChangeScore(int delta)
    {
        editScore = Math.Max(0, Math.Min(10, editScore + delta));
        if (editScore == 0 && delta < 0) editScore = 0;
        StateHasChanged();
    }

    private void SetScore(int val)
    {
        editScore = (editScore == val) ? 0 : val; // toggle off if same
        StateHasChanged();
    }

    private static string GetScoreColor(int idx) => idx switch
    {
        1 or 2      => "score-red",
        3 or 4      => "score-orange",
        5 or 6      => "score-yellow",
        7 or 8      => "score-lime",
        9 or 10     => "score-green",
        _           => ""
    };

    private static string GetScoreLabel(int score) => score switch
    {
        1  => "Appalling",
        2  => "Horrible",
        3  => "Very Bad",
        4  => "Bad",
        5  => "Average",
        6  => "Fine",
        7  => "Good",
        8  => "Very Good",
        9  => "Great",
        10 => "Masterpiece",
        _  => ""
    };

    private void ChangeEpisodes(int delta)
    {
        editEpisodes = Math.Max(0, editEpisodes + delta);
        StateHasChanged();
    }

    // ─── Transition helper ────────────────────────────────────────────────────

    private string GetModalTransition()
    {
        if (isPulling || isEdgeSwiping) return "none";
        return "transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94)";
    }

    // ─── Touch handlers ───────────────────────────────────────────────────────

    private async Task HandleModalTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        var touch = e.Touches[0];

        if (touch.ClientX <= EDGE_ZONE_WIDTH)
        {
            isEdgeSwipeTrackingActive = true;
            isEdgeSwiping = false;
            edgeSwipeStartX = touch.ClientX;
            edgeSwipeStartY = touch.ClientY;
            edgeSwipeOffset = 0;
            return;
        }

        bool atTop = await JS.InvokeAsync<bool>("isModalScrollAtTop", scrollContainerRef);
        if (!atTop) return;
        isPullTrackingActive = true;
        isPulling = false;
        pullStartY = touch.ClientY;
        pullOffset = 0;
    }

    private void HandleModalTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        var touch = e.Touches[0];

        if (isEdgeSwipeTrackingActive)
        {
            double dx = touch.ClientX - edgeSwipeStartX;
            double dy = touch.ClientY - edgeSwipeStartY;
            if (!isEdgeSwiping && Math.Abs(dy) > Math.Abs(dx) + 10)
            {
                isEdgeSwipeTrackingActive = false;
                return;
            }
            if (dx > 0)
            {
                isEdgeSwiping = true;
                edgeSwipeOffset = dx <= EDGE_SWIPE_CLOSE_THRESHOLD
                    ? dx
                    : EDGE_SWIPE_CLOSE_THRESHOLD + (dx - EDGE_SWIPE_CLOSE_THRESHOLD) * 0.25;
                StateHasChanged();
            }
            return;
        }

        if (!isPullTrackingActive) return;
        double delta = touch.ClientY - pullStartY;
        if (delta <= 0) { isPulling = false; pullOffset = 0; return; }
        isPulling = true;
        pullOffset = Math.Sqrt(delta) * 6;
        StateHasChanged();
    }

    private async Task HandleModalTouchEnd(TouchEventArgs e)
    {
        if (isEdgeSwipeTrackingActive)
        {
            isEdgeSwipeTrackingActive = false;
            isEdgeSwiping = false;
            if (edgeSwipeOffset >= EDGE_SWIPE_CLOSE_THRESHOLD)
            {
                edgeSwipeOffset = 500;
                StateHasChanged();
                await Task.Delay(260);
                edgeSwipeOffset = 0;
                await OnClose.InvokeAsync();
            }
            else { edgeSwipeOffset = 0; StateHasChanged(); }
            return;
        }

        if (!isPullTrackingActive) return;
        isPullTrackingActive = false;
        isPulling = false;

        if (pullOffset >= PULL_CLOSE_THRESHOLD)
        {
            pullOffset = 900;
            StateHasChanged();
            await Task.Delay(260);
            pullOffset = 0;
            await OnClose.InvokeAsync();
        }
        else { pullOffset = 0; StateHasChanged(); }
    }

    // ─── Helpers ──────────────────────────────────────────────────────────────

    private void Close() => OnClose.InvokeAsync();
    private void OnOverlayClick() => Close();
