    private void HandleListChanged() { RefreshListState(); InvokeAsync(StateHasChanged); }

    protected override void OnParametersSet()
    {
        if (CurrentAnime?.Id != _lastAnimeId)
        {
            isFavorited = false; showSpoilers = false; showListEditor = false; showDeleteConfirm = false;
            pullOffset = 0; isPulling = false; isPullTrackingActive = false;
            edgeSwipeOffset = 0; isEdgeSwiping = false; isEdgeSwipeTrackingActive = false;
            _scoreBarDragging = false; _epBarDragging = false; _shareOpen = false; _shareCopied = false;
            _lastAnimeId = CurrentAnime?.Id; RefreshListState();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showListEditor && !_wheelListenerActive) { _wheelListenerActive = true; try { await JS.InvokeVoidAsync("preventWheelScroll", _listEditorOverlayRef); } catch { } }
        else if (!showListEditor && _wheelListenerActive) { _wheelListenerActive = false; try { await JS.InvokeVoidAsync("removeWheelScrollPrevention", _listEditorOverlayRef); } catch { } }
        if (IsVisible && !_edgeInterceptorRegistered) { _edgeInterceptorRegistered = true; try { await JS.InvokeVoidAsync("registerEdgeSwipeInterceptor", scrollContainerRef, (int)EDGE_ZONE_WIDTH); } catch { } }
        else if (!IsVisible && _edgeInterceptorRegistered) { _edgeInterceptorRegistered = false; try { await JS.InvokeVoidAsync("unregisterEdgeSwipeInterceptor"); } catch { } }
    }

    private void RefreshListState()
    {
        if (CurrentAnime == null) { isInList = false; currentListStatus = null; currentCustomListId = null; isFavorited = false; return; }
        var entry = UserListService.GetEntry(CurrentAnime.Id);
        isInList = entry != null; currentListStatus = entry?.Status;
        var statusTypeIds = UserListService.GetStatusTypeLists().Select(c => c.Id).ToHashSet();
        currentCustomListId = entry?.CustomListIds.FirstOrDefault(id => statusTypeIds.Contains(id));
        isFavorited = UserListService.IsFavorited(CurrentAnime.Id);
    }

    private async Task AutoSave()
    {
        if (CurrentAnime == null) return;
        var existing = UserListService.GetEntry(CurrentAnime.Id);
        bool hasContent = existing != null || editStatus.HasValue || _editStatusTypeCustomId != null || editScore > 0 || editEpisodes > 0 || editRewatches > 0 || !string.IsNullOrEmpty(editNotes) || editStartDate.HasValue || editFinishDate.HasValue || _editCustomListIds.Any();
        if (!hasContent) return;
        existing ??= new UserListEntry { Anime = CurrentAnime, AddedAt = DateTime.Now };
        existing.Status = editStatus; existing.Score = editScore; existing.EpisodesWatched = editEpisodes; existing.TotalRewatches = editRewatches; existing.Notes = editNotes; existing.StartDate = editStartDate; existing.FinishDate = editFinishDate; existing.IsPrivate = editIsPrivate; existing.HideFromStatusLists = editHideFromLists;
        var allCustomIds = new List<string>(_editCustomListIds); if (_editStatusTypeCustomId != null) allCustomIds.Add(_editStatusTypeCustomId); existing.CustomListIds = allCustomIds;
        UserListService.SaveEntry(existing); currentListStatus = editStatus; currentCustomListId = _editStatusTypeCustomId; isInList = true;
        if (!_deleteAnimVisible && showListEditor) _ = TriggerDeleteAnimAsync();
        StateHasChanged(); await Task.CompletedTask;
    }

    private async Task CloseAndSave()
    {
        if (CurrentAnime != null) await AutoSave();
        showListEditor = false; _statusDropdownOpen = false; _scoreBarDragging = false; _epBarDragging = false; _cachedScoreBounds = null; _cachedEpBounds = null; StateHasChanged();
    }

    private void OpenListEditor()
    {
        if (CurrentAnime == null) return;
        var existing = UserListService.GetEntry(CurrentAnime.Id);
        if (existing != null)
        {
            editStatus = existing.Status; editScore = existing.Score; editEpisodes = existing.EpisodesWatched; editRewatches = existing.TotalRewatches; editNotes = existing.Notes; editStartDate = existing.StartDate; editFinishDate = existing.FinishDate; editIsPrivate = existing.IsPrivate; editHideFromLists = existing.HideFromStatusLists;
            var statusTypeIds = UserListService.GetStatusTypeLists().Select(c => c.Id).ToHashSet(); _editStatusTypeCustomId = existing.CustomListIds.FirstOrDefault(id => statusTypeIds.Contains(id)); _editCustomListIds = new HashSet<string>(existing.CustomListIds.Where(id => !statusTypeIds.Contains(id)));
        }
        else { editStatus = null; editScore = 0; editEpisodes = 0; editRewatches = 0; editNotes = ""; editStartDate = null; editFinishDate = null; editIsPrivate = false; editHideFromLists = false; _editStatusTypeCustomId = null; _editCustomListIds = new(); }
        if (CurrentAnime.Status == "NOT_YET_RELEASED") { editEpisodes = 0; editRewatches = 0; }
        _statusDropdownOpen = false; _deleteAnimVisible = false; showListEditor = true; StateHasChanged();
        if (isInList) _ = TriggerDeleteAnimAsync();
    }

