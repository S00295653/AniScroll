    private void ChangeScore(double delta) { editScore = Math.Max(0, Math.Min(10, Math.Round((editScore + delta) * 2) / 2)); StateHasChanged(); }
    private async Task HandleScoreInputFocus() { try { await JS.InvokeVoidAsync("setAndSelectInput", scoreInputRef, editScore > 0 ? FormatScore(editScore) : ""); } catch { } }
    private async Task HandleScoreTextChange(ChangeEventArgs e) { var raw = e.Value?.ToString() ?? ""; if (string.IsNullOrWhiteSpace(raw)) { editScore = 0; try { await JS.InvokeVoidAsync("setInputValue", scoreInputRef, ""); } catch { } } else if (double.TryParse(raw.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double v) && v >= 0 && v <= 10) editScore = Math.Max(0, Math.Min(10, Math.Round(v * 2) / 2)); else { try { await JS.InvokeVoidAsync("setInputValue", scoreInputRef, editScore > 0 ? FormatScore(editScore) : ""); } catch { } } await AutoSave(); StateHasChanged(); }
    private async Task HandleScoreBarPointerDown(PointerEventArgs e) { _scoreBarDragging = true; try { _cachedScoreBounds = await JS.InvokeAsync<ElementBounds>("getElementBounds", scoreBarRef); await JS.InvokeVoidAsync("capturePointer", scoreBarRef, e.PointerId); } catch { } ApplyScoreFromX(e.ClientX); StateHasChanged(); }
    private void HandleScoreBarPointerMove(PointerEventArgs e) { if (!_scoreBarDragging || _cachedScoreBounds == null) return; ApplyScoreFromX(e.ClientX); JS.InvokeVoidAsync("setBarWidth", scoreBarRef, ".le-score-bar-fill-click", editScore / 10.0 * 100, GetScoreHexColor(editScore)); JS.InvokeVoidAsync("setInputValue", scoreInputRef, editScore > 0 ? ((int)editScore).ToString() : ""); }
    private async Task HandleScoreBarPointerUp(PointerEventArgs e) { if (!_scoreBarDragging) return; _scoreBarDragging = false; _cachedScoreBounds = null; await AutoSave(); StateHasChanged(); }
    private void ApplyScoreFromX(double clientX) { if (_cachedScoreBounds == null || _cachedScoreBounds.Width <= 0) return; editScore = Math.Round(Math.Clamp((clientX - _cachedScoreBounds.Left) / _cachedScoreBounds.Width, 0, 1) * 10); }
    private int GetTotalEpisodes() { if (CurrentAnime == null) return 0; foreach (var part in (CurrentAnime.Episodes ?? "").Split('/').Reverse()) { var c = new string(part.Trim().TakeWhile(char.IsDigit).ToArray()); if (int.TryParse(c, out int p) && p > 0) return p; } return 0; }
    private string GetEpInputDisplay() { int t = GetTotalEpisodes(); return t > 0 ? $"{editEpisodes}/{t}" : editEpisodes.ToString(); }
    private void ChangeEpisodes(int delta) { if (CurrentAnime?.Status == "NOT_YET_RELEASED") return; int total = GetTotalEpisodes(); int next = editEpisodes + delta; if (next < 0 || (total > 0 && next > total)) return; editEpisodes = next; var prev = editStatus; if (editEpisodes > 0 && !editStatus.HasValue) editStatus = ListStatus.Watching; if (total > 0 && editEpisodes == total) editStatus = ListStatus.Completed; ApplyAutoDate(prev, editStatus); StateHasChanged(); }
    private async Task HandleEpInputFocus() { try { await JS.InvokeVoidAsync("selectInputContent", epInputRef); } catch { } }
    private async Task HandleEpTextChange(ChangeEventArgs e) { if (CurrentAnime?.Status == "NOT_YET_RELEASED") { editEpisodes = 0; try { await JS.InvokeVoidAsync("setInputValue", epInputRef, GetEpInputDisplay()); } catch { } StateHasChanged(); return; } var part = (e.Value?.ToString() ?? "").Split('/')[0].Trim(); int totalEp = GetTotalEpisodes(); if (int.TryParse(part, out int v) && v >= 0 && (totalEp <= 0 || v <= totalEp)) { editEpisodes = v; var prev = editStatus; if (editEpisodes > 0 && !editStatus.HasValue) editStatus = ListStatus.Watching; if (totalEp > 0 && editEpisodes == totalEp) editStatus = ListStatus.Completed; ApplyAutoDate(prev, editStatus); } else { try { await JS.InvokeVoidAsync("setInputValue", epInputRef, GetEpInputDisplay()); } catch { } } await AutoSave(); StateHasChanged(); }
    private async Task HandleRewatchInputFocus() { try { await JS.InvokeVoidAsync("selectInputContent", rewatchInputRef); } catch { } }
    private async Task HandleRewatchTextChange(ChangeEventArgs e) { var raw = e.Value?.ToString() ?? ""; if (int.TryParse(raw.Trim(), out int v) && v >= 0) { int prev = editRewatches; editRewatches = v; ApplyRewatchAutoStatus(prev); } else { try { await JS.InvokeVoidAsync("setInputValue", rewatchInputRef, editRewatches.ToString()); } catch { } } await AutoSave(); StateHasChanged(); }
    private void ApplyAutoDate(ListStatus? prev, ListStatus? next) { if (next == ListStatus.Watching && prev != ListStatus.Watching && !editStartDate.HasValue) editStartDate = DateTime.Today; if (next == ListStatus.Completed && prev != ListStatus.Completed && !editFinishDate.HasValue) editFinishDate = DateTime.Today; }
    private void ApplyRewatchAutoStatus(int prev) { if (editRewatches > 0 && prev == 0 && !editStatus.HasValue) { var p = editStatus; editStatus = ListStatus.Completed; int t = GetTotalEpisodes(); if (t > 0) editEpisodes = t; ApplyAutoDate(p, editStatus); } }
    private async Task HandleEpBarPointerDown(PointerEventArgs e) { if (CurrentAnime?.Status == "NOT_YET_RELEASED") return; int totalEp = GetTotalEpisodes(); if (totalEp <= 0) return; _epBarDragging = true; try { _cachedEpBounds = await JS.InvokeAsync<ElementBounds>("getElementBounds", epBarRef); await JS.InvokeVoidAsync("capturePointer", epBarRef, e.PointerId); } catch { } ApplyEpFromX(e.ClientX, totalEp); StateHasChanged(); }
    private void HandleEpBarPointerMove(PointerEventArgs e) { if (!_epBarDragging || _cachedEpBounds == null) return; int totalEp = GetTotalEpisodes(); if (totalEp <= 0) return; ApplyEpFromX(e.ClientX, totalEp); JS.InvokeVoidAsync("setBarWidth", epBarRef, ".list-editor-ep-fill", (double)editEpisodes / totalEp * 100, null); JS.InvokeVoidAsync("setInputValue", epInputRef, $"{editEpisodes}/{totalEp}"); }
    private async Task HandleEpBarPointerUp(PointerEventArgs e) { if (!_epBarDragging) return; _epBarDragging = false; _cachedEpBounds = null; int totalEp = GetTotalEpisodes(); var prev = editStatus; if (editEpisodes > 0 && !editStatus.HasValue) editStatus = ListStatus.Watching; if (totalEp > 0 && editEpisodes == totalEp) editStatus = ListStatus.Completed; ApplyAutoDate(prev, editStatus); await AutoSave(); StateHasChanged(); }
    private void ApplyEpFromX(double clientX, int totalEp) { if (_cachedEpBounds == null || _cachedEpBounds.Width <= 0) return; editEpisodes = (int)Math.Round(Math.Clamp((clientX - _cachedEpBounds.Left) / _cachedEpBounds.Width, 0, 1) * totalEp); }
    private string GetModalTransition() => (isPulling || isEdgeSwiping) ? "none" : "transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94)";
    private async Task HandleModalTouchStart(TouchEventArgs e) { if (e.Touches.Length == 0) return; var touch = e.Touches[0]; if (touch.ClientX <= EDGE_ZONE_WIDTH) { isPullTrackingActive = false; isPulling = false; pullOffset = 0; isEdgeSwipeTrackingActive = true; isEdgeSwiping = false; edgeSwipeStartX = touch.ClientX; edgeSwipeStartY = touch.ClientY; edgeSwipeOffset = 0; StateHasChanged(); return; } bool atTop = await JS.InvokeAsync<bool>("isModalScrollAtTop", scrollContainerRef); if (!atTop) return; isPullTrackingActive = true; isPulling = false; pullStartY = touch.ClientY; pullOffset = 0; }
    private void HandleModalTouchMove(TouchEventArgs e) { if (e.Touches.Length == 0) return; var touch = e.Touches[0]; if (isEdgeSwipeTrackingActive) { double dx = touch.ClientX - edgeSwipeStartX, dy = touch.ClientY - edgeSwipeStartY; if (!isEdgeSwiping && Math.Abs(dy) > Math.Abs(dx) + 10) { isEdgeSwipeTrackingActive = false; StateHasChanged(); return; } if (dx > 0) { isEdgeSwiping = true; edgeSwipeOffset = dx <= EDGE_SWIPE_CLOSE_THRESHOLD ? dx : EDGE_SWIPE_CLOSE_THRESHOLD + (dx - EDGE_SWIPE_CLOSE_THRESHOLD) * 0.25; StateHasChanged(); } return; } if (!isPullTrackingActive) return; double delta = touch.ClientY - pullStartY; if (delta <= 0) { isPulling = false; pullOffset = 0; return; } isPulling = true; pullOffset = Math.Sqrt(delta) * 6; StateHasChanged(); }
    private async Task HandleModalTouchEnd(TouchEventArgs e) { if (isEdgeSwipeTrackingActive) { isEdgeSwipeTrackingActive = false; isEdgeSwiping = false; if (edgeSwipeOffset >= EDGE_SWIPE_CLOSE_THRESHOLD) { edgeSwipeOffset = 500; StateHasChanged(); await Task.Delay(260); edgeSwipeOffset = 0; await OnClose.InvokeAsync(); } else { edgeSwipeOffset = 0; StateHasChanged(); } return; } if (!isPullTrackingActive) return; isPullTrackingActive = false; isPulling = false; if (pullOffset >= PULL_CLOSE_THRESHOLD) { pullOffset = 900; StateHasChanged(); await Task.Delay(260); pullOffset = 0; await OnClose.InvokeAsync(); } else { pullOffset = 0; StateHasChanged(); } }

