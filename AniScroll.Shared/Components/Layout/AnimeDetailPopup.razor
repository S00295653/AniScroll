                                   value="@(editStartDate.HasValue ? editStartDate.Value.ToString("yyyy-MM-dd") : "")"
                                   @onchange="e => editStartDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)" />
                        </div>
                    </div>

                    <!-- Finish Date -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Finish Date</span>
                        <div class="list-editor-date-wrapper">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <input type="date" class="list-editor-date-input"
                                   value="@(editFinishDate.HasValue ? editFinishDate.Value.ToString("yyyy-MM-dd") : "")"
                                   @onchange="e => editFinishDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)" />
                        </div>
                    </div>

                    <!-- Total Rewatches -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Total Rewatches</span>
                        <div class="list-editor-number-input">
                            <span class="list-editor-num-display">@editRewatches</span>
                            <div class="list-editor-arrows">
                                <button class="list-editor-arrow-btn" @onclick="() => editRewatches = Math.Max(0, editRewatches + 1)">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                                </button>
                                <button class="list-editor-arrow-btn" @onclick="() => editRewatches = Math.Max(0, editRewatches - 1)">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Privacy options -->
                    <div class="list-editor-field">
                        <span class="list-editor-label">Options</span>
                        <div class="list-editor-custom-lists">
                            <label class="list-editor-checkbox-row">
                                <input type="checkbox" @bind="editHideFromLists" />
                                <span>Hide from status lists</span>
                            </label>
                            <label class="list-editor-checkbox-row">
                                <input type="checkbox" @bind="editIsPrivate" />
                                <span>Private</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- ── Notes ── -->
                <div class="list-editor-field">
                    <span class="list-editor-label">Notes</span>
                    <textarea class="list-editor-textarea"
                              placeholder="Add notes..."
                              @bind="editNotes"
                              @bind:event="oninput"></textarea>
                </div>

                <!-- ── Footer: Delete ── -->
                @if (isInList)
                {
                    <div class="list-editor-footer">
                        <button class="list-editor-delete-btn" @onclick="PromptDelete">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 style="flex-shrink:0;">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v6M14 11v6"></path>
                                <path d="M9 6V4h6v2"></path>
                            </svg>
                            Delete
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
}

