@using AniScroll.Shared.Models
@inject IJSRuntime JS

@if (IsVisible && CurrentAnime != null)
{
    <div class="anime-detail-overlay" @onclick="OnOverlayClick">
        <div class="anime-detail-modal"
             @onclick:stopPropagation="true"
             style="transform: translateY(@(pullOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px) translateX(@(edgeSwipeOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px); transition: @(isPulling || isEdgeSwiping ? "none" : "transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94)");">

            <button class="modal-close-btn" @onclick="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="modal-scroll-container"
                 @ref="scrollContainerRef"
                 @ontouchstart="HandleModalTouchStart"
                 @ontouchmove="HandleModalTouchMove"
                 @ontouchend="HandleModalTouchEnd">

                <div class="modal-header">
                    <div class="modal-banner" style="@(string.IsNullOrEmpty(CurrentAnime.BannerUrl) ? "background:linear-gradient(135deg,#1a1a2e,#16213e);" : $"background-image:url('{CurrentAnime.BannerUrl}');")"></div>

                    <div class="modal-header-content">
                        <div class="modal-poster-section">
                            <div class="modal-poster" style="background-image: url('@CurrentAnime.ImageUrl');"></div>

                            <div class="modal-action-buttons">
                                <button class="btn-add-to-list" @onclick="OnAddToList">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    Add to List
                                </button>
                                <div class="modal-secondary-btns">
                                    <button class="btn-share" @onclick="OnShare">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="18" cy="5" r="3"></circle>
                                            <circle cx="6" cy="12" r="3"></circle>
                                            <circle cx="18" cy="19" r="3"></circle>
                                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                        </svg>
                                        Share
                                    </button>
                                    <button class="btn-favorite @(isFavorited ? "is-favorited" : "")" @onclick="OnFavorite">
                                        <svg width="16" height="16" viewBox="0 0 24 24"
                                             fill="@(isFavorited ? "currentColor" : "none")"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="modal-info-section">
                            <h1 class="modal-title">@CurrentAnime.Title</h1>

                            @if (!string.IsNullOrEmpty(CurrentAnime.Season) && CurrentAnime.Year.HasValue)
                            {
                                <div class="modal-airing-info">
                                    @if (CurrentAnime.Status == "RELEASING")
                                    {
                                        <span class="popup-status-dot popup-dot-releasing"></span>
                                        <span>@CurrentAnime.Season @CurrentAnime.Year · Airing</span>
                                    }
                                    else if (CurrentAnime.Status == "NOT_YET_RELEASED")
                                    {
                                        <span class="popup-status-dot popup-dot-upcoming"></span>
                                        <span>@CurrentAnime.Season @CurrentAnime.Year · Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="modal-season-plain">@CurrentAnime.Season @CurrentAnime.Year</span>
                                    }
                                </div>
                            }

                            @if (CurrentAnime.Status == "RELEASING" && CurrentAnime.NextAiringEpisodeNum.HasValue)
                            {
                                <div class="next-ep-banner">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span class="next-ep-ep">Ep. @CurrentAnime.NextAiringEpisodeNum</span>
                                    @if (CurrentAnime.NextAiringTimeUntil.HasValue)
                                    {
                                        <span class="next-ep-time">in @FormatCountdown(CurrentAnime.NextAiringTimeUntil.Value)</span>
                                    }
                                </div>
                            }

                            @{
                                var topRankings = CurrentAnime.Rankings?
                                .Where(r => r.AllTime)
                                .OrderBy(r => r.Rank)
                                .Take(2)
                                .ToList();
                            }
                            @if (topRankings?.Any() == true)
                            {
                                <div class="rank-row">
                                    @foreach (var r in topRankings)
                                    {
                                        <span class="rank-badge @(r.Type == "RATED" ? "rank-rated" : "rank-popular")">
                                            @(r.Type == "RATED" ? "⭐" : "❤️") #@r.Rank @(r.Type == "RATED" ? "Rated" : "Popular") All Time
                                        </span>
                                    }
                                </div>
                            }

                            <div class="modal-info-grid">
                                <div class="info-col">
                                    <div class="info-field">
                                        <span class="info-lbl">Score</span>
                                        <span class="info-val">@CurrentAnime.Score</span>
                                    </div>
                                    @if (CurrentAnime.Favourites.HasValue)
                                    {
                                        <div class="info-field">
                                            <span class="info-lbl">Favorites</span>
                                            <span class="info-val">@CurrentAnime.Favourites.Value.ToString("N0")</span>
                                        </div>
                                    }
                                    <div class="info-field">
                                        <span class="info-lbl">Status</span>
                                        <span class="info-val">@GetStatusText(CurrentAnime.Status)</span>
                                    </div>
                                </div>
                                <div class="info-col">
                                    <div class="info-field">
                                        <span class="info-lbl">Episodes</span>
                                        <span class="info-val">@CurrentAnime.Episodes</span>
                                    </div>
                                    @if (CurrentAnime.Duration.HasValue)
                                    {
                                        <div class="info-field">
                                            <span class="info-lbl">Duration</span>
                                            <span class="info-val">@CurrentAnime.Duration min</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(CurrentAnime.Source))
                                    {
                                        <div class="info-field">
                                            <span class="info-lbl">Source</span>
                                            <span class="info-val">@CurrentAnime.Source</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-content">

                    @if (!string.IsNullOrEmpty(CurrentAnime.Description))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Synopsis</h3>
                            <p class="synopsis-text">@CurrentAnime.Description</p>
                        </div>
                    }

                    @{
                        var relationOrder = new Dictionary<string, int>
                        {
                            {"Source", 1}, {"Adaptation", 2}, {"Prequel", 3}, {"Parent", 4},
                            {"Sequel", 5}, {"Side Story", 6}, {"Spin-off", 7},
                            {"Alternative", 8}, {"Character", 9}, {"Summary", 10},
                            {"Compilation", 11}, {"Contains", 12}, {"Other", 99}
                        };
                        var sortedRelations = CurrentAnime.Relations?
                            .OrderBy(r => relationOrder.TryGetValue(r.RelationType, out var o) ? o : 99)
                            .ThenBy(r => r.Title)
                            .ToList();
                    }
                    @if (sortedRelations?.Any() == true && CurrentAnime.Relations != null)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Related <span class="relation-count">(@sortedRelations.Count)</span></h3>
                            <div class="relations-scroll">
                                @foreach (var rel in sortedRelations)
                                {
                                    <div class="relation-card">
                                        <div class="relation-cover" style="background-image: url('@rel.ImageUrl');"></div>
                                        <div class="relation-info">
                                            <div class="relation-type">@rel.RelationType</div>
                                            @if (!string.IsNullOrEmpty(rel.Format))
                                            {
                                                <div class="relation-format">@rel.Format</div>
                                            }
                                            <div class="relation-title">@rel.Title</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (CurrentAnime.Genres?.Any() == true)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Genres</h3>
                            <div class="genres-container">
                                @foreach (var genre in CurrentAnime.Genres)
                                {
                                    <span class="genre-pill">@genre</span>
                                }
                            </div>
                        </div>
                    }

                    @if (CurrentAnime.Studios?.Any() == true)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Studios</h3>
                            <div class="studios-container">
                                @foreach (var studio in CurrentAnime.Studios)
                                {
                                    <span class="studio-badge">@studio.Name</span>
                                }
                            </div>
                        </div>
                    }

                    @{
                        var videoId = GetYouTubeVideoId(CurrentAnime.TrailerUrl ?? "");
                    }
                    @if (!string.IsNullOrEmpty(videoId))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Trailer</h3>
                            <div class="trailer-container">
                                <div class="youtube-embed-wrapper">
                                    <iframe src="https://www.youtube-nocookie.com/embed/@videoId?rel=0&autoplay=0&modestbranding=1"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>
                    }

                    @{
                        var seasonRankings = CurrentAnime.Rankings?.Where(r => !r.AllTime).Take(2).ToList();
                        bool showNativeTitle = !string.IsNullOrWhiteSpace(CurrentAnime.NativeTitle)
                                              && !ContainsNonLatinScript(CurrentAnime.NativeTitle);
                        bool hasDetails = showNativeTitle
                            || !string.IsNullOrEmpty(CurrentAnime.Format)
                            || !string.IsNullOrEmpty(CurrentAnime.StartDate)
                            || !string.IsNullOrEmpty(CurrentAnime.EndDate)
                            || CurrentAnime.Popularity.HasValue
                            || (seasonRankings?.Any() == true);
                    }
                    @if (hasDetails)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Details</h3>
                            <div class="details-grid">
                                @if (showNativeTitle)
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Native Title</span>
                                        <span class="detail-val detail-val-native">@CurrentAnime.NativeTitle</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.Format))
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Format</span>
                                        <span class="detail-val">@CurrentAnime.Format</span>
                                    </div>
                                }
                                @if (CurrentAnime.Popularity.HasValue)
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Popularity</span>
                                        <span class="detail-val">@CurrentAnime.Popularity.Value.ToString("N0") users</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.StartDate))
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">Start Date</span>
                                        <span class="detail-val">@CurrentAnime.StartDate</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.EndDate))
                                {
                                    <div class="detail-row">
                                        <span class="detail-lbl">End Date</span>
                                        <span class="detail-val">@CurrentAnime.EndDate</span>
                                    </div>
                                }
                                @if (seasonRankings?.Any() == true)
                                {
                                    @foreach (var sr in seasonRankings)
                                    {
                                        <div class="detail-row">
                                            <span class="detail-lbl">@(sr.Type == "RATED" ? "Seasonal Rating" : "Seasonal Popularity")</span>
                                            <span class="detail-val">#@sr.Rank · @sr.Season @sr.Year</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @{
                        var visibleTags = CurrentAnime.Tags?
                            .Where(t => !t.IsMediaSpoiler)
                            .OrderByDescending(t => t.Rank)
                            .Take(20)
                            .ToList();
                        var spoilerTags = CurrentAnime.Tags?
                            .Where(t => t.IsMediaSpoiler)
                            .OrderByDescending(t => t.Rank)
                            .ToList();
                        int spoilerCount = spoilerTags?.Count ?? 0;

                        var allTagsSorted = (visibleTags ?? new())
                            .Select(t => (tag: t, isSpoiler: false))
                            .Concat((spoilerTags ?? new()).Select(t => (tag: t, isSpoiler: true)))
                            .OrderByDescending(x => x.tag.Rank)
                            .ToList();
                    }
                    @if ((visibleTags?.Any() == true) || spoilerCount > 0)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Tags</h3>

                            @if (!showSpoilers)
                            {
                                <div class="tags-wrap">
                                    @foreach (var tag in visibleTags ?? new())
                                    {
                                        <span class="tag-pill">
                                            @tag.Name<span class="tag-pct">@tag.Rank%</span>
                                        </span>
                                    }
                                </div>

                                @if (spoilerCount > 0)
                                {
                                    <div style="display:flex;justify-content:center;margin-top:10px;">
                                        <button class="tag-spoiler-btn"
                                                @onclick="() => showSpoilers = true">
                                            @spoilerCount spoiler@(spoilerCount > 1 ? "s" : "") hidden — tap to reveal
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="tags-wrap">
                                    @foreach (var entry in allTagsSorted)
                                    {
                                        @if (!entry.isSpoiler)
                                        {
                                            <span class="tag-pill">
                                                @entry.tag.Name<span class="tag-pct">@entry.tag.Rank%</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="tag-pill tag-pill-spoiler-revealed">
                                                @entry.tag.Name<span class="tag-pct">@entry.tag.Rank%</span>
                                            </span>
                                        }
                                    }
                                </div>

                                <div style="display:flex;justify-content:center;margin-top:10px;">
                                    <button class="tag-spoiler-btn tag-spoiler-hide-btn"
                                            @onclick="() => showSpoilers = false">
                                        Hide spoilers
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @{
                        var streamingLinks = CurrentAnime.ExternalLinks?.Where(l => l.Type == "STREAMING").ToList();
                        var otherLinks = CurrentAnime.ExternalLinks?.Where(l => l.Type == "INFO" || l.Type == "SOCIAL").Take(4).ToList();
                    }
                    <div class="modal-section">
                        <h3 class="section-title">Watch &amp; More</h3>

                        @if (streamingLinks?.Any() == true)
                        {
                            <p class="links-sublabel">Where to watch</p>
                            <div class="platform-list">
                                @foreach (var link in streamingLinks)
                                {
                                    var pc = (!string.IsNullOrEmpty(link.Color) && link.Color != "#000000" && link.Color.StartsWith("#"))
                                        ? link.Color : "#7c7c99";
                                    <a href="@link.Url" target="_blank" class="platform-row" style="--pc: @pc;">
                                        <span class="platform-icon-box">
                                            @GetPlatformIconMarkup(link.Icon, link.Color, link.Site)
                                        </span>
                                        <span class="platform-name-label">@link.Site</span>
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                             stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round">
                                            <path d="m9 18 6-6-6-6"></path>
                                        </svg>
                                    </a>
                                }
                            </div>
                        }

                        <div class="info-chip-row">
                            <a href="https://anilist.co/anime/@CurrentAnime.Id" target="_blank" class="info-chip">
                                <span class="chip-dot" style="background:#02a9ff;"></span>AniList
                            </a>
                            @if (otherLinks?.Any() == true)
                            {
                                @foreach (var ol in otherLinks)
                                {
                                    var c = (!string.IsNullOrEmpty(ol.Color) && ol.Color != "#000000" && ol.Color.StartsWith("#"))
                                        ? ol.Color : "#7c7c99";
                                    <a href="@ol.Url" target="_blank" class="info-chip">
                                        <span class="chip-dot" style="background:@c;"></span>@ol.Site
                                    </a>
                                }
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AnimeCard? CurrentAnime { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool isFavorited = false;
    private bool showSpoilers = false;
    private int? _lastAnimeId = null;

    // ─── Swipe-DOWN-to-close ─────────────────────────────────────────────────────
    private ElementReference scrollContainerRef;
    private double pullOffset = 0;
    private double pullStartY = 0;
    private bool isPulling = false;
    private bool isPullTrackingActive = false;
    private const double PULL_CLOSE_THRESHOLD = 80;

    // ─── Swipe-LEFT-EDGE-to-close ────────────────────────────────────────────────
    private double edgeSwipeOffset = 0;
    private double edgeSwipeStartX = 0;
    private double edgeSwipeStartY = 0;
    private bool isEdgeSwiping = false;
    private bool isEdgeSwipeTrackingActive = false;
    private const double EDGE_TRIGGER_ZONE = 28;    // px from left edge to activate
    private const double EDGE_CLOSE_THRESHOLD = 90; // px of rightward drag to dismiss

    protected override void OnParametersSet()
    {
        if (CurrentAnime?.Id != _lastAnimeId)
        {
            isFavorited = false;
            showSpoilers = false;
            pullOffset = 0;
            isPulling = false;
            isPullTrackingActive = false;
            edgeSwipeOffset = 0;
            isEdgeSwiping = false;
            isEdgeSwipeTrackingActive = false;
            _lastAnimeId = CurrentAnime?.Id;
        }
    }

    // ─── Touch handlers ──────────────────────────────────────────────────────────

    private async Task HandleModalTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        var touch = e.Touches[0];

        // Left-edge swipe takes priority: finger starts within EDGE_TRIGGER_ZONE
        if (touch.ClientX <= EDGE_TRIGGER_ZONE)
        {
            isEdgeSwipeTrackingActive = true;
            isEdgeSwiping = false;
            edgeSwipeStartX = touch.ClientX;
            edgeSwipeStartY = touch.ClientY;
            edgeSwipeOffset = 0;
            return;
        }

        // Pull-down only when the scroll container is at the top
        bool atTop = await JS.InvokeAsync<bool>("isModalScrollAtTop", scrollContainerRef);
        if (!atTop) return;
        isPullTrackingActive = true;
        isPulling = false;
        pullStartY = touch.ClientY;
        pullOffset = 0;
    }

    private void HandleModalTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length == 0) return;
        var touch = e.Touches[0];

        // ── Left-edge horizontal swipe ────────────────────────────────────────
        if (isEdgeSwipeTrackingActive)
        {
            double dx = touch.ClientX - edgeSwipeStartX;
            double dy = touch.ClientY - edgeSwipeStartY;

            // Cancel if the user is clearly scrolling vertically
            if (!isEdgeSwiping && Math.Abs(dy) > Math.Abs(dx) + 10)
            {
                isEdgeSwipeTrackingActive = false;
                edgeSwipeOffset = 0;
                return;
            }

            if (dx > 0)
            {
                isEdgeSwiping = true;
                // Full-speed up to threshold, rubber-band beyond it
                edgeSwipeOffset = dx <= EDGE_CLOSE_THRESHOLD
                    ? dx
                    : EDGE_CLOSE_THRESHOLD + Math.Sqrt(dx - EDGE_CLOSE_THRESHOLD) * 5;
                StateHasChanged();
            }
            return;
        }

        // ── Pull-down vertical swipe ──────────────────────────────────────────
        if (!isPullTrackingActive) return;
        double delta = touch.ClientY - pullStartY;
        if (delta <= 0) { isPulling = false; pullOffset = 0; return; }
        isPulling = true;
        pullOffset = Math.Sqrt(delta) * 6;
        StateHasChanged();
    }

    private async Task HandleModalTouchEnd(TouchEventArgs e)
    {
        // ── Edge swipe release ────────────────────────────────────────────────
        if (isEdgeSwipeTrackingActive)
        {
            isEdgeSwipeTrackingActive = false;
            isEdgeSwiping = false;

            if (edgeSwipeOffset >= EDGE_CLOSE_THRESHOLD)
            {
                edgeSwipeOffset = 600; // fly off to the right
                StateHasChanged();
                await Task.Delay(260);
                edgeSwipeOffset = 0;
                await OnClose.InvokeAsync();
            }
            else
            {
                edgeSwipeOffset = 0;
                StateHasChanged();
            }
            return;
        }

        // ── Pull-down release ─────────────────────────────────────────────────
        if (!isPullTrackingActive) return;
        isPullTrackingActive = false;
        isPulling = false;

        if (pullOffset >= PULL_CLOSE_THRESHOLD)
        {
            pullOffset = 900;
            StateHasChanged();
            await Task.Delay(260);
            pullOffset = 0;
            await OnClose.InvokeAsync();
        }
        else
        {
            pullOffset = 0;
            StateHasChanged();
        }
    }

    // ─── UI helpers ──────────────────────────────────────────────────────────────

    private void Close() => OnClose.InvokeAsync();
    private void OnOverlayClick() => Close();
    private void OnAddToList() { }
    private void OnShare() { }
    private void OnFavorite() { isFavorited = !isFavorited; StateHasChanged(); }

    private string GetStatusText(string status) => status switch
    {
        "RELEASING" => "Airing",
        "FINISHED" => "Completed",
        "NOT_YET_RELEASED" => "Upcoming",
        "CANCELLED" => "Cancelled",
        "HIATUS" => "On Hiatus",
        _ => status
    };

    private string FormatCountdown(int seconds)
    {
        if (seconds <= 0) return "soon";
        int d = seconds / 86400, h = (seconds % 86400) / 3600, m = (seconds % 3600) / 60;
        if (d > 0) return h > 0 ? $"{d}d {h}h" : $"{d}d";
        if (h > 0) return m > 0 ? $"{h}h {m}m" : $"{h}h";
        return $"{m}m";
    }

    private static bool ContainsNonLatinScript(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return false;
        foreach (char c in s)
            if ((c >= 0x0400 && c <= 0x04FF) || (c >= 0x0600 && c <= 0x06FF) ||
                (c >= 0x0590 && c <= 0x05FF) || (c >= 0x0900 && c <= 0x097F) ||
                (c >= 0x0E00 && c <= 0x0E7F) || (c >= 0x3040 && c <= 0x309F) ||
                (c >= 0x30A0 && c <= 0x30FF) || (c >= 0x4E00 && c <= 0x9FFF) ||
                (c >= 0x3400 && c <= 0x4DBF) || (c >= 0xAC00 && c <= 0xD7AF))
                return true;
        return false;
    }

    private string GetYouTubeVideoId(string url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        try
        {
            var uri = new Uri(url);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (query.AllKeys.Contains("v")) return query["v"] ?? "";
            var path = uri.AbsolutePath;
            if (path.Contains("/shorts/")) { var parts = path.Split("/shorts/", StringSplitOptions.RemoveEmptyEntries); return parts.Length > 0 ? parts[0].TrimEnd('/') : ""; }
            if (uri.Segments.Length > 1) { var last = uri.Segments.LastOrDefault()?.TrimEnd('/'); if (!string.IsNullOrEmpty(last) && last != "embed") return last; }
        }
        catch
        {
            if (url.Contains("watch?v=")) { var p = url.Split("watch?v="); return p.Length > 1 ? p[1].Split('&')[0] : ""; }
            if (url.Contains("youtu.be/")) { var p = url.Split("youtu.be/"); return p.Length > 1 ? p[1].Split('?')[0] : ""; }
            if (url.Contains("/shorts/")) { var p = url.Split("/shorts/"); return p.Length > 1 ? p[1].Split('?')[0] : ""; }
        }
        return string.Empty;
    }

