@using AniScroll.Shared.Models
@inject IJSRuntime JS

@if (IsVisible && CurrentAnime != null)
{
    <div class="anime-detail-overlay" @onclick="OnOverlayClick">
        <div class="anime-detail-popup" @onclick:stopPropagation="true">

            <!-- Header avec image de fond -->
            <div class="popup-header" style="background-image: url('@CurrentAnime.BannerUrl');">
                <div class="popup-header-gradient"></div>
                <button class="popup-close-btn" @onclick="Close">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Contenu scrollable -->
            <div class="popup-content">

                <!-- Image et infos principales -->
                <div class="popup-main-info">
                    <div class="popup-cover-section">
                        <div class="popup-cover-image"
                             style="background-image: url('@CurrentAnime.ImageUrl');"></div>
                    </div>

                    <div class="popup-info-section">
                        <h1 class="popup-title">@CurrentAnime.Title</h1>

                        @if (!string.IsNullOrEmpty(CurrentAnime.Format))
                        {
                            <div class="popup-format">@CurrentAnime.Format</div>
                        }

                        @if (!string.IsNullOrEmpty(CurrentAnime.Season) && CurrentAnime.Year.HasValue)
                        {
                            <div class="popup-season">
                                @if (CurrentAnime.Status == "RELEASING")
                                {
                                    <span class="status-dot releasing"></span>
                                }
                                else if (CurrentAnime.Status == "NOT_YET_RELEASED")
                                {
                                    <span class="status-dot upcoming"></span>
                                }
                                <span>@CurrentAnime.Season @CurrentAnime.Year</span>
                            </div>
                        }

                        <div class="popup-stats-grid">
                            <div class="popup-stat-item">
                                <div class="popup-stat-label">Score</div>
                                <div class="popup-stat-value">★ @CurrentAnime.Score</div>
                            </div>
                            <div class="popup-stat-item">
                                <div class="popup-stat-label">Episodes</div>
                                <div class="popup-stat-value">@CurrentAnime.Episodes</div>
                            </div>
                            <div class="popup-stat-item">
                                <div class="popup-stat-label">Status</div>
                                <div class="popup-stat-value">@GetStatusText(CurrentAnime.Status)</div>
                            </div>
                            @if (CurrentAnime.Duration.HasValue)
                            {
                                <div class="popup-stat-item">
                                    <div class="popup-stat-label">Duration</div>
                                    <div class="popup-stat-value">@CurrentAnime.Duration min</div>
                                </div>
                            }
                            @if (CurrentAnime.Popularity.HasValue)
                            {
                                <div class="popup-stat-item">
                                    <div class="popup-stat-label">Popularity</div>
                                    <div class="popup-stat-value">#@CurrentAnime.Popularity.Value.ToString("N0")</div>
                                </div>
                            }
                            @if (CurrentAnime.Favourites.HasValue)
                            {
                                <div class="popup-stat-item">
                                    <div class="popup-stat-label">Favorites</div>
                                    <div class="popup-stat-value">@CurrentAnime.Favourites.Value.ToString("N0")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Informations détaillées -->
                <div class="popup-details-grid">
                    @if (!string.IsNullOrEmpty(CurrentAnime.Source))
                    {
                        <div class="popup-detail-item">
                            <span class="popup-detail-label">Source</span>
                            <span class="popup-detail-value">@CurrentAnime.Source</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(CurrentAnime.StartDate))
                    {
                        <div class="popup-detail-item">
                            <span class="popup-detail-label">Aired</span>
                            <span class="popup-detail-value">
                                @CurrentAnime.StartDate@(!string.IsNullOrEmpty(CurrentAnime.EndDate) ? " to " + CurrentAnime.EndDate : "")
                            </span>
                        </div>
                    }
                    @if (CurrentAnime.Studios?.Any() == true)
                    {
                        <div class="popup-detail-item">
                            <span class="popup-detail-label">Studio@(CurrentAnime.Studios.Count > 1 ? "s" : "")</span>
                            <span class="popup-detail-value">@string.Join(", ", CurrentAnime.Studios.Select(s => s.Name))</span>
                        </div>
                    }
                </div>

                <!-- Genres -->
                @if (CurrentAnime.Genres?.Any() == true)
                {
                    <div class="popup-section">
                        <h3 class="popup-section-title">Genres</h3>
                        <div class="popup-genres-list">
                            @foreach (var genre in CurrentAnime.Genres)
                            {
                                <span class="popup-genre-tag">@genre</span>
                            }
                        </div>
                    </div>
                }

                <!-- Description -->
                @if (!string.IsNullOrEmpty(CurrentAnime.Description))
                {
                    <div class="popup-section">
                        <h3 class="popup-section-title">Synopsis</h3>
                        <p class="popup-description">@CurrentAnime.Description</p>
                    </div>
                }

                <!-- Relations -->
                @if (CurrentAnime.Relations?.Any() == true)
                {
                    <div class="popup-section">
                        <h3 class="popup-section-title">Relations</h3>
                        <div class="popup-relations-grid">
                            @foreach (var relation in CurrentAnime.Relations)
                            {
                                <div class="popup-relation-card">
                                    <div class="popup-relation-image"
                                         style="background-image: url('@relation.ImageUrl');"></div>
                                    <div class="popup-relation-info">
                                        <div class="popup-relation-type">@relation.RelationType</div>
                                        <div class="popup-relation-title">@relation.Title</div>
                                        <div class="popup-relation-meta">
                                            @if (!string.IsNullOrEmpty(relation.Format))
                                            {
                                                <span>@relation.Format</span>
                                            }
                                            @if (!string.IsNullOrEmpty(relation.Status))
                                            {
                                                <span> • @GetStatusText(relation.Status)</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Actions -->
                <div class="popup-actions">
                    <button class="popup-action-btn primary" @onclick="OnAddToList">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add to List
                    </button>
                    @if (!string.IsNullOrEmpty(CurrentAnime.TrailerUrl))
                    {
                        <button class="popup-action-btn secondary" @onclick="OnWatchTrailer">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon>
                            </svg>
                            Watch Trailer
                        </button>
                    }
                    <button class="popup-action-btn secondary" @onclick="OnShare">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                        Share
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AnimeCard? CurrentAnime { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private void Close()
    {
        OnClose.InvokeAsync();
    }

    private void OnOverlayClick()
    {
        Close();
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "RELEASING" => "Ongoing",
            "FINISHED" => "Completed",
            "NOT_YET_RELEASED" => "Upcoming",
            "CANCELLED" => "Cancelled",
            "HIATUS" => "Hiatus",
            _ => status
        };
    }

    private void OnAddToList()
    {
        System.Diagnostics.Debug.WriteLine($"📝 Add to list: {CurrentAnime?.Title}");
        // TODO: Implement add to list functionality
    }

    private void OnWatchTrailer()
    {
        if (!string.IsNullOrEmpty(CurrentAnime?.TrailerUrl))
        {
            System.Diagnostics.Debug.WriteLine($"▶️ Watch trailer: {CurrentAnime.TrailerUrl}");
            // TODO: Open trailer in browser or embedded player
        }
    }

    private void OnShare()
    {
        System.Diagnostics.Debug.WriteLine($"📤 Share: {CurrentAnime?.Title}");
        // TODO: Implement share functionality
    }
}
