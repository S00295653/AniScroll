@using AniScroll.Shared.Models
@inject IJSRuntime JS

@if (IsVisible && CurrentAnime != null)
{
    <div class="anime-detail-overlay" @onclick="OnOverlayClick">
        <div class="anime-detail-modal" @onclick:stopPropagation="true">

            <!-- Close Button -->
            <button class="modal-close-btn" @onclick="Close">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <!-- Scrollable Content -->
            <div class="modal-scroll-container">

                <!-- Header Section -->
                <div class="modal-header">
                    <!-- Top Banner -->
                    <div class="modal-banner" style="background-image: url('@CurrentAnime.BannerUrl');"></div>

                    <!-- Content Container (Poster + Info) -->
                    <div class="modal-header-content">
                        <!-- Left: Cover Poster -->
                        <div class="modal-poster-section">
                            <div class="modal-poster" style="background-image: url('@CurrentAnime.ImageUrl');"></div>
                            
                            <!-- Action Buttons under poster -->
                            <div class="modal-action-buttons">
                                <button class="btn-add-to-list" @onclick="OnAddToList">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    Add to List
                                </button>
                                <button class="btn-favorite" @onclick="OnFavorite">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Right: Title and Info -->
                        <div class="modal-info-section">
                            <!-- Title -->
                            <h1 class="modal-title">@CurrentAnime.Title</h1>

                            <!-- Airing Info -->
                            @if (!string.IsNullOrEmpty(CurrentAnime.Season) && CurrentAnime.Year.HasValue)
                            {
                                <div class="modal-airing-info">
                                    @if (CurrentAnime.Status == "RELEASING")
                                    {
                                        <span class="status-indicator releasing"></span>
                                        <span>Currently Airing • @CurrentAnime.Season @CurrentAnime.Year</span>
                                    }
                                    else if (CurrentAnime.Status == "FINISHED")
                                    {
                                        <span class="status-indicator finished"></span>
                                        <span>Finished • @CurrentAnime.Season @CurrentAnime.Year</span>
                                    }
                                    else if (CurrentAnime.Status == "NOT_YET_RELEASED")
                                    {
                                        <span class="status-indicator upcoming"></span>
                                        <span>Coming Soon • @CurrentAnime.Season @CurrentAnime.Year</span>
                                    }
                                </div>
                            }

                            <!-- Info Fields -->
                            <div class="modal-info-grid">
                                <div class="info-field">
                                    <span class="info-label">Score</span>
                                    <span class="info-value score">⭐ @CurrentAnime.Score</span>
                                </div>
                                <div class="info-field">
                                    <span class="info-label">Status</span>
                                    <span class="info-value">@GetStatusText(CurrentAnime.Status)</span>
                                </div>
                                <div class="info-field">
                                    <span class="info-label">Episodes</span>
                                    <span class="info-value">@CurrentAnime.Episodes</span>
                                </div>
                                @if (CurrentAnime.Duration.HasValue)
                                {
                                    <div class="info-field">
                                        <span class="info-label">Duration</span>
                                        <span class="info-value">@CurrentAnime.Duration min</span>
                                    </div>
                                }
                                @if (CurrentAnime.Favourites.HasValue)
                                {
                                    <div class="info-field">
                                        <span class="info-label">Favorites</span>
                                        <span class="info-value">@CurrentAnime.Favourites.Value.ToString("N0")</span>
                                    </div>
                                }
                                @if (CurrentAnime.Studios?.Any() == true)
                                {
                                    <div class="info-field">
                                        <span class="info-label">Studio</span>
                                        <span class="info-value">@string.Join(", ", CurrentAnime.Studios.Select(s => s.Name))</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="modal-content">

                    <!-- Genres -->
                    @if (CurrentAnime.Genres?.Any() == true)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Genres</h3>
                            <div class="genres-container">
                                @foreach (var genre in CurrentAnime.Genres)
                                {
                                    <span class="genre-pill">@genre</span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Relations -->
                    @if (CurrentAnime.Relations?.Any() == true)
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Relations</h3>
                            <div class="relations-scroll">
                                @foreach (var relation in CurrentAnime.Relations)
                                {
                                    <div class="relation-card">
                                        <div class="relation-cover" style="background-image: url('@relation.ImageUrl');"></div>
                                        <div class="relation-info">
                                            <div class="relation-type">@relation.RelationType</div>
                                            <div class="relation-title">@relation.Title</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Synopsis -->
                    @if (!string.IsNullOrEmpty(CurrentAnime.Description))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Synopsis</h3>
                            <p class="synopsis-text">@CurrentAnime.Description</p>
                        </div>
                    }

                    <!-- Additional Info -->
                    @if (!string.IsNullOrEmpty(CurrentAnime.Source) || !string.IsNullOrEmpty(CurrentAnime.Format))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Additional Information</h3>
                            <div class="additional-info-grid">
                                @if (!string.IsNullOrEmpty(CurrentAnime.Format))
                                {
                                    <div class="info-item">
                                        <span class="info-item-label">Format</span>
                                        <span class="info-item-value">@CurrentAnime.Format</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.Source))
                                {
                                    <div class="info-item">
                                        <span class="info-item-label">Source</span>
                                        <span class="info-item-value">@CurrentAnime.Source</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.StartDate))
                                {
                                    <div class="info-item">
                                        <span class="info-item-label">Start Date</span>
                                        <span class="info-item-value">@CurrentAnime.StartDate</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CurrentAnime.EndDate))
                                {
                                    <div class="info-item">
                                        <span class="info-item-label">End Date</span>
                                        <span class="info-item-value">@CurrentAnime.EndDate</span>
                                    </div>
                                }
                                @if (CurrentAnime.Popularity.HasValue)
                                {
                                    <div class="info-item">
                                        <span class="info-item-label">Popularity</span>
                                        <span class="info-item-value">#@CurrentAnime.Popularity.Value.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Trailer -->
                    @if (!string.IsNullOrEmpty(CurrentAnime.TrailerUrl))
                    {
                        <div class="modal-section">
                            <h3 class="section-title">Trailer</h3>
                            <div class="trailer-container">
                                <a href="@CurrentAnime.TrailerUrl" target="_blank" class="trailer-link">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon>
                                    </svg>
                                    <span>Watch Trailer on YouTube</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Streaming Links -->
                    <div class="modal-section">
                        <h3 class="section-title">Watch On</h3>
                        <div class="streaming-links">
                            <a href="https://anilist.co/anime/@CurrentAnime.Id" target="_blank" class="streaming-btn anilist">
                                <span>AniList</span>
                            </a>
                            <a href="https://myanimelist.net/anime/@CurrentAnime.Id" target="_blank" class="streaming-btn mal">
                                <span>MyAnimeList</span>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AnimeCard? CurrentAnime { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private void Close()
    {
        OnClose.InvokeAsync();
    }

    private void OnOverlayClick()
    {
        Close();
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "RELEASING" => "Ongoing",
            "FINISHED" => "Completed",
            "NOT_YET_RELEASED" => "Upcoming",
            "CANCELLED" => "Cancelled",
            "HIATUS" => "Hiatus",
            _ => status
        };
    }

    private void OnAddToList()
    {
        System.Diagnostics.Debug.WriteLine($"📝 Add to list: {CurrentAnime?.Title}");
    }

    private void OnFavorite()
    {
        System.Diagnostics.Debug.WriteLine($"❤️ Favorite: {CurrentAnime?.Title}");
    }
}
