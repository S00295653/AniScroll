    private static double[] SaturateMatrix(double v)=>new[]{0.213+0.787*v,0.715-0.715*v,0.072-0.072*v,0.213-0.213*v,0.715+0.285*v,0.072-0.072*v,0.213-0.213*v,0.715-0.715*v,0.072+0.928*v};
    private static double[] HueRotateMatrix(double deg){double rad=deg/180.0*Math.PI,sin=Math.Sin(rad),cos=Math.Cos(rad);return new[]{0.213+cos*0.787-sin*0.213,0.715-cos*0.715-sin*0.715,0.072-cos*0.072+sin*0.928,0.213-cos*0.213+sin*0.143,0.715+cos*0.285+sin*0.140,0.072-cos*0.072-sin*0.283,0.213-cos*0.213-sin*0.787,0.715-cos*0.715+sin*0.715,0.072+cos*0.928+sin*0.072};}
    private static double ClampFilterParam(double v,int idx){double max=idx==2?7500:(idx==4||idx==5)?200:100;if(idx==3){if(v>max)v%=max;else if(v<0)v=max+v%max;}else v=Math.Max(0,Math.Min(max,v));return v;}
    private static (double h,double s,double l) RgbToHsl(int r,int g,int b){double rf=r/255.0,gf=g/255.0,bf=b/255.0,max=Math.Max(rf,Math.Max(gf,bf)),min=Math.Min(rf,Math.Min(gf,bf)),l=(max+min)/2.0,h=0,s=0;if(max!=min){double d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);if(max==rf)h=(gf-bf)/d+(gf<bf?6:0);else if(max==gf)h=(bf-rf)/d+2;else h=(rf-gf)/d+4;h/=6;}return(h*100,s*100,l*100);}
