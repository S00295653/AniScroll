    private static readonly HashSet<string> _colorfulIconSites = new(StringComparer.OrdinalIgnoreCase) { "Alpha Manga","AlphaPolis","Asacomi","Bandai Channel","Carlsen Manga!","Ciao Plus","Disney Plus","Dongman Manhua","FEEL web","Flower Comics","Gau Gau","Ichijin Plus","Kana","Kanmanhua","Manga UP!","MangaPlaza","Manman Manhua","Nico Nico Seiga","ONO","Piccoma","Pixiv Comic","Pixiv","Pocket Magazine","Renta!","Rimacomi Plus","SORAJIMA TOON","Star+","SuBLime","Takecomic","Tencent Comics","Viki","WeComics","Weekly CoroCoro Comic","Yanmaga","Yawaraka Spirits","Young Animal" };
    private static readonly HashSet<string> _neverRecolorSites = new(StringComparer.OrdinalIgnoreCase) { "Disney+","Disney Plus" };

    private MarkupString GetPlatformIconMarkup(string iconUrl, string brandColor, string site)
    {
        bool shouldRecolor = !_colorfulIconSites.Contains(site) && !_neverRecolorSites.Contains(site) && !string.IsNullOrEmpty(brandColor) && brandColor != "#000000" && brandColor.StartsWith("#");
        if (!string.IsNullOrEmpty(iconUrl)) { string s = shouldRecolor ? $"object-fit:contain;border-radius:2px;{GetWhiteToColorFilter(brandColor)}" : "object-fit:contain;border-radius:2px;"; return new MarkupString($"<img src=\"{iconUrl}\" width=\"20\" height=\"20\" style=\"{s}\" />"); }
        string sc = shouldRecolor ? brandColor : "rgba(255,255,255,0.6)";
        return new MarkupString($"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='{sc}' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='2' width='20' height='20' rx='4'/><polygon points='10,8 16,12 10,16' fill='{sc}' stroke='none'/></svg>");
    }

    private static readonly Dictionary<string,string> _filterCache = new();
    private static string GetWhiteToColorFilter(string hex)
    {
        if (string.IsNullOrEmpty(hex) || !hex.StartsWith('#')) return string.Empty;
        if (_filterCache.TryGetValue(hex, out var cached)) return cached;
        var rgb = ParseHexColor(hex); if (rgb == null) { _filterCache[hex] = string.Empty; return string.Empty; }
        var cf = ComputeColorFilter(rgb.Value.r, rgb.Value.g, rgb.Value.b); var result = $"filter:brightness(0) saturate(100%) {cf};"; _filterCache[hex] = result; return result;
    }
    private static (int r,int g,int b)? ParseHexColor(string hex) { hex = hex.TrimStart('#'); if (hex.Length==3) hex=new string(new[]{hex[0],hex[0],hex[1],hex[1],hex[2],hex[2]}); if (hex.Length!=6) return null; try { return (Convert.ToInt32(hex[0..2],16),Convert.ToInt32(hex[2..4],16),Convert.ToInt32(hex[4..6],16)); } catch { return null; } }
    private static string ComputeColorFilter(int tr,int tg,int tb) { var (th,ts,tl)=RgbToHsl(tr,tg,tb); var rng=new Random(42); double[] best=Array.Empty<double>(); double bestLoss=double.MaxValue; for(int a=0;a<3&&bestLoss>25;a++){var r=RunSpsa(tr,tg,tb,th,ts,tl,new double[]{50,20,3750,50,100,100},A:5,a:new double[]{60,180,18000,600,1.2,1.2},c:15,iterations:1000,rng);if(r.loss<bestLoss){best=r.values;bestLoss=r.loss;}} double A1=bestLoss+1;var r2=RunSpsa(tr,tg,tb,th,ts,tl,best,A:bestLoss,a:new double[]{0.25*A1,0.25*A1,A1,0.25*A1,0.2*A1,0.2*A1},c:2,iterations:500,rng);if(r2.loss<bestLoss)best=r2.values; static int R(double v)=>(int)Math.Round(v); return $"invert({R(best[0])}%) sepia({R(best[1])}%) saturate({R(best[2])}%) hue-rotate({R(best[3]*3.6)}deg) brightness({R(best[4])}%) contrast({R(best[5])}%)"; }
    private static (double[] values,double loss) RunSpsa(int tr,int tg,int tb,double th,double ts,double tl,double[] initial,double A,double[] a,double c,int iterations,Random rng) { var v=(double[])initial.Clone();double[] best=null!;double bestLoss=double.MaxValue;var deltas=new double[6];var hi=new double[6];var lo=new double[6];for(int k=0;k<iterations;k++){double ck=c/Math.Pow(k+1,1.0/6.0);for(int i=0;i<6;i++){deltas[i]=rng.NextDouble()>0.5?1:-1;hi[i]=v[i]+ck*deltas[i];lo[i]=v[i]-ck*deltas[i];}double lossDiff=FilterLoss(hi,tr,tg,tb,th,ts,tl)-FilterLoss(lo,tr,tg,tb,th,ts,tl);for(int i=0;i<6;i++){double g=lossDiff/(2*ck)*deltas[i];double ak=a[i]/Math.Pow(A+k+1,1.0);v[i]=ClampFilterParam(v[i]-ak*g,i);}double l=FilterLoss(v,tr,tg,tb,th,ts,tl);if(l<bestLoss){best=(double[])v.Clone();bestLoss=l;}}return(best??v,bestLoss); }
    private static double FilterLoss(double[] f,int tr,int tg,int tb,double th,double ts,double tl){var(r,g,b)=ApplyFilters(f);var(h,s,l)=RgbToHsl((int)r,(int)g,(int)b);return Math.Abs(r-tr)+Math.Abs(g-tg)+Math.Abs(b-tb)+Math.Abs(h-th)+Math.Abs(s-ts)+Math.Abs(l-tl);}
    private static (double r,double g,double b) ApplyFilters(double[] f){double r=0,g=0,b=0;double inv=f[0]/100.0;r=Cl((inv+r/255.0*(1-2*inv))*255);g=Cl((inv+g/255.0*(1-2*inv))*255);b=Cl((inv+b/255.0*(1-2*inv))*255);(r,g,b)=MatMul(r,g,b,SepiaMatrix(f[1]/100.0));(r,g,b)=MatMul(r,g,b,SaturateMatrix(f[2]/100.0));(r,g,b)=MatMul(r,g,b,HueRotateMatrix(f[3]*3.6));r=Cl(r*(f[4]/100.0));g=Cl(g*(f[4]/100.0));b=Cl(b*(f[4]/100.0));double con=f[5]/100.0,ic=(-0.5*con+0.5)*255;r=Cl(r*con+ic);g=Cl(g*con+ic);b=Cl(b*con+ic);return(r,g,b);}
    private static double Cl(double v)=>Math.Max(0,Math.Min(255,v));
    private static (double r,double g,double b) MatMul(double r,double g,double b,double[] m)=>(Cl(r*m[0]+g*m[1]+b*m[2]),Cl(r*m[3]+g*m[4]+b*m[5]),Cl(r*m[6]+g*m[7]+b*m[8]));
