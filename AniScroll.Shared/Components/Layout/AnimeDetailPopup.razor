        StateHasChanged();
        _copyResetCts?.Cancel();
        _copyResetCts = new System.Threading.CancellationTokenSource();
        var token = _copyResetCts.Token;
        try { await Task.Delay(2200, token); _shareCopied = false; StateHasChanged(); } catch (TaskCanceledException) { }
    }

