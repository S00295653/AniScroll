@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService

@if (IsVisible)
{
    <div class="sfp-overlay" @onclick="Close">
        <div class="sfp-panel" @onclick:stopPropagation="true">

            <!-- Handle -->
            <div class="sfp-handle-zone">
                <div class="sfp-handle-bar"></div>
            </div>

            <!-- Header -->
            <div class="sfp-header">
                <span class="sfp-title">Sort & Filter</span>
                <div class="sfp-header-actions">
                    @if (HasActiveOptions)
                    {
                        <button class="sfp-reset-btn" @onclick="Reset">Reset</button>
                    }
                    <button class="sfp-close-btn" @onclick="Close">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="sfp-body">

                <!-- ── Sort By ── -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Sort By</div>
                    <div class="sfp-chips">
                        @SortChip(SortMode.RecentlyAdded, "Recently Added")
                        @SortChip(SortMode.OldestFirst, "Oldest First")
                        @SortChip(SortMode.TitleAZ, "Title A → Z")
                        @SortChip(SortMode.TitleZA, "Title Z → A")
                        @SortChip(SortMode.MyScoreDesc, "My Score ↓")
                        @SortChip(SortMode.MyScoreAsc, "My Score ↑")
                        @SortChip(SortMode.AniListScore, "AniList Score")
                        @SortChip(SortMode.EpisodesDesc, "Episodes ↓")
                        @SortChip(SortMode.EpisodesAsc, "Episodes ↑")
                        @SortChip(SortMode.YearDesc, "Year ↓")
                        @SortChip(SortMode.YearAsc, "Year ↑")
                    </div>
                </div>

                <div class="sfp-divider"></div>

                <!-- ── Airing Status ── -->
                @{
                    var airingStatuses = GetDistinctValues(e => e.Anime.Status)
                    .Select(s => (key: s, label: FormatAiringStatus(s)))
                    .OrderBy(x => x.label).ToList();
                }
                @if (airingStatuses.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Airing Status</div>
                        <div class="sfp-chips">
                            @foreach (var item in airingStatuses)
                            {
                                var key = item.key;
                                bool on = FilterAiringStatus.Contains(key);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterAiringStatus, key)">
                                    @if (key == "RELEASING")
                                    {
                                        <span class="sfp-status-dot sfp-dot-releasing"></span>
                                    }
                                    else if (key == "NOT_YET_RELEASED")
                                    {

                                        <span class="sfp-status-dot sfp-dot-upcoming"></span>
                                    }
                                    @item.label
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Format ── -->
                @{
                    var formats = GetDistinctValues(e => e.Anime.Format)
                    .OrderBy(x => x).ToList();
                }
                @if (formats.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Format</div>
                        <div class="sfp-chips">
                            @foreach (var fmt in formats)
                            {
                                var f = fmt;
                                bool on = FilterFormats.Contains(f);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterFormats, f)">
                                    @f
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Season ── -->
                @{
                    var seasons = GetDistinctValues(e => e.Anime.Season)
                    .OrderBy(SeasonOrder).ToList();
                }
                @if (seasons.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Season</div>
                        <div class="sfp-chips">
                            @foreach (var season in seasons)
                            {
                                var s = season;
                                bool on = FilterSeasons.Contains(s);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterSeasons, s)">
                                    @SeasonEmoji(s) @s
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Year ── -->
                @{
                    var years = GetDistinctYears().OrderByDescending(y => y).ToList();
                }
                @if (years.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Year</div>
                        <div class="sfp-chips">
                            @foreach (var yr in years)
                            {
                                var y = yr;
                                bool on = FilterYears.Contains(y);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleYearFilter(y)">
                                    @y
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Genres ── -->
                @{
                    var genres = GetDistinctListValues(e => e.Anime.Genres)
                    .OrderBy(x => x).ToList();
                }
                @if (genres.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Genres</div>
                        <div class="sfp-chips">
                            @foreach (var genre in genres)
                            {
                                var g = genre;
                                bool on = FilterGenres.Contains(g);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterGenres, g)">
                                    @g
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Tags ── -->
                @{
                    var tags = GetDistinctListValues(e => e.Anime.Tags?.Select(t => t.Name).ToList())
                    .OrderBy(x => x).ToList();
                }
                @if (tags.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Tags</div>
                        <div class="sfp-chips">
                            @foreach (var tag in tags)
                            {
                                var t = tag;
                                bool on = FilterTags.Contains(t);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterTags, t)">
                                    @t
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Source Material ── -->
                @{
                    var sources = GetDistinctValues(e => e.Anime.Source)
                    .OrderBy(x => x).ToList();
                }
                @if (sources.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Source Material</div>
                        <div class="sfp-chips">
                            @foreach (var src in sources)
                            {
                                var sv = src;
                                bool on = FilterSources.Contains(sv);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterSources, sv)">
                                    @sv
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Streaming On ── -->
                @{
                    var platforms = GetDistinctListValues(e =>
                    e.Anime.ExternalLinks?
                    .Where(l => l.Type == "STREAMING")
                    .Select(l => l.Site)
                    .ToList())
                    .OrderBy(x => x).ToList();
                }
                @if (platforms.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Streaming On</div>
                        <div class="sfp-chips">
                            @foreach (var plat in platforms)
                            {
                                var p = plat;
                                bool on = FilterPlatforms.Contains(p);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterPlatforms, p)">
                                    @p
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Country of Origin ── -->
                @{
                    var countries = GetDistinctValues(e => e.Anime.CountryOfOrigin)
                    .OrderBy(x => x).ToList();
                }
                @if (countries.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Country of Origin</div>
                        <div class="sfp-chips">
                            @foreach (var country in countries)
                            {
                                var c = country;
                                bool on = FilterCountries.Contains(c);
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")"
                                        @onclick="() => ToggleFilter(FilterCountries, c)">
                                    @CountryEmoji(c) @CountryLabel(c)
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- ── Adult / Explicit ── -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Content</div>
                    <div class="sfp-chips">
                        <button class="sfp-chip @(FilterAdult == false ? "sfp-chip-on" : "")"
                                @onclick="() => FilterAdult = (FilterAdult == false ? null : false)">
                            Non-adult only
                        </button>
                        <button class="sfp-chip @(FilterAdult == true ? "sfp-chip-on sfp-chip-adult" : "")"
                                @onclick="() => FilterAdult = (FilterAdult == true ? null : true)">
                            Adult only
                        </button>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="sfp-footer">
                <button class="sfp-apply-btn" @onclick="Apply">
                    Show results
                    @if (ResultCount >= 0)
                    {
                        <span class="sfp-result-count">@ResultCount</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SortFilterOptions> OnApply { get; set; }
    [Parameter] public SortFilterOptions Current { get; set; } = new();
    [Parameter] public IEnumerable<UserListEntry> AllEntries { get; set; } = Enumerable.Empty<UserListEntry>();

    // ── Sort ─────────────────────────────────────────────────────────────
    public enum SortMode
    {
        RecentlyAdded, OldestFirst,
        TitleAZ, TitleZA,
        MyScoreDesc, MyScoreAsc, AniListScore,
        EpisodesDesc, EpisodesAsc,
        YearDesc, YearAsc,
    }

    private SortMode _sort = SortMode.RecentlyAdded;

    // ── Filters ───────────────────────────────────────────────────────────
    private HashSet<string> FilterAiringStatus = new();
    private HashSet<string> FilterFormats = new();
    private HashSet<string> FilterSeasons = new();
    private HashSet<int> FilterYears = new();
    private HashSet<string> FilterGenres = new();
    private HashSet<string> FilterTags = new();
    private HashSet<string> FilterSources = new();
    private HashSet<string> FilterPlatforms = new();
    private HashSet<string> FilterCountries = new();
    private bool? FilterAdult = null;

    private int ResultCount => ComputeResultCount();

    private bool HasActiveOptions =>
        _sort != SortMode.RecentlyAdded ||
        FilterAiringStatus.Any() || FilterFormats.Any() || FilterSeasons.Any() ||
        FilterYears.Any() || FilterGenres.Any() || FilterTags.Any() ||
        FilterSources.Any() || FilterPlatforms.Any() || FilterCountries.Any() ||
        FilterAdult.HasValue;

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnParametersSet()
    {
        if (IsVisible && Current != null)
        {
            _sort = Current.Sort;
            FilterAiringStatus = new(Current.AiringStatuses);
            FilterFormats = new(Current.Formats);
            FilterSeasons = new(Current.Seasons);
            FilterYears = new(Current.Years);
            FilterGenres = new(Current.Genres);
            FilterTags = new(Current.Tags);
            FilterSources = new(Current.Sources);
            FilterPlatforms = new(Current.Platforms);
            FilterCountries = new(Current.Countries);
            FilterAdult = Current.Adult;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private IEnumerable<string> GetDistinctValues(Func<UserListEntry, string?> selector) =>
        AllEntries.Select(selector).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct()!;

    private IEnumerable<string> GetDistinctListValues(Func<UserListEntry, IEnumerable<string>?> selector) =>
        AllEntries.SelectMany(e => selector(e) ?? Enumerable.Empty<string>())
                  .Where(v => !string.IsNullOrWhiteSpace(v))
                  .Distinct();

    private IEnumerable<int> GetDistinctYears() =>
        AllEntries.Where(e => e.Anime.Year.HasValue).Select(e => e.Anime.Year!.Value).Distinct();

    private void ToggleFilter(HashSet<string> set, string value)
    {
        if (!set.Remove(value)) set.Add(value);
        StateHasChanged();
    }

    private void ToggleYearFilter(int year)
    {
        if (!FilterYears.Remove(year)) FilterYears.Add(year);
        StateHasChanged();
    }

    private int ComputeResultCount()
    {
        var opts = BuildOptions();
        return AllEntries.Where(e => PassesFilters(e, opts)).Count();
    }

    private SortFilterOptions BuildOptions() => new()
    {
        Sort = _sort,
        AiringStatuses = new(FilterAiringStatus),
        Formats = new(FilterFormats),
        Seasons = new(FilterSeasons),
        Years = new(FilterYears),
        Genres = new(FilterGenres),
        Tags = new(FilterTags),
        Sources = new(FilterSources),
        Platforms = new(FilterPlatforms),
        Countries = new(FilterCountries),
        Adult = FilterAdult,
    };

    public static bool PassesFilters(UserListEntry e, SortFilterOptions opts)
    {
        if (opts.AiringStatuses.Any() && !opts.AiringStatuses.Contains(e.Anime.Status ?? "")) return false;
        if (opts.Formats.Any() && !opts.Formats.Contains(e.Anime.Format ?? "")) return false;
        if (opts.Seasons.Any() && !opts.Seasons.Contains(e.Anime.Season ?? "")) return false;
        if (opts.Years.Any() && (!e.Anime.Year.HasValue || !opts.Years.Contains(e.Anime.Year.Value))) return false;
        if (opts.Genres.Any() && !(e.Anime.Genres?.Any(g => opts.Genres.Contains(g)) ?? false)) return false;
        if (opts.Tags.Any() && !(e.Anime.Tags?.Any(t => opts.Tags.Contains(t.Name)) ?? false)) return false;
        if (opts.Sources.Any() && !opts.Sources.Contains(e.Anime.Source ?? "")) return false;
        if (opts.Platforms.Any())
        {
            var ep = e.Anime.ExternalLinks?.Where(l => l.Type == "STREAMING").Select(l => l.Site).ToHashSet() ?? new();
            if (!opts.Platforms.Any(p => ep.Contains(p))) return false;
        }
        if (opts.Countries.Any() && !opts.Countries.Contains(e.Anime.CountryOfOrigin ?? "")) return false;
        if (opts.Adult.HasValue && e.Anime.IsAdult != opts.Adult.Value) return false;
        return true;
    }

    private void Reset()
    {
        _sort = SortMode.RecentlyAdded;
        FilterAiringStatus.Clear();
        FilterFormats.Clear();
        FilterSeasons.Clear();
        FilterYears.Clear();
        FilterGenres.Clear();
        FilterTags.Clear();
        FilterSources.Clear();
        FilterPlatforms.Clear();
        FilterCountries.Clear();
        FilterAdult = null;
        StateHasChanged();
    }

    private async Task Apply()
    {
        await OnApply.InvokeAsync(BuildOptions());
        await OnClose.InvokeAsync();
    }

    private void Close() => OnClose.InvokeAsync();

    // ── Render helpers ────────────────────────────────────────────────────

    private RenderFragment SortChip(SortMode mode, string label) =>
        @<button class="sfp-chip @(_sort == mode ? "sfp-chip-on sfp-chip-sort-on" : "")"
    @onclick="() => { _sort = mode; StateHasChanged(); }">
    @label
    </button>;

    private static string FormatAiringStatus(string s) => s switch
    {
        "RELEASING" => "Airing",
        "FINISHED" => "Finished",
        "NOT_YET_RELEASED" => "Upcoming",
        "CANCELLED" => "Cancelled",
        "HIATUS" => "On Hiatus",
        _ => s
    };

    private static int SeasonOrder(string s) => s?.ToUpper() switch
    {
        "WINTER" => 1,
        "SPRING" => 2,
        "SUMMER" => 3,
        "FALL" => 4,
        _ => 5
    };

    private static string SeasonEmoji(string s) => s?.ToUpper() switch
    {
        "WINTER" => "❄️",
        "SPRING" => "🌸",
        "SUMMER" => "☀️",
        "FALL" => "🍂",
        _ => ""
    };

    private static string CountryEmoji(string c) => c?.ToUpper() switch
    {
        "JP" => "🇯🇵",
        "CN" => "🇨🇳",
        "KR" => "🇰🇷",
        "TW" => "🇹🇼",
        _ => "🌐"
    };

    private static string CountryLabel(string c) => c?.ToUpper() switch
    {
        "JP" => "Japan",
        "CN" => "China",
        "KR" => "South Korea",
        "TW" => "Taiwan",
        _ => c
    };
}
