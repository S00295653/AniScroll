@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService
@inject AniListService AniListService
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="sfp-overlay" @onclick="OnOverlayClick" @onpointerdown="() => _pointerDownOnOverlay = true">
        <div class="sfp-panel" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true"
             @onkeydown="OnPanelKeyDown" @onkeydown:stopPropagation="true">

            <div class="sfp-handle-zone"><div class="sfp-handle-bar"></div></div>

            <!-- Header -->
            <div class="sfp-header">
                <div class="sfp-header-left">
                    <span class="sfp-title">Sort &amp; Filter</span>
                    @if (HasActiveOptions)
                    {
                        <span class="sfp-active-badge">@TotalActiveCount</span>
                    }
                </div>
                <div class="sfp-header-actions">
                    @if (HasActiveOptions)
                    {
                        <button class="sfp-reset-btn" @onclick="Reset">Reset all</button>
                    }
                    <button class="sfp-close-btn" @onclick="Close">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="sfp-body">

                <!-- SORT -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Sort by</div>
                    <div class="sfp-chips">
                        @SortChip(SortMode.RecentlyUpdated, "Recently Updated")
                        @ThreeStateChip(SortMode.TitleAZ,      SortMode.TitleZA,         "Title")
                        @ThreeStateChip(SortMode.MyScoreDesc, SortMode.MyScoreAsc, "My Score")
                        @ThreeStateChip(SortMode.AniListScore, SortMode.AniListScoreAsc, "Rating")
                        @ThreeStateChip(SortMode.EpisodesDesc, SortMode.EpisodesAsc, "Episodes")
                        @ThreeStateChip(SortMode.YearDesc, SortMode.YearAsc, "Year")
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- AIRING STATUS -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Status</div>
                    <div class="sfp-chips">
                        @foreach (var key in _allStatuses)
                        {
                            var k = key; bool on = FilterAiringStatus.Contains(k);
                            <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterAiringStatus, k)">
                                @FormatAiringStatus(k)
                            </button>
                        }
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- FORMAT -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Format</div>
                    <div class="sfp-chips">
                        @foreach (var fmt in _allFormats)
                        {
                            var f = fmt; bool on = FilterFormats.Contains(f);
                            <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterFormats, f)">@f</button>
                        }
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- SEASON -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Season</div>
                    <div class="sfp-chips">
                        @foreach (var s in _allSeasons)
                        {
                            var sv = s; bool on = FilterSeasons.Contains(sv);
                            <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterSeasons, sv)">
                                @(sv[0] + sv[1..].ToLower())
                            </button>
                        }
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- YEAR RANGE -->
                <div class="sfp-section">
                    <div class="sfp-section-label-row">
                        <span class="sfp-section-label">Year</span>
                        <span class="sfp-range-badge">
                            @(_yearFrom == _minYear && _yearTo == _maxYear ? "All"
                              : _yearFrom == _yearTo ? $"{_yearFrom}"
                              : $"{_yearFrom} – {_yearTo}")
                        </span>
                    </div>
                    <div class="sfp-dual-slider">
                        <input type="number" inputmode="numeric" class="sfp-num-input sfp-num-year"
                               min="@_minYear" max="@_maxYear" step="1"
                               value="@_yearFrom"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) { _yearFrom = Math.Clamp(Math.Min(v, _yearTo), _minYear, _maxYear); ScheduleResultCountUpdate(); } }" />
                        <div class="sfp-slider-wrap" @ref="_yearWrapRef" @onclick="e => OnTrackClickAsync(e, SliderType.Year)">
                            <div class="sfp-slider-track"></div>
                            <div class="sfp-slider-fill" style="@YearFillStyle"></div>
                            <input type="range" class="sfp-range sfp-range-lo"
                                   @ref="_yearLoRef"
                                   min="@_minYear" max="@_maxYear" step="1" value="@_yearFrom"
                                   @oninput="e => OnYearFromInput(int.Parse(e.Value!.ToString()!))" />
                            <input type="range" class="sfp-range sfp-range-hi"
                                   @ref="_yearHiRef"
                                   min="@_minYear" max="@_maxYear" step="1" value="@_yearTo"
                                   @oninput="e => OnYearToInput(int.Parse(e.Value!.ToString()!))" />
                        </div>
                        <input type="number" inputmode="numeric" class="sfp-num-input sfp-num-year"
                               min="@_minYear" max="@_maxYear" step="1"
                               value="@_yearTo"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) { _yearTo = Math.Clamp(Math.Max(v, _yearFrom), _minYear, _maxYear); ScheduleResultCountUpdate(); } }" />
                    </div>
                    @if (_yearFrom != _minYear || _yearTo != _maxYear)
                    {
                        <button class="sfp-clear-range" @onclick="() => { _yearFrom = _minYear; _yearTo = _maxYear; ScheduleResultCountUpdate(); }">Reset years</button>
                    }
                </div>
                <div class="sfp-divider"></div>

                <!-- SCORE RANGE -->
                <div class="sfp-section">
                    <div class="sfp-section-label">My Score</div>
                    <div class="sfp-dual-slider">
                        <input type="number" inputmode="decimal" class="sfp-num-input"
                               min="0" max="10" step="0.5"
                               value="@_scoreFrom.ToString("G", System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="e => { var raw = e.Value?.ToString()?.Replace(',', '.'); if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) { _scoreFrom = Math.Min(Math.Clamp(v, 0, 10), _scoreTo); ScheduleResultCountUpdate(); } }"/>
                        <div class="sfp-slider-wrap" @ref="_scoreWrapRef" @onclick="e => OnTrackClickAsync(e, SliderType.Score)">
                            <div class="sfp-slider-track"></div>
                            <div class="sfp-slider-fill" style="@ScoreFillStyle"></div>
                            <input type="range" class="sfp-range sfp-range-lo"
                                   @ref="_scoreLoRef"
                                   min="0" max="10" step="0.5"
                                   value="@_scoreFrom.ToString("G", System.Globalization.CultureInfo.InvariantCulture)"
                                   @oninput="e => OnScoreFromInput(double.Parse(e.Value!.ToString()!, System.Globalization.CultureInfo.InvariantCulture))" />
                            <input type="range" class="sfp-range sfp-range-hi"
                                   @ref="_scoreHiRef"
                                   min="0" max="10" step="0.5"
                                   value="@_scoreTo.ToString("G", System.Globalization.CultureInfo.InvariantCulture)"
                                   @oninput="e => OnScoreToInput(double.Parse(e.Value!.ToString()!, System.Globalization.CultureInfo.InvariantCulture))" />
                        </div>
                        <input type="number" inputmode="decimal" class="sfp-num-input"
                               min="0" max="10" step="0.5"
                               value="@_scoreTo.ToString("G", System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="e => { var raw = e.Value?.ToString()?.Replace(',', '.'); if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) { _scoreTo = Math.Max(Math.Clamp(v, 0, 10), _scoreFrom); ScheduleResultCountUpdate(); } }"/>
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- EPISODES RANGE -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Episodes</div>
                    <div class="sfp-dual-slider">
                        <input type="number" inputmode="numeric" class="sfp-num-input"
                               min="1" max="@_maxEp" value="@_epFrom"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) { _epFrom = Math.Min(Math.Clamp(v, 1, _maxEp), _epTo); ScheduleResultCountUpdate(); } }" />
                        <div class="sfp-slider-wrap" @ref="_epWrapRef" @onclick="e => OnTrackClickAsync(e, SliderType.Episode)">
                            <div class="sfp-slider-track"></div>
                            <div class="sfp-slider-fill" style="@EpFillStyle"></div>
                            <input type="range" class="sfp-range sfp-range-lo"
                                   @ref="_epLoRef"
                                   min="1" max="@_maxEp" step="1" value="@_epFrom"
                                   @oninput="e => OnEpFromInput(int.Parse(e.Value!.ToString()!))" />
                            <input type="range" class="sfp-range sfp-range-hi"
                                   @ref="_epHiRef"
                                   min="1" max="@_maxEp" step="1" value="@_epTo"
                                   @oninput="e => OnEpToInput(int.Parse(e.Value!.ToString()!))" />
                        </div>
                        <input type="number" inputmode="numeric" class="sfp-num-input"
                               min="1" max="@_maxEp" value="@_epTo"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) { _epTo = Math.Max(Math.Clamp(v, 1, _maxEp), _epFrom); ScheduleResultCountUpdate(); } }" />
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- GENRES DROPDOWN -->
                <div class="sfp-section sfp-section-nodrop">
                    @{
                        var genreMyPool  = _genres;
                        var genreAllPool = _allGenres;
                        var genrePoolCount = _genreShowAll ? genreAllPool.Count : genreMyPool.Count;
                    }
                    <button class="sfp-dropdown-trigger @(_genreDropdownOpen ? "open" : "")"
                            @onclick="() => _genreDropdownOpen = !_genreDropdownOpen">
                        <span class="sfp-dt-left">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="8" y1="6" x2="21" y2="6" />
                                <line x1="8" y1="12" x2="21" y2="12" />
                                <line x1="8" y1="18" x2="21" y2="18" />
                                <circle cx="3" cy="6" r="1" fill="currentColor" stroke="none" />
                                <circle cx="3" cy="12" r="1" fill="currentColor" stroke="none" />
                                <circle cx="3" cy="18" r="1" fill="currentColor" stroke="none" />
                            </svg>
                            Genres
                            @if (FilterGenres.Any()) { <span class="sfp-dt-badge">@FilterGenres.Count</span> }
                        </span>
                        @if (genrePoolCount > 0) { <span class="sfp-pool-count">@genrePoolCount</span> }
                        <svg class="sfp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                    @if (_genreDropdownOpen)
                    {
                        <div class="sfp-dropdown-panel">
                            <div class="sfp-toggle-row">
                                <button class="sfp-toggle-btn @(!_genreShowAll ? "active" : "")" @onclick="() => _genreShowAll = false">
                                    My List <span class="sfp-toggle-count">@genreMyPool.Count</span>
                                </button>
                                <button class="sfp-toggle-btn @(_genreShowAll ? "active" : "")" @onclick="() => _genreShowAll = true">
                                    All genres <span class="sfp-toggle-count">@genreAllPool.Count</span>
                                </button>
                            </div>
                            <div class="sfp-search-row">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                    <circle cx="11" cy="11" r="8" />
                                    <line x1="17" y1="17" x2="21" y2="21" />
                                </svg>
                                <input class="sfp-search-input" type="text" placeholder="Search genres…"
                                       @bind="_genreSearch" @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(_genreSearch))
                                {
                                    <button class="sfp-search-clear" @onclick="() => _genreSearch = string.Empty">×</button>
                                }
                            </div>
                            <div class="sfp-chips sfp-chips-compact sfp-dp-scroll">
                                @{
                                    var genrePool = _genreShowAll ? genreAllPool : genreMyPool;
                                    var fg = (string.IsNullOrWhiteSpace(_genreSearch)
                                        ? genrePool
                                        : genrePool.Where(g => g.Contains(_genreSearch, StringComparison.OrdinalIgnoreCase))).ToList();
                                }
                                @if (!fg.Any()) { <span class="sfp-dp-empty">@(_genreShowAll ? "No results" : "No genres in your list yet")</span> }
                                @foreach (var g in fg)
                                {
                                    var gv = g; bool on = FilterGenres.Contains(gv);
                                    <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterGenres, gv)">
                                        @if (on) { <span>✓</span> } @gv
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="sfp-divider"></div>

                <!-- STUDIOS DROPDOWN -->
                <div class="sfp-section sfp-section-nodrop">
                    @{
                        var studioMyPool  = _studios;
                        var studioAllPool = _allStudios;
                        var studioPoolCount = _studioShowAll ? studioAllPool.Count : studioMyPool.Count;
                    }
                    <button class="sfp-dropdown-trigger @(_studioDropdownOpen ? "open" : "")"
                            @onclick="() => _studioDropdownOpen = !_studioDropdownOpen">
                        <span class="sfp-dt-left">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.6;">
                                <rect x="2" y="3" width="20" height="14" rx="2" />
                                <path d="M8 21h8" />
                                <path d="M12 17v4" />
                            </svg>
                            Studio
                            @if (FilterStudios.Any()) { <span class="sfp-dt-badge">@FilterStudios.Count</span> }
                        </span>
                        @if (studioPoolCount > 0)
                        {
                            <span class="sfp-pool-count">
                                @studioPoolCount
                                @if (AniListService.IsStudiosLoading) { <span class="sfp-loading-dot">…</span> }
                            </span>
                        }
                        <svg class="sfp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                    @if (_studioDropdownOpen)
                    {
                        <div class="sfp-dropdown-panel">
                            <div class="sfp-toggle-row">
                                <button class="sfp-toggle-btn @(!_studioShowAll ? "active" : "")" @onclick="() => _studioShowAll = false">
                                    My List <span class="sfp-toggle-count">@studioMyPool.Count</span>
                                </button>
                                <button class="sfp-toggle-btn @(_studioShowAll ? "active" : "")" @onclick="() => _studioShowAll = true">
                                    All studios <span class="sfp-toggle-count">@(studioAllPool.Count > 0 ? studioAllPool.Count.ToString() : "…")</span>
                                </button>
                            </div>
                            <div class="sfp-search-row">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                    <circle cx="11" cy="11" r="8" />
                                    <line x1="17" y1="17" x2="21" y2="21" />
                                </svg>
                                <input class="sfp-search-input" type="text" placeholder="Search studios…"
                                       @bind="_studioSearch" @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(_studioSearch))
                                {
                                    <button class="sfp-search-clear" @onclick="() => _studioSearch = string.Empty">×</button>
                                }
                            </div>
                            <div class="sfp-chips sfp-chips-compact sfp-dp-scroll">
                                @{
                                    var studioPool = _studioShowAll ? studioAllPool : studioMyPool;
                                    var fs = (string.IsNullOrWhiteSpace(_studioSearch)
                                        ? studioPool
                                        : studioPool.Where(s => s.Contains(_studioSearch, StringComparison.OrdinalIgnoreCase))).ToList();
                                }
                                @if (!fs.Any())
                                {
                                    <span class="sfp-dp-empty">
                                        @if (_studioShowAll && AniListService.IsStudiosLoading && !studioAllPool.Any())
                                        { @("Loading studios…") }
                                        else
                                        { @(_studioShowAll ? "No results" : "No studios in your list yet") }
                                    </span>
                                }
                                @foreach (var st in fs)
                                {
                                    var sv = st; bool on = FilterStudios.Contains(sv);
                                    <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterStudios, sv)">
                                        @if (on) { <span>✓</span> } @sv
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="sfp-divider"></div>

                <!-- TAGS DROPDOWN -->
                <div class="sfp-section sfp-section-nodrop">
                    @{
                        var tagMyPool  = _tags;
                        var tagAllPool = _allTags;
                        var tagPoolCount = _tagShowAll ? tagAllPool.Count : tagMyPool.Count;
                    }
                    <button class="sfp-dropdown-trigger @(_tagDropdownOpen ? "open" : "")"
                            @onclick="() => _tagDropdownOpen = !_tagDropdownOpen">
                        <span class="sfp-dt-left">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                                <line x1="7" y1="7" x2="7.01" y2="7"/>
                            </svg>
                            Tags
                            @if (FilterTags.Any()) { <span class="sfp-dt-badge">@FilterTags.Count</span> }
                        </span>
                        @if (tagPoolCount > 0) { <span class="sfp-pool-count">@tagPoolCount</span> }
                        <svg class="sfp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                    @if (_tagDropdownOpen)
                    {
                        <div class="sfp-dropdown-panel">
                            <div class="sfp-toggle-row">
                                <button class="sfp-toggle-btn @(!_tagShowAll ? "active" : "")" @onclick="() => _tagShowAll = false">
                                    My List <span class="sfp-toggle-count">@tagMyPool.Count</span>
                                </button>
                                <button class="sfp-toggle-btn @(_tagShowAll ? "active" : "")" @onclick="() => _tagShowAll = true">
                                    All tags <span class="sfp-toggle-count">@tagAllPool.Count</span>
                                </button>
                            </div>
                            <div class="sfp-search-row">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                    <circle cx="11" cy="11" r="8" />
                                    <line x1="17" y1="17" x2="21" y2="21" />
                                </svg>
                                <input class="sfp-search-input" type="text" placeholder="Search tags…"
                                       @bind="_tagSearch" @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(_tagSearch))
                                {
                                    <button class="sfp-search-clear" @onclick="() => _tagSearch = string.Empty">×</button>
                                }
                            </div>
                            <div class="sfp-chips sfp-chips-compact sfp-dp-scroll">
                                @{
                                    var tagPool = _tagShowAll ? tagAllPool : tagMyPool;
                                    var ft = (string.IsNullOrWhiteSpace(_tagSearch)
                                        ? tagPool
                                        : tagPool.Where(t => t.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase))).ToList();
                                }
                                @if (!ft.Any()) { <span class="sfp-dp-empty">@(_tagShowAll ? "No results" : "No tags in your list yet")</span> }
                                @foreach (var t in ft)
                                {
                                    var tv = t; bool on = FilterTags.Contains(tv);
                                    <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterTags, tv)">
                                        @if (on) { <span>✓</span> } @tv
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="sfp-divider"></div>

                <!-- SOURCE -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Source Material</div>
                    <div class="sfp-chips">
                        @foreach (var src in _allSources)
                        {
                            var sv = src; bool on = FilterSources.Contains(sv);
                            <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterSources, sv)">@sv</button>
                        }
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- STREAMING -->
                @if (_platforms.Any())
                {
                    <div class="sfp-section">
                        <div class="sfp-section-label">Streaming On</div>
                        <div class="sfp-chips">
                            @foreach (var p in _platforms)
                            {
                                var pv = p;
                                bool on = FilterPlatforms.Contains(pv);
                                _platformLinkMap.TryGetValue(pv, out var lnk);
                                var fallback = GetPlatformFallback(pv);
                                string? iconUrl    = lnk?.Icon;
                                string? brandColor = lnk?.Color;
                                bool shouldRecolor = !_sfpColorfulIconSites.Contains(pv)
                                    && !_sfpNeverRecolorSites.Contains(pv)
                                    && !string.IsNullOrEmpty(brandColor)
                                    && brandColor != "#000000"
                                    && brandColor!.StartsWith("#");
                                <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterPlatforms, pv)">
                                    @if (!string.IsNullOrEmpty(iconUrl))
                                    {
                                        string imgStyle = shouldRecolor ? GetWhiteToColorFilter(brandColor!) : "object-fit:contain;";
                                        <img class="sfp-platform-icon" src="@iconUrl" alt="@pv" style="@imgStyle"
                                             onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='inline-flex')" />
                                        <span class="sfp-platform-badge sfp-platform-badge-hidden"
                                              style="background:@(fallback.bg);color:@(fallback.fg)">@fallback.abbr</span>
                                    }
                                    else
                                    {
                                        <span class="sfp-platform-badge" style="background:@(fallback.bg);color:@(fallback.fg)">@fallback.abbr</span>
                                    }
                                    @pv
                                </button>
                            }
                        </div>
                    </div>
                    <div class="sfp-divider"></div>
                }

                <!-- COUNTRY -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Country of Origin</div>
                    <div class="sfp-chips">
                        @foreach (var c in _allCountries)
                        {
                            var cv = c; bool on = FilterCountries.Contains(cv);
                            <button class="sfp-chip @(on ? "sfp-chip-on" : "")" @onclick="() => ToggleFilter(FilterCountries, cv)">
                                @CountryEmoji(cv) @CountryLabel(cv)
                            </button>
                        }
                    </div>
                </div>
                <div class="sfp-divider"></div>

                <!-- CONTENT -->
                <div class="sfp-section">
                    <div class="sfp-section-label">Content</div>
                    <div class="sfp-chips">
                        <button class="sfp-chip @(FilterAdult == false ? "sfp-chip-on" : "")"
                                @onclick="() => { FilterAdult = (FilterAdult == false ? null : false); ScheduleResultCountUpdate(); }">
                            Non-adult only
                        </button>
                        <button class="sfp-chip @(FilterAdult == true ? "sfp-chip-on" : "")"
                                @onclick="() => { FilterAdult = (FilterAdult == true ? null : true); ScheduleResultCountUpdate(); }">
                            Adult only
                        </button>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="sfp-footer">
                <button class="sfp-random-btn" @onclick="PickRandom" title="Random anime from current filters">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 3 21 3 21 8" />
                        <polyline points="16 21 21 21 21 16" />
                        <line x1="4" y1="20" x2="21" y2="3" />
                        <path d="M21 16l-5 5" />
                        <path d="M4 4l5 5" />
                    </svg>
                </button>
                <button class="sfp-apply-btn" @onclick="Apply">
                    Show <span class="sfp-result-count">@_resultCount</span> result@(_resultCount != 1 ? "s" : "")
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SortFilterOptions> OnApply { get; set; }
    [Parameter] public EventCallback<AnimeCard> OnRandomPicked { get; set; }
    [Parameter] public SortFilterOptions Current { get; set; } = new();
    [Parameter] public IEnumerable<UserListEntry> AllEntries { get; set; } = Enumerable.Empty<UserListEntry>();

    public enum SortMode
    {
        RecentlyAdded,    // kept for back-compat
        OldestFirst,      // kept for back-compat
        RecentlyUpdated,
        TitleAZ, TitleZA,
        MyScoreDesc, MyScoreAsc,
        AniListScore,     // desc
        AniListScoreAsc,  // asc
        EpisodesDesc, EpisodesAsc,
        YearDesc, YearAsc,
    }

    private enum SliderType { Year, Score, Episode }

    private bool _pointerDownOnOverlay = false;

    private SortMode _sort = SortMode.RecentlyUpdated;
    private int    _yearFrom, _yearTo;
    private double _scoreFrom, _scoreTo;
    private int    _epFrom, _epTo;

    private ElementReference _yearWrapRef, _scoreWrapRef, _epWrapRef;
    private ElementReference _yearLoRef,  _yearHiRef;
    private ElementReference _scoreLoRef, _scoreHiRef;
    private ElementReference _epLoRef,    _epHiRef;

    private bool _jsReady = false;

    private HashSet<string> FilterAiringStatus = new();
    private HashSet<string> FilterFormats      = new();
    private HashSet<string> FilterSeasons      = new();
    private HashSet<string> FilterGenres       = new();
    private HashSet<string> FilterStudios      = new();
    private HashSet<string> FilterTags         = new();
    private HashSet<string> FilterSources      = new();
    private HashSet<string> FilterPlatforms    = new();
    private HashSet<string> FilterCountries    = new();
    private bool? FilterAdult = null;

    private bool   _genreDropdownOpen  = false;
    private bool   _tagDropdownOpen    = false;
    private bool   _studioDropdownOpen = false;
    private bool   _genreShowAll       = false;
    private bool   _studioShowAll      = false;
    private bool   _tagShowAll         = false;
    private string _genreSearch        = string.Empty;
    private string _tagSearch          = string.Empty;
    private string _studioSearch       = string.Empty;

    private static readonly string[] _allStatuses =
        { "RELEASING", "NOT_YET_RELEASED", "FINISHED", "CANCELLED", "HIATUS" };

    private static readonly List<string> _allFormats = new()
        { "TV Series", "Movie", "OVA", "ONA", "TV Short", "Special", "Music" };

    private static readonly List<string> _allSeasons = new()
        { "WINTER", "SPRING", "SUMMER", "FALL" };

    private static readonly List<string> _allSources = new()
    {
        "Original", "Manga", "Light Novel", "Visual Novel", "Web Novel",
        "Novel", "Video Game", "Game", "Comic", "Picture Book",
        "Multimedia Project", "Other"
    };

    private static readonly List<string> _allCountries = new()
        { "JP", "CN", "KR", "TW" };

    private static readonly List<string> _genresFallback = new()
    {
        "Action","Adventure","Comedy","Drama","Ecchi","Fantasy","Horror","Hentai",
        "Mahou Shoujo","Mecha","Music","Mystery","Psychological","Romance","Sci-Fi",
        "Slice of Life","Sports","Supernatural","Thriller"
    };

    private List<string> _genres     = new();
    private List<string> _allGenres  = new();
    private List<string> _studios    = new();
    private List<string> _allStudios = new();
    private List<string> _tags       = new();
    private List<string> _allTags    = new();
    private List<string> _platforms  = new();
    private Dictionary<string, AnimeExternalLink> _platformLinkMap = new();
    private List<int>    _years      = new();
    private int    _minYear = 1940, _maxYear = DateTime.Now.Year;
    private int    _maxEp   = 1;
    private int    _resultCount = 0;
    private CancellationTokenSource? _debounceCtS;

    // ── Fill styles ──────────────────────────────────────────────────────────

    private string YearFillStyle
    {
        get
        {
            double range = Math.Max(1.0, _maxYear - _minYear);
            double l = Math.Clamp((_yearFrom - _minYear) * 100.0 / range, 0, 100);
            double r = Math.Clamp((_maxYear  - _yearTo)  * 100.0 / range, 0, 100);
            return string.Format(System.Globalization.CultureInfo.InvariantCulture, "left:{0:F2}%;right:{1:F2}%", l, r);
        }
    }

    private string ScoreFillStyle
    {
        get
        {
            double l = Math.Clamp(_scoreFrom * 10.0,         0, 100);
            double r = Math.Clamp((10.0 - _scoreTo) * 10.0,  0, 100);
            return string.Format(System.Globalization.CultureInfo.InvariantCulture, "left:{0:F2}%;right:{1:F2}%", l, r);
        }
    }

    private string EpFillStyle
    {
        get
        {
            double range = Math.Max(1.0, _maxEp - 1);
            double l = Math.Clamp((_epFrom - 1)     * 100.0 / range, 0, 100);
            double r = Math.Clamp((_maxEp  - _epTo) * 100.0 / range, 0, 100);
            return string.Format(System.Globalization.CultureInfo.InvariantCulture, "left:{0:F2}%;right:{1:F2}%", l, r);
        }
    }

    private bool HasActiveOptions =>
        _sort != SortMode.RecentlyUpdated || RangeActive ||
        FilterAiringStatus.Any() || FilterFormats.Any() || FilterSeasons.Any() ||
        FilterGenres.Any() || FilterStudios.Any() || FilterTags.Any() ||
        FilterSources.Any() || FilterPlatforms.Any() || FilterCountries.Any() || FilterAdult.HasValue;

    private bool RangeActive =>
        _yearFrom  != _minYear || _yearTo  != _maxYear ||
        _scoreFrom != 0        || _scoreTo != 10       ||
        _epFrom    != 1        || _epTo    != _maxEp;

    private int TotalActiveCount
    {
        get
        {
            int n = (_sort != SortMode.RecentlyUpdated ? 1 : 0) + (RangeActive ? 1 : 0);
            n += new[] { FilterAiringStatus, FilterFormats, FilterSeasons, FilterGenres,
                         FilterStudios, FilterTags, FilterSources, FilterPlatforms, FilterCountries }
                 .Count(s => s.Any());
            if (FilterAdult.HasValue) n++;
            return n;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_jsReady)
        {
            await JS.InvokeVoidAsync("eval", @"
                if (!window.sfpTrackClick) {
                    window.sfpTrackClick = function(el, clientX) {
                        var r = el.getBoundingClientRect();
                        return r.width > 0 ? Math.min(1, Math.max(0, (clientX - r.left) / r.width)) : 0;
                    };
                }
                if (!window.sfpSetValue) {
                    window.sfpSetValue = function(el, val) {
                        if (el) el.value = val;
                    };
                }
                if (!window.sfpInitDualSlider) {
                    window.sfpInitDualSlider = function(loEl, hiEl) {
                        if (!loEl || !hiEl || loEl._sfpInited) return;
                        loEl._sfpInited = true;
                        loEl.addEventListener('input', function() {
                            var hi = parseFloat(hiEl.value);
                            if (parseFloat(loEl.value) > hi) loEl.value = hi;
                        }, { capture: true });
                        hiEl.addEventListener('input', function() {
                            var lo = parseFloat(loEl.value);
                            if (parseFloat(hiEl.value) < lo) hiEl.value = lo;
                        }, { capture: true });
                    };
                }
            ");
            _jsReady = true;
        }
        if (IsVisible && _jsReady)
        {
            await JS.InvokeVoidAsync("sfpInitDualSlider", _yearLoRef,  _yearHiRef);
            await JS.InvokeVoidAsync("sfpInitDualSlider", _scoreLoRef, _scoreHiRef);
            await JS.InvokeVoidAsync("sfpInitDualSlider", _epLoRef,    _epHiRef);
        }
    }

    protected override void OnParametersSet()
    {
        if (!IsVisible) return;
        _pointerDownOnOverlay = false;
        RebuildCache();
        _sort = Current.Sort;
        FilterAiringStatus = new(Current.AiringStatuses); FilterFormats   = new(Current.Formats);
        FilterSeasons      = new(Current.Seasons);        FilterGenres    = new(Current.Genres);
        FilterStudios      = new(Current.Studios);        FilterTags      = new(Current.Tags);
        FilterSources      = new(Current.Sources);        FilterPlatforms = new(Current.Platforms);
        FilterCountries    = new(Current.Countries);      FilterAdult     = Current.Adult;
        _yearFrom  = Current.YearFrom  ?? _minYear; _yearTo  = Current.YearTo  ?? _maxYear;
        _scoreFrom = Current.ScoreFrom ?? 0;        _scoreTo = Current.ScoreTo ?? 10;
        _epFrom    = Current.EpFrom    ?? 1;        _epTo    = Current.EpTo    ?? _maxEp;
        if (_yearFrom  > _yearTo)  (_yearFrom,  _yearTo)  = (_yearTo,  _yearFrom);
        if (_scoreFrom > _scoreTo) (_scoreFrom, _scoreTo) = (_scoreTo, _scoreFrom);
        if (_epFrom    > _epTo)    (_epFrom,    _epTo)    = (_epTo,    _epFrom);
        _resultCount = AllEntries.Count(e => PassesFilters(e, BuildOptions()));
        _ = EnsureMetadataAsync();
    }

    private async Task EnsureMetadataAsync()
    {
        bool needsUiUpdate = false;
        if (AniListService.GetCachedGenres() == null || AniListService.GetCachedTags() == null)
        {
            await AniListService.FetchGenresAndTagsAsync();
            ApplyMetadataCache();
            needsUiUpdate = true;
        }
        if (AniListService.GetCachedStudios() == null && !AniListService.IsStudiosLoading)
        {
            _ = AniListService.FetchAllStudiosAsync(async () =>
            {
                ApplyMetadataCache();
                await InvokeAsync(StateHasChanged);
            });
        }
        if (needsUiUpdate) await InvokeAsync(StateHasChanged);
    }

    private void ApplyMetadataCache()
    {
        var cachedGenres = AniListService.GetCachedGenres();
        _allGenres = (cachedGenres ?? _genresFallback)
            .Union(_genres).Union(FilterGenres)
            .Distinct().OrderBy(x => x).ToList();

        var cachedTags = AniListService.GetCachedTags();
        if (cachedTags?.Any() == true)
            _allTags = cachedTags
                .Union(_tags).Union(FilterTags)
                .Distinct().OrderBy(x => x).ToList();

        var cachedStudios = AniListService.GetCachedStudios();
        if (cachedStudios?.Any() == true)
            _allStudios = cachedStudios
                .Union(_studios).Union(FilterStudios)
                .Distinct().OrderBy(x => x).ToList();
    }

    private void RebuildCache()
    {
        var en = AllEntries.ToList();

        _genres = en.SelectMany(e => e.Anime.Genres ?? Enumerable.Empty<string>())
                    .Distinct().OrderBy(x => x).ToList();

        var studioFreq = en
            .SelectMany(e => e.Anime.Studios?.Select(s => s.Name) ?? Enumerable.Empty<string>())
            .GroupBy(s => s).ToDictionary(g => g.Key, g => g.Count());
        _studios = studioFreq.OrderByDescending(kv => kv.Value).Select(kv => kv.Key).ToList();

        _tags = en.SelectMany(e => e.Anime.Tags?.Select(t => t.Name) ?? Enumerable.Empty<string>())
                  .Where(v => !string.IsNullOrWhiteSpace(v)).Distinct().OrderBy(x => x).ToList();

        _platforms = en
            .SelectMany(e => e.Anime.ExternalLinks?
                .Where(l => l.Type == "STREAMING").Select(l => l.Site) ?? Enumerable.Empty<string>())
            .Distinct().OrderBy(x => x).ToList();

        _platformLinkMap = en
            .SelectMany(e => e.Anime.ExternalLinks?.Where(l => l.Type == "STREAMING") ?? Enumerable.Empty<AnimeExternalLink>())
            .GroupBy(l => l.Site)
            .ToDictionary(g => g.Key, g => g.FirstOrDefault(l => !string.IsNullOrEmpty(l.Icon)) ?? g.First());

        _years   = en.Where(e => e.Anime.Year.HasValue).Select(e => e.Anime.Year!.Value).Distinct().ToList();
        _minYear = 1940;
        _maxYear = DateTime.Now.Year;

        _maxEp = en
          .Select(e => ParseEpisodeCount(e.Anime.Episodes))
          .Where(v => v > 0 && v < int.MaxValue - 1) // exclure les valeurs sentinelles
          .DefaultIfEmpty(1)
          .Max();
        _maxEp = Math.Max(_maxEp, 1);

        ApplyMetadataCache();
    }

    private static int ParseEpisodeCount(string? s)
    {
        if (string.IsNullOrWhiteSpace(s) || s == "N/A" || s == "?") return 0;
        var slash = s.IndexOf('/');
        var part = slash >= 0 ? s[(slash + 1)..] : s;
        if (part.TrimEnd('+', '?', ' ') == "" || part.StartsWith('?')) return int.MaxValue - 1;
        part = part.TrimEnd('+', '?', ' ');
        return int.TryParse(part, out var v) ? v : 0;
    }

    private async Task OnYearFromInput(int v)
    {
        var clamped = Math.Min(v, _yearTo);
        _yearFrom = clamped;
        if (clamped != v)
        {
            await JS.InvokeVoidAsync("sfpSetValue", _yearLoRef, clamped);
            await JS.InvokeVoidAsync("sfpSetValue", _yearHiRef, _yearTo);
        }
        ScheduleResultCountUpdate();
    }

    private async Task OnYearToInput(int v)
    {
        var clamped = Math.Max(v, _yearFrom);
        _yearTo = clamped;
        if (clamped != v)
        {
            await JS.InvokeVoidAsync("sfpSetValue", _yearHiRef, clamped);
            await JS.InvokeVoidAsync("sfpSetValue", _yearLoRef, _yearFrom);
        }
        ScheduleResultCountUpdate();
    }

    private async Task OnScoreFromInput(double v)
    {
        var clamped = Math.Min(v, _scoreTo);
        _scoreFrom = clamped;
        if (clamped != v)
        {
            await JS.InvokeVoidAsync("sfpSetValue", _scoreLoRef, clamped.ToString("G", System.Globalization.CultureInfo.InvariantCulture));
            await JS.InvokeVoidAsync("sfpSetValue", _scoreHiRef, _scoreTo.ToString("G", System.Globalization.CultureInfo.InvariantCulture));
        }
        ScheduleResultCountUpdate();
    }

    private async Task OnScoreToInput(double v)
    {
        var clamped = Math.Max(v, _scoreFrom);
        _scoreTo = clamped;
        if (clamped != v)
        {
            await JS.InvokeVoidAsync("sfpSetValue", _scoreHiRef, clamped.ToString("G", System.Globalization.CultureInfo.InvariantCulture));
            await JS.InvokeVoidAsync("sfpSetValue", _scoreLoRef, _scoreFrom.ToString("G", System.Globalization.CultureInfo.InvariantCulture));
        }
        ScheduleResultCountUpdate();
    }

    private async Task OnEpFromInput(int v)
    {
        var clamped = Math.Min(v, _epTo);
        _epFrom = clamped;
        if (clamped != v)
        {
            await JS.InvokeVoidAsync("sfpSetValue", _epLoRef, clamped);
            await JS.InvokeVoidAsync("sfpSetValue", _epHiRef, _epTo);
        }
        ScheduleResultCountUpdate();
    }

    private async Task OnEpToInput(int v)
    {
        var clamped = Math.Max(v, _epFrom);
        _epTo = clamped;
        if (clamped != v)
        {
            await JS.InvokeVoidAsync("sfpSetValue", _epHiRef, clamped);
            await JS.InvokeVoidAsync("sfpSetValue", _epLoRef, _epFrom);
        }
        ScheduleResultCountUpdate();
    }

    private async Task OnTrackClickAsync(MouseEventArgs e, SliderType type)
    {
        if (!_jsReady) return;
        var wrapRef = type == SliderType.Year  ? _yearWrapRef
                    : type == SliderType.Score ? _scoreWrapRef
                    : _epWrapRef;
        double pct;
        try   { pct = Math.Clamp(await JS.InvokeAsync<double>("sfpTrackClick", wrapRef, e.ClientX), 0, 1); }
        catch { return; }

        switch (type)
        {
            case SliderType.Year:
            {
                int v = (int)Math.Round(_minYear + pct * (_maxYear - _minYear));
                if (Math.Abs(v - _yearFrom) <= Math.Abs(v - _yearTo))
                    _yearFrom = Math.Min(v, _yearTo);
                else
                    _yearTo = Math.Max(v, _yearFrom);
                break;
            }
            case SliderType.Score:
            {
                double v = Math.Clamp(Math.Round(pct * 10.0 / 0.5) * 0.5, 0, 10);
                if (Math.Abs(v - _scoreFrom) <= Math.Abs(v - _scoreTo))
                    _scoreFrom = Math.Min(v, _scoreTo);
                else
                    _scoreTo = Math.Max(v, _scoreFrom);
                break;
            }
            case SliderType.Episode:
            {
                int v = (int)Math.Round(1 + pct * (_maxEp - 1));
                if (Math.Abs(v - _epFrom) <= Math.Abs(v - _epTo))
                    _epFrom = Math.Min(v, _epTo);
                else
                    _epTo = Math.Max(v, _epFrom);
                break;
            }
        }
        StateHasChanged();
        ScheduleResultCountUpdate();
    }

    private void ScheduleResultCountUpdate()
    {
        _debounceCtS?.Cancel();
        _debounceCtS = new CancellationTokenSource();
        var token = _debounceCtS.Token;
        _ = Task.Delay(100, token).ContinueWith(_ =>
        {
            if (token.IsCancellationRequested) return;
            _resultCount = AllEntries.Count(e => PassesFilters(e, BuildOptions()));
            InvokeAsync(StateHasChanged);
        }, TaskContinuationOptions.NotOnCanceled);
    }

    private void ToggleFilter(HashSet<string> set, string value)
    {
        if (!set.Remove(value)) set.Add(value);
        _resultCount = AllEntries.Count(e => PassesFilters(e, BuildOptions()));
    }

    private SortFilterOptions BuildOptions() => new()
    {
        Sort = _sort, AiringStatuses = new(FilterAiringStatus), Formats = new(FilterFormats),
        Seasons = new(FilterSeasons), Genres = new(FilterGenres), Studios = new(FilterStudios),
        Tags = new(FilterTags), Sources = new(FilterSources), Platforms = new(FilterPlatforms),
        Countries = new(FilterCountries), Adult = FilterAdult,
        YearFrom  = _yearFrom  != _minYear ? _yearFrom  : null, YearTo  = _yearTo  != _maxYear ? _yearTo  : null,
        ScoreFrom = _scoreFrom != 0        ? _scoreFrom : null, ScoreTo = _scoreTo != 10        ? _scoreTo : null,
        EpFrom    = _epFrom    != 1        ? _epFrom    : null, EpTo    = _epTo    != _maxEp    ? _epTo    : null,
    };

    public static bool PassesFilters(UserListEntry e, SortFilterOptions opts)
    {
        if (opts.AiringStatuses.Any() && !opts.AiringStatuses.Contains(e.Anime.Status ?? "")) return false;
        if (opts.Formats.Any()  && !opts.Formats.Contains(e.Anime.Format ?? ""))  return false;
        if (opts.Seasons.Any()  && !opts.Seasons.Contains(e.Anime.Season ?? ""))  return false;
        if (opts.Genres.Any()   && !(e.Anime.Genres?.Any(g => opts.Genres.Contains(g)) ?? false))        return false;
        if (opts.Studios.Any()  && !(e.Anime.Studios?.Any(s => opts.Studios.Contains(s.Name)) ?? false)) return false;
        if (opts.Tags.Any()     && !(e.Anime.Tags?.Any(t => opts.Tags.Contains(t.Name)) ?? false))       return false;
        if (opts.Sources.Any()  && !opts.Sources.Contains(e.Anime.Source ?? ""))  return false;
        if (opts.Platforms.Any()) { var ep = e.Anime.ExternalLinks?.Where(l => l.Type == "STREAMING").Select(l => l.Site).ToHashSet() ?? new(); if (!opts.Platforms.Any(p => ep.Contains(p))) return false; }
        if (opts.Countries.Any() && !opts.Countries.Contains(e.Anime.CountryOfOrigin ?? "")) return false;
        if (opts.Adult.HasValue  && e.Anime.IsAdult != opts.Adult.Value) return false;
        if (opts.YearFrom.HasValue  && (!e.Anime.Year.HasValue || e.Anime.Year  < opts.YearFrom))  return false;
        if (opts.YearTo.HasValue    && (!e.Anime.Year.HasValue || e.Anime.Year  > opts.YearTo))    return false;
        if (opts.ScoreFrom.HasValue || opts.ScoreTo.HasValue)
        {
            if (e.Score <= 0) return false; // pas de score → exclu si filtre actif
            if (opts.ScoreFrom.HasValue && e.Score < opts.ScoreFrom) return false;
            if (opts.ScoreTo.HasValue && e.Score > opts.ScoreTo) return false;
        }
        if (opts.EpFrom.HasValue || opts.EpTo.HasValue)
        {
            var epTotal = ParseEpisodeCount(e.Anime.Episodes);
            if (epTotal <= 0) return false; // pas de total connu → exclu si filtre actif
            if (opts.EpFrom.HasValue && epTotal < opts.EpFrom) return false;
            if (opts.EpTo.HasValue && epTotal > opts.EpTo) return false;
        }
        return true;
    }

    private void Reset()
    {
        _sort = SortMode.RecentlyUpdated;
        FilterAiringStatus.Clear(); FilterFormats.Clear();   FilterSeasons.Clear();
        FilterGenres.Clear();       FilterStudios.Clear();   FilterTags.Clear();
        FilterSources.Clear();      FilterPlatforms.Clear(); FilterCountries.Clear();
        FilterAdult = null;
        _genreDropdownOpen = false; _tagDropdownOpen = false; _studioDropdownOpen = false;
        _yearFrom = _minYear; _yearTo = _maxYear; _scoreFrom = 0; _scoreTo = 10;
        _epFrom = 1; _epTo = _maxEp;
        _resultCount = AllEntries.Count(e => PassesFilters(e, BuildOptions()));
    }

    private async Task Apply() { await OnApply.InvokeAsync(BuildOptions()); await OnClose.InvokeAsync(); }

    private async Task OnOverlayClick()
    {
        if (!_pointerDownOnOverlay) { _pointerDownOnOverlay = false; return; }
        _pointerDownOnOverlay = false;
        await Apply();
    }

    private async Task OnPanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task PickRandom()
    {
        var opts    = BuildOptions();
        var matches = AllEntries.Where(e => PassesFilters(e, opts)).ToList();
        if (!matches.Any()) { matches = AllEntries.ToList(); if (!matches.Any()) return; }
        matches = ApplySort(matches, opts.Sort);
        var picked = matches[new Random().Next(matches.Count)];
        await OnApply.InvokeAsync(opts);
        await OnClose.InvokeAsync();
        await OnRandomPicked.InvokeAsync(picked.Anime);
    }

    // ── Sort helpers ─────────────────────────────────────────────────────────

    // Episodes: anime sans épisodes connus → toujours à la fin
    private static int EpSortKey(UserListEntry e)
    {
        var ep = ParseEpisodeCount(e.Anime.Episodes);
        return ep > 0 ? ep : -1;
    }

    // AniList score parsing
    private static double AniScoreKey(UserListEntry e) =>
    double.TryParse(e.Anime.Score, System.Globalization.NumberStyles.Any,
        System.Globalization.CultureInfo.InvariantCulture, out var s) && s > 0 ? s : -1;

    private static List<UserListEntry> ApplySort(List<UserListEntry> list, SortMode sort) => sort switch
    {
        SortMode.TitleAZ         => list.OrderBy(e => e.Anime.Title).ToList(),
        SortMode.TitleZA         => list.OrderByDescending(e => e.Anime.Title).ToList(),
        SortMode.MyScoreDesc     => list.OrderByDescending(e => e.Score).ToList(),
        SortMode.MyScoreAsc      => list.OrderBy(e => e.Score).ToList(),
        // Rating desc : sans score (-1) → fin
        SortMode.AniListScore    => list.OrderByDescending(e => AniScoreKey(e)).ToList(),
        // Rating asc  : sans score → fin (on utilise double.MaxValue)
        SortMode.AniListScoreAsc => list.OrderBy(e => AniScoreKey(e) >= 0 ? AniScoreKey(e) : double.MaxValue).ToList(),
        // Épisodes desc : sans épisodes (-1) → fin
        SortMode.EpisodesDesc    => list.OrderByDescending(e => EpSortKey(e)).ToList(),
        // Épisodes asc  : sans épisodes → fin (on utilise int.MaxValue)
        SortMode.EpisodesAsc     => list.OrderBy(e => EpSortKey(e) >= 0 ? EpSortKey(e) : int.MaxValue).ToList(),
        SortMode.YearDesc        => list.OrderByDescending(e => e.Anime.Year ?? 0).ToList(),
        SortMode.YearAsc         => list.OrderBy(e => e.Anime.Year ?? 0).ToList(),
        _                        => list.OrderByDescending(e => e.UpdatedAt).ToList(), // RecentlyUpdated
    };

    // Standard single-state sort chip (radio behaviour).
    private RenderFragment SortChip(SortMode mode, string label) =>
        @<button class="sfp-chip @(_sort == mode ? "sfp-chip-on" : "")"
        @onclick="() => { _sort = mode; _resultCount = AllEntries.Count(e => PassesFilters(e, BuildOptions())); }">@label</button>;

    // 2-state sort chip: asc ↔ desc, toggle entre les deux.
    private RenderFragment ThreeStateChip(SortMode asc, SortMode desc, string label) =>
        @<button class="sfp-chip sfp-chip-3state @(_sort == asc || _sort == desc ? "sfp-chip-on" : "")"
@onclick="() => { _sort = _sort == asc ? desc : asc; _resultCount = AllEntries.Count(e => PassesFilters(e, BuildOptions())); }">
            @label
            @if (_sort == asc)  { <span class="sfp-sort-arrow">↑</span> }
            @if (_sort == desc) { <span class="sfp-sort-arrow">↓</span> }
        </button>;

