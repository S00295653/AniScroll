        if (l.Contains("wakanim"))                        return ("#1B90D7", "#fff", "Wk");
        if (l.Contains("adn"))                            return ("#009EE0", "#fff", "ADN");
        if (l.Contains("bilibili"))                       return ("#00A1D6", "#fff", "Bi");
        if (l.Contains("tubi"))                           return ("#FA4816", "#fff", "Tu");
        if (l.Contains("peacock"))                        return ("#0452FF", "#fff", "Pc");
        if (l.Contains("max") || l.Contains("hbo"))      return ("#002BE7", "#fff", "Max");
        if (l.Contains("paramount"))                      return ("#0064FF", "#fff", "P+");
        if (l.Contains("aniplus"))                        return ("#E4011C", "#fff", "AP");
