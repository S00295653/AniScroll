    private static readonly Dictionary<string, string> _sfpFilterCache = new();
    private static string GetWhiteToColorFilter(string hex)
    {
        if (string.IsNullOrEmpty(hex) || !hex.StartsWith('#')) return string.Empty;
        if (_sfpFilterCache.TryGetValue(hex, out var cached)) return cached;
        var rgb = ParseHex(hex);
        if (rgb == null) { _sfpFilterCache[hex] = string.Empty; return string.Empty; }
        var f = ComputeFilter(rgb.Value.r, rgb.Value.g, rgb.Value.b);
        var result = $"filter:brightness(0) saturate(100%) {f};";
        _sfpFilterCache[hex] = result;
        return result;
    }
    private static (int r, int g, int b)? ParseHex(string hex)
    {
        hex = hex.TrimStart('#');
        if (hex.Length == 3) hex = new string(new[] { hex[0], hex[0], hex[1], hex[1], hex[2], hex[2] });
        if (hex.Length != 6) return null;
        try { return (Convert.ToInt32(hex[0..2], 16), Convert.ToInt32(hex[2..4], 16), Convert.ToInt32(hex[4..6], 16)); }
        catch { return null; }
    }
    private static string ComputeFilter(int tr, int tg, int tb)
    {
        var (th, ts, tl) = ToHsl(tr, tg, tb);
        var rng = new Random(42);
        double[] best = Array.Empty<double>();
        double bestLoss = double.MaxValue;
        for (int a = 0; a < 3 && bestLoss > 25; a++)
        {
            var r = Spsa(tr, tg, tb, th, ts, tl, new double[] { 50,20,3750,50,100,100 },
                5, new double[]{60,180,18000,600,1.2,1.2}, 15, 1000, rng);
            if (r.loss < bestLoss) { best = r.vals; bestLoss = r.loss; }
        }
        double A1 = bestLoss + 1;
        var r2 = Spsa(tr, tg, tb, th, ts, tl, best, bestLoss,
            new double[]{0.25*A1,0.25*A1,A1,0.25*A1,0.2*A1,0.2*A1}, 2, 500, rng);
        if (r2.loss < bestLoss) best = r2.vals;
        static int R(double v) => (int)Math.Round(v);
        return $"invert({R(best[0])}%) sepia({R(best[1])}%) saturate({R(best[2])}%) hue-rotate({R(best[3]*3.6)}deg) brightness({R(best[4])}%) contrast({R(best[5])}%)";
    }
    private static (double[] vals, double loss) Spsa(int tr, int tg, int tb, double th, double ts, double tl,
        double[] init, double A, double[] a, double c, int iters, Random rng)
    {
        var v = (double[])init.Clone(); double[] best = null!; double bl = double.MaxValue;
        var d = new double[6]; var hi = new double[6]; var lo = new double[6];
        for (int k = 0; k < iters; k++)
        {
            double ck = c / Math.Pow(k+1, 1.0/6.0);
            for (int i = 0; i < 6; i++) { d[i] = rng.NextDouble()>0.5?1:-1; hi[i]=v[i]+ck*d[i]; lo[i]=v[i]-ck*d[i]; }
            double ld = FLoss(hi,tr,tg,tb,th,ts,tl) - FLoss(lo,tr,tg,tb,th,ts,tl);
            for (int i = 0; i < 6; i++) { double g=ld/(2*ck)*d[i]; v[i]=FClamp(v[i]-a[i]/Math.Pow(A+k+1,1.0)*g, i); }
            double l = FLoss(v,tr,tg,tb,th,ts,tl);
            if (l < bl) { best=(double[])v.Clone(); bl=l; }
        }
        return (best ?? v, bl);
    }
    private static double FLoss(double[] f, int tr, int tg, int tb, double th, double ts, double tl)
    {
        var (r,g,b) = ApplyF(f); var (h,s,l) = ToHsl((int)r,(int)g,(int)b);
        return Math.Abs(r-tr)+Math.Abs(g-tg)+Math.Abs(b-tb)+Math.Abs(h-th)+Math.Abs(s-ts)+Math.Abs(l-tl);
    }
    private static (double r,double g,double b) ApplyF(double[] f)
    {
        double r=0,g=0,b=0;
        double inv=f[0]/100.0; r=FC((inv+r/255.0*(1-2*inv))*255); g=FC((inv+g/255.0*(1-2*inv))*255); b=FC((inv+b/255.0*(1-2*inv))*255);
        (r,g,b)=MM(r,g,b,SM(f[1]/100.0)); (r,g,b)=MM(r,g,b,SAT(f[2]/100.0)); (r,g,b)=MM(r,g,b,HR(f[3]*3.6));
        r=FC(r*(f[4]/100.0)); g=FC(g*(f[4]/100.0)); b=FC(b*(f[4]/100.0));
        double con=f[5]/100.0,ic=(-0.5*con+0.5)*255; r=FC(r*con+ic); g=FC(g*con+ic); b=FC(b*con+ic);
        return (r,g,b);
    }
    private static double FC(double v) => Math.Max(0,Math.Min(255,v));
    private static (double,double,double) MM(double r,double g,double b,double[] m) =>
        (FC(r*m[0]+g*m[1]+b*m[2]),FC(r*m[3]+g*m[4]+b*m[5]),FC(r*m[6]+g*m[7]+b*m[8]));
    private static double[] SM(double v) => new[]{0.393+0.607*(1-v),0.769-0.769*(1-v),0.189-0.189*(1-v),0.349-0.349*(1-v),0.686+0.314*(1-v),0.168-0.168*(1-v),0.272-0.272*(1-v),0.534-0.534*(1-v),0.131+0.869*(1-v)};
    private static double[] SAT(double v) => new[]{0.213+0.787*v,0.715-0.715*v,0.072-0.072*v,0.213-0.213*v,0.715+0.285*v,0.072-0.072*v,0.213-0.213*v,0.715-0.715*v,0.072+0.928*v};
    private static double[] HR(double deg) { double rad=deg/180.0*Math.PI,sin=Math.Sin(rad),cos=Math.Cos(rad); return new[]{0.213+cos*0.787-sin*0.213,0.715-cos*0.715-sin*0.715,0.072-cos*0.072+sin*0.928,0.213-cos*0.213+sin*0.143,0.715+cos*0.285+sin*0.140,0.072-cos*0.072-sin*0.283,0.213-cos*0.213-sin*0.787,0.715-cos*0.715+sin*0.715,0.072+cos*0.928+sin*0.072}; }
    private static double FClamp(double v, int i) { double max=i==2?7500:(i==4||i==5)?200:100; if(i==3){if(v>max)v%=max;else if(v<0)v=max+v%max;}else v=Math.Max(0,Math.Min(max,v)); return v; }
    private static (double h,double s,double l) ToHsl(int r,int g,int b) { double rf=r/255.0,gf=g/255.0,bf=b/255.0,max=Math.Max(rf,Math.Max(gf,bf)),min=Math.Min(rf,Math.Min(gf,bf)),l=(max+min)/2.0,h=0,s=0; if(max!=min){double d=max-min;s=l>0.5?d/(2-max-min):d/(max+min);if(max==rf)h=(gf-bf)/d+(gf<bf?6:0);else if(max==gf)h=(bf-rf)/d+2;else h=(rf-gf)/d+4;h/=6;}return(h*100,s*100,l*100); }

    private static string FormatAiringStatus(string s) => s switch
    { "RELEASING" => "Airing", "FINISHED" => "Finished", "NOT_YET_RELEASED" => "Upcoming", "CANCELLED" => "Cancelled", "HIATUS" => "On Hiatus", _ => s };
