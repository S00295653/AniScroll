@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject AniListAuthService AniListAuth
@inject UserListService UserListService
@inject IJSRuntime JS
@implements IDisposable

@if (IsActive)
{
    @if (_state == PanelState.NotConnected)
    {
        <div class="pp-connect-section">
            <div class="pp-connect-icon-wrap">
                <svg width="36" height="36" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 0h512v512H0" fill="#1e2630" />
                    <path d="M321.92 323.27V136.6c0-10.698-5.887-16.602-16.558-16.602h-36.433c-10.672 0-16.561 5.904-16.561 16.602v88.651c0 2.497 23.996 14.089 24.623 16.541 18.282 71.61 3.972 128.92-13.359 131.6 28.337 1.405 31.455 15.064 10.348 5.731 3.229-38.209 15.828-38.134 52.049-1.406.31.317 7.427 15.282 7.87 15.282h85.545c10.672 0 16.558-5.9 16.558-16.6v-36.524c0-10.698-5.886-16.602-16.558-16.602z" fill="#02a9ff" />
                    <path d="M170.68 120 74.999 393h74.338l16.192-47.222h80.96L262.315 393h73.968l-95.314-273zm11.776 165.28 23.183-75.629 25.393 75.629z" fill="#fefefe" />
                </svg>
            </div>
            <p class="pp-connect-title">Connect with AniList</p>
            <p class="pp-connect-sub">Sign in to sync your anime list, custom lists, scores, episodes, and notes.</p>
            <div class="pp-connect-features">
                <div class="pp-connect-feature">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="#02a9ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Import your anime &amp; manga list
                </div>
                <div class="pp-connect-feature">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="#02a9ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Sync scores, episodes &amp; notes
                </div>
                <div class="pp-connect-feature">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><polyline points="20,6 9,17 4,12" stroke="#02a9ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Custom lists &amp; watch status
                </div>
            </div>
            <button class="pp-anilist-btn" @onclick="StartOAuth">
                <svg width="16" height="16" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 0h512v512H0" fill="#1e2630" />
                    <path d="M321.92 323.27V136.6c0-10.698-5.887-16.602-16.558-16.602h-36.433c-10.672 0-16.561 5.904-16.561 16.602v88.651c0 2.497 23.996 14.089 24.623 16.541 18.282 71.61 3.972 128.92-13.359 131.6 28.337 1.405 31.455 15.064 10.348 5.731 3.229-38.209 15.828-38.134 52.049-1.406.31.317 7.427 15.282 7.87 15.282h85.545c10.672 0 16.558-5.9 16.558-16.6v-36.524c0-10.698-5.886-16.602-16.558-16.602z" fill="#02a9ff" />
                    <path d="M170.68 120 74.999 393h74.338l16.192-47.222h80.96L262.315 393h73.968l-95.314-273zm11.776 165.28 23.183-75.629 25.393 75.629z" fill="#fefefe" />
                </svg>
                Connect with AniList
            </button>
        </div>
    }
    else if (_state == PanelState.Loading)
    {
        <div class="pp-loading-section">
            <div class="pp-spinner"></div>
            <p class="pp-loading-text">@_loadingText</p>
        </div>
    }
    else if (_state == PanelState.Connected)
    {
        <div class="pp-user-card">
            @if (!string.IsNullOrEmpty(AniListAuth.CurrentUser?.AvatarUrl))
            {
                <div class="pp-avatar" style="background-image:url('@AniListAuth.CurrentUser.AvatarUrl');"></div>
            }
            else
            {
                <div class="pp-avatar pp-avatar-placeholder">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
            }
            <div class="pp-user-info">
                <span class="pp-username">@(AniListAuth.CurrentUser?.Name ?? "AniList User")</span>
                <a class="pp-anilist-link" href="https://anilist.co/user/@(AniListAuth.CurrentUser?.Name)" target="_blank">
                    <span class="pp-al-dot"></span>AniList profile
                </a>
            </div>
        </div>
        <button class="pp-import-btn" @onclick="StartImport">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 2v13M7 10l5 5 5-5" />
                <rect x="3" y="16" width="18" height="5" rx="1" />
            </svg>
            Import My List
        </button>
        <button class="pp-disconnect-btn" @onclick="() => _ = Disconnect()">Disconnect</button>
    }
    else if (_state == PanelState.Importing)
    {
        <div class="pp-import-progress">
            <div class="pp-spinner"></div>
            <p class="pp-loading-text">@_loadingText</p>
            @if (_importTotal > 0)
            {
                <div class="pp-progress-bar-wrap">
                    <div class="pp-progress-bar" style="width:@((_importDone * 100.0 / _importTotal).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                </div>
                <p class="pp-progress-count">@_importDone / @_importTotal</p>
            }
        </div>
    }
    else if (_state == PanelState.Done)
    {
        <div class="pp-done-section">
            <div class="pp-done-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11.5 14.5 15.5 9.5" />
                </svg>
            </div>
            <p class="pp-done-title">Import Complete!</p>
            <div class="pp-done-stats">
                <div class="pp-stat"><span class="pp-stat-num">@_importDone</span><span class="pp-stat-lbl">anime imported</span></div>
                <div class="pp-stat"><span class="pp-stat-num">@_listsCreated</span><span class="pp-stat-lbl">lists created</span></div>
            </div>
            @if (!string.IsNullOrEmpty(AniListAuth.CurrentUser?.Name))
            {
                <div class="pp-user-mini">
                    @if (!string.IsNullOrEmpty(AniListAuth.CurrentUser.AvatarUrl))
                    {
                        <div class="pp-avatar-mini" style="background-image:url('@AniListAuth.CurrentUser.AvatarUrl');"></div>
                    }
                    <span class="pp-username-mini">@AniListAuth.CurrentUser.Name</span>
                </div>
            }
            <button class="pp-done-close-btn" @onclick="() => _state = PanelState.Connected">Done</button>
            <button class="pp-disconnect-btn" @onclick="() => _ = Disconnect()">Disconnect</button>
        </div>
    }
    else if (_state == PanelState.Error)
    {
        <div class="pp-error-section">
            <div class="pp-error-icon">⚠️</div>
            <p class="pp-error-title">Something went wrong</p>
            <p class="pp-error-sub">@_errorMessage</p>
            <button class="pp-anilist-btn" @onclick="() => _state = PanelState.NotConnected">Try Again</button>
        </div>
    }
    else if (_state == PanelState.WaitingForPin)
    {
        <div class="pp-connect-section">
            <p class="pp-connect-title">Paste your token</p>
            <p class="pp-connect-sub">AniList has opened in a new tab. After authorizing, copy the token shown and paste it below.</p>
            <input class="pp-token-input" placeholder="Paste token here..." @bind="_pastedToken" />
            <button class="pp-anilist-btn" @onclick="SubmitToken">Connect</button>
        </div>
    }
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsActive { get; set; }

    private DotNetObjectReference<AccountTab>? _selfRef;

    private string _pastedToken = "";

    private enum PanelState { NotConnected, Loading, Connected, Importing, Done, Error, WaitingForPin }
    private PanelState _state = PanelState.NotConnected;
    private string _loadingText = "Loading…";
    private string _errorMessage = "";
    private int _importTotal = 0, _importDone = 0, _listsCreated = 0;

    private static readonly string[] _swatches = {
        "#ef4444","#f97316","#f59e0b","#eab308","#84cc16","#22c55e",
        "#10b981","#14b8a6","#06b6d4","#0ea5e9","#3b82f6","#6366f1",
        "#8b5cf6","#a855f7","#d946ef","#ec4899"
    };

    private bool _prevVisible = false;

    // ── Lifecycle ──────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        bool justOpened = IsVisible && !_prevVisible;
        _prevVisible = IsVisible;

        if (justOpened)
        {
            if (AniListAuth.IsAuthenticated && _state == PanelState.NotConnected)
                _state = PanelState.Connected;
        }
    }

    // ── Public API (called from ProfilePanel) ──────────────────────────────

    public async Task OnTokenReceived()
    {
        _state = PanelState.Loading;
        _loadingText = "Fetching your profile…";
        StateHasChanged();
        var user = await AniListAuth.FetchCurrentUserAsync();
        _state = user == null ? PanelState.Error : PanelState.Connected;
        if (user == null) _errorMessage = "Could not fetch your AniList profile.";
        StateHasChanged();
    }

    public async Task TryAutoImportAsync()
    {
        if (!AniListAuth.IsAuthenticated) return;
        if (AniListAuth.CurrentUser == null)
        {
            var u = await AniListAuth.FetchCurrentUserAsync();
            if (u == null) return;
        }
        await DoImportAsync(false);
    }

    // ── OAuth ──────────────────────────────────────────────────────────────

    private async Task StartOAuth()
    {
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("aniListListenForToken", _selfRef);
            await JS.InvokeVoidAsync("open", AniListAuth.GetAuthUrl(), "_blank");
            _state = PanelState.WaitingForPin;
            _loadingText = "Waiting for authorization…";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _state = PanelState.Error;
            _errorMessage = "Could not open AniList login: " + ex.Message;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnTokenFromOtherTab(string token)
    {
        if (string.IsNullOrWhiteSpace(token)) return;
        _pastedToken = token;
        AniListAuth.SetToken(token);
        try { await JS.InvokeVoidAsync("aniListSaveToken", token); } catch { }
        _state = PanelState.Loading;
        _loadingText = "Fetching your profile…";
        await InvokeAsync(StateHasChanged);
        var user = await AniListAuth.FetchCurrentUserAsync();
        _state = user == null ? PanelState.Error : PanelState.Connected;
        if (user == null) _errorMessage = "Invalid token or could not fetch profile.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitToken()
    {
        if (string.IsNullOrWhiteSpace(_pastedToken)) return;
        var token = _pastedToken.Trim();
        AniListAuth.SetToken(token);
        try { await JS.InvokeVoidAsync("aniListSaveToken", token); } catch { }  // ← ligne ajoutée
        _state = PanelState.Loading;
        _loadingText = "Fetching your profile…";
        StateHasChanged();
        var user = await AniListAuth.FetchCurrentUserAsync();
        _state = user == null ? PanelState.Error : PanelState.Connected;
        if (user == null) _errorMessage = "Invalid token or could not fetch profile.";
        StateHasChanged();
    }

    // ── Import ─────────────────────────────────────────────────────────────

    private async Task StartImport()
    {
        if (AniListAuth.CurrentUser == null) return;
        _state = PanelState.Importing;
        _loadingText = "Fetching your anime list…";
        _importDone = 0; _importTotal = 0; _listsCreated = 0;
        StateHasChanged();
        await DoImportAsync(true);
    }

    private async Task DoImportAsync(bool showUI)
    {
        if (AniListAuth.CurrentUser == null) return;
        var entries = await AniListAuth.FetchAnimeListAsync(AniListAuth.CurrentUser.Id);
        if (entries.Count == 0)
        {
            if (showUI)
            {
                _state = PanelState.Error;
                _errorMessage = "Your AniList is empty or could not be fetched.";
                StateHasChanged();
            }
            return;
        }

        var (map, newCount) = BuildCustomListMap(
            entries.SelectMany(e => e.CustomListNames)
                   .Distinct(StringComparer.OrdinalIgnoreCase)
                   .ToList());

        _listsCreated = newCount;
        _importTotal = entries.Count;
        if (showUI) { _loadingText = "Importing anime…"; StateHasChanged(); }

        foreach (var imp in entries)
        {
            ApplyEntry(imp, map);
            _importDone++;
            if (showUI && _importDone % 20 == 0) { StateHasChanged(); await Task.Yield(); }
        }
        UserListService.NotifyChanged();

        try
        {
            var favIds = await AniListAuth.FetchFavouriteIdsAsync();
            if (favIds.Count > 0) { UserListService.ImportFavorites(favIds); UserListService.NotifyChanged(); }
        }
        catch { }

        if (showUI) { _state = PanelState.Done; StateHasChanged(); }
    }

    private (Dictionary<string, string> map, int newCount) BuildCustomListMap(List<string> names)
    {
        if (!names.Any()) return (new(), 0);
        var existing = UserListService.GetCustomLists();
        var avail = _swatches.Where(c => !existing.Select(l => l.Color).ToHashSet(StringComparer.OrdinalIgnoreCase).Contains(c)).ToList();
        if (!avail.Any()) avail = _swatches.ToList();
        var rng = new Random();
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var toAdd = new List<UserCustomList>();

        foreach (var name in names)
        {
            var ex = existing.FirstOrDefault(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase));
            if (ex != null) { map[name] = ex.Id; continue; }
            string color;
            if (avail.Any()) { int idx = rng.Next(avail.Count); color = avail[idx]; avail.RemoveAt(idx); }
            else color = _swatches[rng.Next(_swatches.Length)];
            var nl = new UserCustomList { Id = Guid.NewGuid().ToString(), Name = name, Color = color, IsStatusList = false, Order = existing.Count + toAdd.Count };
            toAdd.Add(nl);
            map[name] = nl.Id;
        }

        int newCount = toAdd.Count;
        if (toAdd.Any()) UserListService.SaveCustomLists(existing.Concat(toAdd).ToList());
        return (map, newCount);
    }

    private void ApplyEntry(AniListImportEntry src, Dictionary<string, string> map)
    {
        if (src.AnimeCard.Id == 0 && src.MediaId == 0) return;
        if (src.AnimeCard.Id == 0) src.AnimeCard.Id = src.MediaId;
        UserListService.ImportEntry(new UserListEntry
        {
            Anime = src.AnimeCard,
            Status = MapStatus(src.AniListStatus),
            Score = src.Score,
            EpisodesWatched = src.Progress,
            TotalRewatches = src.Repeat,
            Notes = src.Notes,
            IsPrivate = src.IsPrivate,
            HideFromStatusLists = src.HideFromStatusLists,
            StartDate = src.StartedAt,
            FinishDate = src.CompletedAt,
            AddedAt = src.CreatedAt,
            UpdatedAt = src.UpdatedAt,
            CustomListIds = src.CustomListNames.Where(n => map.ContainsKey(n)).Select(n => map[n]).ToList()
        });
    }

    private static ListStatus? MapStatus(string s) => s switch
    {
        "CURRENT" => ListStatus.Watching,
        "REPEATING" => ListStatus.Rewatching,
        "COMPLETED" => ListStatus.Completed,
        "PLANNING" => ListStatus.Planning,
        "PAUSED" => ListStatus.Paused,
        "DROPPED" => ListStatus.Dropped,
        _ => null
    };

    private async Task Disconnect()
    {
        try { await JS.InvokeVoidAsync("aniListStopListening"); } catch { }
        AniListAuth.ClearToken();
        _state = PanelState.NotConnected;
        _importDone = 0; _importTotal = 0; _listsCreated = 0;
        StateHasChanged();
    }

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("aniListStopListening"); } catch { }
        _selfRef?.Dispose();
    }
}
