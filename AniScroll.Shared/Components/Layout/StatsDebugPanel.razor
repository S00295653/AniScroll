@* ══════════════════════════════════════════════════════════════════════
   StatsDebugPanel.razor — TEMPORARY DEBUG COMPONENT
   
   HOW TO USE:
   1. Add this file to AniScroll.Shared/Components/Layout/
   2. In Index.razor, add inside the main div:
         <StatsDebugPanel />
   3. Open the app, tap the "🐛 DEBUG STATS" button
   4. Read the report — it shows exactly where the inflation comes from
   5. Remove this component once the bug is identified
   ══════════════════════════════════════════════════════════════════════ *@

@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService

<button @onclick="Toggle"
        style="position:fixed;bottom:160px;right:10px;z-index:9999;
               background:#E94560;border:none;color:white;padding:6px 10px;
               border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;">
    🐛 DEBUG STATS
</button>

@if (_show && _report != null)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.95);
                overflow-y:auto;padding:16px;font-family:monospace;font-size:11px;color:#e0e0e0;">

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
            <span style="color:#E94560;font-size:15px;font-weight:700;">📊 Stats Debug Report</span>
            <button @onclick="Toggle"
                    style="background:#333;border:none;color:white;padding:6px 14px;border-radius:6px;cursor:pointer;">
                Close
            </button>
        </div>

        @* ── Raw entry counts ── *@
        <Section Title="RAW ENTRY COUNTS">
            <Row Label="GetAll() total" Value="@_report.RawTotal.ToString()" Color="#fff" />
            <Row Label="With Status OR CustomList" Value="@_report.WithStatusOrList.ToString()" Color="#fff" />
            <Row Label="With Id == 0" Value="@_report.ZeroIdCount.ToString()" Color="@(_report.ZeroIdCount > 0 ? "#ff6b6b" : "#51cf66")" />
            <Row Label="Unique anime IDs (non-zero)" Value="@_report.UniqueNonZeroIds.ToString()" Color="#51cf66" />
            <Row Label="Duplicate IDs detected" Value="@_report.DuplicateIds.ToString()" Color="@(_report.DuplicateIds > 0 ? "#ff6b6b" : "#51cf66")" />
        </Section>

        @* ── Duplicate details ── *@
        @if (_report.DuplicateDetails.Any())
        {
            <Section Title="DUPLICATE ENTRIES (first 10)">
                @foreach (var d in _report.DuplicateDetails.Take(10))
                {
                    <div style="margin-bottom:6px;padding:6px 8px;background:#1a0010;border:1px solid #ff6b6b33;border-radius:6px;">
                        <div style="color:#ff6b6b;">ID: @d.Id (@d.Count× duplicated)</div>
                        <div style="color:#aaa;margin-top:2px;">@d.Title</div>
                        @foreach (var s in d.Statuses)
                        {
                            <div style="color:#888;font-size:10px;">  status=@(s.Status?.ToString() ?? "null")  lists=[@(string.Join(",", s.CustomListIds))]  updatedAt=@s.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    </div>
                }
            </Section>
        }

        @* ── Counts after dedup ── *@
        <Section Title="AFTER GroupBy DEDUP">
            <Row Label="Unique entries" Value="@_report.AfterDedup.ToString()" Color="#51cf66" />
            <Row Label="With Score > 0" Value="@_report.ScoredAfterDedup.ToString()" Color="#51cf66" />
        </Section>

        @* ── Field inflation check ── *@
        <Section Title="FIELD INFLATION CHECK (after dedup)">
            <Row Label="Sum of all genre references" Value="@_report.TotalGenreRefs.ToString()" Color="#fff" />
            <Row Label="Sum of all studio references" Value="@_report.TotalStudioRefs.ToString()" Color="#fff" />
            <Row Label="Sum of all tag references" Value="@_report.TotalTagRefs.ToString()" Color="#fff" />
            <Row Label="Sum of ByCountry values" Value="@_report.SumCountry.ToString()" Color="@(_report.SumCountry > _report.AfterDedup ? "#ff6b6b" : "#51cf66")"
                 Note="@(_report.SumCountry > _report.AfterDedup ? "⚠ EXCEEDS anime count!" : "✓ OK")" />
            <Row Label="Sum of BySeason values" Value="@_report.SumSeason.ToString()" Color="@(_report.SumSeason > _report.AfterDedup ? "#ffd43b" : "#51cf66")"
                 Note="@(_report.SumSeason > _report.AfterDedup ? "⚠ anime with no season not counted — expected" : "✓ OK")" />
        </Section>

        @* ── Top tag analysis ── *@
        <Section Title="TOP 10 TAGS (after dedup)">
            @foreach (var t in _report.TopTags)
            {
                <Row Label="@t.Key" Value="@t.Value.ToString()"
                     Color="@(t.Value > _report.AfterDedup ? "#ff6b6b" : "#51cf66")"
                     Note="@(t.Value > _report.AfterDedup ? "⚠ IMPOSSIBLE — exceeds anime count!" : "")" />
            }
        </Section>

        @* ── Top country analysis ── *@
        <Section Title="TOP COUNTRIES (after dedup)">
            @foreach (var c in _report.CountryBreakdown)
            {
                <Row Label="@c.Key" Value="@c.Value.ToString()"
                     Color="@(c.Value > _report.AfterDedup ? "#ff6b6b" : "#51cf66")" />
            }
        </Section>

        @* ── Before vs After ── *@
        <Section Title="OLD vs NEW STAT VALUES">
            <Row Label="Scored count (OLD loop)" Value="@_report.OldScoredCount.ToString()" Color="#ffd43b" />
            <Row Label="Scored count (GroupBy fix)" Value="@_report.ScoredAfterDedup.ToString()" Color="#51cf66" />
            <Row Label="Japan count (OLD loop)" Value="@_report.OldJapanCount.ToString()" Color="#ffd43b" />
            <Row Label="Japan count (GroupBy fix)" Value="@_report.NewJapanCount.ToString()" Color="#51cf66" />
            <Row Label="Male Protagonist (OLD)" Value="@_report.OldMaleProtag.ToString()" Color="#ffd43b" />
            <Row Label="Male Protagonist (NEW)" Value="@_report.NewMaleProtag.ToString()" Color="#51cf66" />
            <Row Label="Episodes total (NEW)" Value="@_report.NewEpisodes.ToString()" Color="#51cf66" />
        </Section>

        <div style="margin-top:16px;padding:10px;background:#001a00;border:1px solid #22c55e33;border-radius:8px;color:#86efac;font-size:10px;line-height:1.7;">
            <strong>What to look for:</strong><br/>
            • If "Duplicate IDs detected" &gt; 0 → import produced duplicate entries — the GroupBy fix solves this.<br/>
            • If "Id == 0" &gt; 0 → failed lookups are polluting stats — filter them out.<br/>
            • If tag/country counts exceed anime count after dedup → AniList data itself has duplicates in arrays — need inner HashSet per entry.<br/>
            • If counts look correct after dedup → you haven't applied the GroupBy fix to ComputeStats() yet.
        </div>
    </div>
}

@code {
    private bool _show = false;
    private DebugReport? _report;

    private void Toggle()
    {
        _show = !_show;
        if (_show) _report = BuildReport();
    }

    private DebugReport BuildReport()
    {
        var r = new DebugReport();

        // ── Raw data ──────────────────────────────────────────────────────────
        var rawAll = UserListService.GetAll().ToList();
        r.RawTotal = rawAll.Count;

        var withFilter = rawAll.Where(e => e.Status.HasValue || e.CustomListIds.Any()).ToList();
        r.WithStatusOrList = withFilter.Count;
        r.ZeroIdCount = withFilter.Count(e => e.Anime.Id == 0);

        var grouped = withFilter.GroupBy(e => e.Anime.Id).ToList();
        r.UniqueNonZeroIds = grouped.Count(g => g.Key != 0);
        r.DuplicateIds = grouped.Count(g => g.Count() > 1);

        r.DuplicateDetails = grouped
            .Where(g => g.Count() > 1)
            .OrderByDescending(g => g.Count())
            .Take(10)
            .Select(g => new DupDetail
            {
                Id = g.Key,
                Title = g.First().Anime.Title,
                Count = g.Count(),
                Statuses = g.Select(e => new StatusInfo
                {
                    Status = e.Status,
                    CustomListIds = e.CustomListIds,
                    UpdatedAt = e.UpdatedAt
                }).ToList()
            }).ToList();

        // ── After dedup ───────────────────────────────────────────────────────
        var deduped = grouped
            .Select(g => g.OrderByDescending(e => e.UpdatedAt).First())
            .ToList();
        r.AfterDedup = deduped.Count;
        r.ScoredAfterDedup = deduped.Count(e => e.Score > 0);

        // ── Field analysis ────────────────────────────────────────────────────
        r.TotalGenreRefs  = deduped.Sum(e => (e.Anime.Genres  ?? new()).Count);
        r.TotalStudioRefs = deduped.Sum(e => (e.Anime.Studios ?? new()).Count);
        r.TotalTagRefs    = deduped.Sum(e => (e.Anime.Tags    ?? new()).Count(t => !t.IsMediaSpoiler));

        // Country
        var countryDict = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var e in deduped)
            if (!string.IsNullOrEmpty(e.Anime.CountryOfOrigin))
                countryDict[e.Anime.CountryOfOrigin] = countryDict.GetValueOrDefault(e.Anime.CountryOfOrigin) + 1;
        r.SumCountry = countryDict.Values.Sum();
        r.CountryBreakdown = countryDict.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);
        r.NewJapanCount = countryDict.GetValueOrDefault("JP");

        // Season
        var seasonDict = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var e in deduped)
            if (!string.IsNullOrEmpty(e.Anime.Season))
                seasonDict[e.Anime.Season] = seasonDict.GetValueOrDefault(e.Anime.Season) + 1;
        r.SumSeason = seasonDict.Values.Sum();

        // Tags
        var tagDict = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var e in deduped)
        {
            var localTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var t in e.Anime.Tags?.Where(t => !t.IsMediaSpoiler) ?? Enumerable.Empty<AnimeTag>())
                if (localTags.Add(t.Name))
                    tagDict[t.Name] = tagDict.GetValueOrDefault(t.Name) + 1;
        }
        r.TopTags = tagDict.OrderByDescending(x => x.Value).Take(10).ToDictionary(x => x.Key, x => x.Value);
        r.NewMaleProtag = tagDict.GetValueOrDefault("Male Protagonist");

        // ── Old loop simulation (no GroupBy, no local dedup) ─────────────────
        // Simulates what the ORIGINAL ComputeStats does
        int oldScored = 0, oldJapan = 0, oldMaleProtag = 0;
        int newEpisodes = 0;
        var seenIds = new HashSet<int>();
        var seenTagsGlobal = new HashSet<(int, string)>();
        var seenCountryGlobal = new HashSet<int>();

        foreach (var e in withFilter)
        {
            if (e.Score > 0) oldScored++;  // OLD: no dedup = counts dupes
            var id = e.Anime.Id;
            if (!string.IsNullOrEmpty(e.Anime.CountryOfOrigin) && seenCountryGlobal.Add(id))
                if (e.Anime.CountryOfOrigin == "JP") oldJapan++;
            foreach (var t in e.Anime.Tags?.Where(t => !t.IsMediaSpoiler) ?? Enumerable.Empty<AnimeTag>())
                if (seenTagsGlobal.Add((id, t.Name)) && t.Name == "Male Protagonist") oldMaleProtag++;
        }

        // New episodes calc on deduped
        foreach (var e in deduped)
        {
            int tot = GetTotalEps(e.Anime.Episodes);
            int rw = (e.TotalRewatches > 0 && e.Status != ListStatus.Planning)
                ? e.TotalRewatches * (tot > 0 ? tot : e.EpisodesWatched) : 0;
            newEpisodes += e.EpisodesWatched + rw;
        }

        r.OldScoredCount = oldScored;
        r.OldJapanCount  = oldJapan;
        r.OldMaleProtag  = oldMaleProtag;
        r.NewEpisodes    = newEpisodes;

        return r;
    }

    private static int GetTotalEps(string? s)
    {
        if (string.IsNullOrWhiteSpace(s) || s == "N/A") return 0;
        var part = s.Split('/').Last().Trim().TrimEnd('+', '?');
        return int.TryParse(part, out int v) && v > 0 ? v : 0;
    }

    // ── Tiny render helpers ───────────────────────────────────────────────────

    private RenderFragment Section(string Title, RenderFragment ChildContent) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", "margin-bottom:14px;");
        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "style", "color:#ffd43b;font-weight:700;font-size:10px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px;padding-bottom:4px;border-bottom:1px solid #333;");
        __builder.AddContent(4, Title);
        __builder.CloseElement();
        __builder.AddContent(5, ChildContent);
        __builder.CloseElement();
    };

    private RenderFragment Row(string Label, string Value, string Color, string Note = "") => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", "display:flex;align-items:center;gap:8px;padding:3px 0;");
        __builder.OpenElement(2, "span");
        __builder.AddAttribute(3, "style", "color:#888;flex:1;");
        __builder.AddContent(4, Label);
        __builder.CloseElement();
        __builder.OpenElement(5, "span");
        __builder.AddAttribute(6, "style", $"color:{Color};font-weight:700;min-width:50px;text-align:right;");
        __builder.AddContent(7, Value);
        __builder.CloseElement();
        if (!string.IsNullOrEmpty(Note))
        {
            __builder.OpenElement(8, "span");
            __builder.AddAttribute(9, "style", $"color:{Color};font-size:9px;");
            __builder.AddContent(10, Note);
            __builder.CloseElement();
        }
        __builder.CloseElement();
    };

    // ── Models ────────────────────────────────────────────────────────────────

    private class DebugReport
    {
        public int RawTotal;
        public int WithStatusOrList;
        public int ZeroIdCount;
        public int UniqueNonZeroIds;
        public int DuplicateIds;
        public List<DupDetail> DuplicateDetails = new();
        public int AfterDedup;
        public int ScoredAfterDedup;
        public int TotalGenreRefs;
        public int TotalStudioRefs;
        public int TotalTagRefs;
        public int SumCountry;
        public int SumSeason;
        public Dictionary<string, int> CountryBreakdown = new();
        public Dictionary<string, int> TopTags = new();
        public int NewJapanCount;
        public int NewMaleProtag;
        public int OldScoredCount;
        public int OldJapanCount;
        public int OldMaleProtag;
        public int NewEpisodes;
    }

    private class DupDetail
    {
        public int Id;
        public string Title = "";
        public int Count;
        public List<StatusInfo> Statuses = new();
    }

    private class StatusInfo
    {
        public ListStatus? Status;
        public List<string> CustomListIds = new();
        public DateTime UpdatedAt;
    }
}
