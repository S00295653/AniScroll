@* StatsDebugPanel.razor — Add to Layout/, add <StatsDebugPanel /> in Index.razor *@
@using AniScroll.Shared.Models
@using AniScroll.Shared.Services
@inject UserListService UserListService

@if (!_show)
{
    <button @onclick="() => _show = true"
            style="position:fixed;bottom:160px;right:10px;z-index:9999;background:#E94560;
                       border:none;color:white;padding:8px 12px;border-radius:8px;font-size:12px;
                       font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(233,69,96,0.5);">
        🔢 COUNTS
    </button>
}
else
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.97);
                    display:flex;flex-direction:column;align-items:center;justify-content:center;
                    padding:20px;font-family:monospace;">

        <div style="width:100%;max-width:420px;">
            <div style="color:#E94560;font-size:16px;font-weight:700;margin-bottom:20px;text-align:center;">
                🔢 Nombre d'entrées réelles
            </div>

            @foreach (var r in _rows)
            {
                <div style="display:flex;justify-content:space-between;align-items:center;
                                    padding:12px 16px;margin-bottom:6px;border-radius:10px;
                                    background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);">
                    <span style="color:rgba(255,255,255,0.6);font-size:12px;">@r.Label</span>
                    <span style="color:@r.Color;font-size:20px;font-weight:900;">@r.Value</span>
                </div>
            }

            <div style="margin-top:16px;padding:14px;background:#0a1a0a;border:1px solid #166534;
                            border-radius:10px;color:#86efac;font-size:12px;line-height:1.8;text-align:center;">
                @((MarkupString)_msg)
            </div>

            <button @onclick="() => _show = false"
                    style="margin-top:16px;width:100%;padding:14px;background:#333;border:none;
                               color:white;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;">
                Fermer
            </button>
        </div>
    </div>
}

@code {
    bool _show = false;
    record Row(string Label, string Value, string Color);
    List<Row> _rows = new();
    string _msg = "";

    protected override void OnParametersSet() { }

    private void Show()
    {
        _show = true;
        Build();
    }

    protected override void OnAfterRender(bool first) { }

    private void Build()
    {
        var all = UserListService.GetAll().ToList();
        var filtered = all.Where(e => e.Status.HasValue || e.CustomListIds.Any()).ToList();
        int tracked = UserListService.CountTracked();
        int scored = filtered.Count(e => e.Score > 0);
        int planning = filtered.Count(e => e.Status == ListStatus.Planning);
        int notPlan = filtered.Count(e => e.Status != ListStatus.Planning);
        var seasons = filtered.Where(e => !string.IsNullOrEmpty(e.Anime.Season)).ToList();
        int seasonSum = seasons.Count;                        // 1 entry = 1 season
        int jpCount = filtered.Count(e => e.Anime.CountryOfOrigin == "JP");
        int mpCount = 0;
        foreach (var e in filtered)
        {
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var t in e.Anime.Tags?.Where(t => !t.IsMediaSpoiler) ?? Enumerable.Empty<AnimeTag>())
                if (seen.Add(t.Name) && t.Name == "Male Protagonist") { mpCount++; break; }
        }

        _rows = new()
        {
            new("GetAll() brut (tout)", all.Count.ToString(), "#fff"),
            new("Avec status OU custom list", filtered.Count.ToString(), "#fff"),
            new("CountTracked() (badge UI)", tracked.ToString(), filtered.Count == tracked ? "#51cf66" : "#ff6b6b"),
            new("─────────────────────────────", "", "#333"),
            new("Planning", planning.ToString(), "#a855f7"),
            new("Non-planning (sans planning)", notPlan.ToString(), "#3b82f6"),
            new("─────────────────────────────", "", "#333"),
            new("Avec score > 0 (correct)", scored.ToString(), scored <= filtered.Count ? "#51cf66" : "#ff6b6b"),
            new("Japan JP (correct)", jpCount.ToString(), jpCount <= filtered.Count ? "#51cf66" : "#ff6b6b"),
            new("Male Protagonist (correct)", mpCount.ToString(), mpCount <= filtered.Count ? "#51cf66" : "#ff6b6b"),
            new("Season count (correct)", seasonSum.ToString(), seasonSum <= filtered.Count ? "#51cf66" : "#ff6b6b"),
        };

        bool ok = scored <= filtered.Count && jpCount <= filtered.Count
               && mpCount <= filtered.Count && seasonSum <= filtered.Count;

        if (ok)
        {
            _msg = $"<strong>✅ Toutes les valeurs sont CORRECTES</strong><br/>" +
                   $"Total réel = <strong>{filtered.Count}</strong> anime<br/>" +
                   $"(dont {planning} en Planning + {notPlan} autres)<br/><br/>" +
                   $"Si tu pensais avoir <strong>361</strong> anime, c'est probablement<br/>" +
                   $"le count <em>sans Planning</em> ({notPlan}) ou <em>sans Custom List</em>.";
        }
        else
        {
            _msg = $"<strong>🔴 VALEURS ENCORE GONFLÉES</strong><br/>Le fix n'est pas compilé.<br/>" +
                   $"Faire un Clean + Rebuild complet et vider le cache navigateur.";
        }
    }

    // Called when button clicked
    private new void StateHasChanged() => base.StateHasChanged();

    protected new void OnInitialized()
    {
        base.OnInitialized();
    }

    // Override pour recalculer à chaque ouverture
    private bool _built = false;
    protected override bool ShouldRender()
    {
        if (_show && !_built) { _built = true; Build(); }
        if (!_show) _built = false;
        return true;
    }
}
