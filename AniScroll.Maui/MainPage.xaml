<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AniScroll.Maui"
             x:Class="AniScroll.Maui.MainPage"
             BackgroundColor="Black">

    <!--
        x:Name="blazorWebView" is required so MainPage.xaml.cs can subscribe
        to UrlLoading and redirect external links to the system browser.
    -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
